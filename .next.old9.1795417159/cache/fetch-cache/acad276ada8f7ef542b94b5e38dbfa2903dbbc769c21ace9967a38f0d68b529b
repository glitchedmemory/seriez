{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":791523,\"title\":\"Wildwood\",\"tagline\":\"How far would you go for those you love?\",\"overview\":\"Prue and her classmate Curtis are drawn into a magical forest filled with enchanted creatures, loyal allies, and formidable adversaries as they embark on a desperate quest to rescue Prue's abducted baby brother from a murder of crows led by a mysterious woman named Alexandra.\",\"poster\":\"https://image.tmdb.org/t/p/w780/snFM00mpNAfUzUtkdEW0uDEvXA0.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/sl5NJ1vtyhP9Vr88bB4blULsJYp.jpg\",\"rating\":8.5,\"voteCount\":317,\"year\":2026,\"runtime\":132,\"genres\":[\"Animation\",\"Adventure\",\"Drama\",\"Fantasy\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":100000000,\"revenue\":67370469,\"director\":\"Travis Knight\",\"cast\":[{\"id\":1033661,\"name\":\"Travis Knight\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/5JmhiYsF0H1geSwbX5NtByZuJjC.jpg\"},{\"id\":1768964,\"name\":\"Peyton Elizabeth Lee\",\"character\":\"Prue McKeel (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/hnEl4HxqGNGHCJ7Y8l3dJ21WHeG.jpg\"},{\"id\":1277188,\"name\":\"Jacob Tremblay\",\"character\":\"Curtis Mehlberg (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/h8CXDp86Y36CUENF4SXJq5ZRTsf.jpg\"},{\"id\":36662,\"name\":\"Carey Mulligan\",\"character\":\"Alexandra (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/iwVHhqoz5b62FR0SDpZ7wfsuTBI.jpg\"},{\"id\":932967,\"name\":\"Mahershala Ali\",\"character\":\"Brenden (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/9ZmSejm5lnUVY5IJ1iNx2QEjnHb.jpg\"},{\"id\":20766,\"name\":\"Richard E. Grant\",\"character\":\"Owl Rex (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/92oaBntIXhndCxUXaGywUyILIIE.jpg\"},{\"id\":9780,\"name\":\"Angela Bassett\",\"character\":\"The General (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/tKnu