{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1232569,\"title\":\"Pinocchio: Unstrung\",\"tagline\":\"He has no strings to hold him back now.\",\"overview\":\"Influenced by a sinister Cricket and created by Geppetto, Pinocchio launches a violent crusade to carve himself into a real boy like his brother James, one piece at a time.\",\"poster\":\"https://image.tmdb.org/t/p/w780/hJNdizFlxOW89edX3Rzr6OliSFI.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7RsPdXLDNugDIlwXPVeeprNfMx.jpg\",\"rating\":6.3,\"voteCount\":179,\"year\":2026,\"runtime\":82,\"genres\":[\"Horror\",\"Fantasy\",\"Mystery\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"}],\"budget\":500000,\"revenue\":822910,\"director\":\"Rhys Frake-Waterfield\",\"cast\":[{\"id\":3122176,\"name\":\"Rhys Frake-Waterfield\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/a0ETg5j54Nca7dO2s9Tfhco0u40.jpg\"},{\"id\":5752734,\"name\":\"Jude Evan Lloyd\",\"character\":\"Pinocchio (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/5lcnZuR8L3W64DOICg9h5VE6uW4.jpg\"},{\"id\":4916781,\"name\":\"Cameron Bell\",\"character\":\"James\",\"photo\":\"https://image.tmdb.org/t/p/w780/mjSipiIUJFqhdjmBdtttsmZGgx1.jpg\"},{\"id\":3901,\"name\":\"Richard Brake\",\"character\":\"Geppetto\",\"photo\":\"https://image.tmdb.org/t/p/w780/JwsiErANShzPSdYsNoiNYdrSg1.jpg\"},{\"id\":3909217,\"name\":\"Jessica Balmer\",\"character\":\"Mia\",\"photo\":\"https://image.tmdb.org/t/p/w780/fhb5Oj719yH7z5f2lYU2r8Lyu46.jpg\"},{\"id\":5692794,\"name\":\"Jack Art Gray\",\"character\":\"Dudley\",\"photo\":\"https://image.tmdb.org/t/p/w780/pysea7rtgJOHRv77WXD1RNHkWku.jpg\"},{\"id\":5139,\"name\":\"Robert Englund\",\"character\":\"Cricket (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/cjGEkiavinHa1dnetDvnEhlD2Wm.jpg\"},{\"id\":185065,\"name\":\"Emma Tate\",\"character\":\"Woodmother (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/in8SZAA5dG6wW1LBCU10j1J