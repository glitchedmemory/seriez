ype\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":285677,\"title\":\"S:t Görans sjukhus\",\"poster\":\"https://image.tmdb.org/t/p/w780/mUKvjKax4j7kiZ4yC7QfJY9f2g1.jpg\",\"rating\":5,\"year\":2025,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":74307,\"title\":\"Trafikpoliserna\",\"poster\":\"https://image.tmdb.org/t/p/w780/1L5ZtQ5PupN0REyKeHPo8h9Cexk.jpg\",\"rating\":0,\"year\":2017,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":153914,\"title\":\"Pantbanken\",\"poster\":\"https://image.tmdb.org/t/p/w780/kQG5FOYXVhQVyoh103jI9dcwLCY.jpg\",\"rating\":0,\"year\":2019,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":38631,\"title\":\"112 - på liv och död\",\"poster\":\"https://image.tmdb.org/t/p/w780/2rSHtmVmmqBhwDbiX3M2AoMFbZU.jpg\",\"rating\":0,\"year\":2010,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":222574,\"title\":\"Högspänning med Erik Ekstrand\",\"poster\":\"https://image.tmdb.org/t/p/w780/nMedvfCeI11fCOkpB9hqLcY1vog.jpg\",\"rating\":0,\"year\":2023,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":63065,\"title\":\"112 - luftens hjältar\",\"poster\":\"https://image.tmdb.org/t/p/w780/d4sv98pZ4p4Mdet9BQ1T2OPObfq.jpg\",\"rating\":10,\"year\":2011,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":246715,\"title\":\"Poliserna i våldsvågen\",\"poster\":\"https://image.tmdb.org/t/p/w780/xogCWxOdDehadIO1jymJYlYXgL7.jpg\",\"rating\":2,\"year\":2024,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1},{\"id\":63060,\"title\":\"Tunnelbanan\",\"poster\":\"https://image.tmdb.org/t/p/w780/1AqxeqZ1gk1QDabdQ9zqZT32aH0.jpg\",\"rating\":8,\"year\":2012,\"type\":\"tv\",\"_score\":0.4,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/kpGpKpX17OADUAB3UkhnbhOB3V6.jpg\",\"seasonAirDate\":\"2009-11-02\",\"episodes\":[{\"number\":1,\"name\":\"Rose-Marie tänker slå förra årets rekord\",\"overview\":\"VDn Boris är lite bekymrad när solen strålar, vilket är dåligt shoppingväder. Kjell, Rose-Marie och alla deras döttrar från Malmö kommer varje sommar till Ullared och bor på campingen och handlar allt de behöver för det kommande året. En av de 1050 anställda på varuhuset är Morgan som jobbar på lagret. Han bor ensam i ett stort hus som han visar upp. Maggan och Gittan från Göteborg är stamgäster och de är mycket exalterade över att få se idolen Robert Wells. Från Vimmerby kommer den blonda makeupartisten Mattias och hans färgglada mamma Susanne.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-11-02\",\"runtime\":60},{\"number\":2,\"name\":\"Ullared får celebert besök av Wahlbeck\",\"overview\":\"Madde har tagit med sig fästmannen Martin till Ullared. Hon är en trogen besökare, men nu när det ska handlas till deras stundande bröllop måste den mycket motvillige Martin följa med och handla. Bröllopet ska ha Gudfaderntema och paret letar efter prylar som passar in på temat.             \\n\\nPeter Wahlbeck och hans son har tagit in på campingen för att sälja lite grejer, böcker, tröjor m.m. Han gjorde Ullared känt med sin låt om Ullared 1994.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-11-09\",\"runtime\":60},{\"number\":3,\"name\":\"Korvätartävling i Ullared\",\"overview\":\"Gunnel fyller 50 och eftersom hon älskar Gekås firas hon med en trip till Ullared. Där ska Gunnel och hennes gäng bo på campingen och spela paketspelet, ett spel som börjar med att Gunnel får gå in i varuhuset och handla 12 paket. Sen börjar kampen om paketen!\\n\\nElin och Frida från Växjö är partysugna och har bokat en stuga på campingen när de ska utforska Ullareds festutbud. De tar också en sväng på Erotikvaruhuset i Ullared efter sin stora shoppingtur i varuhuset.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-11-16\",\"runtime\":60},{\"number\":4,\"name\":\"Radioprofilerna shoppar loss ordentligt\",\"overview\":\"Gunnar har varit i Ullared en gång, och svor på att aldrig mer åka dit. Nu har hans fru Jenny tänkt överraska honom med en romantisk weekend i Ullared för att ge igen för alla överraskningar hon har utsatts för de senaste åren. När han väl kommer in i varuhuset lägger sig chocken och han blir mycket entusiastisk över billiga spikar och annat.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-11-23\",\"runtime\":60},{\"number\":5,\"name\":\"Kjell och Rose-Marie packar ihop\",\"overview\":\"Tvillingarna Tommy och Benny från Småland gör Ullaredsdebut när de ska köpa en billig bröllopspresent till deras kompis som ska gifta sig. De satsar på kvantitet och väljer ut prylar från hela varuhuset med filosofin ”Hellre sex dåliga grejer än en bra!”.\\n\\nSverige måste vara ett bakande folk. En av Ullareds allra populäraste produkter är nämligen det egna bakplåtspappret.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-11-30\",\"runtime\":60},{\"number\":6,\"name\":\"Morgan beskriver sin drömtjej\",\"overview\":\"Från Sundsvall kommer en hel busslast med shoppingsugna. Förskolläraren Angelique och hennes väninnor ser detta som en liten minisemester och har inget emot de 80 milen i buss. De har förberett sig väl inför handlandet men efter en halv dags shoppande händer det som inte får hända, en vagn försvinner inne i varuhuset! Katrin försöker använda kundradion för att ropa ut en efterlysning efter vagnen.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-12-07\",\"runtime\":60},{\"number\":7,\"name\":\"Julen har äntligen kommit till Ullared\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2009-12-14\",\"runtime\":60}],\"firstAirDate\":\"2009-11-02\"}","status":200,"url":""},"revalidate":86400,"tags":[]}