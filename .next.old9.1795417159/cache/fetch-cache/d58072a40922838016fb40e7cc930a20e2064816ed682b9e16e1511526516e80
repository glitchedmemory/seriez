Until\":null},{\"id\":494333,\"title\":\"Ego Death\",\"poster\":null,\"backdrop\":null,\"rating\":0,\"year\":2014,\"type\":\"movie\",\"overview\":\"\",\"genres\":[\"Drama\"],\"daysUntil\":null},{\"id\":1473993,\"title\":\"Romances\",\"poster\":null,\"backdrop\":\"https://image.tmdb.org/t/p/original/cEykcow0MbVNf02k9HylrmjF1PM.jpg\",\"rating\":0,\"year\":2008,\"type\":\"movie\",\"overview\":\"The film, based on the artistic-documentary aesthetics, is about the fate of three sons of the Javanshir dynasty, who are connected to Karabakh and this corner of Azerbaijan - Mahammad bey Ashiq, who lived in the 18th century, Abdussamad bey Ashiq, who lived in the 19th century, and Khosrov bey Javanshir, who lived in the 20th century. These three personalities, influential poets and public figures of their time, were subjected to persecution and repression during the Russian and Soviet empires.\",\"genres\":[\"Documentary\"],\"daysUntil\":null},{\"id\":494338,\"title\":\"Badger Creek\",\"poster\":\"https://image.tmdb.org/t/p/w780/59AGnM6KsGsqsFMubXWQNHjIY5h.jpg\",\"backdrop\":null,\"rating\":0,\"year\":2016,\"type\":\"movie\",\"overview\":\"Badger Creek is a portrait of Native resilience as seen through a year in the life of three generations of a Blackfeet family living on the rez in Montana. The Mombergs are a loving, sober family who run a successful ranch, live a traditional worldview and are re-learning their language.\",\"genres\":[\"Documentary\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"q9ypILdJrwE\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"flBMnHojY9w\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"GTYcCYBjW6A\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}