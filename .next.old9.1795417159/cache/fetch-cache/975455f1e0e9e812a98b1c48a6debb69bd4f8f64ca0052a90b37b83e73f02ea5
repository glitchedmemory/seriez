\":null},{\"id\":515195,\"title\":\"Yesterday\",\"poster\":\"https://image.tmdb.org/t/p/w780/9fYka5CQt9nrb6LOtKicysUf9NA.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/t5Kp02Jzixl0KfpwthHp9ZUex9t.jpg\",\"rating\":6.7,\"year\":2019,\"type\":\"movie\",\"overview\":\"A struggling musician realizes he's the only person on Earth who can remember The Beatles after waking up in an alternate reality where the group was forgotten.\",\"genres\":[\"Comedy\",\"Fantasy\",\"Music\"],\"daysUntil\":null},{\"id\":606117,\"title\":\"A Cinderella Story: Christmas Wish\",\"poster\":\"https://image.tmdb.org/t/p/w780/ozBX0u5caaJFli9AssqJmARb5R.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/9O79JFP9C2DY8eQ653A2gDcrwkx.jpg\",\"rating\":6.4,\"year\":2019,\"type\":\"movie\",\"overview\":\"Kat is an aspiring singer-songwriter who dreams of making it big. However, her dreams are stalled by her reality: a conniving and cruel stepfamily  and a demoralizing job working as a singing elf at billionaire Terrence Wintergarden’s Santa Land.\",\"genres\":[\"Romance\",\"Music\",\"Comedy\"],\"daysUntil\":null},{\"id\":13501,\"title\":\"The Good Night\",\"poster\":\"https://image.tmdb.org/t/p/w780/74TDF1OMKOkTonAUbtbsJOdqtVy.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/92ByOurbPtxJG3jAuJexNWkpWJB.jpg\",\"rating\":5.4,\"year\":2007,\"type\":\"movie\",\"overview\":\"Gary, a musician, is trapped in an unhappy relationship with his live-in lover, Dora. He becomes enthralled with a beautiful seductress who enters his dreams, and tries to control his dream-state so he can spend more and more time with her. When Gary sees his mystery woman's face on a bus billboard, he discovers she is real, and fate brings him an opportunity to meet her.\",\"genres\":[\"Comedy\",\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":189204,\"title\":\"Lovestruck: The Musical\",\"poster\":\"https://image.tmdb.org/t/p/w780/2SYu78HqqrDw0Pph44Ikr1eNJbN.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/cyxhtPxRMrudT3UpioNjdkDZX4G.jpg\",\"rating\":6.5,\"year\":2013,\"type\":\"movie\",\"overview\":\"Harper was one of the best dancers to hit Broadway, but an injury caused her to leave the spotlight, become a choreographer, and raise her daughter Mirabella. When Mirabella decides to quit the show to get married, her mother is determined to put a stop to the wedding and show Mirabella that she cannot give up her career for love.\",\"genres\":[\"Comedy\",\"Fantasy\",\"Romance\"],\"daysUntil\":null},{\"id\":1627957,\"title\":\"Till' jail do us part\",\"poster\":\"https://image.tmdb.org/t/p/w780/kdxT0ykDhb2k7pywGaLf8WBUwAD.jpg\",\"backdrop\":null,\"rating\":5,\"year\":2026,\"type\":\"movie\",\"overview\":\"A couple of criminals challenge both love and the law to achieve the wedding of their dreams. Liza, determined to stay in her country despite financial hardships, convinces her boyfriend Joseph to go through with a heist that Las Vejigantes, the crime syndicate he works for, had explicitly abandoned. What starts as a simple art gallery theft, quickly escalates into an unexpected marriage proposal, a chaotic series of heists, police chases, and a media frenzy.\",\"genres\":[\"Comedy\",\"Romance\",\"Crime\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"2jTtSppDlNA\",\"name\":\"Peau d'âne de Jacques Demy bande annonce\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}