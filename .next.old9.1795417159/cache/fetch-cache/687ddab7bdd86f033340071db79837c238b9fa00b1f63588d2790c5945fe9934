{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":27205,\"title\":\"Inception\",\"tagline\":\"Your mind is the scene of the crime.\",\"overview\":\"Cobb, a skilled thief who commits corporate espionage by infiltrating the subconscious of his targets is offered a chance to regain his old life as payment for a task considered to be impossible: \\\"inception\\\", the implantation of another person's idea into a target's subconscious.\",\"poster\":\"https://image.tmdb.org/t/p/w780/xlaY2zyzMfkhk0HSC5VUwzoZPU1.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg\",\"rating\":8.4,\"voteCount\":40808,\"year\":2010,\"runtime\":148,\"genres\":[\"Action\",\"Science Fiction\",\"Crime\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"},{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":160000000,\"revenue\":839030630,\"director\":\"Christopher Nolan\",\"cast\":[{\"id\":525,\"name\":\"Christopher Nolan\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/xuAIuYSmsUzKlUMBFGVZaWsY3DZ.jpg\"},{\"id\":6193,\"name\":\"Leonardo DiCaprio\",\"character\":\"Dom Cobb\",\"photo\":\"https://image.tmdb.org/t/p/w780/wo2hJpn04vbtmh0B9utCFdsQhxM.jpg\"},{\"id\":24045,\"name\":\"Joseph Gordon-Levitt\",\"character\":\"Arthur\",\"photo\":\"https://image.tmdb.org/t/p/w780/z2FA8js799xqtfiFjBTicFYdfk.jpg\"},{\"id\":3899,\"name\":\"Ken Watanabe\",\"character\":\"Saito\",\"photo\":\"https://image.tmdb.org/t/p/w780/AqK1DSCibb8VuMO6t5qH1LVMIYG.jpg\"},{\"id\":2524,\"name\":\"Tom Hardy\",\"character\":\"Eames\",\"photo\":\"https://image.tmdb.org/t/p/w780/d81K0RH8UX7tZj49tZaQhZ9ewH.jpg\"},{\"id\":27578,\"name\":\"Elliot Page\",\"character\":\"Ariadne\",\"photo\":\"https://image.tmdb.org/t/p/w780/eCeFgzS8dYHnMfWQT0oQitCrsSz.jpg\"},{\"id\":95697,\"name\":\"Dileep Rao\",\"character\":\"Yusuf\",\"photo\":\"https://image.tmdb.org/t/p/w780/jRNn8SZqFXuI5wOOlHwYsWh0hXs.jpg\"},{\"id\":2037,