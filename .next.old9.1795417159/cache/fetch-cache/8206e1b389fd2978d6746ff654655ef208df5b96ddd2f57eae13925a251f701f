{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":62650,\"title\":\"Chicago Med\",\"tagline\":\"Welcome home.\",\"overview\":\"An emotional thrill ride through the day-to-day chaos of the city's most explosive hospital and the courageous team of doctors who hold it together. They will tackle unique new cases inspired by topical events, forging fiery relationships in the pulse-pounding pandemonium of the emergency room.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/s55mHZ5q68IUtRsQdy2oC3nPpG7.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/fFgVoJuSBewZWlzgaoUWGm8MvD4.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8.3,\"voteCount\":1294,\"year\":2015,\"genres\":[\"Drama\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":12,\"totalEpisodes\":229,\"createdBy\":[\"Dick Wolf\",\"Matt Olmstead\"],\"networks\":[\"NBC\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2026-11-18\",\"cast\":[{\"id\":1232644,\"name\":\"Anna Dokoza\",\"character\":\"Director\",\"photo\":null},{\"id\":212137,\"name\":\"Michael Waxman\",\"character\":\"Director\",\"photo\":null},{\"id\":59649,\"name\":\"Michael Pressman\",\"character\":\"Director\",\"photo\":null},{\"id\":1940580,\"name\":\"Nicole Cummins-Rubio\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/nVOmvc30Nkhhl28jrUve5aUxqZP.jpg\"},{\"id\":1440554,\"name\":\"Charles S. Carroll\",\"character\":\"Director\",\"photo\":null},{\"id\":1433748,\"name\":\"Tess Malone\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/an4H25jTFq8uUmL8yChnVDjQIgG.jpg\"},{\"id\":121767,\"name\":\"Bethany Rooney\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/q59fiboczOPgklDZL9Hhec7tX3b.jpg\"},{\"id\":2126996,\"name\":\"Anthony Nardolillo\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/46Qaz5UgMhc70lWkKFFoypzK9Ad.jpg\"},{\"id\":1218214,\"name\":\"Milena Govich\",\"characte