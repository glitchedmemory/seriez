ame\":\"Oliver Platt\",\"character\":\"Dr. Daniel Charles\",\"photo\":\"https://image.tmdb.org/t/p/w780/ipBzOzgWRdxxYoM5xNN1cfenFaC.jpg\"}],\"trailers\":[{\"key\":\"U2NZ7G02e40\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"BubdHpP4mAI\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"tMI3G3gG_cg\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":95170,\"title\":\"Betty\",\"poster\":\"https://image.tmdb.org/t/p/w780/ui9Ii7dKaEZBl0N0bSGBY9wH26k.jpg\",\"rating\":6.7,\"year\":2020,\"type\":\"tv\",\"_score\":0.4288461538461539,\"_genreOverlap\":1},{\"id\":60804,\"title\":\"The Night Shift\",\"poster\":\"https://image.tmdb.org/t/p/w780/qSfjudewdGEHAva8LvlbyH0ydof.jpg\",\"rating\":7.5,\"year\":2014,\"type\":\"tv\",\"_score\":0.4288461538461539,\"_genreOverlap\":1},{\"id\":61014,\"title\":\"The Knick\",\"poster\":\"https://image.tmdb.org/t/p/w780/oeEqDSIVOi6q0GcZj8L9Q6G7fGC.jpg\",\"rating\":7.9,\"year\":2014,\"type\":\"tv\",\"_score\":0.42542372881355933,\"_genreOverlap\":1},{\"id\":95066,\"title\":\"Chocolate\",\"poster\":\"https://image.tmdb.org/t/p/w780/ugLwOOv9k6NG0XL2IX06RiqW9yt.jpg\",\"rating\":7.9,\"year\":2019,\"type\":\"tv\",\"_score\":0.4244897959183674,\"_genreOverlap\":1},{\"id\":60557,\"title\":\"Witches of East End\",\"poster\":\"https://image.tmdb.org/t/p/w780/jBWSp8hw8CNUFWxTCawXzAhu2Hj.jpg\",\"rating\":7.3,\"year\":2013,\"type\":\"tv\",\"_score\":0.42307692307692313,\"_genreOverlap\":1},{\"id\":128163,\"title\":\"TOKYO MER: Mobile Emergency Room\",\"poster\":\"https://image.tmdb.org/t/p/w780/4vqdA0krl05ieamrVbdjp0CJNkj.jpg\",\"rating\":7.9,\"year\":2021,\"type\":\"tv\",\"_score\":0.4222222222222222,\"_genreOverlap\":1},{\"id\":60726,\"title\":\"Forever\",\"poster\":\"https://image.tmdb.org/t/p/w780/4OnnU4j2tQEOnsPnRZswW91v9vr.jpg\",\"rating\":7.8,\"year\":2014,\"type\":\"tv\",\"_score\":0.4197802197802198,\"_genreOverlap\":1},{\"id\":312929,\"title\":\"Scent of the Wind\",\"poster\":\"https://image.tmdb.org/t/p/w780/iuGUigEvvjWT2pKvfAVALKJpSPK.jpg\",\"rating\":0,\"year\":2026,\"type\":\"tv\",\"_score\":0.41904761904761906,\"_genreOverlap\":1},{\"id\":547,\"title\":\"Medical Investigation\",\"poster\":\"https://image.tmdb.org/t/p/w780/3bTy80VccV3suS9ywXryGakdG5y.jpg\",\"rating\":6.6,\"year\":2004,\"type\":\"tv\",\"_score\":0.4176470588235294,\"_genreOverlap\":1},{\"id\":94903,\"title\":\"The Surgeons\",\"poster\":null,\"rating\":0,\"year\":2003,\"type\":\"tv\",\"_score\":0.41500000000000004,\"_genreOverlap\":1},{\"id\":128113,\"title\":\"The Winchesters\",\"poster\":\"https://image.tmdb.org/t/p/w780/oyleYabGfn6c50bIo4M3c7ogrfL.jpg\",\"rating\":7.5,\"year\":2022,\"type\":\"tv\",\"_score\":0.4140625,\"_genreOverlap\":1},{\"id\":60956,\"title\":\"Doctor Stranger\",\"poster\":\"https://image.tmdb.org/t/p/w780/odH9cebqUNHKh1p6BKVSs0gsD34.jpg\",\"rating\":8,\"year\":2014,\"type\":\"tv\",\"_score\":0.41139240506329117,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"Inside the high-stakes emergency department of Chicago’s top hospital, a team of doctors and nurses faces intense medical cases while navigating complex emotions and ethical dilemmas. The adrenaline never stops — and neither does the pressure.\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/49LPQsmjxfqIC2Yva5JNylHIMgy.jpg\",\"seasonAirDate\":\"2015-11-17\",\"episodes\":[{\"number\":1,\"name\":\"Derailed\",\"overview\":\"The grand opening of Chicago Med's emergency department is interrupted by victims of an elevated train crash, pushing the staff to their limits.\",\"still\":\"https://image.tmdb.org/t/p/w780/zgO40DcRVc3sh9vg9CpRoaICn0a.jpg\",\"rating\":7,\"voteCount\":23,\"airDate\":\"2015-11-17\",\"runtime\":44},{\"number\":2,\"name\":\"iNO\",\"overview\":\"Dr. Choi treats a teen mother who abandoned her newborn baby in an alley, as the staffers must make difficult decisions about the teen's future. Also, a hypochondriac with chest pains is treated, as is a patient suffering from possible dementia.\",\"still\":\"https://image.tmdb.org/t/p/w780/sTsALfOcSgzuev7DBDYxfqgHIys.jpg\",\"rating\":7.1,\"voteCount\":17,\"airDate\":\"2015-11-24\",\"runtime\":42},{\"number\":3,\"name\":\"Fallback\",\"overview\":\"Dr. Rhodes must confront his past when he treats a close family friend who's been impaled by glass in a case that reunites him with his sister. Meanwhile, a musician must decide to undergo surgery that will save her life but could destroy her hearing.\",\"still\":\"https://image.tmdb.org/t/p/w780/fepPfWcmxxhUG6YAocvF46z5F4Z.jpg\",\"rating\":7.5,\"voteCount\":16,\"airDate\":\"2015-12-01\",\"runtime\":42},{\"number\":4,\"name\":\"Mistaken\",\"overview\":\"The doctors treat victims of a movie-theater shooting as Sharon Goodwin tries to keep the press at bay. A teen with an eating disorder is treated, but Dr. Charles' methods rub others the wrong way. The staffers deal with a racist patient.\",\"still\":\"https://image.tmdb.org/t/p/w780/m0f2e3PUDSzxWsurEvgJ4zgEOD1.jpg\",\"rating\":6.8,\"voteCount\":13,\"airDate\":\"2015-12-08\",\"runtime\":42},{\"number\":5,\"name\":\"Malignant (II)\",\"overview\":\"A member of Firehouse 51 clings to life and takes a sudden turn for the worse as medical staffers race to give treatment. Meanwhile, Dr. Natalie Manning prepares for her pregnancy and members of Chicago P.D. probe the case of a woman pulled from a fire.\\n\\nThe crossover starts on Chicago Fire S04E10 The Beating Heart (I). It continues on Chicago P.D. S03E10 Now I'm God (III).\",\"still\":\"https://image.tmdb.org/t/p/w780/tXPSludLRIDMdjnyeYYccUuapZH.jpg\",\"rating\":7.2,\"voteCount\":14,\"airDate\":\"2016-01-05\",\"runtime\":43},{\"number\":6,\"name\":\"Bound\",\"overview\":\"Dark family secrets emerge when Dr. Rhodes' father is honored for making a large donation to the hospital. Meanwhile, the Department of Homeland Security arrives when two injured airplane stowaways are brought to the hospital and Dr. Sarah Reese must deliver heartbreaking news to a boy.\",\"still\":\"https://image.tmdb.org/t/p/w780/edmspadQG2JuXfFhybJYHvmRmPp.jpg\",\"rating\":7.3,\"voteCount\":14,\"airDate\":\"2016-01-19\",\"runtime\":44},{\"number\":7,\"name\":\"Saints\",\"overview\":\"Sharon Goodwin puts her job on the line for a patient in need of a lifesaving bone-marrow transplant. Meanwhile, April cares for a homeless man, Dr. Manning's parents arrive, and a couple are injured during their first date by a hit-and-run driver.\",\"still\":\"https://image.tmdb.org/t/p/w780/2U9BpVEHmc0eflW1AbzP7WzoeJ2.jpg\",\"rating\":7.4,\"voteCount\":13,\"airDate\":\"2016-01-26\",\"runtime\":44},{\"number\":8,\"name\":\"Reunion\",\"overview\":\"Dr. Manning returns from maternity leave and treats a teen with a history of medical issues. Meanwhile, Dr. Choi cares for a former Navy shipmate; a Saudi prince arrives for a surgical procedure, but only from a hotshot surgeon; and a romance blooms between Sarah and a lab tech.\",\"still\":\"https://image.tmdb.org/t/p/w780/vTIVLRhdPasn9ScpF9VsGIbT8WV.jpg\",\"rating\":7,\"voteCount\":14,\"airDate\":\"2016-02-02\",\"runtime\":44},{\"number\":9,\"name\":\"Choices\",\"overview\":\"Dr. Halstead jeopardizes his career when he goes against a family's order regarding a terminally ill cancer patient. Meanwhile, April and Dr. Reese treat a homeless man, and Choi's personal issues emerge while caring for a bipolar patient.\",\"still\":\"https://image.tmdb.org/t/p/w780/8d7prpxtd8GfbbwJ75SNef9yERa.jpg\",\"rating\":7.2,\"voteCount\":14,\"airDate\":\"2016-02-09\",\"runtime\":43},{\"number\":10,\"name\":\"Clarity\",\"overview\":\"A 9/11 hero is treated, but an unforeseen medical problem arises. Meanwhile, Sarah contemplates which hospital to select for her residency; Dr. Choi cares for an injured teen hockey player with a demanding father; and Halstead and Manning clash.\",\"still\":\"https://image.tmdb.org/t/p/w780/mCUfJNIh4zfFZheVR1NAdflxjtL.jpg\",\"rating\":7.2,\"voteCount\":15,\"airDate\":\"2016-02-16\",\"runtime\":44},{\"number\":11,\"name\":\"Intervention\",\"overview\":\"Dr. Rhodes and Dr. Choi clash over the final decision made by a dying patient. Meanwhile, a pending lawsuit against Dr. Halstead moves forward, and doctors race to save a patient with a misdiagnosed flesh-eating bacterial disease.\",\"still\":\"https://image.tmdb.org/t/p/w780/zY3fqztdhXg5wOR9jSGQgoiVAvw.jpg\",\"rating\":7.1,\"voteCount\":13,\"airDate\":\"2016-02-23\",\"runtime\":43},{\"number\":12,\"name\":\"Guilty\",\"overview\":\"Nurse Lockwood gets arrested when she takes a stand. Meanwhile, Dr. Halstead deals with a pending lawsuit against him; a baby's injuries come into question; Dr. Charles faces personal issues; and suspicions rise about a patient who was hit by a car.\",\"still\":\"https://image.tmdb.org/t/p/w780/gi0e3nVID3AHMflcgTnZDw4nYDi.jpg\",\"rating\":7.2,\"voteCount\":12,\"airDate\":\"2016-03-29\",\"runtime\":44},{\"number\":13,\"name\":\"Us\",\"overview\":\"A husband makes a request following his wife's death; Dr. Charles tries to reason with a patient who wants to remove his own arm from his body; a child arrives at the hospital after swallowing magnets; Sarah has last-minute thoughts about her residency.\",\"still\":\"https://image.tmdb.org/t/p/w780/yP2owYh6HhlXPElgLOO9nFnjmoJ.jpg\",\"rating\":6.8,\"voteCount\":13,\"airDate\":\"2016-04-05\",\"runtime\":44},{\"number\":14,\"name\":\"Hearts\",\"overview\":\"An erratic patient arrives, claiming that his heart is pounding inside his head as he takes drastic measures to stop it. Also, Dr. Manning helps a boy with a broken wrist, but she suspects deeper issues exist; Dr. Rhodes impresses with his skills; and Will receives news about a lawsuit.\",\"still\":\"https://image.tmdb.org/t/p/w780/kkXtDKwRWDOI5rIPsT8KcamZoRs.jpg\",\"rating\":7.2,\"voteCount\":13,\"airDate\":\"2016-04-19\",\"runtime\":43},{\"number\":15,\"name\":\"Inheritance\",\"overview\":\"A teen patient with abdominal pain firmly refuses any drugs. Meanwhile, Dr. Halstead reconnects with his past when treating a patient; a pregnant woman does everything in her power not to deliver the child; and Dr. Rhodes tries to avoid family issues.\",\"still\":\"https://image.tmdb.org/t/p/w780/lHT3RrzvZHch5oyQZKAjHcDKdC2.jpg\",\"rating\":7.1,\"voteCount\":12,\"airDate\":\"2016-04-26\",\"runtime\":43},{\"number\":16,\"name\":\"Disorder\",\"overview\":\"Dr. Rhodes and Dr. Downey clash over how to treat a patient with various health and heart issues. Meanwhile, excessive hoarding at a home comes into play when trying to help a man with a leg injury; a patient is bitten by her own dog; and a commission pays a surprise visit to evaluate the hospital.\",\"still\":\"https://image.tmdb.org/t/p/w780/k003JZvSIk9r0iyYozSXmbWlA1d.jpg\",\"rating\":7.1,\"voteCount\":13,\"airDate\":\"2016-05-03\",\"runtime\":43},{\"number\":17,\"name\":\"Withdrawal\",\"overview\":\"April and Dr. Halstead clash over how to treat an alcoholic homeless man with a broken leg. Also, Dr. Manning continues to grieve over her husband's death; two elderly women with the same symptoms share a surprise link; Halstead mulls over a job offer in California.\",\"still\":\"https://image.tmdb.org/t/p/w780/ew3dDVsOPhuYdBXuHLmLCP3o64f.jpg\",\"rating\":6.9,\"voteCount\":13,\"airDate\":\"2016-05-10\",\"runtime\":44},{\"number\":18,\"name\":\"Timing\",\"overview\":\"Dr. Rhodes treats his mentor and Goodman faces personal issues in the Season 1 finale. Also: April deals with a disorderly patient; Dr. Manning's past catches up with her; and Sarah's graduation day arrives, but she remains conflicted about her future.\",\"still\":\"https://image.tmdb.org/t/p/w780/zRLUINlG4xSJVXD4SkNaQ0JuaZ0.jpg\",\"rating\":7.4,\"voteCount\":11,\"airDate\":\"2016-05-17\",\"runtime\":45}],\"firstAirDate\":\"2015-11-17\"}","status":200,"url":""},"revalidate":86400,"tags":[]}