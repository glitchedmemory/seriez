{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":5920,\"title\":\"The Mentalist\",\"tagline\":\"Let the mind games begin.\",\"overview\":\"Patrick Jane, a former celebrity psychic medium, uses his razor sharp skills of observation and expertise at \\\"reading\\\" people to solve serious crimes with the California Bureau of Investigation.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/k0kMdO52LpC5JWgd0uWEH7gqcCe.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/rJFqKcmMSttdNP58l0dVzY2NcTA.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8.4,\"voteCount\":5040,\"year\":2008,\"genres\":[\"Crime\",\"Drama\",\"Mystery\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":7,\"totalEpisodes\":151,\"createdBy\":[\"Bruno Heller\"],\"networks\":[\"CBS\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2015-02-18\",\"cast\":[{\"id\":1214432,\"name\":\"Chris Long\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/kphn24MER5N0g7vnD69csE3onU4.jpg\"},{\"id\":47020,\"name\":\"Eric Laneuville\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/hrVy4Ws5sL7rOI7TbTlKrUVosMF.jpg\"},{\"id\":1288953,\"name\":\"John F. Showalter\",\"character\":\"Director\",\"photo\":null},{\"id\":146887,\"name\":\"Charles Beeson\",\"character\":\"Director\",\"photo\":null},{\"id\":1214368,\"name\":\"Randall Zisk\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/70VovaU7buN3vGFqdqzloCdUkBs.jpg\"},{\"id\":9556,\"name\":\"David Barrett\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/aGLJHvn8BPFzbRq0zAIHGvqlmje.jpg\"},{\"id\":933949,\"name\":\"Geary McLeod\",\"character\":\"Director\",\"photo\":null},{\"id\":43468,\"name\":\"Guy Ferland\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/oOBx7tqSGZ5BatZydBYRXfoKsRj.jpg\"},{\"id\":15337,\"name\":\"John Polson\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org