{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":129,\"title\":\"Spirited Away\",\"tagline\":\"Prepare to be spirited away.\",\"overview\":\"A young girl, Chihiro, becomes trapped in a strange new world of spirits. When her parents undergo a mysterious transformation, she must call upon the courage she never knew she had to free her family.\",\"poster\":\"https://image.tmdb.org/t/p/w780/39wmItIWsg5sZMyRUHLkWBcuVCM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/m4TUa2ciEWSlk37rOsjiSIvZDXE.jpg\",\"rating\":8.5,\"voteCount\":19272,\"year\":2001,\"runtime\":125,\"genres\":[\"Animation\",\"Family\",\"Fantasy\",\"Adventure\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"JP\",\"name\":\"Japan\"}],\"budget\":19000000,\"revenue\":274925095,\"director\":\"Hayao Miyazaki\",\"cast\":[{\"id\":608,\"name\":\"Hayao Miyazaki\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/ouhjt9KugzhWtdEyBPipihB3ic8.jpg\"},{\"id\":19587,\"name\":\"Rumi Hiiragi\",\"character\":\"Chihiro (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/nTKM4GgfkrZvAOFL55uhEuckt7M.jpg\"},{\"id\":19588,\"name\":\"Miyu Irino\",\"character\":\"Haku (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/8qEEhHUObNvGQr4e6eqLu5z4qTz.jpg\"},{\"id\":19589,\"name\":\"Mari Natsuki\",\"character\":\"Yubaba / Zeniba (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/MIFzUc77Sx57FQOZsoiGWEbpH2.jpg\"},{\"id\":19590,\"name\":\"Takashi Naito\",\"character\":\"Father (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/xwsm0ygjG79jLIogutwo6r64igy.jpg\"},{\"id\":19591,\"name\":\"Yasuko Sawaguchi\",\"character\":\"Mother (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/rWspusb13VeJowmctnniXYYTcqq.jpg\"},{\"id\":19592,\"name\":\"Tatsuya Gashuin\",\"character\":\"Aogaeru (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/fLqIdkShknsJmZy4EfBWuWyHN4C.jpg\"},{\"id\":225730,\"name\":\"Ryunosuke Kamiki\",\"character\":\"Boh (voice)\",\"photo\":\"https://image.tmdb.