r\":\"https://image.tmdb.org/t/p/w780/78lPtwv72eTNqFW9COBYI0dWDJa.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/cKvDv2LpwVEqbdXWoQl4XgGN6le.jpg\",\"rating\":7.7,\"year\":2008,\"type\":\"movie\",\"overview\":\"After being held captive in an Afghan cave, billionaire engineer Tony Stark creates a unique weaponized suit of armor to fight evil.\",\"genres\":[\"Action\",\"Sci-Fi\",\"Adventure\"],\"daysUntil\":null},{\"id\":1300968,\"title\":\"The Hunger Games: Sunrise on the Reaping\",\"poster\":\"https://image.tmdb.org/t/p/w780/nzIXSQNgYZwFOMrmv0d0I3ulvkM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/aqFZcr2dxSZ2UwWSo1WC6C0rwDf.jpg\",\"rating\":7.8,\"year\":2026,\"type\":\"movie\",\"overview\":\"Return to the world of Panem 24 years before Katniss Everdeen volunteers in her sister's place, commencing on the morning of the reaping of the 50th Hunger Games, also known as the Second Quarter Quell.\",\"genres\":[\"Sci-Fi\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":969681,\"title\":\"Spider-Man: Brand New Day\",\"poster\":\"https://image.tmdb.org/t/p/w780/bjiS5ipwxb9JFy3XRRN4OAilSeX.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/subj7knTn4DeS6KS7qI66EQKe9i.jpg\",\"rating\":8.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Fighting crime full-time as Spider-Man in a world that doesn't remember him—and the pressure of seeing his old friends move on without him—sparks a change in Peter Parker he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\",\"genres\":[\"Sci-Fi\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":1041360,\"title\":\"Olimpo, Andalucía\",\"poster\":\"https://image.tmdb.org/t/p/w780/di6Ta8oSDvEbAieHE9RmQjmZGJi.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/9HangqB5RzcTnclUDmAHKUSarm2.jpg\",\"rating\":8,\"year\":2023,\"type\":\"movie\",\"overview\":\"In a 'neo-quinqui' Andalusia plagued by superheroes and villains, the paths of a couple with superhuman strength and a criminal organization with highly developed technology collide spectacularly.\",\"genres\":[\"Action\",\"Sci-Fi\",\"Comedy\"],\"daysUntil\":null},{\"id\":1271,\"title\":\"300\",\"poster\":\"https://image.tmdb.org/t/p/w780/h7Lcio0c9ohxPhSZg42eTlKIVVY.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/lgBZlJ1LHQel5nneNQMoesmvc7l.jpg\",\"rating\":7.2,\"year\":2007,\"type\":\"movie\",\"overview\":\"A story very loosely based the 480 B.C. Battle of Thermopylae, where the King of Sparta led his army against the advancing Persians.\",\"genres\":[\"Action\",\"Adventure\",\"War\"],\"daysUntil\":null},{\"id\":956,\"title\":\"Mission: Impossible III\",\"poster\":\"https://image.tmdb.org/t/p/w780/vKGYCpmQyV9uHybWDzXuII8Los5.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/bYKeB9uUcPmvikjouEEQ86uvPw9.jpg\",\"rating\":6.8,\"year\":2006,\"type\":\"movie\",\"overview\":\"Retired from active duty, and training recruits for the Impossible Mission Force, agent Ethan Hunt faces the toughest foe of his career: Owen Davian, an international broker of arms and information, who's as cunning as he is ruthless. Davian emerges to threaten Hunt and all that he holds dear – including the woman Hunt loves.\",\"genres\":[\"Adventure\",\"Action\",\"Thriller\"],\"daysUntil\":null},{\"id\":268673,\"title\":\"Kamen Rider Agito: Project G4\",\"poster\":\"https://image.tmdb.org/t/p/w780/8Ib5YCu3opbGlO8YuQ30tVRYnuc.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/oJJ2Ba4n1bLl51gOb2YzPXb0m1h.jpg\",\"rating\":6.6,\"year\":2001,\"type\":\"movie\",\"overview\":\"Shouichi encounters a teenage girl called Sayaka, who ran away from a military facility because of an attack by the Ant Lords. Sayaka has a supernatural ability to foresee the future. Risa Fukami, of the military group GA, wants to use that power to enhance the newly-made G4 System, which was based upon designs stolen from Ozawa.  Now, Agito and Gills must fight to stop the Ant Lords' attack, as G3 and G4 settle their score.\",\"genres\":[\"Action\",\"Adventure\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":2080,\"title\":\"X-Men Origins: Wolverine\",\"poster\":\"https://image.tmdb.org/t/p/w780/yj8LbTju1p7CUJg7US2unSBk33s.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/p4GzAzjlL7lXIVGvayg7zvzGTSi.jpg\",\"rating\":6.3,\"year\":2009,\"type\":\"movie\",\"overview\":\"After seeking to live a normal life after 200 years, Logan sets out to avenge a death by undergoing the mutant Weapon X program and becoming Wolverine.\",\"genres\":[\"Adventure\",\"Action\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":456740,\"title\":\"Hellboy\",\"poster\":\"https://image.tmdb.org/t/p/w780/bk8LyaMqUtaQ9hUShuvFznQYQKR.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/djiDKVB07xTy7tDFbWb9k7KLI3E.jpg\",\"rating\":5.6,\"year\":2019,\"type\":\"movie\",\"overview\":\"Hellboy comes to England, where he must defeat Nimue, Merlin's consort and the Blood Queen. But their battle will bring about the end of the world, a fate he desperately tries to turn away.\",\"genres\":[\"Fantasy\",\"Horror\",\"Action\"],\"daysUntil\":null},{\"id\":1041557,\"title\":\"Ultraman Connection Presents: Tamashii Nations Special Streaming featuring Ultraman Trigger\",\"poster\":\"https://image.tmdb.org/t/p/w780/3s0aPnfgHmeYm6qpM7M2S47LEDL.jpg\",\"backdrop\":null,\"rating\":0,\"year\":2022,\"type\":\"movie\",\"overview\":\"Ultraman Connection Presents: Tamashii Nations Special Streaming featuring Ultraman Trigger is a special filmed stage show based on various Ultraman characters and released on YouTube as a part of the eponymous stream.\",\"genres\":[\"Action\",\"Adventure\",\"Drama\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"X1aFkAkFASk\",\"name\":\"Special Look\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"irVNGjRFZGk\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"Kl7nG1nD0