w780/soIgqZBoTiTgMqUW0JtxsPWAilQ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/nrp2khEM6JWFqqNLeub1J6Qafe0.jpg\",\"rating\":6.7,\"year\":2023,\"type\":\"movie\",\"overview\":\"Following the brutal murder of a young real estate agent, a hardened detective attempts to uncover the truth in a case where nothing is as it seems, and by doing so dismantles the illusions in his own life.\",\"genres\":[\"Crime\",\"Mystery\",\"Thriller\"],\"daysUntil\":null},{\"id\":30018,\"title\":\"Mother\",\"poster\":\"https://image.tmdb.org/t/p/w780/8oBnSkZE6GDVugAbLPO6uJd4GcS.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/mjtocjdhqJNnppHIgBesT3BBIOi.jpg\",\"rating\":7.7,\"year\":2009,\"type\":\"movie\",\"overview\":\"A mother lives quietly with her son. One day, a girl is brutally killed, and the boy is charged with the murder. Now, it's his mother's mission to prove him innocent.\",\"genres\":[\"Crime\",\"Drama\",\"Mystery\"],\"daysUntil\":null},{\"id\":799876,\"title\":\"The Outfit\",\"poster\":\"https://image.tmdb.org/t/p/w780/lZa5EB6PVJBT5mxhgZS5ftqdAm6.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/jjXnYpRQMqzylAmYqKL7VFa3l9w.jpg\",\"rating\":7.1,\"year\":2022,\"type\":\"movie\",\"overview\":\"Leonard is an English tailor who used to craft suits on London’s world-famous Savile Row. After a personal tragedy, he’s ended up in Chicago, operating a small tailor shop in a rough part of town where he makes beautiful clothes for the only people around who can afford them: a family of vicious gangsters.\",\"genres\":[\"Crime\",\"Drama\",\"Thriller\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"6ybQHR8mJ2g\",\"name\":\"Trailer [Subtitled]\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}