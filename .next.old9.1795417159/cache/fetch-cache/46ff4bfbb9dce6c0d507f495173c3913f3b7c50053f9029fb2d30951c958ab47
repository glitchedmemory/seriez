{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":15161,\"title\":\"Click\",\"tagline\":\"\",\"overview\":\"Your user-friendly guide to the latest technology news, issues, gadgets and apps.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/osUNbnb0iVTRpyhNnO153ddfXBh.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/1fTT1y42YVCaYb8lcRxCMPTGvrx.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.1,\"voteCount\":10,\"year\":2000,\"genres\":[\"News\",\"Documentary\"],\"status\":\"Canceled\",\"type\":\"tv\",\"totalSeasons\":26,\"totalEpisodes\":1005,\"createdBy\":[\"Stephen Cole\"],\"networks\":[\"BBC World News\",\"BBC News\"],\"countries\":[{\"code\":\"GB\",\"name\":\"GB\"}],\"lastAirDate\":\"2025-03-22\",\"cast\":[{\"id\":2344657,\"name\":\"Spencer Kelly\",\"character\":\"Self - Presenter\",\"photo\":\"https://image.tmdb.org/t/p/w780/sKZiay6vTpRxQqRco68BOF2vDPO.jpg\"}],\"trailers\":[{\"key\":\"Z6EtjtU-oxA\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"BN9vUVaJvHw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"SwWWUq9A22E\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":95696,\"title\":\"The Age of A.I.\",\"poster\":\"https://image.tmdb.org/t/p/w780/ccOtYMsGr7xUGgDFS7Tsx32fItv.jpg\",\"rating\":8.1,\"year\":2019,\"type\":\"tv\",\"_score\":0.225,\"_genreOverlap\":1},{\"id\":62040,\"title\":\"Battle Stations\",\"poster\":\"https://image.tmdb.org/t/p/w780/iggY9wJDvEh18Wyjga79BhREEVC.jpg\",\"rating\":2,\"year\":2000,\"type\":\"tv\",\"_score\":0.2236842105263158,\"_genreOverlap\":1},{\"id\":132300,\"title\":\"Murder on the Internet\",\"poster\":\"https://image.tmdb.org/t/p/w780/8tUXz8gN8Hl52N0s1DaGZbB3A2y.jpg\",\"rating\":0,\"year\":2017,\"type\":\"tv\",\"_score\":0.21935483870967742,\"_genreOverlap\":1},{\"id\":95863,\"title\":\"Retro Tech\",\"poster\":\"https://image.tmdb.org/t/p/w780/KqUND422kGEVWCGgYYvW8NrJAm.jpg\",\"rating\":9,\"year\":2019,\"type\":\"tv\",\"_score\":0.21875,\"_genreOverlap\":1},{\"id\":60891,\"title\":\"Nature Tech\",\"poster\":\"https://image.tmdb.org/t/p/w780/eGM2ntlpzK63SAX4DUEqe60tuyE.jpg\",\"rating\":10,\"year\":2006,\"type\":\"tv\",\"_score\":0.2173076923076923,\"_genreOverlap\":1},{\"id\":215920,\"title\":\"Oddity Archive\",\"poster\":\"https://image.tmdb.org/t/p/w780/xR3vmpzfzyhiEwaTO2BwUfeHY4a.jpg\",\"rating\":8,\"year\":2012,\"type\":\"tv\",\"_score\":0.2173076923076923,\"_genreOverlap\":1},{\"id\":64220,\"title\":\"Breakthrough\",\"poster\":\"https://image.tmdb.org/t/p/w780/n8QaodjwN1lbHnU0HnksJS64xiF.jpg\",\"rating\":6,\"year\":2015,\"type\":\"tv\",\"_score\":0.21714285714285714,\"_genreOverlap\":1},{\"id\":212062,\"title\":\"Dirty Rotten Scammers\",\"poster\":\"https://image.tmdb.org/t/p/w780/csk5hLmGsTHuvmyujeRV6TXHRwI.jpg\",\"rating\":0,\"year\":2022,\"type\":\"tv\",\"_score\":0.2153846153846154,\"_genreOverlap\":1},{\"id\":312811,\"title\":\"Carrier Strike Group 8\",\"poster\":\"https://image.tmdb.org/t/p/w780/oxWovviScMBHVcATviJF4Z0B86n.jpg\",\"rating\":0,\"year\":2018,\"type\":\"tv\",\"_score\":0.21250000000000002,\"_genreOverlap\":1},{\"id\":64607,\"title\":\"Dark Net\",\"poster\":\"https://image.tmdb.org/t/p/w780/tWeJD3WEf1NkmBviPlzUOHmtKMd.jpg\",\"rating\":5.8,\"year\":2016,\"type\":\"tv\",\"_score\":0.2109090909090909,\"_genreOverlap\":1},{\"id\":1044,\"title\":\"Planet Earth\",\"poster\":\"https://image.tmdb.org/t/p/w780/bNcNxUtZ520d5de5s78onoiSiwQ.jpg\",\"rating\":8.6,\"year\":2006,\"type\":\"tv\",\"_score\":0.21000000000000002,\"_genreOverlap\":1},{\"id\":313406,\"title\":\"Chernobyl: Inside the Meltdown\",\"poster\":\"https://image.tmdb.org/t/p/w780/h6pIX1Q7TgqoKt4Gg4APDJtc8D1.jpg\",\"rating\":8.6,\"year\":2026,\"type\":\"tv\",\"_score\":0.21000000000000002,\"_genreOverlap\":1}],\"seasonNumber\":20,\"seasonName\":\"2019\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/osUNbnb0iVTRpyhNnO153ddfXBh.jpg\",\"seasonAirDate\":\"2019-01-05\",\"episodes\":[{\"number\":1,\"name\":\"Best of 2018\",\"overview\":\"Compilation show looking at the best of Click's travels on the road in 2018.\",\"still\":\"https://image.tmdb.org/t/p/w780/gL2pMx2Z0uc7pmJxAc9QxFVIQ8w.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-01-05\",\"runtime\":30},{\"number\":2,\"name\":\"The Greatest Show\",\"overview\":\"20 gadgets in 19 minutes! That's the challenge the team set themselves to cover at CES - the world's largest technology show. Watch to see how they got on!\",\"still\":\"https://image.tmdb.org/t/p/w780/8eN28bJ3s3j5Aw1U3ZOKylQVHQX.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-01-12\",\"runtime\":30},{\"number\":3,\"name\":\"The Big Talk\",\"overview\":\"Your user-friendly guide to the latest technology news, issues, gadgets and apps. The future of voice assistants - can your digital assistant tell if you are ill?\",\"still\":\"https://image.tmdb.org/t/p/w780/mdsMMS2wNxUXk4OEjZRM2U09Bux.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-01-19\",\"runtime\":30},{\"number\":4,\"name\":\"Robo Retail\",\"overview\":\"Click gets a look at Amazon's robotic future. From checkout-free grocery stores to vests that protect warehouse workers from autonomous robots.\",\"still\":\"https://image.tmdb.org/t/p/w780/3IKer4JnY6fOgJgR0aZgFQYavrb.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-01-26\",\"runtime\":30},{\"number\":5,\"name\":\"Tech Takin on Trumps Wall\",\"overview\":\"A look at how tech could be the answer to Trump's border wall, plus the team get rare access to Microsoft's Washington HQ.\",\"still\":\"https://image.tmdb.org/t/p/w780/lpqhoUZVszncN5HHIS4pcMIpkes.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-02-02\",\"runtime\":30},{\"number\":6,\"name\":\"Whatever the Weather\",\"overview\":\"Click goes to the world's largest weather centre in Japan. Lara gives her best Spice Girls act. And we look at how virtual reality is helping injured children.\",\"still\":\"https://image.tmdb.org/t/p/w780/lVISWcYXKheOWRIlVWPeRz6Snil.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-02-09\",\"runtime\":30},{\"number\":7,\"name\":\"Storing Data in DNA\",\"overview\":\"A comprehensive guide to all the latest gadgets, websites, games and computer industry news. A look at how the future of data storage might be within us all - our DNA.\",\"still\":\"https://image.tmdb.org/t/p/w780/uw7WrOCAothe47kGLfy9dDJpy8z.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-02-16\",\"runtime\":30},{\"number\":8,\"name\":\"One Small Step\",\"overview\":\"Click looks at foldable mobile phones and the exosuit helping disabled people to walk. Plus the social media content creators getting together at Vidcon.\",\"still\":\"https://image.tmdb.org/t/p/w780/lIUJ5EXiXGDMbI7vW10WB9F6nzc.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-02-23\",\"runtime\":30},{\"number\":9,\"name\":\"Everything Mobile\",\"overview\":\"Click visits the world's biggest smartphone show, Mobile World Congress, in Barcelona to see all the latest launches and developments in mobile tech.\",\"still\":\"https://image.tmdb.org/t/p/w780/25piB7kqlN1DiD0d9Dsk3bNx6qz.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-03-02\",\"runtime\":30},{\"number\":10,\"name\":\"Gone in 6 seconds\",\"overview\":\"Click reveals how some popular third-party alarms have made cars easier to steal. Plus how tech can help with rugby injuries and a preview of action game Days Gone.\",\"still\":\"https://image.tmdb.org/t/p/w780/g0o29mm9B0frh3fEngsMcdJ2h7V.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-03-09\",\"runtime\":30},{\"number\":11,\"name\":\"Japan Special: Flames and Fire\",\"overview\":\"Click travels to Japan to see how they're preparing technologically for next year's Olympics with new AI-powered facial recognition technology being deployed across the event.\",\"still\":\"https://image.tmdb.org/t/p/w780/8oPh5s21GScreQeqScKiIQet8d5.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-03-16\",\"runtime\":30},{\"number\":12,\"name\":\"Drone Wars\",\"overview\":\"Click looks at the latest anti-drone tech from the Netherlands, Google’s move into online gaming, and making coding accessible for children with vision impairment.\",\"still\":\"https://image.tmdb.org/t/p/w780/zYboyAKjlN3xHmhhacflhim9PNO.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-03-23\",\"runtime\":30},{\"number\":13,\"name\":\"Policing Child Cybersex\",\"overview\":\"Click investigates the sexual exploitation of children on encrypted messaging apps in the Philippines, and the undercover bot trying to catch the perpetrators.\",\"still\":\"https://image.tmdb.org/t/p/w780/ytrRwctvRw0I97vDOO6rnk1BCfw.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-03-30\",\"runtime\":30},{\"number\":14,\"name\":\"Preventing Pollution\",\"overview\":\"Click looks at the tech that could help to keep our air clean. And we ask how vulnerable our infrastructure is to cyber-attack.\",\"still\":\"https://image.tmdb.org/t/p/w780/puYjvXFgBxcbGrO9GUnObqXShFv.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-04-06\",\"runtime\":30},{\"number\":15,\"name\":\"The Pope and the Robots\",\"overview\":\"Click is at the Vatican as the Pope hosts a workshop on robot ethics. Plus visits to a digital Van Gogh show in Paris and the London Games Festival.\",\"still\":\"https://image.tmdb.org/t/p/w780/k5bJDxKu3kH27ne14Jgzfxh1zBD.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-04-13\",\"runtime\":30},{\"number\":16,\"name\":\"Bend It Like...\",\"overview\":\"Click looks at how social media is being used in the Indian elections, AI techniques being applied to art, and artificial shooting stars becoming a reality.\",\"still\":\"https://image.tmdb.org/t/p/w780/lSidmLGHCsV49rJomZ3TiOPfwqE.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-04-20\",\"runtime\":30},{\"number\":17,\"name\":\"AI Criminal Record\",\"overview\":\"Click explores an AI algorithm helping expunge previous convictions for carrying marijuana in California. Plus we visit the teams from Japan racing to the moon.\",\"still\":\"https://image.tmdb.org/t/p/w780/pnGgu8h1Iq6ElPLAD2QepflhVm3.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-04-27\",\"runtime\":30},{\"number\":18,\"name\":\"5G Whizz\",\"overview\":\"The future is 5G: from race tracks to connected cows. Plus a look at China’s leading role in the technology.\",\"still\":\"https://image.tmdb.org/t/p/w780/ehR1fVlgYOPZx7RPKDEmtPJQ1WY.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-05-04\",\"runtime\":30},{\"number\":19,\"name\":\"Facial Recognition\",\"overview\":\"Police deployment of facial recognition is happening across the globe. But the tech is fraught with issues such as civil liberties. Click investigates.\",\"still\":\"https://image.tmdb.org/t/p/w780/6mcPYqpRfQTdKrlG49KArY4AbYd.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-05-11\",\"runtime\":30},{\"number\":20,\"name\":\"Rise of the Machines\",\"overview\":\"Police deployment of facial recognition is happening across the globe. But the tech is fraught with issues such as civil liberties. Click investigates.\",\"still\":\"https://image.tmdb.org/t/p/w780/aOl1WGAV6cMMonaGy4Rttu1tlWC.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-05-18\",\"runtime\":30},{\"number\":21,\"name\":\"GDPR One Year On\",\"overview\":\"A year on from launch, Click looks at the impact of GDPR, and how getting access to your data may still not be as easy as you think.\",\"still\":\"https://image.tmdb.org/t/p/w780/d1gh9e15IEKP6rEqGpz98FOjAaB.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-05-25\",\"runtime\":30},{\"number\":22,\"name\":\"The Tech That Helped Maisy See Again\",\"overview\":\"Click is at Hay Festival with its latest live show – where a blind woman uses tech to see for the first time in years.\",\"still\":\"https://image.tmdb.org/t/p/w780/dbNK3BqfcJJjJwVhJ2aaIj8PFH4.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-06-01\",\"runtime\":30},{\"number\":23,\"name\":\"Behind the Wheel\",\"overview\":\"Click gets in the driver’s seat in this in-depth look at the tech behind Formula E. Plus a look at how ransomware has brought a city to a standstill.\",\"still\":\"https://image.tmdb.org/t/p/w780/a0GGwFepaCa7dTNqZmu2UwHf21w.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-06-08\",\"runtime\":30},{\"number\":24,\"name\":\"No More Consoles\",\"overview\":\"Click travels to Los Angeles for E3 - the biggest gaming convention in the world - to check out the latest games and find out what might be next.\",\"still\":\"https://image.tmdb.org/t/p/w780/pUI5FnzXRp5jKYlIO02aV6gLFyD.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-06-15\",\"runtime\":30},{\"number\":25,\"name\":\"Tech Takedown\",\"overview\":\"Click visits Toronto's new 'smart' neighbourhood. However, some residents aren't so happy about living in the new age of 'surveillance capitalism'.\",\"still\":\"https://image.tmdb.org/t/p/w780/8CstENL5QIj1PTjEsQhabvH8qUn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-06-22\",\"runtime\":30},{\"number\":26,\"name\":\"999 Emergency Earth\",\"overview\":\"Click is in Arizona finding out how 'artificial trees' are being developed to suck carbon out of the air. Plus, drones that follow ships to 'sniff' emissions.\",\"still\":\"https://image.tmdb.org/t/p/w780/xnf68LnqOWEeoupcZRwAtdDiNJ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-06-29\",\"runtime\":30},{\"number\":27,\"name\":\"Click 1,000: The Future of Television\",\"overview\":\"This is the 1,000th episode of Click - so we’ve created a special show that gives you complete control over what you watch. Check it out at bbc.co.uk/click1000.\",\"still\":\"https://image.tmdb.org/t/p/w780/goA4k6bpakeBFMhD6i0zSOhmghh.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-07-06\",\"runtime\":30},{\"number\":28,\"name\":\"1001 a Space Odyssey\",\"overview\":\"To celebrate the 50th anniversary of the moon landing, Click lifts off with technology which takes us back to the moon as well as a little closer to earth - from the private companies that are building their own spaceships, to NASA's own efforts to return to the lunar surface. The team looks at future methods of space travel and also debunks the myriad conspiracy theories that have sprung up around the landing, using science to prove that astronauts landed on the Moon. And they find out why scientists are 3D printing geologically accurate moon rocks on terra firma and how they will help future space exploration.\",\"still\":\"https://image.tmdb.org/t/p/w780/odo4bU2y3uOstgW8jNc1rEg8lEk.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-07-13\",\"runtime\":30},{\"number\":29,\"name\":\"Nasa Goes Big Brother\",\"overview\":\"Click gets rare access into Nasa HQ to take a look at the research and engineering that is going to make space exploration possible. For the first time, the Human Exploration Research division opens its doors to give an insight into a specially designed habitat that locks up four astronauts for a 45-day fake mission, studying human behaviour in isolation, confinement, and stressful exploration scenarios.\\n\\nClick also gets to test drive space exploration vehicles on specially designed Mars terrain, gets up close and personal with humanoid space robots and interviews the head of Nasa mission control.\",\"still\":\"https://image.tmdb.org/t/p/w780/w5wIvgtwHX0nZTeIgZ22V0ge9BK.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-07-20\",\"runtime\":30},{\"number\":30,\"name\":\"The Self-Driving Revolution\",\"overview\":\"Click is in Arizona, self-driving car capital of the world. We dive deep in to the technology to see how it works and how sometimes it fails with tragic consequences. We also meet the people whose livelihoods are affected by the technology.\",\"still\":\"https://image.tmdb.org/t/p/w780/rntjdGwjMaRJ6rcXN7KM2VHHh78.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-07-27\",\"runtime\":30},{\"number\":31,\"name\":\"Future Food\",\"overview\":\"Click looks at the tech producing food with less environmental impact and at how 5G is helping salmon farms in the Orkney Islands. Plus a taste of new laboratory grown foods.\",\"still\":\"https://image.tmdb.org/t/p/w780/i3LC7CSvGlB3nEnEytx9lAoHpd6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-03\",\"runtime\":30},{\"number\":32,\"name\":\"Shutdown\",\"overview\":\"Click reports on the internet shutdowns in Kashmir, on Israel's new car scanner, and the remaking of Disney's Lion King. Includes tech news.\",\"still\":\"https://image.tmdb.org/t/p/w780/8D4dRF1YhaADCmmg9Z9cpVxx5KF.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-10\",\"runtime\":30},{\"number\":33,\"name\":\"Are E-Scooters Legal?\",\"overview\":\"Click goes on patrol with the Met's scooter enforcement division and hears from transport law-makers about what to do about new categories of electric personal vehicles.\",\"still\":\"https://image.tmdb.org/t/p/w780/eRQjaLoyLjAn1zsIcWzerJ32NQk.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-17\",\"runtime\":30},{\"number\":34,\"name\":\"Out of this World\",\"overview\":\"Click travels to Spaceport USA in New Mexico to speak to the team behind Virgin Galactic and learn more about their plans to put tourists into space.\",\"still\":\"https://image.tmdb.org/t/p/w780/fK9CGsjmtvg3jPE21RMcv1sMGoe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-07\",\"runtime\":30},{\"number\":35,\"name\":\"The Technology Powering Protest\",\"overview\":\"Danny Vincent looks at how technology is used by protesters in Hong Kong. Click also investigates if tech can make the fashion industry more sustainable.\",\"still\":\"https://image.tmdb.org/t/p/w780/cJEjr3bJolyLCDSWybQJsWK53mx.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-14\",\"runtime\":30},{\"number\":36,\"name\":\"Can Technology Solve the Opioid Crisis?\",\"overview\":\"Technology companies have been accused of facilitating the illicit sale of drugs online, but are they really to blame?\\n\\nSeventy thousand Americans are dying each year from drug overdoses. Two-thirds are the result of opioid addiction. Technology companies have been accused of helping facilitate the illicit sale of drugs online, but are they really to blame?\\n\\nWarning: This programme contains people affected by drug abuse.\",\"still\":\"https://image.tmdb.org/t/p/w780/37CWRJkt9TbezKNVVP4ukzQmpoX.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-21\",\"runtime\":30},{\"number\":37,\"name\":\"Breaking the Sound Barrier\",\"overview\":\"Click tests all things audio this week, by paragliding, breaking glass, dancing in raves, and going to an Elton John concert.\",\"still\":\"https://image.tmdb.org/t/p/w780/7VKWuJ5w1yZEs9tOyOUgVhev8vz.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-28\",\"runtime\":30},{\"number\":38,\"name\":\"Electric Cars\",\"overview\":\"Are electric cars a credible replacement for petrol or diesel vehicles? We compare performance, range, cost, practicality and charging of the cars.\",\"still\":\"https://image.tmdb.org/t/p/w780/mCvxlnxf8Yf6f3BAE2itlMsN1lR.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-12\",\"runtime\":30},{\"number\":39,\"name\":\"Has China Hacked Wikipedia?\",\"overview\":\"Click investigates the possible state manipulation of Wikipedia, speaks to Microsoft CEO Satya Nadella, and heads to Dreamworks to speak to the people behind a truly Abominable animation.\",\"still\":\"https://image.tmdb.org/t/p/w780/ddTE1hOGDpYHDr9HxS1YbX19SYr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-05\",\"runtime\":0},{\"number\":40,\"name\":\"19/10/2019\",\"overview\":\"We visit a children's hospital using a new low-cost portable ultrasound scanner and see the latest gadgets from Japan's CEATEC expo.\",\"still\":\"https://image.tmdb.org/t/p/w780/8w4gbStaYJheOKiXT3CT1sXOA00.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-19\",\"runtime\":30},{\"number\":41,\"name\":\"Happy 50th Birthday, Internet!\",\"overview\":\"On Click we see the 50th anniversary of the internet. To celebrate we talk to its creator, Vint Cerf to get his views on what his creation has become and where it's headed. Plus as the internet disrupts democracy the world over, could it also provide a new way to govern?\",\"still\":\"https://image.tmdb.org/t/p/w780/le9EyKEXyjqIaL8XU349Bm8YZcC.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-26\",\"runtime\":30},{\"number\":42,\"name\":\"Made in Taiwan\",\"overview\":\"Click heads to Taiwan to find out what 'Made in Taiwan' really means in the 21st century, from healthcare artificial intelligence to solving the pollution crisis.\",\"still\":\"https://image.tmdb.org/t/p/w780/dTcC3G9BwTG77cwpdHRJ5sF9dgz.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-02\",\"runtime\":30},{\"number\":43,\"name\":\"09/11/2019\",\"overview\":\"Click investigates whether 5G networks could damage our health as some fear, and whether 5G might take our weather forecasting ability back to the 1980s?\",\"still\":\"https://image.tmdb.org/t/p/w780/oZIOP5j2jOKtNY1ZFRGNDDjhjIj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-09\",\"runtime\":30},{\"number\":44,\"name\":\"Inside The Gig Economy\",\"overview\":\"Click looks at Uber and the importance of data for workers in the gig economy. Plus deep fakes, not of humans but birds.\",\"still\":\"https://image.tmdb.org/t/p/w780/9nsTcCNBZGS6HZrfLzf22OX8Uu2.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-16\",\"runtime\":30},{\"number\":45,\"name\":\"Death of the Console?\",\"overview\":\"Will Google's entry into gaming mean the end of the console? Plus a British-designed hypercar and an artificial intelligence debate at Cambridge.\",\"still\":\"https://image.tmdb.org/t/p/w780/8YKcfTWbsL9G81Dy9jZiT3ygG7F.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-23\",\"runtime\":30},{\"number\":46,\"name\":\"Blades of Glory\",\"overview\":\"Click looks at the latest developments in accessibility technology for disabled people, including how prosthetic running blades are developed and manufactured, and smart homes enabling people with learning difficulties to live more independently.\",\"still\":\"https://image.tmdb.org/t/p/w780/4gx7nmxjx1S7dVRWUxGm9pzrYFN.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-30\",\"runtime\":30},{\"number\":47,\"name\":\"The Outrage Election\",\"overview\":\"Click takes a deep dive into the world of social media and the abuse MPs are suffering during this so-called ‘outrage election’.\",\"still\":\"https://image.tmdb.org/t/p/w780/fbMN1YJUOzgYFKRsLD4O2znonbR.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-07\",\"runtime\":30},{\"number\":48,\"name\":\"China vs Silicon Valley\",\"overview\":\"We look at social media innovation coming out of China, and how that’s making Silicon Valley nervous. Are the global power-dynamics of the internet changing?\",\"still\":\"https://image.tmdb.org/t/p/w780/2yNCard0LbBwFRDxqZaZrKxtIAZ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-14\",\"runtime\":30},{\"number\":49,\"name\":\"Clickmas Special\",\"overview\":\"It's the Clickmas Special! With bags of seasonal tech fun. Astronaut Tim Peake chats about the year in Space and we race one of the fastest ever e-cars.\",\"still\":\"https://image.tmdb.org/t/p/w780/9efiyBpPHsYGtpprPynj2XZjAId.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-21\",\"runtime\":30},{\"number\":50,\"name\":\"Click: Live\",\"overview\":\"This year we come from V&A Dundee, where we hear about the region's pivotal role in video games, drink water from a pollution-sucking car and have a visit from Nasa, who show us the latest robots they have been developing and which will soon be exploring Mars.\",\"still\":\"https://image.tmdb.org/t/p/w780/bP0z1XNUmzVJ9W3Dn3TUJIenSPI.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-28\",\"runtime\":30}],\"firstAirDate\":\"2000-04-06\"}","status":200,"url":""},"revalidate":86400,"tags":[]}