acter\":\"Unknown\",\"photo\":null},{\"id\":1478882,\"name\":\"Mircea Bogdan\",\"character\":\"Unknown\",\"photo\":null},{\"id\":2401140,\"name\":\"Ștefan-Niculescu Cadet\",\"character\":\"Unknown\",\"photo\":null},{\"id\":2419136,\"name\":\"Valeria Rădulescu\",\"character\":\"Unknown\",\"photo\":null},{\"id\":1407274,\"name\":\"Corneliu Gîrbea\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/bXVC7mHcNYOrFvekYrESyOciBHW.jpg\"},{\"id\":1317713,\"name\":\"Mircea Krishan\",\"character\":\"Unknown\",\"photo\":null}],\"similar\":[{\"id\":1514026,\"title\":\"Buddy\",\"poster\":\"https://image.tmdb.org/t/p/w780/1BdZbNvl1SfrrX8J9X5tQzN6Ivu.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/sMmG82PtjK8A9rVc34gwKQtCm3A.jpg\",\"rating\":6.8,\"year\":2026,\"type\":\"movie\",\"overview\":\"Inside the colorful world of \\\"It's Buddy!\\\", a group of children spend their days singing, dancing, and helping Buddy - bright orange unicorn - spread happiness. But when one child refuses to play along, Buddy is not pleased and cracks begin to appear in this seemingly perfect world.\",\"genres\":[\"Horror\",\"Comedy\",\"Fantasy\"],\"daysUntil\":null},{\"id\":1153576,\"title\":\"Street Fighter\",\"poster\":\"https://image.tmdb.org/t/p/w780/ccxdepKqORLwccbzvO4eAGkN0IC.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/zDE9hd1SG9695YncbZGjSf7Z9Jk.jpg\",\"rating\":6.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"In 1993, estranged Street Fighters Ryu and Ken Masters are thrown back into combat when the mysterious Chun-Li recruits them for the next World Warrior Tournament: a brutal clash of fists, fate, and fury. But behind this battle royale lies a deadly conspiracy that forces them to face off against each other and the demons of their past. And if they don't, it's GAME OVER!\",\"genres\":[\"Action\",\"Comedy\",\"Fantasy\"],\"daysUntil\":null},{\"id\":1465063,\"title\":\"Forgotten Island\",\"poster\":\"https://image.tmdb.org/t/p/w780/myd1K3gefdNAWFsGNRDdMeiK9Qg.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/2o9FzuBzCqrDTdlHRuEVnGD2d5h.jpg\",\"rating\":8.1,\"year\":2026,\"type\":\"movie\",\"overview\":\"While celebrating their last night together, high school graduates and best friends Jo and Raissa stumble upon a mysterious portal that transports them to the fantastical island of Nakali. When they discover that the memories of their entire friendship are the price for returning home, Jo and Raissa must race to find a way to leave the island before they forget each other forever.\",\"genres\":[\"Animation\",\"Adventure\",\"Fantasy\"],\"daysUntil\":null},{\"id\":1108427,\"title\":\"Moana\",\"poster\":\"https://image.tmdb.org/t/p/w780/gaet1xQ2nxrG0V1Ep9T20ZMNEIC.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/c6BPbkO5Npt1OdwttAxCFo06wtH.jpg\",\"rating\":7.4,\"year\":2026,\"type\":\"movie\",\"overview\":\"Teenage Moana answers the Ocean's call and, for the first time, voyages beyond the reef of her island of Motunui with infamous demigod Maui on an unforgettable journey to restore prosperity to her people.\",\"genres\":[\"Family\",\"Fantasy\",\"Comedy\"],\"daysUntil\":null},{\"id\":1315772,\"title\":\"Minions & Monsters\",\"poster\":\"https://image.tmdb.org/t/p/w780/4LwvU9SZc8QQzW1X1FAPhNbXnEU.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/kkcwhgSFd81QDlXo8ytrpHPQjhy.jpg\",\"rating\":7.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"This is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created.\",\"genres\":[\"Adventure\",\"Animation\",\"Comedy\"],\"daysUntil\":null},{\"id\":1226863,\"title\":\"The Super Mario Galaxy Movie\",\"poster\":\"https://image.tmdb.org/t/p/w780/eJGWx219ZcEMVQJhAgMiqo8tYY.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/kxQiIJ4gVcD3K6o14MJ72p5yRcE.jpg\",\"rating\":8.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"Having thwarted Bowser's previous plot to marry Princess Peach, Mario and Luigi now face a fresh threat in Bowser Jr., who is determined to liberate his father from captivity and restore the family legacy. Alongside companions new and old, the brothers travel across the stars to stop the young heir's crusade.\",\"genres\":[\"Family\",\"Comedy\",\"Adventure\"],\"daysUntil\":null},{\"id\":8871,\"title\":\"How the Grinch Stole Christmas\",\"poster\":\"https://image.tmdb.org/t/p/w780/1WZbbPApEivA421gCOluuzMMKCk.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/sy0vo1cmpKqwPRiMUiJ45jyLsX7.jpg\",\"rating\":6.8,\"year\":2000,\"type\":\"movie\",\"overview\":\"The Grinch decides to rob Whoville of Christmas - but a dash of kindness from little Cindy Lou Who and her family may be enough to melt his heart...\",\"genres\":[\"Family\",\"Comedy\",\"Fantasy\"],\"daysUntil\":null},{\"id\":1302904,\"title\":\"Practical Magic 2\",\"poster\":\"https://image.tmdb.org/t/p/w780/ogwQOLbCfncjvBhFb5l0OmQH8KC.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/oIglj0Jy9duG4LnrRUpH8n001Pk.jpg\",\"rating\":7.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"The Owens sisters must confront the dark curse that threatens to unravel their family once and for all.\",\"genres\":[\"Romance\",\"Fantasy\",\"Comedy\"],\"daysUntil\":null},{\"id\":803796,\"title\":\"KPop Demon Hunters\",\"poster\":\"https://image.tmdb.org/t/p/w780/zT7Lhw3BhJbMkRqm9Zlx2YGMsY0.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/w3Bi0wygeFQctn6AqFTwhGNXRwL.jpg\",\"rating\":8,\"year\":2025,\"type\":\"movie\",\"overview\":\"When K-pop superstars Rumi, Mira and Zoey aren't selling out stadiums, they're using their secret powers to protect their fans from supernatural threats.\",\"genres\":[\"Fantasy\",\"Music\",\"Comedy\"],\"daysUntil\":null},{\"id\":360920,\"title\":\"The Grinch\",\"poster\":\"https://image.tmdb.org/t/p/w780/Al7DMUp8bqUN4JwXVNxfJYyv5cH.j