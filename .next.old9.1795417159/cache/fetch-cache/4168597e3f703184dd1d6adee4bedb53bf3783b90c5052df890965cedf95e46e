{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":643811,\"title\":\"Vojnarka\",\"tagline\":\"\",\"overview\":\"Antonín Havel was unhappily in love with Madlena. She married the rich Sedlák Vojnar, and Havel went to war. But Madlena soon became a widow. Madlena is forced by her brother-in-law Jakub into a second marriage. She refuses this not only because of her son Jeník, but also because of her memories of Antonín.\",\"poster\":null,\"backdrop\":null,\"rating\":10,\"voteCount\":1,\"year\":1936,\"runtime\":102,\"genres\":[\"Drama\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"XC\",\"name\":\"Czechoslovakia\"}],\"budget\":0,\"revenue\":0,\"director\":\"Vladimír Borský\",\"cast\":[{\"id\":1605155,\"name\":\"Vladimír Borský\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/ysoWpOxBFCuNpr0Mh2Wu4julpx.jpg\"},{\"id\":1283320,\"name\":\"Jiřina Štěpničková\",\"character\":\"Madlena Vojnarová\",\"photo\":\"https://image.tmdb.org/t/p/w780/efr6pETFxijSyCj61ZaktjifpTS.jpg\"},{\"id\":2648780,\"name\":\"Karel Pecián\",\"character\":\"Jeník\",\"photo\":null},{\"id\":1602531,\"name\":\"Václav Vydra\",\"character\":\"Jakub Vojnar\",\"photo\":\"https://image.tmdb.org/t/p/w780/zOvlmg3HY5LZgjsPkp1dYB24yMc.jpg\"},{\"id\":120000,\"name\":\"Zdeněk Štěpánek\",\"character\":\"Antonín Havel\",\"photo\":\"https://image.tmdb.org/t/p/w780/gSYj1tr25rCdsVpOy0Lli4UobJ3.jpg\"},{\"id\":590659,\"name\":\"Antonie Nedošinská\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/zGt2VH3QyOIx1Uc5WO7fhpyV6sG.jpg\"},{\"id\":544301,\"name\":\"Jindřich Plachta\",\"character\":\"Jan Hruška\",\"photo\":\"https://image.tmdb.org/t/p/w780/sw0GRrB2NddN8OMzo7VqQdy5s7j.jpg\"},{\"id\":1183196,\"name\":\"Elena Hálková\",\"character\":\"Bětka\",\"photo\":\"https://image.tmdb.org/t/p/w780/mwqm4FaAfo6NBKqBwAuXQGT7cAk.jpg\"},{\"id\":1470759,\"name\":\"Jiří Hron\",\"character\":\"Martin\",\"photo\":\"https://image.tmdb.org/t/p/w780/nJoWc2gdS2nmighq5eDz4