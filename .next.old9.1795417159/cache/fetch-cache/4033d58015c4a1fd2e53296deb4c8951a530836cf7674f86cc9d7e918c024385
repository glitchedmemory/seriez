{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":312733,\"title\":\"Swimming Limitless\",\"tagline\":\"\",\"overview\":\"Rebellious teenager Lin Bei discovers his extraordinary swimming talent under Coach Zhang Zhutian and, alongside rival-turned-teammate Pan Liang, faces personal struggles, family pressures, and fierce competition. Through perseverance and teamwork, they grow, overcome obstacles, and achieve both personal and shared triumph in the pool.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/vsVYg6FqkZ69KRN9WRY75ZHknhg.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/z075OIpdsW9BKukQCcMgZQO3NM1.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":2026,\"genres\":[\"Drama\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":1,\"totalEpisodes\":17,\"createdBy\":[],\"networks\":[\"iQiyi\",\"Youku\"],\"countries\":[{\"code\":\"CN\",\"name\":\"China\"}],\"lastAirDate\":\"2026-02-10\",\"cast\":[{\"id\":4458461,\"name\":\"Qi Zijie\",\"character\":\"Lin Bei\",\"photo\":\"https://image.tmdb.org/t/p/w780/xSnVgLQqHpLcGx0FI5QLJRm0cgl.jpg\"},{\"id\":5972584,\"name\":\"Yang Yide\",\"character\":\"Pan Liang\",\"photo\":null},{\"id\":5972585,\"name\":\"Qi Kefei\",\"character\":\"Gao Xiaofei\",\"photo\":null},{\"id\":4521746,\"name\":\"Zhang Xiner\",\"character\":\"Sui Jia\",\"photo\":\"https://image.tmdb.org/t/p/w780/uNl0CxxtaKZD4FG7DYiKeHysVNW.jpg\"},{\"id\":5972587,\"name\":\"Lei Yufei\",\"character\":\"Doudou\",\"photo\":null},{\"id\":3366888,\"name\":\"Li Hanjun\",\"character\":\"Zhang Zhutian\",\"photo\":\"https://image.tmdb.org/t/p/w780/kBv7pnsuenHfq8biKgRqWo1mhbZ.jpg\"},{\"id\":4517954,\"name\":\"Wang Shimeng\",\"character\":\"He Qian\",\"photo\":\"https://image.tmdb.org/t/p/w780/jnNHltVyazFCObMkgfwZ8w67FDJ.jpg\"}],\"trailers\":[{\"key\":\"SdcLM9xYa70\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"CF9LnbtZpnI\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"ty