/p/w780/ktmwzcWou5vCyqDnRJXih812XGI.jpg\",\"rating\":6.3,\"year\":2013,\"type\":\"tv\",\"_score\":0.3204545454545455,\"_genreOverlap\":3},{\"id\":281441,\"title\":\"Wonderblocks\",\"poster\":\"https://image.tmdb.org/t/p/w780/wNQ3ptV0RgzeBXRpAmfEnnldDXH.jpg\",\"rating\":4.2,\"year\":2025,\"type\":\"tv\",\"_score\":0.21764705882352942,\"_genreOverlap\":2},{\"id\":441,\"title\":\"Father of the Pride\",\"poster\":\"https://image.tmdb.org/t/p/w780/eJ8kqnWfgeYb1XyKmRXCBs599pa.jpg\",\"rating\":5.1,\"year\":2004,\"type\":\"tv\",\"_score\":0.21415094339622642,\"_genreOverlap\":2},{\"id\":128643,\"title\":\"Pirata and Capitano\",\"poster\":\"https://image.tmdb.org/t/p/w780/7vjDjiXi9DgCIhs70yPIKKM6Zec.jpg\",\"rating\":0,\"year\":2016,\"type\":\"tv\",\"_score\":0.21304347826086958,\"_genreOverlap\":2},{\"id\":312776,\"title\":\"Tutu\",\"poster\":\"https://image.tmdb.org/t/p/w780/iZxos9AglEISFe9uvN3E8Nlr7Hs.jpg\",\"rating\":0,\"year\":2017,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":2},{\"id\":211735,\"title\":\"La La La Demacia\",\"poster\":\"https://image.tmdb.org/t/p/w780/tWlUgg1lUTB85JMdj4E1wL0EOvF.jpg\",\"rating\":8.3,\"year\":2011,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":2},{\"id\":128315,\"title\":\"Saturday Morning Minions\",\"poster\":\"https://image.tmdb.org/t/p/w780/3MfL4g6kE5Ax6OlLHOJrGPvIfZT.jpg\",\"rating\":8.2,\"year\":2021,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":2}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/w8qGbXH61sP082jhHj0S4oQ2I4k.jpg\",\"seasonAirDate\":\"2015-01-15\",\"episodes\":[{\"number\":1,\"name\":\"Hidden\",\"overview\":\"Puss stumbles upon the legendary hidden city of San Lorenzo, and soon finds himself forced to protect it from thieves.\",\"still\":\"https://image.tmdb.org/t/p/w780/sdrOYWrYmwYg20Kk32t4gqtwxAZ.jpg\",\"rating\":7.6,\"voteCount\":14,\"airDate\":\"2015-01-16\",\"runtime\":23},{\"number\":2,\"name\":\"Sphinx\",\"overview\":\"Puss accidentally gives the orphans a magic substance that will ultimately make them explode. The only cure is guarded by a Sphinx who challenges Puss with riddles - and contrary to his own belief, Puss is not good at riddles.\",\"still\":\"https://image.tmdb.org/t/p/w780/8V5GoqtL9JPNq1SaMY0DN0a7XZy.jpg\",\"rating\":7.8,\"voteCount\":9,\"airDate\":\"2015-01-16\",\"runtime\":23},{\"number\":3,\"name\":\"Brothers\",\"overview\":\"When Toby's ninja brothers try to get him to steal San Lorenzo‘s treasure, he must decide between them and his friendship with Puss.\",\"still\":\"https://image.tmdb.org/t/p/w780/wywrL0wYpCK2uIqkXMBVwSlmDQT.jpg\",\"rating\":5.9,\"voteCount\":7,\"airDate\":\"2015-01-16\",\"runtime\":23},{\"number\":4,\"name\":\"Duchess\",\"overview\":\"The Duchess, who wants to rule the world by harnessing the power of sorcerers, captures Artephius...and it's up to Puss to rescue him.\",\"still\":\"https://image.tmdb.org/t/p/w780/zPSyKgf2lh12indJlgu5n7wHAvW.jpg\",\"rating\":7,\"voteCount\":8,\"airDate\":\"2015-01-16\",\"runtime\":23},{\"number\":5,\"name\":\"Adventure\",\"overview\":\"Puss is tricked into going on a quest with an old friend, Jack Sprat. What starts out as a mission to save a princess soon turns dangerous.\",\"still\":\"https://image.tmdb.org/t/p/w780/2ZZRAV3EWGO5aJLnyAdvCr2izuK.jpg\",\"rating\":6.5,\"voteCount\":6,\"airDate\":\"2015-01-16\",\"runtime\":23},{\"number\":6,\"name\":\"Fountains\",\"overview\":\"In an effort to save Puss's old mentor, El Guante Blanco, Puss and Dulcinea embark on an adventure to find the Fountain of Youth.\",\"still\":\"https://image.tmdb.org/t/p/w780/5hK4loiKGTUFodw8smoMkSBeE8T.jpg\",\"rating\":6.7,\"voteCount\":6,\"airDate\":\"2015-05-08\",\"runtime\":23},{\"number\":7,\"name\":\"Bravery\",\"overview\":\"Puss tries to convince the Mayor that he is really a hero -- but being \\\"brave\\\" quickly goes to the Mayor's head.\",\"still\":\"https://image.tmdb.org/t/p/w780/aBI9ae2s223WrOBzKaf9yqJgBhM.jpg\",\"rating\":6.5,\"voteCount\":6,\"airDate\":\"2015-05-08\",\"runtime\":23},{\"number\":8,\"name\":\"Golem\",\"overview\":\"The Golem, a giant clay enemy Puss has been outrunning for years, comes to San Lorenzo. With the help of Artephius, Puss may finally defeat his foe.\",\"still\":\"https://image.tmdb.org/t/p/w780/84OTrUHy89kaRwwm1yLJAX2WPPA.jpg\",\"rating\":6.5,\"voteCount\":6,\"airDate\":\"2015-05-08\",\"runtime\":23},{\"number\":9,\"name\":\"Boots\",\"overview\":\"By stealing enchanted boots from the Treasure House, Jack Sprat sets off a dangerous Devil Wind that threatens to consume all of the town's treasure.\",\"still\":\"https://image.tmdb.org/t/p/w780/A1unW8gxBRfm3i2DgJndEeClIxu.jpg\",\"rating\":6.7,\"voteCount\":6,\"airDate\":\"2015-05-08\",\"runtime\":23},{\"number\":10,\"name\":\"Sword\",\"overview\":\"Dulcinea becomes enchanted with heroic powers when she pulls a magical sword from a stone, and Puss must help her learn how to control her strength.\",\"still\":\"https://image.tmdb.org/t/p/w780/w2Q5n5rypayrLl5kPcJHQyDOdW2.jpg\",\"rating\":6.7,\"voteCount\":6,\"airDate\":\"2015-05-08\",\"runtime\":23},{\"number\":11,\"name\":\"Mouse\",\"overview\":\"Puss is obsessed with catching an adorable mouse, but when strange things happen around town, he fears the rodent may be more than a delicious meal.\",\"still\":\"https://image.tmdb.org/t/p/w780/eGba0NQKeejYHledWNR6207gQi5.jpg\",\"rating\":6.2,\"voteCount\":4,\"airDate\":\"2015-09-28\",\"runtime\":23},{\"number\":12,\"name\":\"Goblin\",\"overview\":\"When a young goblin arrives in town, Puss instantly likes her and tries to convince the orphans that she is more than just a brash troublemaker.\",\"still\":\"https://image.tmdb.org/t/p/w780/osAUwktMUuDhIzn9t8gwBIeoPTR.jpg\",\"rating\":6.2,\"voteCount\":4,\"airDate\":\"2015-09-28\",\"runtime\":23},{\"number\":13,\"name\":\"Star\",\"overview\":\"Dulcinea secretly discovers a wishing star and tries to make things better for everyone with her wishes, but ends up making things a lot worse.\",\"still\":\"https://image.tmdb.org/t/p/w780/h5e6TYWcvmqx55aWHbYPVIFN9rX.jpg\",\"rating\":6.2,\"voteCount\":4,\"airDate\":\"2015-09-28\",\"runtime\":23},{\"number\":14,\"name\":\"Pigs\",\"overview\":\"Convinced his ninja brothers were forced to kick him out of the gang by an evil wizard, Toby's brother, Brandt, begs Puss to help them reunite.\",\"still\":\"https://image.tmdb.org/t/p/w780/och4qAHOXUMoDwMRjXqsgTDUyfK.jpg\",\"rating\":6.2,\"voteCount\":4,\"airDate\":\"2015-09-28\",\"runtime\":23},{\"number\":15,\"name\":\"Luck\",\"overview\":\"When a bad luck curse turns Puss into a black cat and he is run out of San Lorenzo, a thieving crew of no-good cats tries to get him to join the gang.\",\"still\":\"https://image.tmdb.org/t/p/w780/bPwpXP6chlKK7huC3nVSW8hp17A.jpg\",\"rating\":6.2,\"voteCount\":4,\"airDate\":\"2015-09-28\",\"runtime\":23}],\"firstAirDate\":\"2015-01-16\"}","status":200,"url":""},"revalidate":86400,"tags":[]}