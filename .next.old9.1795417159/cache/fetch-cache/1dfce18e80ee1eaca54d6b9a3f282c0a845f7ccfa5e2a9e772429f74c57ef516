\"},{\"id\":2380715,\"name\":\"Aïcha Ben Ahmed\",\"character\":\"Hind\",\"photo\":\"https://image.tmdb.org/t/p/w780/jrViFEKQsMSELJd3yoqW6wbL9rB.jpg\"}],\"similar\":[{\"id\":1666428,\"title\":\"MIGAJERO!!\",\"poster\":\"https://image.tmdb.org/t/p/w780/fot4D3fAYA21CafbCIvwGuIVZKX.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7o70XRYBPOhrzl0hI3kd3Ioxgft.jpg\",\"rating\":10,\"year\":2026,\"type\":\"movie\",\"overview\":\"This is an intimate and fragmented portrait of what it means to fall in love in the 21st century. Where desire, breadcrumbing, and vulnerability intertwine in a process of falling, self-creation, and pure frenzy.\",\"genres\":[\"Documentary\"],\"daysUntil\":null},{\"id\":681527,\"title\":\"Time & Again\",\"poster\":\"https://image.tmdb.org/t/p/w780/voySgB7Ewexma9V01numAtys2XP.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/aVDcFAqCTw9tmRTc2nc134nJvHL.jpg\",\"rating\":9,\"year\":2019,\"type\":\"movie\",\"overview\":\"Eleanor and Isabelle meet again, sixty years after their relationship break up...\",\"genres\":[\"Drama\"],\"daysUntil\":null},{\"id\":663113,\"title\":\"Patalliro! The Movie\",\"poster\":\"https://image.tmdb.org/t/p/w780/qR17ndNiqh3hvlzSG9PEoI7M1rD.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/hSqDOIXckuDCLSudWJxYBMDJ8Ah.jpg\",\"rating\":9,\"year\":2019,\"type\":\"movie\",\"overview\":\"Patalliro du Malyner VIII is the crown prince of Malynera, a kingdom that produces diamonds. Despite being ugly and mischievous, he is loyal and fair. Many enemies of the throne, including Malynera's Prime Minister, plan to get rid of him and take control of the rich nation. Patalliro, however, has the protection of Jack Barbarosa Bancoran, his haughty and extremely handsome bodyguard, who will protect him even from the latter's own lover, the beautiful bishonen hitman Maraich Juschenfe and other assassins.\",\"genres\":[\"Music\",\"Adventure\",\"Comedy\"],\"daysUntil\":null},{\"id\":21634,\"title\":\"Prayers for Bobby\",\"poster\":\"https://image.tmdb.org/t/p/w780/1viFwXluAettogGDsTrSUUg29lZ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/9BrhCgffilZPr3VOnDAKP9vBrU1.jpg\",\"rating\":8,\"year\":2009,\"type\":\"movie\",\"overview\":\"Bobby Griffith was his mother's favorite son, the perfect all-American boy growing up under deeply religious influences in Walnut Creek, California. Bobby was also gay. Struggling with a conflict no one knew of, much less understood, Bobby finally came out to his family.\",\"genres\":[\"Drama\",\"History\",\"TV Movie\"],\"daysUntil\":null},{\"id\":475888,\"title\":\"Tell It to the Bees\",\"poster\":\"https://image.tmdb.org/t/p/w780/Rj6zpHhMU1zFW3v28U4PSRSRgP.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/Oeo4ZabmekrqCQyn34SI95692d.jpg\",\"rating\":7.5,\"year\":2019,\"type\":\"movie\",\"overview\":\"Dr. Jean Markham returns to the town she left as a teenager to take over her late father's medical practice. When a school-yard scuffle lands Charlie in her surgery, she invites him to visit the hives in her garden and tell his secrets to the bees, as she once did. The new friendship between the boy and the bee keeper brings his mother Lydia into Jean's world.\",\"genres\":[\"Romance\",\"Drama\"],\"daysUntil\":null},{\"id\":663105,\"title\":\"His\",\"poster\":\"https://image.tmdb.org/t/p/w780/ePBDOSLQ26voWspjWoDn1GuhiU8.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/unGBAgFxeKUzGEsTReV2ECphMVl.jpg\",\"rating\":7.1,\"year\":2020,\"type\":\"movie\",\"overview\":\"Shun and Nagisa first meet and fall in love during their first year of high school. While Shun is graduating from university, Nagisa tells him that he doesn't see a future for them. Despite Shun's strong feelings, they go their separate ways. Years later, Shun is now a store owner, living alone in a rural area. Out of the blue, Nagisa arrives with his six-year-old daughter, Sora. Spending time together, Shun realizes he still harbors feelings for Nagisa. Can Nagisa reconcile with his feelings for Shun, which have been there all along?\",\"genres\":[\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":22373,\"title\":\"Saturn in Opposition\",\"poster\":\"https://image.tmdb.org/t/p/w780/qpzR06PrVDaJGBaSngEMUhVhhw.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/xLjv2ah3MeLrkm6EoViJR9ZGznj.jpg\",\"rating\":6.9,\"year\":2007,\"type\":\"movie\",\"overview\":\"This film focuses on contemporary 30- and 40-somethings trying to make sense of their lives in an age in which the old certainties have disappeared. Lorenzo and Davide make their lives together within a circle that includes Antonio and Angelica, married with children; Nerval and her policeman husband.\",\"genres\":[\"Drama\"],\"daysUntil\":null},{\"id\":40692,\"title\":\"Ready? OK!\",\"poster\":\"https://image.tmdb.org/t/p/w780/dfgaaUuuqvFfsjCxwHr4QFOGoZa.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/gjATBKGXm7RrviSZV1y9p8fGlLC.jpg\",\"rating\":5.8,\"year\":2008,\"type\":\"movie\",\"overview\":\"When 10-year-old Joshua (Lurie Poston) decides to join the cheerleading squad at his Catholic school, he faces an uphill battle -- and opposition from his single mom, Andy (Carrie Preston), who struggles to understand her Hollywood musical- and pom-pom-loving son. With the help of sympathetic neighbor Charlie (Michael Emerson), Andy attempts to embrace her son for who he is, not who she wants him to be. James Vasquez directs this touching comedy.\",\"genres\":[\"Comedy\",\"Family\"],\"daysUntil\":null},{\"id\":475930,\"title\":\"Knife+Heart\",\"poster\":\"https://image.tmdb.org/t/p/w780/Aodlp3TH6FBti9igUCt8f5KS7Nb.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/o6rSSDdXkQRGCYKTkwiFjWG7qov.jpg\",\"rating\":5.8,\"year\":2018,\"type\":\"movie\",\"overview\":\"In the summer of 1979, gay porn producer Anne sets out to film her most ambitious film yet, but her actors are picked off, one by one, by a mysterious killer.\",\"genres\":[\"Horror\",\"Romance\",\"Mystery\"],\"daysUntil\":null},{\"id\":287855,\"title\":\"Drown\",\"poster\":\"https://image.tmdb.org/t/p/w780/fHqPEhRJjDI2Qo6EjPvtOtToyH5.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/ezkcwZIUoSziZ6fWHNHkMRioZet.jpg\",\"rating\":5.5,\"year\":2015,\"type\":\"movie\",\"overview\":\"Len is a Surf Lifesaving champion, a legend in the cloistered surf club just like his father. When the younger, faster, and fitter Phil arrives at the club, Len’s legendary status starts to crumble. Then Len sees Phil arriving in the company of another man. Phil is gay.\",\"genres\":[\"Drama\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"xnHrfYp6HCI\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"ZJpRjFX5jw4\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"o7HQnwnUl1I\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}