or\"],\"daysUntil\":null},{\"id\":791523,\"title\":\"Wildwood\",\"poster\":\"https://image.tmdb.org/t/p/w780/snFM00mpNAfUzUtkdEW0uDEvXA0.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/sl5NJ1vtyhP9Vr88bB4blULsJYp.jpg\",\"rating\":8.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Prue and her classmate Curtis are drawn into a magical forest filled with enchanted creatures, loyal allies, and formidable adversaries as they embark on a desperate quest to rescue Prue's abducted baby brother from a murder of crows led by a mysterious woman named Alexandra.\",\"genres\":[\"Animation\",\"Adventure\",\"Drama\"],\"daysUntil\":null},{\"id\":1503762,\"title\":\"Sense and Sensibility\",\"poster\":\"https://image.tmdb.org/t/p/w780/czsyPHosFNbh4PPqXfqWu1aBXnA.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/tIcONOFK9D3F89ETK8DBS1hIwVF.jpg\",\"rating\":7.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"A charming, witty, and deeply relatable story of love and sisterhood.\",\"genres\":[\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":872585,\"title\":\"Oppenheimer\",\"poster\":\"https://image.tmdb.org/t/p/w780/8Gxv8gSFCU0XGDykEGv7zR1n2ua.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg\",\"rating\":8,\"year\":2023,\"type\":\"movie\",\"overview\":\"The story of J. Robert Oppenheimer's role in the development of the atomic bomb during World War II.\",\"genres\":[\"Drama\",\"History\",\"War\"],\"daysUntil\":null},{\"id\":9674,\"title\":\"Ring 0\",\"poster\":\"https://image.tmdb.org/t/p/w780/nuhEWlaoMD00rTDCiYxdEc7d1tD.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/noRX8VyyAFK1tt0DQSq5qy1tE10.jpg\",\"rating\":6.1,\"year\":2000,\"type\":\"movie\",\"overview\":\"Taking place thirty years before the events of Ringu, Ringu 0 provides the shocking background story of how the girl on the video became a deadly, vengeful spirit.\",\"genres\":[\"Horror\",\"Thriller\",\"Drama\"],\"daysUntil\":null},{\"id\":290098,\"title\":\"The Handmaiden\",\"poster\":\"https://image.tmdb.org/t/p/w780/dLlH4aNHdnmf62umnInL8xPlPzw.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/2b3RNXF7ca9bgX8FrjRBYfLnNQC.jpg\",\"rating\":8.2,\"year\":2016,\"type\":\"movie\",\"overview\":\"1930s Korea, in the period of Japanese occupation, a new girl, Sook-hee, is hired as a handmaiden to a Japanese heiress, Hideko, who lives a secluded life on a large countryside estate with her domineering Uncle Kouzuki. But the maid has a secret. She is a pickpocket recruited by a swindler posing as a Japanese Count to help him seduce the Lady to steal her fortune.\",\"genres\":[\"Thriller\",\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":453,\"title\":\"A Beautiful Mind\",\"poster\":\"https://image.tmdb.org/t/p/w780/rEIg5yJdNOt9fmX4P8gU9LeNoTQ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/hCJFWTPghXCwwSpvPpAoIB8318Q.jpg\",\"rating\":7.9,\"year\":2001,\"type\":\"movie\",\"overview\":\"From the heights of notoriety to the depths of depravity, John Forbes Nash Jr. experiences it all. As a brilliant but socially awkward mathematician, he made a groundbreaking discovery early in his career and stands on the brink of international acclaim. But as the handsome and arrogant Nash accepts secret work in cryptography, he becomes entangled in a mysterious conspiracy. His life takes a nightmarish turn and he soon finds himself on a painful and harrowing journey of self-discovery.\",\"genres\":[\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":8966,\"title\":\"Twilight\",\"poster\":\"https://image.tmdb.org/t/p/w780/3Gkb6jm6962ADUPaCBqzz9CTbn9.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/weAYfu6FfrNxEDJ3xH1XpgQcqUv.jpg\",\"rating\":6.3,\"year\":2008,\"type\":\"movie\",\"overview\":\"When Bella Swan moves to a small town in the Pacific Northwest, she falls in love with Edward Cullen, a mysterious classmate who reveals himself to be a 108-year-old vampire. Despite Edward's repeated cautions, Bella can't stay away from him, a fatal move that endangers her own life.\",\"genres\":[\"Fantasy\",\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":106646,\"title\":\"The Wolf of Wall Street\",\"poster\":\"https://image.tmdb.org/t/p/w780/kW9LmvYHAaS9iA0tHmZVq8hQYoq.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7Nwnmyzrtd0FkcRyPqmdzTPppQa.jpg\",\"rating\":8,\"year\":2013,\"type\":\"movie\",\"overview\":\"A New York stockbroker refuses to cooperate in a large securities fraud case involving corruption on Wall Street, corporate banking world and mob infiltration. Based on Jordan Belfort's autobiography.\",\"genres\":[\"Crime\",\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":1516698,\"title\":\"The Last Sunrise\",\"poster\":\"https://image.tmdb.org/t/p/w780/3PWJqDfygN0YNNjWsDUOXclCp3h.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/zFCWfU2ViMIm38G1W8UsnSpqmWn.jpg\",\"rating\":6.9,\"year\":2026,\"type\":\"movie\",\"overview\":\"Ry, a college student with a chronic illness, escapes to Mallorca for the summer with her mother, where she unexpectedly falls for a local and begins to embrace living in the moment. But as her condition worsens and long-hidden family secrets come to light, everything she has found before summer's end is threatened.\",\"genres\":[\"Romance\",\"Drama\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"Z2EKgtxJ7MU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"qHCGs4mOmpU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"R91Dm9F-dg8\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}