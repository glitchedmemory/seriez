{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1146147,\"title\":\"A Really Haunted Loud House\",\"tagline\":\"\",\"overview\":\"Lincoln and his best friend, Clyde, struggle to decide whether to participate in the Loud family Spooktacular, attend their friend, Xander's, party, or go trick-or-treating on Halloween.\",\"poster\":\"https://image.tmdb.org/t/p/w780/3TT1na5ox9EfWrRiWfmjIysIN81.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/iOYZbQA4wiMHoVSECQfZSvny6Nw.jpg\",\"rating\":6.7,\"voteCount\":28,\"year\":2023,\"runtime\":72,\"genres\":[\"TV Movie\",\"Comedy\",\"Family\",\"Horror\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":0,\"revenue\":0,\"director\":\"Jonathan Judge\",\"cast\":[{\"id\":228732,\"name\":\"Jonathan Judge\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/wp92hrQc213wfnXvqZmbqHG4R3u.jpg\"},{\"id\":3209765,\"name\":\"Wolfgang Schaeffer\",\"character\":\"Lincoln Loud\",\"photo\":\"https://image.tmdb.org/t/p/w780/7WQPuZnYkk3GWdJkxnmaPZVBJPh.jpg\"},{\"id\":2241218,\"name\":\"Jahzir Bruno\",\"character\":\"Clyde McBride\",\"photo\":\"https://image.tmdb.org/t/p/w780/hOcGEUz1QUsNUTCTIwOpSRn5olP.jpg\"},{\"id\":146391,\"name\":\"Brian Stepanek\",\"character\":\"Lynn Loud Sr.\",\"photo\":\"https://image.tmdb.org/t/p/w780/oxBgwkiEZtoHE4Uqi7GMwM3sK9x.jpg\"},{\"id\":51753,\"name\":\"Jolie Jenkins\",\"character\":\"Rita Loud\",\"photo\":\"https://image.tmdb.org/t/p/w780/w981tkMy3mj7zCtQS8brx1f2XmI.jpg\"},{\"id\":1362853,\"name\":\"Lexi DiBenedetto\",\"character\":\"Lori Loud\",\"photo\":\"https://image.tmdb.org/t/p/w780/sBRQVEkJkJQ2WpAiO0Ikkd0fnb0.jpg\"},{\"id\":2274742,\"name\":\"Eva Carlton\",\"character\":\"Leni Loud\",\"photo\":\"https://image.tmdb.org/t/p/w780/rXFYhfUpjoTRHxkJLf6J0632fQ1.jpg\"},{\"id\":1633076,\"name\":\"Sophia Woodward\",\"character\":\"Luna Loud\",\"photo\":\"https://image.tmdb.org/t/p/w780/iJ2vie4G3P8Abz0vbjz310rifs4.