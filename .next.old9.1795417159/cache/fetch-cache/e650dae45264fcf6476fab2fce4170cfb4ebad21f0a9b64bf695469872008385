ter\":\"https://image.tmdb.org/t/p/w780/hMpInGHQCFTlMBFjy3w1VEGZQcP.jpg\",\"rating\":5,\"year\":2026,\"type\":\"tv\",\"_score\":0.40681818181818186,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/dTc9MC4oHkBCfTp40yW3SMhlt5m.jpg\",\"seasonAirDate\":\"2024-10-12\",\"episodes\":[{\"number\":1,\"name\":\"Act 1\",\"overview\":\"Jeong-nyeon is a gifted singer. Desperate to escape her life, she discovers the world of gukgeuk.\",\"still\":\"https://image.tmdb.org/t/p/w780/eHPZeKGQpKrO4feaeDr70Ptu8Dy.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-12\",\"runtime\":71},{\"number\":2,\"name\":\"Act 2\",\"overview\":\"Jeong-nyeon is accepted into Maeran Gukgeukdan and must now prove she deserves to stay.\",\"still\":\"https://image.tmdb.org/t/p/w780/vlVff3d9TMFrz4ZDNzPRalCmVVh.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-13\",\"runtime\":68},{\"number\":3,\"name\":\"Act 3\",\"overview\":\"As she struggles to play a character, Jeong-nyeon faces a sudden crisis during her first performance.\",\"still\":\"https://image.tmdb.org/t/p/w780/f28lGFsSdHtmxxhJqOJ1Xn2ku3T.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-19\",\"runtime\":71},{\"number\":4,\"name\":\"Act 4\",\"overview\":\"It's discovered that Jeong-nyeon works at the coffee shop. She then discovers Young-seo's secret.\",\"still\":\"https://image.tmdb.org/t/p/w780/oXwUgixxuApL9KQcL9r0c4tEi5i.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-20\",\"runtime\":70},{\"number\":5,\"name\":\"Act 5\",\"overview\":\"Jeong-nyeon is shocked about her mother's secret and Jong-kook's ill intent right before her debut.\",\"still\":\"https://image.tmdb.org/t/p/w780/2RUb6Xqq6hnyOS2vIKJhqE5K7Kq.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-26\",\"runtime\":72},{\"number\":6,\"name\":\"Act 6\",\"overview\":\"Jeong-nyeon feels strange about Joo-ran and Young-seo getting closer and makes a huge mistake on stage.\",\"still\":\"https://image.tmdb.org/t/p/w780/jvBZ8BG1TqD1okM4WxTc9a2d1qu.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-27\",\"runtime\":62},{\"number\":7,\"name\":\"Act 7\",\"overview\":\"Banned from performing, Jeong0nyeon realizes her mistake. Meanwhile, Joo-ran is unexpectedly injured.\",\"still\":\"https://image.tmdb.org/t/p/w780/xZ2wqUOn9SHQ7pp9bioAAXBhCVQ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-02\",\"runtime\":72},{\"number\":8,\"name\":\"Act 8\",\"overview\":\"The pressure from the audition becomes too much for Jeong-nyeon, and she makes a dangerous choice.\",\"still\":\"https://image.tmdb.org/t/p/w780/2n1Wwo16jezo4KcGRxUa3VV0O2d.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-03\",\"runtime\":63},{\"number\":9,\"name\":\"Act 9\",\"overview\":\"Jeong-nyeon collapses and several issues within and out of Maeran jeopardize the joint performance.\",\"still\":\"https://image.tmdb.org/t/p/w780/5BWbS8S2Enn8BrzwaQzq8AxOK4j.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-09\",\"runtime\":67},{\"number\":10,\"name\":\"Act 10\",\"overview\":\"So-bok and Young-seo pour out their feelings in Mokpo. Yong-rye makes a brave decision for Jeong-nyeon.\",\"still\":\"https://image.tmdb.org/t/p/w780/s70T9ZHu2r7GA9DBOAoTSZ3EZG2.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-10\",\"runtime\":69},{\"number\":11,\"name\":\"Act 11\",\"overview\":\"Jeong-nyeon returns to a troupe in disarray. So-bok collapses and Joo-ran makes an announcement.\",\"still\":\"https://image.tmdb.org/t/p/w780/p6VnrUZvJ7cKaU0ubRVDKia1uq4.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-16\",\"runtime\":69},{\"number\":12,\"name\":\"Act 12\",\"overview\":\"Curtains rise on Jeong-nyeon and Young-seo's final competition to decide the new gukgeuk prince.\",\"still\":\"https://image.tmdb.org/t/p/w780/qXWBREQYaDoD3OsJatGuuc33VGl.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-11-17\",\"runtime\":75}],\"firstAirDate\":\"2024-10-12\"