{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":332434,\"title\":\"The Aquabats! RadVentures!\",\"tagline\":\"\",\"overview\":\"A continuation of the Emmy Award–winning children’s series The Aquabats! Super Show!, this web spin-off features shorter, fast-paced episodes packed with new villains, guest stars, and music-fueled antics from The Aquabats. Designed as bite-sized adventures for online release, RadVentures! carries forward the show’s offbeat superhero comedy and family-friendly chaos.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/jP8KqhxncZT7qshoCDmlofD7yaX.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/yhBvMvVcBGQQT1C4Pza4InG4QfG.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":2019,\"genres\":[\"Action & Adventure\",\"Comedy\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":1,\"totalEpisodes\":12,\"createdBy\":[],\"networks\":[],\"countries\":[{\"code\":\"US\",\"name\":\"US\"}],\"lastAirDate\":\"2025-02-22\",\"cast\":[{\"id\":159714,\"name\":\"Christian Jacobs\",\"character\":\"The M.C. Bat Commander\",\"photo\":\"https://image.tmdb.org/t/p/w780/xW1trJYxEQ4SesKpHQjlWOaQzTK.jpg\"},{\"id\":2265712,\"name\":\"Chad Larson\",\"character\":\"Crash McLarson\",\"photo\":null},{\"id\":2265713,\"name\":\"James R. Briggs, Jr\",\"character\":\"Jimmy The Robot\",\"photo\":null},{\"id\":2265714,\"name\":\"Richard Falomir\",\"character\":\"Ricky Fitness\",\"photo\":null},{\"id\":2265715,\"name\":\"Ian Fowles\",\"character\":\"Falcon Hawk\",\"photo\":null}],\"trailers\":[{\"key\":\"di1Q6rKKTns\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"b5L4Mw19SLg\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"5BsxDRTHNbk\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":60590,\"title\":\"Popadoodledandy\",\"poster\":\"https://image.tmdb.org/t/p/w780/uqwxc0RPim0Ty44xzZoHEDUAgf.j