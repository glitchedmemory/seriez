{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":596812,\"title\":\"Supermum\",\"tagline\":\"\",\"overview\":\"The protagonist of the play, an old lady, due to her old age and an accident that resulted in her fall, caused her children to begin feuding one another for the family’s fortune. While some are pressured due to their living environment, others just hope to live a simple life. After a series of events however, the siblings choose to hurt one another and ignore the importance of being a family. In the end, with the help of the old lady’s teachings and her unyielding faith in family principles, the ending of the story changed for the better…\",\"poster\":\"https://image.tmdb.org/t/p/w780/nqyMu7njbXw98jegWkdC4vsw6vX.jpg\",\"backdrop\":null,\"rating\":0,\"voteCount\":0,\"year\":2019,\"runtime\":0,\"genres\":[],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[],\"budget\":0,\"revenue\":0,\"director\":\"\",\"cast\":[{\"id\":2294268,\"name\":\"Eliza Wong\",\"character\":\"Unknown\",\"photo\":null},{\"id\":2294269,\"name\":\"Remon Lim\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/xQQPDazLpRU8c2fRsA4vfEa0iD4.jpg\"},{\"id\":566040,\"name\":\"Joey Leong\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/dhLwCsgk3zMFdOF0P0FRZJuSEjV.jpg\"}],\"similar\":[],\"videos\":[{\"key\":\"XNekQjU0uZ0\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"lmehG5cRD48\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"RkeZeFZc8II\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}