{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":67732,\"title\":\"Woodsmith Shop\",\"tagline\":\"\",\"overview\":\"The Woodsmith Shop is designed to help you get the most out of your woodworking shop with helpful tips and techniques. Whether viewers are just starting out or have been woodworking for years, they'll find something new in every episode.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/A2cT0MxCHTIBrZIve5hZj0nAizF.jpg\",\"backdropPath\":null,\"youtubeBackdrop\":\"https://img.youtube.com/vi/0xMqV-Gsznc/maxresdefault.jpg\",\"anilistBanner\":null,\"rating\":5.5,\"voteCount\":2,\"year\":2007,\"genres\":[\"Reality\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":19,\"totalEpisodes\":221,\"createdBy\":[\"Don Peschke\"],\"networks\":[],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2023-10-27\",\"cast\":[],\"trailers\":[{\"key\":\"0xMqV-Gsznc\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"12tbKLZc_EQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"Qd10WERYMjs\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":97655,\"title\":\"Classic Woodworking\",\"poster\":\"https://image.tmdb.org/t/p/w780/goGYVomZXjqTJDLyRjLQ5TtxTEd.jpg\",\"rating\":0,\"year\":2018,\"type\":\"tv\",\"_score\":0.43529411764705883,\"_genreOverlap\":1},{\"id\":61779,\"title\":\"Framework\",\"poster\":\"https://image.tmdb.org/t/p/w780/bd9kcH7xIdEH9q7SnD0bO2D8kBC.jpg\",\"rating\":4.7,\"year\":2015,\"type\":\"tv\",\"_score\":0.4227848101265823,\"_genreOverlap\":1},{\"id\":2351,\"title\":\"TransGeneration\",\"poster\":\"https://image.tmdb.org/t/p/w780/cckeDldsr3JCFTp5hmyNRs5eLVX.jpg\",\"rating\":6.1,\"year\":2005,\"type\":\"tv\",\"_score\":0.4206896551724138,\"_genreOverlap\":1},{\"id\":327624,\"title\":\"The Reclaimers: Made in Suffolk\",\"poster\":\"https://image.tmdb.org/t/p/w780/nJAAREOpLJtULyDAPf5ngWd8y58.jpg\",\"rating\":5.5,\"year\":2026,\"type\":\"tv\",\"_score\":0.42000000000000004,\"_genreOverlap\":1},{\"id\":217695,\"title\":\"The Woodland Workshop\",\"poster\":\"https://image.tmdb.org/t/p/w780/eAJbnzDN6zemQ9fxLX26MRkiJvs.jpg\",\"rating\":2,\"year\":2022,\"type\":\"tv\",\"_score\":0.4076923076923077,\"_genreOverlap\":1}],\"seasonNumber\":11,\"seasonName\":\"Season 11\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/A2cT0MxCHTIBrZIve5hZj0nAizF.jpg\",\"seasonAirDate\":\"2017-09-19\",\"episodes\":[{\"number\":1,\"name\":\"Details of Craftsmanship\",\"overview\":\"The Woodsmith editors begin their newest project, a dresser-top valet, by creating small joinery at the router table.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-09-19\",\"runtime\":0},{\"number\":2,\"name\":\"Small Project Assembly\",\"overview\":\"The details of assembling a small project successfully are covered. Plus, large scale joinery takes center stage when they begin a tower bookcase.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-09-26\",\"runtime\":0},{\"number\":3,\"name\":\"Adding Details & Tower Bookcase Assembly\",\"overview\":\"Custom liners are fitted to the dresser-top valet. Then watch as the Woodsmith editors bring the parts of the tower bookcase together.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-03\",\"runtime\":0},{\"number\":4,\"name\":\"Curved Lids & Face Frames\",\"overview\":\"A curved lid provides the final touch to the dresser-top valet. Then learn the key details the editors of Woodsmith use for building a solid face frame.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-10\",\"runtime\":0},{\"number\":5,\"name\":\"Combination Router Table & Custom Molding\",\"overview\":\"The Woodsmith editors begin a combination router table that adds more capability to any shop. Custom trim and moldings dress up the tower bookcase.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-17\",\"runtime\":0},{\"number\":6,\"name\":\"Router Table Cabinet & Final Details\",\"overview\":\"The editors of Woodsmith round out the cabinet of the router table by adding storage and doors. Plus, they wrap up the tower bookcase.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-24\",\"runtime\":0},{\"number\":7,\"name\":\"Router Table Top\",\"overview\":\"Join the Woodsmith editors as they build a heavy-duty top for the combination router table. Then get the details on creating tenons as they talk shop.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-31\",\"runtime\":0},{\"number\":8,\"name\":\"Scalloped Lid Box\",\"overview\":\"The Woodsmith editors add a router table insert to the completed tabletop. Then discover a simple technique for creating a scalloped lid for a decorative box.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-07\",\"runtime\":0},{\"number\":9,\"name\":\"Horizontal Routing\",\"overview\":\"Add versatility to the combination router table with an easy-to-build horizontal table. Follow along as the editors make a carved lid for the decorative box.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-14\",\"runtime\":0},{\"number\":10,\"name\":\"Mortising Jig & Box Assembly\",\"overview\":\"A mortising jig is a great option for the combination router table. Plus, the Woodsmith editors cover the details of making a mitered box.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-21\",\"runtime\":0},{\"number\":11,\"name\":\"Tray Centerpiece & Table Saw Sleds\",\"overview\":\"An elegant tray centerpiece starts from a single block of wood. And get better results at your table saw with a crosscut sled you can build in an afternoon.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-28\",\"runtime\":0},{\"number\":12,\"name\":\"Project Wrap-Up\",\"overview\":\"Watch the Woodsmith editors step through the final details of making the tray centerpiece. Then they make a table saw sled even more versatile.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-12-05\",\"runtime\":0},{\"number\":13,\"name\":\"Classic Tips & Tricks\",\"overview\":\"The editors of Woodsmith magazine wrap up the season with a series of tips and tricks segments covering the full range of woodworking topics.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-12-12\",\"runtime\":0}],\"firstAirDate\":\"2007-10-05\"}","status":200,"url":""},"revalidate":86400,"tags":[]}