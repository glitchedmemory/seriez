{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":295,\"title\":\"Sean's Show\",\"tagline\":\"\",\"overview\":\"Sean's Show was a United Kingdom television situation comedy broadcast on Channel 4. Stand-up comedian Sean Hughes co-wrote and starred as a fictionalised version of himself, aware of the fact he was living in a sitcom.\\n\\nIt received a nomination for the 1992 British Comedy Award for Best Channel 4 Sitcom.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/s0RRAXn3YWAvvZ6TY5GLiK0iR8f.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/lMSMf04GfPXtFgPK9a5jvd6rNIj.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6,\"voteCount\":5,\"year\":1992,\"genres\":[\"Comedy\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":14,\"createdBy\":[\"Sean Hughes\"],\"networks\":[\"Channel 4\"],\"countries\":[{\"code\":\"GB\",\"name\":\"GB\"}],\"lastAirDate\":\"1993-12-29\",\"cast\":[{\"id\":109932,\"name\":\"Sean Hughes\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/guRle1OWp1MggljWTzhO8GTyL6e.jpg\"},{\"id\":4318,\"name\":\"Victor McGuire\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/tJBZU4NrQWYFxtPs0ltqOuQgW9K.jpg\"},{\"id\":1215275,\"name\":\"Michael Troughton\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/coeVOHgXPrerg8XItZnNjr7hvzs.jpg\"},{\"id\":164549,\"name\":\"Eileen Way\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/1ozoZtVIgFKBj1w6ggboU97SaQ9.jpg\"},{\"id\":1215277,\"name\":\"Owen O'Neill\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/x1Q3LgUcIL9RjFl3jX3RSOz5bz0.jpg\"}],\"trailers\":[{\"key\":\"dOrdOx8hCAc\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"tWl4jhn6tzw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"O4zPkiDgHKQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":