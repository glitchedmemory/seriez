{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":980431,\"title\":\"Avatar Aang: The Last Airbender\",\"tagline\":\"The legacy reawakens.\",\"overview\":\"Avatar Aang, the world's last Airbender, learns of an ancient power that could save his culture from extinction. With the help of his friends, he embarks on a global quest to find it before it falls into the wrong hands and threatens to upend the peace they sacrificed everything to achieve.\",\"poster\":\"https://image.tmdb.org/t/p/w780/3sgnSfNT27Bx5O5ukr7B26mhEQq.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/ezbrL1dMymKQZw7mDEWa2ZTzN7d.jpg\",\"rating\":9,\"voteCount\":1471,\"year\":2026,\"runtime\":99,\"genres\":[\"Animation\",\"Adventure\",\"Fantasy\",\"Action\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"},{\"code\":\"KR\",\"name\":\"South Korea\"},{\"code\":\"AU\",\"name\":\"Australia\"}],\"budget\":0,\"revenue\":0,\"director\":\"Lauren Montgomery\",\"cast\":[{\"id\":74863,\"name\":\"Lauren Montgomery\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/tKq2IYbMr5pHrWMS99fCXQbVlrt.jpg\"},{\"id\":1610783,\"name\":\"Eric Nam\",\"character\":\"Aang (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/gEH0b5q9tupL49dmUFkjm9dnxP2.jpg\"},{\"id\":543530,\"name\":\"Dave Bautista\",\"character\":\"Tagah (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/snk6JiXOOoRjPtHU5VMoy6qbd32.jpg\"},{\"id\":1703912,\"name\":\"Jessica Matten\",\"character\":\"Katara (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/EQsPxsav8AZmaeT3mpU3Evilee.jpg\"},{\"id\":2775164,\"name\":\"Román Zaragoza\",\"character\":\"Sokka (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/uWkOkSLqj2POMqkeLk5E5UJzebv.jpg\"},{\"id\":215055,\"name\":\"Steven Yeun\",\"character\":\"Zuko (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/fOMFO2Xx4duzpNgS9Q5ytO44yGb.jpg\"},{\"id\":86432,\"name\":\"Dionne Quan\",\"character\":\"Toph (voice)\",\"pho