score\":0.4041666666666667,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"Female soccer teams comprised of celebrities and non-celebrities, working together to battle it out on the soccer field.\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/sLP7lWtm2uD6E34tN7VXXrj2lf7.jpg\",\"seasonAirDate\":\"2021-06-16\",\"episodes\":[{\"number\":1,\"name\":\"What Kind of Woman Plays Soccer?\",\"overview\":\"The new season of “Shooting Stars” begins with two more new teams joining the league, FC World Class and FC Actionista. And finally, the opening match of “Shooting Stars” begins today between FC World Class and FC Tiger Moth. Check out which team achieves the first victory of the season!\",\"still\":\"https://image.tmdb.org/t/p/w780/rjWMK0abQQzfNb6irahjcDWkrtA.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-06-16\",\"runtime\":100},{\"number\":2,\"name\":\"There are No Eternal Losers and Winners in Soccer\",\"overview\":\"At last, the first games for Group A and Group B begin! The players are stronger and better than they were during the New Year's Special. Will they make some goals and show their improvements in the game today?\",\"still\":\"https://image.tmdb.org/t/p/w780/mxcCFc4qBipxe8EysKVqmjtIuWV.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-06-23\",\"runtime\":100},{\"number\":3,\"name\":\"Eat, Pray and Play Soccer\",\"overview\":\"It’s FC Giants against FC National Team Family! Soon after the game begins, Hye Jin, the captain, scores their glorious first goal. The National Team Family is taken back by her unexpected goal, but they also manage to score just before the game ends. And so, the two teams’ fate relies on the shoot-out.\",\"still\":\"https://image.tmdb.org/t/p/w780/m4pVAQoFEl6QnsFDvUFCh93BiLx.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-06-30\",\"runtime\":100},{\"number\":4,\"name\":\"The Strong One Does Not Win, But the Winning One is Strong\",\"overview\":\"Finally, the return match of FC Gaevengers against FC Fire Moth takes place! FC Gaevengers lost to FC Fire Moth in the final match of the New Year's special by 2 to 0. With Kim Min Kyoung newly joined, the Gaevengers have practiced restlessly for their revenge. Check out if they can avenge themselves on FC Fire Moth, one of the strongest teams in the league!\",\"still\":\"https://image.tmdb.org/t/p/w780/jhj86ny79pfeUzhw4M97yK7fB3H.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-07-07\",\"runtime\":100},{\"number\":5,\"name\":\"There is Always a Game That a Soccer Team Must Win!\",\"overview\":\"Na Mi gets emotional by Coach Hwang's message on the way to the hospital. And now, the last match of Group A begins. It will decide the team that will be eliminated. And FC World Class must win to make it to the tournament. As the game proceeds, Kyung Sil and Young Mi get injured. Which team would get eliminated in the end?\",\"still\":\"https://image.tmdb.org/t/p/w780/2BOLJgqE1jAyL2is6ZuWpAcBBBn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-07-14\",\"runtime\":100},{\"number\":6,\"name\":\"When was the Best Moment of Your Life?\",\"overview\":\"FC Actionista makes their debut! The team consists of fit players who are very experienced with all kinds of sports. As it’s their first game, the players are nervous. On the other hand, if FC Giants lose this game, they will be eliminated and never make it to the tournament. Which team would take their first victory?\",\"still\":\"https://image.tmdb.org/t/p/w780/vf5ybwqjbeziraddDxeirTR12YP.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-07-21\",\"runtime\":100},{\"number\":7,\"name\":\"Episode 7\",\"overview\":\"The last game of Group B that will decide the team to be eliminated now begins. Both FC Actionista and FC National Team Family are on edge. Myoung Seo Hyun of FC National Team Family scores the first goal of the game. During the fierce match, Jang Jin Hee gets her head injured, and Nam Hyun Hee falls. Which team would be eliminated after this match?\",\"still\":\"https://image.tmdb.org/t/p/w780/mvwwEBDTtTz8hNF7ZBSsFl7Wwd.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-08-11\",\"runtime\":100},{\"number\":8,\"name\":\"Episode 8\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/yg9ZfCZ2IptFAsF9HeLTkBTc9k9.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-08-18\",\"runtime\":100},{\"number\":9,\"name\":\"Episode 9\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/Awy4cwrOVOiUuisAQUNk9QeXnFK.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-08-25\",\"runtime\":100},{\"number\":10,\"name\":\"Episode 10\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/wOUHjZqRxBq9PGOkDHuKro3zWJ3.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-09-01\",\"runtime\":100},{\"number\":11,\"name\":\"Episode 11\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-09-08\",\"runtime\":100},{\"number\":12,\"name\":\"Episode 12\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-09-15\",\"runtime\":100},{\"number\":13,\"name\":\"Episode 13\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-09-22\",\"runtime\":100},{\"number\":14,\"name\":\"Episode 14\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-09-29\",\"runtime\":100},{\"number\":15,\"name\":\"Episode 15\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-10-06\",\"runtime\":100},{\"number\":16,\"name\":\"Episode 16\",\"overview\":\"\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-10-13\",\"runtime\":100},{\"number\":17,\"name\":\"Episode 17\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/gtmNQJT96Ixl6Mqr1iY5m3hd1P7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-10-20\",\"runtime\":100},{\"number\":18,\"name\":\"Episode 18\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/52kO5bHVYwZJk9nUvLwUJ5Pryjh.jpg\