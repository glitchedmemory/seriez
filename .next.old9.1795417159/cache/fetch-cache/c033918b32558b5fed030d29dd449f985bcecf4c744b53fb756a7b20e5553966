p/w780/12vvTklZaXHSvfyuQMoi8HuHbh4.jpg\",\"rating\":7.5,\"year\":2015,\"type\":\"tv\",\"_score\":0.41190476190476194,\"_genreOverlap\":2},{\"id\":283818,\"title\":\"A Star Brighter than the Sun\",\"poster\":\"https://image.tmdb.org/t/p/w780/tMCyjS1Qif5VhmRakSJpF0TzdQj.jpg\",\"rating\":7.5,\"year\":2025,\"type\":\"tv\",\"_score\":0.4100840336134454,\"_genreOverlap\":2},{\"id\":63453,\"title\":\"Garo: The Animation\",\"poster\":\"https://image.tmdb.org/t/p/w780/cl9x83myIZtDSqHPu4WMekKt7E0.jpg\",\"rating\":7.3,\"year\":2014,\"type\":\"tv\",\"_score\":0.40923076923076923,\"_genreOverlap\":2},{\"id\":247045,\"title\":\"Nyaight of the Living Cat\",\"poster\":\"https://image.tmdb.org/t/p/w780/lF2awNMJIasAZsSy2XzFlYGtzKW.jpg\",\"rating\":7.3,\"year\":2025,\"type\":\"tv\",\"_score\":0.4090909090909091,\"_genreOverlap\":2},{\"id\":63576,\"title\":\"Fate/kaleid liner Prisma Illya\",\"poster\":\"https://image.tmdb.org/t/p/w780/fivwHxH3xddSkSyqonXtuydBpIY.jpg\",\"rating\":6.7,\"year\":2013,\"type\":\"tv\",\"_score\":0.4088888888888889,\"_genreOverlap\":2},{\"id\":283884,\"title\":\"Chuhai Lips: Canned Flavor of Married Women\",\"poster\":\"https://image.tmdb.org/t/p/w780/sVgDf52QbkKRYBXjM4Y2xQOr86X.jpg\",\"rating\":5.6,\"year\":2025,\"type\":\"tv\",\"_score\":0.4065934065934066,\"_genreOverlap\":2},{\"id\":63322,\"title\":\"Superb Song of the Valkyries: Symphogear\",\"poster\":\"https://image.tmdb.org/t/p/w780/g0jsgViN4aBybkgTmr4XgZHluxX.jpg\",\"rating\":6.9,\"year\":2012,\"type\":\"tv\",\"_score\":0.22109375,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"After having fought over Share energy for many years, the Goddesses signed a treaty which forbids each from taking Share energy from the other using forceful means. As a result of Neptune's laziness, Planeptune's shares steadily decline, and Histoire sends Neptune off to find a way to remedy the situation.\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/5LY7socoCOS9zfGQW4ZFaeJNIoF.jpg\",\"seasonAirDate\":\"2013-07-12\",\"episodes\":[{\"number\":1,\"name\":\"The Goddess (Neptune) of Planeptune\",\"overview\":\"After long years of war, peace has finally come to Gamindustri. As usual, though, the goddess of Planeptune is a little TOO peaceful--gaming is so much more fun than running a country! With the Console Wars over, will the next war be Neptune vs. inertia?!\",\"still\":\"https://image.tmdb.org/t/p/w780/bpY4bWLKuIMyXKPv8nFvCqPzBSm.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-07-12\",\"runtime\":24},{\"number\":2,\"name\":\"The Terrorist (Lickorist) of Lowee\",\"overview\":\"A day at the amusement park takes a sinister turn when two (mostly) innocent girls are kidnapped by a monster. And then a stranger with a camera crew barges into the Basilicom, and things kinda start to get weird.\",\"still\":\"https://image.tmdb.org/t/p/w780/aVWEN4ecncHhwnMFelETTVPf3zE.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-07-19\",\"runtime\":24},{\"number\":3,\"name\":\"A Weekend (Girls' Night) in Leanbox\",\"overview\":\"Vert offers to throw all the goddesses a party in Leanbox, but when they arrive, she's busy with another kind of party. Then, just as the celebration finally begins, the Basilicom staff reports a monster invasion that has all the CPUs leaping to action.\",\"still\":\"https://image.tmdb.org/t/p/w780/eNc8rqAFHc8xtKHhG7ksdscEE7d.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-07-26\",\"runtime\":24},{\"number\":4,\"name\":\"The Sisters' Resolve (Turn)\",\"overview\":\"Nepgear, Uni, Rom, and Ram are instructed to go back home after their sisters' capture, but they can't bear to leave their families behind in danger. To get back their sisters, they'll have to learn how to transform into goddesses themselves.\",\"still\":\"https://image.tmdb.org/t/p/w780/cyn6BY6NxfAFmP5FjlSV5ACFKKa.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-08-02\",\"runtime\":24},{\"number\":5,\"name\":\"The Goddesses' Resonance (Over Limit)\",\"overview\":\"It's the little sisters to the rescue as Nepgear leads the charge against Arfoire's monsters. But with their older sisters sinking further into darkness every second, can they do anything in time to help?\",\"still\":\"https://image.tmdb.org/t/p/w780/2Zh2Hy8ZJUbPigraJ5xgKXaPjYd.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-08-09\",\"runtime\":24},{\"number\":6,\"name\":\"Lastation's Secret (For Your Eyes Only)\",\"overview\":\"Noire's up to something at night behind closed doors, and Uni's dying to know what it is. Luckily, she's got tech expert Nepgear to help her out. But as it turns out, Uni's not the only one interested in what Noire's doing.\",\"still\":\"https://image.tmdb.org/t/p/w780/2PL4LsOkrLWi5a8Npn2XTizBzL3.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-08-16\",\"runtime\":24},{\"number\":7,\"name\":\"The Fruit (Deep Purple) of Revenge\",\"overview\":\"The gang learns more about Plutia, and Neptune's very worst, most hated enemy appears.\",\"still\":\"https://image.tmdb.org/t/p/w780/zRLFZsFrkxh3TCMvPt8jWnkuz1m.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-08-23\",\"runtime\":24},{\"number\":8,\"name\":\"The Forbidden Paradise (Island)\",\"overview\":\"The CPUs visit an adults-only island full of forbidden pleasures--for work reasons, of course. Meanwhile, Peashy is stuck at home sulking after a fight with Neptune.\",\"still\":\"https://image.tmdb.org/t/p/w780/iOso9fMRRij7NYkYjEoyhlZbwe3.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-08-30\",\"runtime\":24},{\"number\":9,\"name\":\"The Challenge (Rebellion) of Eden\",\"overview\":\"Neptune's maybe having a tiny bit of trouble bouncing back, and Plutia's maybe getting a tiny bit irritated about it. Soon, though, Gamindustri finds itself facing a problem even bigger than Plutia's rage...\",\"still\":\"https://image.tmdb.org/t/p/w780/1ygzI1iFAsD3dNZmPY7rdsWeG4F.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-09-06\",\"runtime\":24},{\"number\":10,\"name\":\"The Battlefront (Conflict) of Oblivion\",\"overview\":\"Eden acts on its bold proclamation and invades Planeptune, but Neptune is too upset to fight, leaving Nepgear on her own. The other CPUs aren't able to run much interference, though, because they've got Eden problems of their own too.\",\"still\":\"https://image.tmdb.org/t/p/w780/kBZ96HKY3TSh1HzFKI3OBCqdYVP.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-09-13\",\"runtime\":24},{\"number\":11,\"name\":\"The Messenger (Aggressor) from the Past\",\"overview\":\"All the problems with Eden are over, and the world is finally at peace again--but not everyone is happy about that. Now the nations' Shares are drastically unbalanced, and that never leads to anything good...\",\"still\":\"https://image.tmdb.org/t/p/w780/AbpiBxvQL6KC0sSdM0tbgqapzcI.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-09-20\",\"runtime\":24},{\"number\":12,\"name\":\"The Ties (Bifrosts) of Tomorrow\",\"overview\":\"It's the final battle, and the fate of Gamindustri is on the line!\",\"still\":\"https://image.tmdb.org/t/p/w780/yrdy4t3sszpux9dpCBHjHWbAUDz.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2013-09-27\",\"runtime\":24}],\"firstAirDate\":\"2013-07-12\"}","status":200,"url":""},"revalidate":86400,"tags":[]}