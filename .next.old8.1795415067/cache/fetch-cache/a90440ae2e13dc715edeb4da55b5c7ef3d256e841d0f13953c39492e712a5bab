,\"type\":\"tv\",\"_score\":0.22195121951219512,\"_genreOverlap\":1},{\"id\":63692,\"title\":\"I Have a Lover\",\"poster\":\"https://image.tmdb.org/t/p/w780/pp2IEuWWnNeorMNcE5wVk8IIujQ.jpg\",\"rating\":4.3,\"year\":2015,\"type\":\"tv\",\"_score\":0.2103448275862069,\"_genreOverlap\":1},{\"id\":283885,\"title\":\"Up in the Air\",\"poster\":\"https://image.tmdb.org/t/p/w780/ditJcw2eNajZfJP2HrBWShquUQt.jpg\",\"rating\":0,\"year\":2025,\"type\":\"tv\",\"_score\":0.2057692307692308,\"_genreOverlap\":1},{\"id\":2876,\"title\":\"Ninpuu Sentai Hurricaneger\",\"poster\":\"https://image.tmdb.org/t/p/w780/AWddI4rGUkOTO9HjbrTPeLgKEI.jpg\",\"rating\":8.4,\"year\":2002,\"type\":\"tv\",\"_score\":0.20535714285714288,\"_genreOverlap\":1},{\"id\":2766,\"title\":\"Inconceivable\",\"poster\":\"https://image.tmdb.org/t/p/w780/8Zs8DF9JKxTvwXVdLhZqkuJ5mY4.jpg\",\"rating\":9,\"year\":2005,\"type\":\"tv\",\"_score\":0.20441176470588238,\"_genreOverlap\":1},{\"id\":2756,\"title\":\"Heartland\",\"poster\":\"https://image.tmdb.org/t/p/w780/x9BA5GJyCzDrVf2Nkhi9Kf1fmcL.jpg\",\"rating\":6.5,\"year\":2007,\"type\":\"tv\",\"_score\":0.20434782608695654,\"_genreOverlap\":1},{\"id\":2761,\"title\":\"Calla Lily\",\"poster\":null,\"rating\":0,\"year\":2006,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1},{\"id\":63311,\"title\":\"Yong Pal\",\"poster\":\"https://image.tmdb.org/t/p/w780/x2oJBuehtxyPHy1KGxOPBFxhuvC.jpg\",\"rating\":7.4,\"year\":2015,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1},{\"id\":2961,\"title\":\"It's All Relative\",\"poster\":\"https://image.tmdb.org/t/p/w780/wp2FV4YcfmFojT2MoVKt8sVpQHK.jpg\",\"rating\":5.5,\"year\":2003,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"Twenty years after leaving her medical career, a housewife returns as a first-year resident — struggling to find her footing in a job full of surprises.\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/nXyBG35lorZnRio71278EmR0ygH.jpg\",\"seasonAirDate\":\"2023-04-15\",\"episodes\":[{\"number\":1,\"name\":\"Episode 1\",\"overview\":\"Cha Jeong-suk witnesses a frightening incident and freezes amid the chaos. She later receives a scary diagnosis — sending Seo In-ho into a spiral.\",\"still\":\"https://image.tmdb.org/t/p/w780/ctEWnAG5kVkPpTLu56Wy6gheUyT.jpg\",\"rating\":8,\"voteCount\":3,\"airDate\":\"2023-04-15\",\"runtime\":62},{\"number\":2,\"name\":\"Episode 2\",\"overview\":\"Back from the brink of death, Jeong-suk decides to live life differently — claiming her independence by making an ambitious career move.\",\"still\":\"https://image.tmdb.org/t/p/w780/tvp8HoXds51u6uUWZXO9vSqNn14.jpg\",\"rating\":8.3,\"voteCount\":3,\"airDate\":\"2023-04-16\",\"runtime\":60},{\"number\":3,\"name\":\"Episode 3\",\"overview\":\"Jeong-suk's acceptance leaves In-ho and Choi Seung-hi reeling. Jeong-suk attempts to adjust to her new role — but finds opposition from all sides.\",\"still\":\"https://image.tmdb.org/t/p/w780/2vdzXySI4FrurMGiWjsnUQvVF5d.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-04-22\",\"runtime\":62},{\"number\":4,\"name\":\"Episode 4\",\"overview\":\"After an eventful night out, Jeong-suk gets closer with Roy Kim — irritating In-ho. At the hospital, she continues to struggle amid the chaos.\",\"still\":\"https://image.tmdb.org/t/p/w780/es5h1FeE1xAwyT4tswVteh9uDH3.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2023-04-23\",\"runtime\":64},{\"number\":5,\"name\":\"Episode 5\",\"overview\":\"Rumors surrounding Jeong-suk and In-ho's relations arise. After Seung-hi puts her through the ringer, Jeong-suk wonders if she's cut out for the job.\",\"still\":\"https://image.tmdb.org/t/p/w780/dHrcP8XRGCfXcHIHwX5GUzUQoCR.jpg\",\"rating\":7,\"voteCount\":2,\"airDate\":\"2023-04-29\",\"runtime\":61},{\"number\":6,\"name\":\"Episode 6\",\"overview\":\"Despite being singled out for praise, Jeong-suk faces belittlement from In-ho. Roy confronts In-ho about his behavior, later befriending Jeong-suk.\",\"still\":\"https://image.tmdb.org/t/p/w780/4k6fOZNWDMYDMXph1eD4KYoX9fQ.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-04-30\",\"runtime\":62},{\"number\":7,\"name\":\"Episode 7\",\"overview\":\"Jeong-suk clashes with In-ho about their daughter. She later finds evidence of her son's relationship. Seung-hi confronts Roy about his recent discovery.\",\"still\":\"https://image.tmdb.org/t/p/w780/d1PKvtkn53encaioostF9p5LtJW.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-05-06\",\"runtime\":61},{\"number\":8,\"name\":\"Episode 8\",\"overview\":\"In-ho panics after his secret is discovered. Confronted with conflicting requests, Roy faces a difficult decision. Jeong-suk begins connecting the dots.\",\"still\":\"https://image.tmdb.org/t/p/w780/c63yrpILk5XaPYcEymVGRiQoz07.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2023-05-07\",\"runtime\":62},{\"number\":9,\"name\":\"Episode 9\",\"overview\":\"Finally clued in on In-ho's secret, Jeong-suk begins acting erratically. After In-ho's mother pays her a visit, Seung-hi faces an emergency.\",\"still\":\"https://image.tmdb.org/t/p/w780/dF3hW67MCGBs4QDen4tzOTGmHfu.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-05-13\",\"runtime\":60},{\"number\":10,\"name\":\"Episode 10\",\"overview\":\"A public revelation leaves Jeong-suk in a tough spot. Seung-hi confronts In-ho about their future. Jeon So-ra lends Jeong-suk much-needed support.\",\"still\":\"https://image.tmdb.org/t/p/w780/qqMejjyKcEqjf7AupmykwVZtxBQ.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2023-05-14\",\"runtime\":61},{\"number\":11,\"name\":\"Episode 11\",\"overview\":\"Having reached her breaking point, Jeong-suk meets with Seung-hi and In-ho. Later, Roy and In-ho lock horns over their complicated emotions.\",\"still\":\"https://image.tmdb.org/t/p/w780/8r4oIAx1N4kopwN3eI4rIgfbgXY.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2023-05-20\",\"runtime\":60},{\"number\":12,\"name\":\"Episode 12\",\"overview\":\"Seung-hi clashes with In-ho after choosing to hold her ground. Seo Jung-min spirals after experiencing a tragedy. Jeong-suk makes a resolute decision.\",\"still\":\"https://image.tmdb.org/t/p/w780/5LmxjwBY9E3q1pS81lMw6EuQDbs.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2023-05-21\",\"runtime\":60},{\"number\":13,\"name\":\"Episode 13\",\"overview\":\"Jeong-suk attempts to move forward after making her decision — despite In-ho's persistence. Roy looks to find the truth about his family.\",\"still\":\"https://image.tmdb.org/t/p/w780/3UHiNJafi8KeOmJ6Shu4gW8KVKi.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2023-05-27\",\"runtime\":61},{\"number\":14,\"name\":\"Episode 14\",\"overview\":\"After finding out the truth, Jeong-suk's mother deals with her health. Seung-hi works hard to find a treatment. In-ho rebels against Jeong-suk's wishes.\",\"still\":\"https://image.tmdb.org/t/p/w780/nAU6d1bbmjedQim925T30sbe8gL.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2023-05-28\",\"runtime\":63},{\"number\":15,\"name\":\"Episode 15\",\"overview\":\"Jeong-suk learns shocking news that may bring her career to a halt. In-ho's mother panics about a looming situation — putting In-ho in a tough position.\",\"still\":\"https://image.tmdb.org/t/p/w780/4lnTazrdQr81Lp2Du8oTXTCNf3f.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-06-03\",\"runtime\":60},{\"number\":16,\"name\":\"Episode 16\",\"overview\":\"As everyone around her worries, Jeong-suk ties up her loose ends leading up to her procedure — all the while preparing for her future.\",\"still\":\"https://image.tmdb.org/t/p/w780/uhHcZEMSH0Tw46S6FM6KqsX21ZN.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-06-04\",\"runtime\":62}],\"firstAirDate\":\"2023-04-15\"}","status":200,"url":""},"revalidate":86400,"tags":[]}