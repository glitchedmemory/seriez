{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1918,\"title\":\"The Twilight Zone\",\"tagline\":\"\",\"overview\":\"This 1980s revival of the classic sci-fi series features a similar style to the original anthology series. Each episode tells a tale (sometimes two or three) rooted in horror or suspense, often with a surprising twist at the end. Episodes usually feature elements of drama and comedy.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/5OYHoUEKE3RJMqiHcJ8XA5kB7bw.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/fy9fhl09shpTLjw4IEqqmVMYM28.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":7.7,\"voteCount\":273,\"year\":1985,\"genres\":[\"Sci-Fi & Fantasy\",\"Drama\",\"Mystery\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":65,\"createdBy\":[\"Rod Serling\"],\"networks\":[\"CBS\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"1989-04-15\",\"cast\":[{\"id\":44130,\"name\":\"Paul Lynch\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/arkyMLYttuJEj5mTrwVhXJsROE1.jpg\"},{\"id\":21377,\"name\":\"Peter Medak\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/oUPjJXMOSomwrqFx4eobxROVZOV.jpg\"},{\"id\":5140,\"name\":\"Wes Craven\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/eqwl6owrYykeTGTpKxwcAkbEJmg.jpg\"},{\"id\":79726,\"name\":\"John D. Hancock\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/xRBi5ESLY2jSFKA30Vd0XJ0WBMt.jpg\"},{\"id\":101891,\"name\":\"Gus Trikonis\",\"character\":\"Director\",\"photo\":null},{\"id\":1212565,\"name\":\"Randy Bradshaw\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/bx9FpC2t8wZjzdfwNrOqKULuR8d.jpg\"},{\"id\":83319,\"name\":\"Ryszard Bugajski\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/hw1DZO9Y5FWRaHrvF8q6bccq8GF.jpg\"},{\"id\":63713,\"name\":\"Martha Coolidge\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/tJyj0LOfbsmKJRdHTJXW6kYX9nn.jpg\"},{\"id\":46891,\"name\":\"Gilbert M. Shilton\",\"character\":\"Director\",\"photo\":null},{\"id\":83996,\"name\":\"Bradford May\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/p7pC1Ih1sSPyN8qBXZl1dYeNDKT.jpg\"},{\"id\":8573,\"name\":\"Thomas J. Wright\",\"character\":\"Director\",\"photo\":null},{\"id\":1227996,\"name\":\"Paul Tucker\",\"character\":\"Director\",\"photo\":null},{\"id\":8626,\"name\":\"Gerd Oswald\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/qYZHmV2PforKqjdLK7VT4xAQonF.jpg\"},{\"id\":59874,\"name\":\"Robert Downey Sr.\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/akIXqQTWs3ILjo1ibd49cExC5z9.jpg\"},{\"id\":58075,\"name\":\"Bill L. Norton\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/aGB8BQCNJs2TrzCMtwdtqKYgJVK.jpg\"},{\"id\":109876,\"name\":\"Noel Black\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/bzRB0dax0ojGSdjZHKC4yIVkVR1.jpg\"},{\"id\":16187,\"name\":\"Jeannot Szwarc\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/cMRLZXHEDmeiUGsci5beLTUiSUs.jpg\"},{\"id\":225065,\"name\":\"René Bonnière\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/rKKIb8ajKMuJAXW6CaxkVmbXjfv.jpg\"},{\"id\":65548,\"name\":\"Rick Friedberg\",\"character\":\"Director\",\"photo\":null},{\"id\":144596,\"name\":\"Sheldon Larry\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/2IZBYbTtsupo5997MipQ04lHSj0.jpg\"},{\"id\":4600,\"name\":\"Joe Dante\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/2Aev68oWboAC31dj8eJnEUzH41x.jpg\"},{\"id\":15175,\"name\":\"William Friedkin\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/r9JJ3VDB7VeDol7cEGsS4NyM6d5.jpg\"},{\"id\":35325,\"name\":\"Eric Till\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.