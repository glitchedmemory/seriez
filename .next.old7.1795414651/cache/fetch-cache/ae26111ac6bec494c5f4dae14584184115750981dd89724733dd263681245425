{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":312639,\"title\":\"The Best of The Tony Awards: The Plays\",\"tagline\":\"\",\"overview\":\"The Great White Way comes into your living room via this disc of rare performances from some of Broadway's brightest luminaries. Culled from clips from the Tony Awards shows, this unique collection features acting powerhouses James Earl Jones, Annette Bening, Joan Allen, Joe Mantegna, Gary Sinise and Maggie Smith, among others, performing works by such playwrights as August Wilson, David Mamet, Wendy Wasserstein and more.\",\"poster\":\"https://image.tmdb.org/t/p/w780/pqn9Vtk7OWxhmA3fALM6I1aRgRS.jpg\",\"backdrop\":null,\"rating\":0,\"voteCount\":0,\"year\":2006,\"runtime\":0,\"genres\":[\"Documentary\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":0,\"revenue\":0,\"director\":\"Christopher A. Cohen\",\"cast\":[{\"id\":2228198,\"name\":\"Christopher A. Cohen\",\"character\":\"Director\",\"photo\":null},{\"id\":7420,\"name\":\"Harvey Fierstein\",\"character\":\"Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/4th4mr9iR23DdjFjVGhrtCnJRNq.jpg\"},{\"id\":15152,\"name\":\"James Earl Jones\",\"character\":\"Jack Jefferson (segment \\\"The Great White Hope\\\") / Troy Maxson (segment \\\"Fences\\\")\",\"photo\":\"https://image.tmdb.org/t/p/w780/sgc8yxYr8ecNn1TXjWXWx3wmUYA.jpg\"},{\"id\":13724,\"name\":\"Jane Alexander\",\"character\":\"Eleanor Bachman (segment \\\"The Great White Hope\\\") / Sara Goode (segment \\\"The Sisters Rosensweig\\\")\",\"photo\":\"https://image.tmdb.org/t/p/w780/5nWLBhNH6tQGVskI89J45C7LU2o.jpg\"},{\"id\":33,\"name\":\"Gary Sinise\",\"character\":\"Randle P. McMurphy (segment \\\"One Flew Over the Cuckoo's Nest\\\")\",\"photo\":\"https://image.tmdb.org/t/p/w780/olRjiV8ZhBixQiTvrGwXhpVXxsV.jpg\"},{\"id\":26930,\"name\":\"Amy Morton\",\"character\":\"Nurse Ratched (segment \\\"One Flew Over the Cuckoo's Nest\\\")\",\"photo\":\"