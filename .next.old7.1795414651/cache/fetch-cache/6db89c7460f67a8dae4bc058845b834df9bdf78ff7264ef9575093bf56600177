{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":64974,\"title\":\"House of Horrors: Kidnapped\",\"tagline\":\"\",\"overview\":\"HOUSE OF HORRORS: KIDNAPPED tells the gripping stories of people who were kidnapped and lived to tell. Each episode reveals one survivor’s terrifying experience from the moment of abduction to the hours, days, or months of captivity to the escape and recovery, as told through their eyes.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/6S63gRYcjkzwCHy2Tb6hXOmw8vU.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/dy8dPHxRptcB3VTpDjW9aE2wNOJ.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8,\"voteCount\":1,\"year\":2014,\"genres\":[\"Crime\",\"Documentary\",\"Reality\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":36,\"createdBy\":[],\"networks\":[\"Investigation Discovery\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2016-05-12\",\"cast\":[],\"trailers\":[{\"key\":\"x5fXae4latE\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"zO0BthnTf1c\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"fly6D-bDT6I\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":95302,\"title\":\"Stalkers Who Kill\",\"poster\":\"https://image.tmdb.org/t/p/w780/z0PgxZbhazDStsItGdsoH544utz.jpg\",\"rating\":3,\"year\":2016,\"type\":\"tv\",\"_score\":0.28541666666666665,\"_genreOverlap\":2},{\"id\":284647,\"title\":\"Forensic Justice\",\"poster\":\"https://image.tmdb.org/t/p/w780/bxRHnCRGZvyaJAVcrRpAGijQRzf.jpg\",\"rating\":0,\"year\":2016,\"type\":\"tv\",\"_score\":0.28205128205128205,\"_genreOverlap\":2},{\"id\":64888,\"title\":\"Redrum\",\"poster\":\"https://image.tmdb.org/t/p/w780/26e6hA3Ltq1y9h5FhE8ioDpyiCU.jpg\",\"rating\":6.4,\"year\":2013,\"type\":\"tv\",\"_score\":0.28205128205128205,\"_genreOverlap\":2},{\"id\":98796,\"title\":\"