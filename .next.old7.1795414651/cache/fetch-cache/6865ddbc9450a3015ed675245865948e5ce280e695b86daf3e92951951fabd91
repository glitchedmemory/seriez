{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":87247,\"title\":\"Bakugan\",\"tagline\":\"\",\"overview\":\"Follow the adventures of Dan Kouzo and his best friends: the first kids on Earth to bond with the mysterious creatures known as Bakugan!\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/lg6QqCdvZOZM7EWf9zFJL12EsKv.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/qsjFoAc3Y5JlsSPsOY84bt82OzN.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6,\"voteCount\":27,\"year\":2018,\"genres\":[\"Animation\",\"Kids\",\"Sci-Fi & Fantasy\",\"Action & Adventure\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":6,\"totalEpisodes\":338,\"createdBy\":[\"Steven T. Seagle\",\"Joe Kelly\",\"Joe Casey\",\"Duncan Rouleau\"],\"networks\":[\"Cartoon Network\",\"Teletoon\",\"Netflix\"],\"countries\":[{\"code\":\"CA\",\"name\":\"Canada\"},{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2023-03-01\",\"cast\":[{\"id\":1579863,\"name\":\"Hideki Okamoto\",\"character\":\"Director\",\"photo\":null},{\"id\":1157391,\"name\":\"Kazuya Ichikawa\",\"character\":\"Director\",\"photo\":null},{\"id\":3073082,\"name\":\"Masaru Kanamori\",\"character\":\"Director\",\"photo\":null},{\"id\":3710231,\"name\":\"Kanae Komoda\",\"character\":\"Director\",\"photo\":null},{\"id\":1698186,\"name\":\"Jonah Wineberg\",\"character\":\"Dan Kouzo (voice)\",\"photo\":null},{\"id\":2254809,\"name\":\"Margarita Valderrama\",\"character\":\"Lia Venegas (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/6iOCaG95aqJv41fA49tXWCAk3Av.jpg\"},{\"id\":1240335,\"name\":\"Deven Mack\",\"character\":\"Wynton Styles (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/qfFZTN1lgoliBK4uf9aHjejSqZF.jpg\"}],\"trailers\":[{\"key\":\"op5ixBbEpXo\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"yEdgJefq9WY\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"yDnO9vZZVxs\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":63090,\"title\":\"Transformers: Robots In Disguise\",\"poster\":\"https://image.tmdb.org/t/p/w780/pbRpKAGbXnASnNFHCGFC4CwVPla.jpg\",\"rating\":7.1,\"year\":2015,\"type\":\"tv\",\"_score\":0.419672131147541,\"_genreOverlap\":4},{\"id\":130794,\"title\":\"Beast Saga\",\"poster\":\"https://image.tmdb.org/t/p/w780/xGMCap22vSUeeNLMNQahRPsNeJe.jpg\",\"rating\":0,\"year\":2013,\"type\":\"tv\",\"_score\":0.41463414634146345,\"_genreOverlap\":4},{\"id\":214593,\"title\":\"Go for Speed\",\"poster\":\"https://image.tmdb.org/t/p/w780/hDVcw5gT4vvImS8l2vjpy2mY247.jpg\",\"rating\":9,\"year\":2009,\"type\":\"tv\",\"_score\":0.4137614678899083,\"_genreOverlap\":4},{\"id\":98034,\"title\":\"Digimon Adventure:\",\"poster\":\"https://image.tmdb.org/t/p/w780/7Qspx2eFX0uBSQLLlAKnYrjZgse.jpg\",\"rating\":7.6,\"year\":2020,\"type\":\"tv\",\"_score\":0.4116883116883117,\"_genreOverlap\":4},{\"id\":3035,\"title\":\"He-Man and the Masters of the Universe\",\"poster\":\"https://image.tmdb.org/t/p/w780/2MZQ7GH4WfxeZYkuDGZD7H69X4L.jpg\",\"rating\":7.6,\"year\":2002,\"type\":\"tv\",\"_score\":0.4105263157894737,\"_genreOverlap\":4},{\"id\":96659,\"title\":\"He-Man and the Masters of the Universe\",\"poster\":\"https://image.tmdb.org/t/p/w780/khU0nt0PAbX0t6IpBBvTxm1uzoZ.jpg\",\"rating\":7.1,\"year\":2021,\"type\":\"tv\",\"_score\":0.32571428571428573,\"_genreOverlap\":3},{\"id\":60667,\"title\":\"Gundam Build Fighters\",\"poster\":\"https://image.tmdb.org/t/p/w780/dzvm78n4yOmeO2FdtD2aAbjDTuG.jpg\",\"rating\":7.4,\"year\":2013,\"type\":\"tv\",\"_score\":0.32307692307692315,\"_genreOverlap\":3},{\"id\":128255,\"title\":\"Transformers: War for Cybertron: Kingdom\",\"poster\":\"https://image.tmdb.org/t/p/w780/1HQEdk7gsLvECRzycwxW2m0o4xW.jpg\",\"rating\":7.7,\"year\":2021,\"type\":\"tv\",\"_score\":0.31935483870967746,\"_genreOverlap\":3},{\"id\":29540,\"title\":\"Zoids: New Century\",\"poster\":\"https://image.tmdb.org/t/p/w780/2BvXKFvqBe7HKptl5urEsB48B6V.jpg\",\"rating\":7.8,\"year\":2001,\"type\":\"tv\",\"_score\":0.3179104477611941,\"_genreOverlap\":3},{\"id\":214592,\"title\":\"GAMERA -Rebirth-\",\"poster\":\"https://image.tmdb.org/t/p/w780/qL5NCj2lwZi667ZHO0s5jkUykwl.jpg\",\"rating\":7.7,\"year\":2023,\"type\":\"tv\",\"_score\":0.31714285714285717,\"_genreOverlap\":3},{\"id\":97782,\"title\":\"Kuma Kuma Kuma Bear\",\"poster\":\"https://image.tmdb.org/t/p/w780/AtjPKOfpW2VcaB37yNoiPDY73iV.jpg\",\"rating\":7.3,\"year\":2020,\"type\":\"tv\",\"_score\":0.31600000000000006,\"_genreOverlap\":3},{\"id\":96658,\"title\":\"Masters of the Universe: Revelation\",\"poster\":\"https://image.tmdb.org/t/p/w780/y93cJr4fCYt9j5f23j5p3TXv5Ar.jpg\",\"rating\":6.6,\"year\":2021,\"type\":\"tv\",\"_score\":0.31578947368421056,\"_genreOverlap\":3}],\"seasonNumber\":2,\"seasonName\":\"Battle Planet Season 2\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/razW0RtkKqepuPeUcO0t6RGY2M6.jpg\",\"seasonAirDate\":\"2019-08-04\",\"episodes\":[{\"number\":1,\"name\":\"The Forbidden Isle\",\"overview\":\"The AO travel to a remote island in search of a Core Cell, but instead they find the Bakugan known as Kelion, which soon bonds with Dan.\",\"still\":\"https://image.tmdb.org/t/p/w780/uV424RpfhQ5rKt8MvhqpWjMFHAq.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2019-08-04\",\"runtime\":11},{\"number\":2,\"name\":\"New World Orders\",\"overview\":\"The AO discover a small group of kids and Bakugan being used as laborers against their will, but freeing them is only half the problem.\",\"still\":\"https://image.tmdb.org/t/p/w780/p0KdT5gUxpJtoHpLU0L36AEIVcV.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2019-08-04\",\"runtime\":11},{\"number\":3,\"name\":\"In the Wild\",\"overview\":\"The AO are invited to a video-stars conference, but when the chartered jet goes down, the AO must give over to their wild sides to survive!\",\"still\":\"https://image.tmdb.org/t/p/w780/gB5BF2XmT2MN9j4XzGCz37RK5J6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-11\",\"runtime\":11},{\"number\":4,\"name\":\"Call Me Old Brakken\",\"overview\":\"Lord Brakken is the ultimate AO super-fan, but his zeal takes a dark turn when he looks to prove that he is their superior in battle.\",\"still\":\"https://image.tmdb.org/t/p/w780/fhUtvtk8YgtoiMreSkaRZDu4Plw.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-11\",\"runtime\":11},{\"number\":5,\"name\":\"Hide Matrix and Seek\",\"overview\":\"The AO go undercover to try and pass as citizens of Lord Brakken, but quickly discover that even minor celebrity makes anonymity impossible.\",\"still\":\"https://image.tmdb.org/t/p/w780/kMgIhUmqqmPvNcLYkX4Zj63p4G9.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-18\",\"runtime\":11},{\"number\":6,\"name\":\"Or Forever Hold Your Peace\",\"overview\":\"The AO seek to rescue Lia from an arranged marriage with Lord Brakken only to discover she just made a major discovery for the Bakugan!\",\"still\":\"https://image.tmdb.org/t/p/w780/w1jlulkH3b3wXvzj8wqunTG5vbx.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-18\",\"runtime\":11},{\"number\":7,\"name\":\"Two Sides of the Coin\",\"overview\":\"The AO and Magnus take parallel tracks to retrieve the same piece of data, one that promises a breakthrough in the Bakugan phenomenon.\",\"still\":\"https://image.tmdb.org/t/p/w780/bhzBmskX9cxZvr7njwj3dd8VPD3.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-08-25\",\"runtime\":11},{\"number\":8,\"name\":\"The Race for Gold\",\"overview\":\"When the AO seek out a mythical, lost Bakugan, they get more than they bargained for when Magnus is on the trail of this new discovery, too.\",\"still\":\"https://image.tmdb.org/t/p/w780/7DqvSwXoy7Iut4gbi3tJWjsmwfs.jpg\",\"rating\":4,\"voteCount\":1,\"airDate\":\"2019-08-25\",\"runtime\":11},{\"number\":9,\"name\":\"Seek and Hide\",\"overview\":\"Sent to investigate a Japanese island by Benton Dusk, the AO discover a hidden facility conducting experiments that affect The Hide.\",\"still\":\"https://image.tmdb.org/t/p/w780/af1XF7EtkkivE54fPXiX0cYsJKc.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-08\",\"runtime\":11},{\"number\":10,\"name\":\"Family First\",\"overview\":\"Trapped by his father, Shun is forced to battle his own friends, revealing dark secrets about the Kazami family and Masato's experiments.\",\"still\":\"https://image.tmdb.org/t/p/w780/qYS3UUnigsayRtxao3ZhIo3hLnV.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-08\",\"runtime\":11},{\"number\":11,\"name\":\"A Door Closes, a Door Opens\",\"overview\":\"Shun must stand up to his father and protect his friends before Masato destroys everyone.\",\"still\":\"https://image.tmdb.org/t/p/w780/aNfSkesErxDgHtiyacZNQdiwls6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-15\",\"runtime\":11},{\"number\":12,\"name\":\"Kazami's Gambit\",\"overview\":\"When Magnus looks to steal the Dimensional Doorway, Shun and Ichiro must make peace with the AO stop the Doorway from destroying them all.\",\"still\":\"https://image.tmdb.org/t/p/w780/dveFBKa5ES85aWwfAbYBzfkagxI.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-15\",\"runtime\":11},{\"number\":13,\"name\":\"A Devil on Your Shoulder\",\"overview\":\"Near giving up, Magnus gains new strength and insight on the AO's mission to find Core Cells that will eventually lead him down a dark hole.\",\"still\":\"https://image.tmdb.org/t/p/w780/ywN7LTH4OIIWzziQamMzB7N22Fi.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-22\",\"runtime\":11},{\"number\":14,\"name\":\"Vestral Visions\",\"overview\":\"Drago's sickness leads Dan to a revelation that there is an ailing Core Cell.\",\"still\":\"https://image.tmdb.org/t/p/w780/liqagtJs0VGS5dkJLjeUHjHeYiE.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-22\",\"runtime\":11},{\"number\":15,\"name\":\"Bakuzoned!\",\"overview\":\"Strata's return is much more than a simple rematch when he's been infected by a strange ooze.\",\"still\":\"https://image.tmdb.org/t/p/w780/gCqelMef2r9y8KxUgZXXqjCvRCA.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-29\",\"runtime\":11},{\"number\":16,\"name\":\"The Golden Secret\",\"overview\":\"Using Strata's gauntlet, the AO think they've found a way thorugh the labyrinth, but soon discover trusting the enemy is not always best.\",\"still\":\"https://image.tmdb.org/t/p/w780/b2FEzNyspTEgX8gaHZVNQ9oUb93.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-09-29\",\"runtime\":11},{\"number\":17,\"name\":\"The Bakugan Breakers\",\"overview\":\"Magnus's new team of Bakugan Brawlers overhear Lightning's warnings of a sick Core Cell and decide to capture the dog to find its location.\",\"still\":\"https://image.tmdb.org/t/p/w780/23kVv4TSTRBUTtEos4AHM6RZMtO.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-06\",\"runtime\":11},{\"number\":18,\"name\":\"The Awful Ones\",\"overview\":\"Magnus heads into the Labyrinth to claim the Fortus Core Cell for his own, but comes in direct contact with the evil versions of the AO.\",\"still\":\"https://image.tmdb.org/t/p/w780/5qbRhzk4vvLxZEnE31vlhNT3wOX.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-06\",\"runtime\":11},{\"number\":19,\"name\":\"The Mask of Pride\",\"overview\":\"Driven by revenge, Magnus decides to go back into the labyrinth, face the AO and claim the Fortus Core Cell energy for himself.\",\"still\":\"https://image.tmdb.org/t/p/w780/fW47VY8WooV3QHELOmCn8g48x8Z.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-13\",\"runtime\":11},{\"number\":20,\"name\":\"The Graveyard of Courage\",\"overview\":\"Super charged by the Fortus Core Cell, Magnus wages war on the AO only to discover his newfound power has a price attached.\",\"still\":\"https://image.tmdb.org/t/p/w780/968m09XtgetPj5i07qbuvETmq27.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-13\",\"runtime\":11},{\"number\":21,\"name\":\"Vestroia (1)\",\"overview\":\"The AO discover the only way to stop Magnus, and possibly save him, involves shutting down the infected Fortus Core Cell./\",\"still\":\"https://image.tmdb.org/t/p/w780/hDU3kVffhvHVYKiETRLBZvuDIre.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-20\",\"runtime\":11},{\"number\":22,\"name\":\"Vestroia (2)\",\"overview\":\"The AO must decide whether or not to help Benton Dusk destroy the infected Fortus Core Cell, risking the destruction of their own Bakugan.\",\"still\":\"https://image.tmdb.org/t/p/w780/pOhlL1boA72XghiwHU4c6FG3P7t.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-20\",\"runtime\":11},{\"number\":23,\"name\":\"Too Much\",\"overview\":\"The Hide Matrix goes crazy and a simple AO training mission turns into a complicated rampage that brings down Studio D./\",\"still\":\"https://image.tmdb.org/t/p/w780/khoqkudCCzHvUBKhKhbWHbYvH9i.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-27\",\"runtime\":11},{\"number\":24,\"name\":\"Who Are You?\",\"overview\":\"After the loss of their HQ, the AO is a little off, but in talking to Benton Dusk, they learn a new sense of purpose for their team.\",\"still\":\"https://image.tmdb.org/t/p/w780/j5u8IheSbqpnqvZVSnyZPceMNbe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-10-27\",\"runtime\":11},{\"number\":25,\"name\":\"Happy\",\"overview\":\"The AO expect a fight in Brakistan, but soon discover that old enemies Lord Brakken, Magnus, and Nillious are unnaturally happy to see them.\",\"still\":\"https://image.tmdb.org/t/p/w780/ihe5mEZDPGtXV1saHLt5OVMyxZr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-03\",\"runtime\":11},{\"number\":26,\"name\":\"One Way or Another\",\"overview\":\"In the heat of emotions, Shun convinces Lord Brakken that his usual enemies are the best allies he has to sequester a renegade Core Cell.\",\"still\":\"https://image.tmdb.org/t/p/w780/4WTyCWGQxx7iC5z3p36iRJ0mCRJ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-03\",\"runtime\":11},{\"number\":27,\"name\":\"Stormy Weather\",\"overview\":\"On a flight to their next Core Cell mission, the AO's plane falls under attack by Pyravian, who strangely believes the team to be Bakuzon.\",\"still\":\"https://image.tmdb.org/t/p/w780/rOiwYsjfdrsk2TXp1LFW4WYYFHu.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-10\",\"runtime\":11},{\"number\":28,\"name\":\"Who Can It Be Now\",\"overview\":\"The AO find themselves in a battle against the Bakuzon forces of Tiko that upends everything they thought they knew about Core Cells.\",\"still\":\"https://image.tmdb.org/t/p/w780/8BKVWBi6lnfXWwGdesQfJUSkHHe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-10\",\"runtime\":11},{\"number\":29,\"name\":\"In My Room\",\"overview\":\"When the AO report that they've been fighting the wrong fight, they discover that Benton has been corrupted by the villainous Tiko.\",\"still\":\"https://image.tmdb.org/t/p/w780/lgwmJ53yfEuRX8mXGhJ3aam7tIH.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-17\",\"runtime\":11},{\"number\":30,\"name\":\"An Army of Their Own\",\"overview\":\"The AO are forced to turn to Philomena Dusk for help, only to realize that they have led Benton/Tiko right to the AAAnimus Campus.\",\"still\":\"https://image.tmdb.org/t/p/w780/uEK5tIzR3UPJobDerLxtIpqMe9g.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-17\",\"runtime\":11},{\"number\":31,\"name\":\"Calling All Parents\",\"overview\":\"When the parents of the world are turned against their children and confiscate their Bakugan, the AO must seek out the Rowdy Reds.\",\"still\":\"https://image.tmdb.org/t/p/w780/vtFhwKubx1PE7J70yUjXCCQkDQ9.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-24\",\"runtime\":11},{\"number\":32,\"name\":\"Nowhere to Turn\",\"overview\":\"Nowhere to Turn: While the AO attempt to gain allies and warn other children, Wynton is confronted by Armstrong Tripp, who now works for Benton Dusk.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33281/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-11-24\",\"runtime\":11},{\"number\":33,\"name\":\"Girl Power\",\"overview\":\"When Lia battles with China Riot, they eventually come to an understanding as China finally realizes she's been set up by Benton/Tiko.\",\"still\":\"https://image.tmdb.org/t/p/w780/d2TEmyuA7BdC4ccXsoBt4L8nHas.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-01\",\"runtime\":11},{\"number\":34,\"name\":\"Return to the Fold\",\"overview\":\"On the run and with options dwindling, the AO turn to Shun's father, Ichiro Kazami, for help.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33283/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-01\",\"runtime\":11},{\"number\":35,\"name\":\"Kazami Family Feud\",\"overview\":\"Masato attacks, but the AO soon realize that Ichiro is keeping a Golden Bakugan captive, forcing them to choose between the lesser of two evils!\",\"still\":\"https://image.tmdb.org/t/p/w780/9FR0DQzVrcqpK74QyOMXFpOMWSY.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-08\",\"runtime\":11},{\"number\":36,\"name\":\"Greatest of the Kazami\",\"overview\":\"Shun makes an impassioned plea to Ichiro, but it is too late as the Kazami compound is overrun by Bakuzon and the Visvus Cell is lost.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33285/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-08\",\"runtime\":11},{\"number\":37,\"name\":\"Our Ugly Selves\",\"overview\":\"Abandoned in the Vestroia Labyrinth, the AO must deal with their personal losses and, worse, the Bakuzoned Awful Ones!\",\"still\":\"https://image.tmdb.org/t/p/w780/gZskfK6nvDXgtNhxkRvkXmDpAhb.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-15\",\"runtime\":11},{\"number\":38,\"name\":\"Thryno Lives!\",\"overview\":\"When the AO and Magnus form an alliance to free the Golden Bakugan, their differences lead to a horrible sacrifice for Dan and Lia.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33287/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-15\",\"runtime\":11},{\"number\":39,\"name\":\"The Healing Challenge\",\"overview\":\"As the AO struggle to hold together, a discovery is made involving the Golden Bakugan, a Golden Drome, and curing of a Bakuzoned Gorthion.\",\"still\":\"https://image.tmdb.org/t/p/w780/iksRErvG7tIKEJJlVMvozKoml1L.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-22\",\"runtime\":11},{\"number\":40,\"name\":\"The Golden Drome\",\"overview\":\"While Dan and Drago enter the Golden Drome to heal Trhyno, the rest of the AO defend the Golden Drome from a militia of human hunters.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33289/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-22\",\"runtime\":11},{\"number\":41,\"name\":\"The Golden Forge\",\"overview\":\"As Dan and Drago battle to free Trhyno from Tiko's infection, they learn the history of Vestroia and the nature of Golden Bakugan.\",\"still\":\"https://image.tmdb.org/t/p/w780/pKLv7EUzihbA6K8zhmfacqlnUTt.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-29\",\"runtime\":11},{\"number\":42,\"name\":\"A Deep Hibernation\",\"overview\":\"Trhyno must give Dan and Drago the power they need if they are to have any chance in stopping Tiko from destroying both Vestroia and Earth.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33291/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2019-12-29\",\"runtime\":11},{\"number\":43,\"name\":\"At the Beginning, an Ending\",\"overview\":\"When Shun and Lia track down Ichiro and Masato on their quest for more allies, they are forced to battle a Bakuzoned Ichiro!\",\"still\":\"https://image.tmdb.org/t/p/w780/g9P6L6fxppBs3fWGQuwPZ7UnE8B.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-05\",\"runtime\":11},{\"number\":44,\"name\":\"This Late Hour\",\"overview\":\"Shun, Lia and Masato must square off against the Dusk Forces, but they are not alone when they are joined by Lt. Brenan and Kino.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33293/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-05\",\"runtime\":11},{\"number\":45,\"name\":\"Bakuzon at the Gate (1)\",\"overview\":\"As the Dusk Forces storm the Numena Core Cell, infighting between the Awesome Ones and their allies threatens to tear them all apart.\",\"still\":\"https://image.tmdb.org/t/p/w780/p4ek20uhWLeb8nLnCcqREI4dKvP.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-12\",\"runtime\":11},{\"number\":46,\"name\":\"Bakuzon at the Gate (2)\",\"overview\":\"Tiko/Dusk Forces have coalesced into global power and are waging a no holds barred assault on the Numena Core Cell.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33295/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-12\",\"runtime\":11},{\"number\":47,\"name\":\"Planet-Ception\",\"overview\":\"The final showdown between Tiko and AO with the future of Earth and Vestroia in balance.\",\"still\":\"https://image.tmdb.org/t/p/w780/x4SoTfwWCulFgX8RjryZWerN6uI.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-19\",\"runtime\":11},{\"number\":48,\"name\":\"United We Stand\",\"overview\":\"The Awesome Ones return home as heroes, wondering what battles await them in the future.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/33297/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2020-01-19\",\"runtime\":11}],\"firstAirDate\":\"2018-12-23\"}","status":200,"url":""},"revalidate":86400,"tags":[]}