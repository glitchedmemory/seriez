ll}],\"similar\":[{\"id\":1726,\"title\":\"Iron Man\",\"poster\":\"https://image.tmdb.org/t/p/w780/78lPtwv72eTNqFW9COBYI0dWDJa.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/cKvDv2LpwVEqbdXWoQl4XgGN6le.jpg\",\"rating\":7.7,\"year\":2008,\"type\":\"movie\",\"overview\":\"After being held captive in an Afghan cave, billionaire engineer Tony Stark creates a unique weaponized suit of armor to fight evil.\",\"genres\":[\"Action\",\"Sci-Fi\",\"Adventure\"],\"daysUntil\":null},{\"id\":1300968,\"title\":\"The Hunger Games: Sunrise on the Reaping\",\"poster\":\"https://image.tmdb.org/t/p/w780/nzIXSQNgYZwFOMrmv0d0I3ulvkM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/aqFZcr2dxSZ2UwWSo1WC6C0rwDf.jpg\",\"rating\":7.8,\"year\":2026,\"type\":\"movie\",\"overview\":\"Return to the world of Panem 24 years before Katniss Everdeen volunteers in her sister's place, commencing on the morning of the reaping of the 50th Hunger Games, also known as the Second Quarter Quell.\",\"genres\":[\"Sci-Fi\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":969681,\"title\":\"Spider-Man: Brand New Day\",\"poster\":\"https://image.tmdb.org/t/p/w780/bjiS5ipwxb9JFy3XRRN4OAilSeX.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/subj7knTn4DeS6KS7qI66EQKe9i.jpg\",\"rating\":8.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Fighting crime full-time as Spider-Man in a world that doesn't remember him—and the pressure of seeing his old friends move on without him—sparks a change in Peter Parker he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see.\",\"genres\":[\"Sci-Fi\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":1058424,\"title\":\"Hope\",\"poster\":\"https://image.tmdb.org/t/p/w780/6VY1ZKgpsc8CfGsQcCGiYEgHdH0.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/qqHFLg90IUSoTmSMpKOOW5RyqN3.jpg\",\"rating\":6.9,\"year\":2026,\"type\":\"movie\",\"overview\":\"In the remote South Korean village of Hope Harbor, police chief Bum-seok and officer Sung-ae are called to investigate a mysterious creature wreaking havoc on the community. But all is not as it seems, and perceptions can be misleading. What begins as ignorance plants the seed of disaster, escalating through human conflict into a tragedy of cosmic proportions.\",\"genres\":[\"Sci-Fi\",\"Mystery\",\"Action\"],\"daysUntil\":null},{\"id\":1381071,\"title\":\"Godzilla Minus Zero\",\"poster\":\"https://image.tmdb.org/t/p/w780/hSmIJluOJmTWvJs4d7kHRxjc8s8.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/oqrYIDH4tvfEzPe1yqT4jzmAWHQ.jpg\",\"rating\":7.7,\"year\":2026,\"type\":\"movie\",\"overview\":\"War reduced Japan to zero, and Godzilla plunged it into minus. Two years have passed since then, and the country has faced agonizing struggles to achieve recovery and finally reclaim its daily life. Just as humanity managed to cling to a hard-won peace, a new threat strikes, crushing hope in an instant. There is no third time. Everything ends here.\",\"genres\":[\"Sci-Fi\",\"Horror\",\"Action\"],\"daysUntil\":null},{\"id\":299534,\"title\":\"Avengers: Endgame\",\"poster\":\"https://image.tmdb.org/t/p/w780/jtDv3lCnST0fZRvdYFwR5CVwK2x.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7RyHsO4yDXtBv1zUU3mTpHeQ0d5.jpg\",\"rating\":8.2,\"year\":2019,\"type\":\"movie\",\"overview\":\"After the devastating events of Avengers: Infinity War, the universe is in ruins due to the efforts of the Mad Titan, Thanos. With the help of remaining allies, the Avengers must assemble once more in order to undo Thanos' actions and restore order to the universe once and for all, no matter what consequences may be in store.\",\"genres\":[\"Adventure\",\"Sci-Fi\",\"Action\"],\"daysUntil\":null},{\"id\":1384216,\"title\":\"The Dog Stars\",\"poster\":\"https://image.tmdb.org/t/p/w780/5O616X9vmRzQdB68PHzBewPittd.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/3k7GzxOdLZkN3eZsuhLi2eRzkXO.jpg\",\"rating\":7.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"After the world's population has been ravaged by a pandemic, a man lives a lonesome existence in a Colorado airplane hangar with his dog and a dour gunman he has befriended. When a mysterious transmission comes through on the radio while he’s flying his old Cessna, it sparks a hunt for the provenance of the sound.\",\"genres\":[\"Action\",\"Thriller\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":1375646,\"title\":\"Colony\",\"poster\":\"https://image.tmdb.org/t/p/w780/enz3WLx5QU1FUyhXZld04QWIc6N.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/iGViga8sDCET1S6GfwOlAbuhSGQ.jpg\",\"rating\":8.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"Professor Se-jeong is thrust into a bloody nightmare when a rapidly mutating virus is released during a biotech conference causing authorities to seal the facility. Trapped inside with no escape, Se-jeong along with a small group of survivors must fight to stay alive while the infected undergo horrific transformations.\",\"genres\":[\"Horror\",\"Action\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":27205,\"title\":\"Inception\",\"poster\":\"https://image.tmdb.org/t/p/w780/xlaY2zyzMfkhk0HSC5VUwzoZPU1.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg\",\"rating\":8.4,\"year\":2010,\"type\":\"movie\",\"overview\":\"Cobb, a skilled thief who commits corporate espionage by infiltrating the subconscious of his targets is offered a chance to regain his old life as payment for a task considered to be impossible: \\\"inception\\\", the implantation of another person's idea into a target's subconscious.\",\"genres\":[\"Action\",\"Sci-Fi\",\"Crime\"],\"daysUntil\":null},{\"id\":9654,\"title\":\"The Italian Job\",\"poster\":\"https://image.tmdb.org/t/p/w780/eSkjK4kctyrWpFhxl35GPvSs6tI.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/scub2eRSY0c3feyVIZhjZFXvgeV.jpg\",\"rating\":6.8,\"year\":2003,\"type\":\"movie\",\"overview\":\"Charlie Croker pulled off the crime of a lifetime. The one thing that he didn't plan on was being double-crossed. Along with a drop-dead gorgeous safecracker, Croker and his team take off to re-steal the loot and end up in a pulse-pounding, pedal-to-the-metal chase that careens up, down, above and below the streets of Los Angeles.\",\"genres\":[\"Action\",\"Crime\"],\"daysUntil\":null},{\"id\":296,\"title\":\"Terminator 3: Rise of the Machines\",\"poster\":\"https://image.tmdb.org/t/p/w780/vvevzdYIrk2636maNW4qeWmlPFG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/voVkSwgFYv9GOpRNfUAwj6qYRTL.jpg\",\"rating\":6.2,\"year\":2003,\"type\":\"movie\",\"overview\":\"It's been 10 years since John Connor saved Earth from Judgment Day, and he's now living under the radar, steering clear of using anything Skynet can trace. That is, until he encounters T-X, a robotic assassin ordered to finish what T-1000 started. Good thing Connor's former nemesis, the Terminator, is back to aid the now-adult Connor … just like he promised.\",\"genres\":[\"Action\",\"Thriller\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":4965,\"title\":\"Impostor\",\"poster\":\"https://image.tmdb.org/t/p/w780/7Uy4JbalP0mEyKnFW2IorQDmbBa.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/dv4tLF2gISz3w1e9YK3rK1jxpLj.jpg\",\"rating\":6.1,\"year\":2001,\"type\":\"movie\",\"overview\":\"A top-secret government weapons designer is arrested by a clandestine government organization on suspicion of being a clone created by the hostile alien race wanting to take over Earth.\",\"genres\":[\"Action\",\"Sci-Fi\",\"Thriller\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"x7YSbnUCuDo\",\"name\":\"SHADOW WARRIORS (1995) Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}