{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":69051,\"title\":\"Best Lover\",\"tagline\":\"\",\"overview\":\"In the glitzy world of Korean entertainment, two top stars enter a fake marriage for personal gain—he's a self-made actor with a painful past, she's a chaebol heiress hiding her emotional scars. As they struggle to keep up appearances, they discover each other’s vulnerabilities and unexpectedly fall in love.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/yn0MIfncUAtJoOOFpgmLKTJxNWC.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/c5kievszrPtGWc2TR5tNYMdGygY.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":7,\"voteCount\":10,\"year\":2016,\"genres\":[\"Drama\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":1,\"totalEpisodes\":12,\"createdBy\":[],\"networks\":[\"Youku\"],\"countries\":[{\"code\":\"CN\",\"name\":\"China\"}],\"lastAirDate\":\"2017-01-30\",\"cast\":[{\"id\":1235045,\"name\":\"Lee Da-hae\",\"character\":\"Choi Hwan-yeong / Ye Huanying\",\"photo\":\"https://image.tmdb.org/t/p/w780/liWpwu9TfCsoT6ovDuDMKwIyxDo.jpg\"},{\"id\":2380029,\"name\":\"Zhou Mi\",\"character\":\"Hee-sung / Yan Xiecheng\",\"photo\":\"https://image.tmdb.org/t/p/w780/kS1VJ6MMM2ZPqpEoLW2k0JJ28Io.jpg\"},{\"id\":117372,\"name\":\"Park Kwang-hyun\",\"character\":\"Jin Yongjian\",\"photo\":\"https://image.tmdb.org/t/p/w780/lA6Vs4Vu1CqPu9esJE0O4CxSV6i.jpg\"},{\"id\":1276424,\"name\":\"Wang Qiu Zi\",\"character\":\"Jia Ren / Xian Hua\",\"photo\":\"https://image.tmdb.org/t/p/w780/z6XqTbJLYLIAVzEStB297GK9rYz.jpg\"}],\"trailers\":[{\"key\":\"_ZQTClyv5TY\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"9Dk7n7Nb1ZU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"4O1_Cin8tnw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":283164,\"title\":\"Destiny of Love\",\"poster\":\"https://image.tmdb.org/t/p/w780/6hQnlaGQ6Qof7qJQldVpiNW