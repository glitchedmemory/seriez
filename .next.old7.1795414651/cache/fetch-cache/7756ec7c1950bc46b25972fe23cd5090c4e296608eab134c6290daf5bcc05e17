36364,\"_genreOverlap\":1},{\"id\":283167,\"title\":\"A Prime Minister's Disguise\",\"poster\":\"https://image.tmdb.org/t/p/w780/mSoQyinTCbnjHFhISfhPAgrcClc.jpg\",\"rating\":8,\"year\":2025,\"type\":\"tv\",\"_score\":0.41090909090909095,\"_genreOverlap\":1},{\"id\":31923,\"title\":\"The Legend of the Condor Heroes\",\"poster\":\"https://image.tmdb.org/t/p/w780/jH4UglJjh9pl9qNevoqofEHDGOs.jpg\",\"rating\":7.3,\"year\":2008,\"type\":\"tv\",\"_score\":0.4108433734939759,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"Two young stars with different backgrounds and agendas enter into a fake marriage to advance their careers, until the fake starts turning real.\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/p1xKk0AfHbGN2o8ZTBkRNUA5vIP.jpg\",\"seasonAirDate\":\"2016-11-14\",\"episodes\":[{\"number\":1,\"name\":\"Episode 1\",\"overview\":\"Actress Ye Huan-ying meets newcomer Yan Xi-cheng at an audition and spurns him mercilessly. Stung, Xi-cheng vows to become equally popular.\",\"still\":\"https://image.tmdb.org/t/p/w780/2jVfsBtInAtB7eUP8tno5L2uAsc.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-11-14\",\"runtime\":45},{\"number\":2,\"name\":\"Episode 2\",\"overview\":\"Huan-ying's father reveals that he plans to leave the company to her, but with conditions. Embroiled in a scandal, Xi-cheng asks for a big favor.\",\"still\":\"https://image.tmdb.org/t/p/w780/A2c4sunAv0Cv2fnN6YTao9qam77.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-11-21\",\"runtime\":45},{\"number\":3,\"name\":\"Episode 3\",\"overview\":\"After her father's accident, Huan-ying learns that she has a young half-brother who will inherit everything if she doesn't marry.\",\"still\":\"https://image.tmdb.org/t/p/w780/thCDnGCmDFAGmcrx3AvR2xKP5aG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-11-28\",\"runtime\":44},{\"number\":4,\"name\":\"Episode 4\",\"overview\":\"Xi-cheng takes Huan-ying and her brother to his parents' home for their honeymoon. Huan-ying gets a taste of life in the country.\",\"still\":\"https://image.tmdb.org/t/p/w780/qMXT9IQ03UPZ4Xaz5PovQ6oTNPd.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-12-05\",\"runtime\":45},{\"number\":5,\"name\":\"Episode 5\",\"overview\":\"Huan-ying hires a new stylist, but a photographer's photo of the three of them causes trouble for Xi-cheng with a famous French director.\",\"still\":\"https://image.tmdb.org/t/p/w780/yDl1TCDyg3BGXo2cizPifMuY686.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-12-12\",\"runtime\":45},{\"number\":6,\"name\":\"Episode 6\",\"overview\":\"Xi-cheng auditions for the French film. Mr. Piao makes a decision in advance of the company board meeting, which Huan-ying attends.\",\"still\":\"https://image.tmdb.org/t/p/w780/1b4nBgH4V3YvnWc2pduTO6nFPPP.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-12-19\",\"runtime\":45},{\"number\":7,\"name\":\"Episode 7\",\"overview\":\"Xi-cheng gets Shan-hua to stand in for Jia-ren after they're spotted together at a party, then asks her to step in for Huan-ying on a commercial.\",\"still\":\"https://image.tmdb.org/t/p/w780/sbHEeMdqK81Hs4bIaBeqAwx8bzH.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2016-12-26\",\"runtime\":45},{\"number\":8,\"name\":\"Episode 8\",\"overview\":\"Thanks to the commercial, Shan-hua signs a talent contract and moves into acting, close to Xi-cheng. Jia-ren fakes a pregnancy to deceive her husband.\",\"still\":\"https://image.tmdb.org/t/p/w780/1C1Jr1j1GzsBayIJZyxFhebPFGR.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-01-02\",\"runtime\":45},{\"number\":9,\"name\":\"Episode 9\",\"overview\":\"Yong-jian and Piao continue to scheme, and Yong-jian makes Shan-hua an offer. Huan-ying and Shan-hua compete for a movie role and do a photo shoot.\",\"still\":\"https://image.tmdb.org/t/p/w780/8Frgga6N6Ib7LJIKMy15KLlHjKJ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-01-09\",\"runtime\":45},{\"number\":10,\"name\":\"Episode 10\",\"overview\":\"After her brother disappears and his mother dies mysteriously, Huan-ying's uncle threatens her over her shares. Shan-hua calls a press conference.\",\"still\":\"https://image.tmdb.org/t/p/w780/p6y71neKP94kaLRE4DkIVjazSJP.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-01-16\",\"runtime\":45},{\"number\":11,\"name\":\"Episode 11\",\"overview\":\"Enveloped in scandal, Huan-ying and Xi-cheng do a TV appearance in which Huan-ying says she wants a divorce. Jia-ren's husband discovers her lies.\",\"still\":\"https://image.tmdb.org/t/p/w780/jhyUTBPkzSDNlXT1zLPJh1EDfJj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-01-23\",\"runtime\":46},{\"number\":12,\"name\":\"Episode 12\",\"overview\":\"Xi-cheng intervenes to save Huan-ying from Piao, and her father confronts his brother. Xi-cheng's manager tries to salvage his career.\",\"still\":\"https://image.tmdb.org/t/p/w780/kUstEoaSt3E6Yd2qi5iPAF7P5Dv.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-01-30\",\"runtime\":46}],\"firstAirDate\":\"2016-11-14\"}","status":200,"url":""},"revalidate":86400,"tags":[]}