{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":5730,\"title\":\"Macy's Thanksgiving Day Parade\",\"tagline\":\"\",\"overview\":\"The Macy's Thanksgiving Day Parade is an annual parade presented by the U.S. chain store business Macy's. The tradition started in 1924, tying it for the second-oldest Thanksgiving parade in the United States along with America's Thanksgiving Parade in Detroit, with both parades four years younger than the 6abc Dunkin' Donuts Thanksgiving Day Parade in Philadelphia. The three-hour Macy's event is held in New York City starting at 9:00 a.m. EST on Thanksgiving Day.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/ssk5SmXK4jHANKH6bvboGP4N1up.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/w2e8vh4tXkIOmOfMoAhHQuUxXRw.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8,\"voteCount\":3,\"year\":1948,\"genres\":[],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":79,\"totalEpisodes\":79,\"createdBy\":[],\"networks\":[\"NBC\",\"CBS\",\"Peacock\"],\"countries\":[{\"code\":\"US\",\"name\":\"US\"}],\"lastAirDate\":\"2025-11-27\",\"cast\":[{\"id\":1592610,\"name\":\"Ron de Moraes\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/eFvBJ6630F3KiUa2JpRD7vTL8P9.jpg\"}],\"trailers\":[{\"key\":\"LIzDgyh4av8\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"UM7SAnOBlUM\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"zyHttAGux7k\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":64496,\"title\":\"Saints & Strangers\",\"poster\":\"https://image.tmdb.org/t/p/w780/mhsaftBLNIQ5mcMgVhFtqc0ANYV.jpg\",\"rating\":6.4,\"year\":2015,\"type\":\"tv\",\"_score\":0.015,\"_genreOverlap\":0},{\"id\":326166,\"title\":\"Looney Tunes presents Bugs and Daffy's Thanksgiving Road Trip\",\"poster\":\"https://image.tmdb.org/t/p/w780/5jjYQDrfUvuYReAzSsSmomWZb8E.jpg\",\"rating\":0,\"year\":2021