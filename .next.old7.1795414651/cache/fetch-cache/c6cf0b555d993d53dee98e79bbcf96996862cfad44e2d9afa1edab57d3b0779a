g\":6.1,\"year\":2014,\"type\":\"tv\",\"_score\":0.41515151515151516,\"_genreOverlap\":1}],\"seasonNumber\":6,\"seasonName\":\"Season 6\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/jcsDJX4Px6MdU9geEuGX2r5Yt53.jpg\",\"seasonAirDate\":\"2017-09-24\",\"episodes\":[{\"number\":1,\"name\":\"Into the Unknown\",\"overview\":\"In the season premiere, brothers Chris and Casey Keefer are dropped in the wilderness of New Zealand with virtually nothing. They must quickly adapt to their new environment or face life threatening consequences.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-09-24\",\"runtime\":22},{\"number\":2,\"name\":\"White Water\",\"overview\":\"The adrenaline has worn off for Chris and Casey, and the jet lag has set in. The brothers face frigid temperatures and unpredictable whitewater rapids. When they try to navigate the rough waterways, their safety is threatened.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-01\",\"runtime\":22},{\"number\":3,\"name\":\"Risk and Reward\",\"overview\":\"The Keefer Brothers make an important decision that vastly impacts their expedition. In a desperate search of necessary food, they attempt to hunt big game for the first time in New Zealand, and encounter a new set of challenges.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-08\",\"runtime\":22},{\"number\":4,\"name\":\"Driving the Bus\",\"overview\":\"Chris and Casey are introduced to the tastes of the New Zealand wild, and get a rude awakening. Mother Nature's mind games start to mess with the brothers' mental strength, while their inflatable raft continues to be a serious problem.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-15\",\"runtime\":22},{\"number\":5,\"name\":\"Round Two\",\"overview\":\"Tensions run high as Chris and Casey disagree on what their next course of action should be. Without clear cache directions, the brothers are left with a hard choice. Should they stay, or should they go?\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-22\",\"runtime\":22},{\"number\":6,\"name\":\"Peaks and Valleys\",\"overview\":\"Chris and Casey hike the mountainside, but the steep slopes and shifting shale make the trek anything but easy. The brothers face energy depletion and exhaustion, and they feel the pressure to find new food sources soon, or go hungry.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-10-29\",\"runtime\":22},{\"number\":7,\"name\":\"Day in the Life\",\"overview\":\"The raft continues to cause problems as Chris and Casey spend valuable energy trying to stay afloat. With their days in the South Pacific dwindling, the brothers have reached their breaking point'until a new discovery leaves a lasting impact.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-05\",\"runtime\":22},{\"number\":8,\"name\":\"Bridge the Gap\",\"overview\":\"Chris and Casey have hiked across New Zealand for weeks. Fighting for their lives has taken a toll on their emotions and abilities. They team up to hunt feral pigs, but the cache items used for survival create new challenges and deep frustrations.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-12\",\"runtime\":22},{\"number\":9,\"name\":\"The LZ\",\"overview\":\"Chris and Casey Keefer must push to reach the LZ with a failing raft. With only a few hours before extraction, will Mother Nature get the best of them before they can get to safety?\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2017-11-19\",\"runtime\":22}],\"firstAirDate\":\"2011-12-31\"}","status":200,"url":""},"revalidate":86400,"tags":[]}