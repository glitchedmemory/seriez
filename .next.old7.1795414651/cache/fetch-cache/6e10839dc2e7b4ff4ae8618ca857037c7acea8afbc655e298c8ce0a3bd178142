{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":2527,\"title\":\"Emmerdale\",\"tagline\":\"\",\"overview\":\"The lives of several families in the Yorkshire Dales revolve around a farm and the nearby village. With murders, affairs, lies, deceit, laughter and tears, it's all there in the village.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/4elMyMe6W782VxXr5R1BmWDoqSg.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/kkyrixKwSU6fHCUOD9QJj6XKYmi.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":4.3,\"voteCount\":100,\"year\":1972,\"genres\":[\"Soap\",\"Drama\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":55,\"totalEpisodes\":10119,\"createdBy\":[\"Kevin Laffan\"],\"networks\":[\"ITV1\",\"ITV Yorkshire\"],\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"}],\"lastAirDate\":\"2026-10-25\",\"cast\":[{\"id\":1223025,\"name\":\"Paddy Russell\",\"character\":\"Director\",\"photo\":null},{\"id\":1763176,\"name\":\"Ian Bevitt\",\"character\":\"Director\",\"photo\":null},{\"id\":1190407,\"name\":\"Gary Williams\",\"character\":\"Director\",\"photo\":null},{\"id\":5444528,\"name\":\"Jeff Naylor\",\"character\":\"Director\",\"photo\":null},{\"id\":5002219,\"name\":\"Tim Finn\",\"character\":\"Director\",\"photo\":null},{\"id\":3506220,\"name\":\"Aashish Gadhvi\",\"character\":\"Director\",\"photo\":null},{\"id\":1617528,\"name\":\"Audrey O'Reilly\",\"character\":\"Director\",\"photo\":null},{\"id\":1582173,\"name\":\"Tim O'Mara\",\"character\":\"Director\",\"photo\":null},{\"id\":4123606,\"name\":\"Vicky Thomas\",\"character\":\"Director\",\"photo\":null},{\"id\":1542507,\"name\":\"Paul Copeland\",\"character\":\"Director\",\"photo\":null},{\"id\":6145727,\"name\":\"Simon Ferguson\",\"character\":\"Director\",\"photo\":null},{\"id\":2884138,\"name\":\"Tim Royle\",\"character\":\"Director\",\"photo\":null},{\"id\":1516714,\"name\":\"Desmond McCarthy\",\"character\":\"Director\",\"photo\":null},{\"id\":2828061,\"nam