{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":34381,\"title\":\"On Broadway\",\"tagline\":\"\",\"overview\":\"On Broadway tells the story of Jack O'Toole, a 30-something Boston everyman, who writes a play about his dead uncle as a way to reconnect with his hard-nosed dad. With no money and just his gut to guide him, Jack quits his job as a carpenter so that he can mount a production of his play on the only stage he can afford: in the back room of his neighborhood pub, on a little street called Broadway.\",\"poster\":\"https://image.tmdb.org/t/p/w780/3kn708IcIg2BWDOadrcSZ7HKNDP.jpg\",\"backdrop\":null,\"rating\":6.5,\"voteCount\":2,\"year\":2007,\"runtime\":98,\"genres\":[\"Drama\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":0,\"revenue\":0,\"director\":\"Dave McLaughlin\",\"cast\":[{\"id\":112269,\"name\":\"Dave McLaughlin\",\"character\":\"Director\",\"photo\":null},{\"id\":112261,\"name\":\"Joey McIntyre\",\"character\":\"Jack O'Toole\",\"photo\":\"https://image.tmdb.org/t/p/w780/x4FRMf5KijkRxHQvI0U1QNK3dlj.jpg\"},{\"id\":13446,\"name\":\"Eliza Dushku\",\"character\":\"Lena Wilson\",\"photo\":\"https://image.tmdb.org/t/p/w780/lvu4Vo9GL7uOjtU59MDiy3QDPAZ.jpg\"},{\"id\":87192,\"name\":\"Mike O'Malley\",\"character\":\"Father Rolie O'Toole\",\"photo\":\"https://image.tmdb.org/t/p/w780/q5T34bdF9BhQ6N95I8b6pzUM8KQ.jpg\"},{\"id\":2472,\"name\":\"Sean Lawlor\",\"character\":\"Martin O'Toole\",\"photo\":\"https://image.tmdb.org/t/p/w780/y7sWGFyRYObwk6TjZ98YlSBjis7.jpg\"},{\"id\":112262,\"name\":\"Lance Greene\",\"character\":\"Billy O'Toole\",\"photo\":null},{\"id\":112263,\"name\":\"Vincent Dowling\",\"character\":\"Augie Burke\",\"photo\":null},{\"id\":112264,\"name\":\"Lucas Caleb Rooney\",\"character\":\"Neil Quinn\",\"photo\":\"https://image.tmdb.org/t/p/w780/lZUtCfuYvXZM0EoX1Hl5EZvBzQg.jpg\"},{\"id\":112268,\"name\":\"Peter Giles\",\"character\":\"Barry Cook\",\"photo\":\"https