0/iBDFnLkTZZxQlbb6IIeYkufnPCY.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/xChyWmjDeEH8zOVi9dwVrtIJEfd.jpg\",\"rating\":6.4,\"year\":2005,\"type\":\"movie\",\"overview\":\"When a fellow scientist asks for Jack's help in locating the mausoleum of China's first emperor, the past collides violently with the present as Jack discovers his amazing visions are based in fact.\",\"genres\":[\"Action\",\"Adventure\",\"Comedy\"],\"daysUntil\":null},{\"id\":4442,\"title\":\"The Brothers Grimm\",\"poster\":\"https://image.tmdb.org/t/p/w780/iPrey2UYrA5Fqa8L3KnxqMqfmSq.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/aDfGKWdtNHzDmnHkdDyXz7zoDuy.jpg\",\"rating\":5.9,\"year\":2005,\"type\":\"movie\",\"overview\":\"Folklore collectors and con artists, Jake and Will Grimm, travel from village to village pretending to protect townsfolk from enchanted creatures and performing exorcisms. However, they are put to the test when they encounter a real magical curse in a haunted forest with real magical beings, requiring genuine courage.\",\"genres\":[\"Adventure\",\"Fantasy\",\"Action\"],\"daysUntil\":null},{\"id\":10992,\"title\":\"Cats & Dogs\",\"poster\":\"https://image.tmdb.org/t/p/w780/wUWoat7L4vvQburQ8pVEJhRG9L5.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/3ipuPBeBfsxcsry7Gh5m9J1rwJ1.jpg\",\"rating\":5.4,\"year\":2001,\"type\":\"movie\",\"overview\":\"When a professor develops a vaccine that eliminates human allergies to dogs, he unwittingly upsets the fragile balance of power between cats and dogs and touches off an epic battle for pet supremacy. The fur flies as the feline faction, led by Mr. Tinkles, squares off against wide-eyed puppy Lou and his canine cohorts.\",\"genres\":[\"Family\",\"Comedy\",\"Action\"],\"daysUntil\":null},{\"id\":6589,\"title\":\"Underdog\",\"poster\":\"https://image.tmdb.org/t/p/w780/pqGahPUmqrXbkeTQg7HCUa4VeHV.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/1BEuoA7UpCF51WpiIZ7rypAhxfs.jpg\",\"rating\":5.6,\"year\":2007,\"type\":\"movie\",\"overview\":\"A lab accident gives a beagle named Shoeshine some serious superpowers -- a secret that the dog eventually shares with the young boy who becomes his owner and friend.\",\"genres\":[\"Family\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":170657,\"title\":\"Journey to the West: Conquering the Demons\",\"poster\":\"https://image.tmdb.org/t/p/w780/qhsCEEjT8yOSdFh6pcGHmUGAQiO.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/60Y6NXOXiqPHACYhMoW5Fo4eCO5.jpg\",\"rating\":7,\"year\":2013,\"type\":\"movie\",\"overview\":\"In a world plagued by demons who cause great human suffering, young demon hunter Tang Sanzang must fight against monstrous demons, as well as contend with a beautiful demon hunting woman on his path to enlightenment.\",\"genres\":[\"Action\",\"Fantasy\",\"Adventure\"],\"daysUntil\":null},{\"id\":19585,\"title\":\"G-Force\",\"poster\":\"https://image.tmdb.org/t/p/w780/9Tly3ZXTTsQKM26fis8v9LR4GxG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/xgic8uEqzzhc0YimHGsWSQWMduE.jpg\",\"rating\":5.5,\"year\":2009,\"type\":\"movie\",\"overview\":\"A team of trained secret agent animals, guinea pigs Darwin, Hurley, Juarez, Blaster, mole Speckles, and fly Mooch takes on a mission for the US government to stop evil Leonard Saber, who plans to destroy the world with household appliances. But the government shuts them down and they are sentenced to a pet shop. Can they escape to defeat the villain and save the world?\",\"genres\":[\"Family\",\"Fantasy\",\"Action\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"G-9toGCn2Vs\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"UF_xpbaZrnY\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"HUlbfmKtKcw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}