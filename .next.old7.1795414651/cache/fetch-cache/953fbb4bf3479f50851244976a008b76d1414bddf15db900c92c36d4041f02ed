{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":427433,\"title\":\"Sky on Fire\",\"tagline\":\"\",\"overview\":\"The chief security officer at a top-secret medical facility finds himself caught in an explosive battle when a young thief and his accomplices steal a groundbreaking curative medicine. After discovering the true origins of the medicine, the officer must decide who he can trust to protect the cure from falling into the wrong hands, and prevent an all-out war from bringing the city to its knees.\",\"poster\":\"https://image.tmdb.org/t/p/w780/kmxWh9e7y2pvhnCZNaSzW5NpT3R.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/6svSoYJ3NCZxlRCLuwn7xScShqA.jpg\",\"rating\":5.8,\"voteCount\":23,\"year\":2016,\"runtime\":99,\"genres\":[\"Action\",\"Crime\",\"Thriller\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"HK\",\"name\":\"Hong Kong\"},{\"code\":\"CN\",\"name\":\"China\"}],\"budget\":0,\"revenue\":0,\"director\":\"Ringo Lam Ling-tung\",\"cast\":[{\"id\":26767,\"name\":\"Ringo Lam Ling-tung\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/qAuEWqf9HTrKx6a91cxoPMh78SV.jpg\"},{\"id\":64436,\"name\":\"Daniel Wu\",\"character\":\"Tinbo\",\"photo\":\"https://image.tmdb.org/t/p/w780/w6fCmYDlTNYfgdXBZjZH107c9zJ.jpg\"},{\"id\":1675905,\"name\":\"Zhang Ruoyun\",\"character\":\"Ziwan\",\"photo\":\"https://image.tmdb.org/t/p/w780/dnNTcRc58ikoJ0JihisgXYTwr75.jpg\"},{\"id\":41894,\"name\":\"Zhang Jingchu\",\"character\":\"Ko Yu\",\"photo\":\"https://image.tmdb.org/t/p/w780/nQdau9zu3e91AZZv471hKBnjIHo.jpg\"},{\"id\":126717,\"name\":\"Joseph Chang Hsiao-Chuan\",\"character\":\"Jia\",\"photo\":\"https://image.tmdb.org/t/p/w780/jZY7c982XpzwUWmnLxDhP7QaypY.jpg\"},{\"id\":126716,\"name\":\"Amber Kuo Tsai-chieh\",\"character\":\"Jane\",\"photo\":\"https://image.tmdb.org/t/p/w780/fepx2AfAdWcQ53VcjEZuAOYiIdd.jpg\"},{\"id\":1624255,\"name\":\"Fan Kuang-yao\",\"character\":\"Tang\",\"photo\":\"https://image.tmdb.org/t/p/w780/8QD