lar\":[{\"id\":1400837,\"title\":\"Other Mommy\",\"poster\":\"https://image.tmdb.org/t/p/w780/fGRNCssTRrhYZxNzykGGCoMsAVq.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/smZ8BT4Vzw4iCEppTLCnN8jNYtn.jpg\",\"rating\":6.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Young Bela forms a relationship with a sinister entity in her home that looks uncannily like her own mother, drawing her into a terrifying and increasingly dark world.\",\"genres\":[\"Horror\"],\"daysUntil\":null},{\"id\":1423191,\"title\":\"Resident Evil\",\"poster\":\"https://image.tmdb.org/t/p/w780/gAgWJhUSQWCgtKR8170nMkYlBda.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/3icyRAqgakNcQn6aDVz9libFmBA.jpg\",\"rating\":7.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Medical courier Bryan unwittingly finds himself fighting for survival as one fateful, horrifying night collapses around him in chaos.\",\"genres\":[\"Horror\",\"Sci-Fi\",\"Adventure\"],\"daysUntil\":null},{\"id\":1507696,\"title\":\"Apocalypse Z: New World\",\"poster\":\"https://image.tmdb.org/t/p/w780/wXln4DUrwcyjcFPwgQxFPYTlG1Z.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/o3XwuDUj0n8qnK91p6q8LKfr6rj.jpg\",\"rating\":6.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"The Canary Islands have become Europe’s last refuge following the outbreak of the TSJ virus. When a special mission sets out for the mainland in search of vital supplies, Roberto joins the team with questionable intentions. The dangerous operation turns into a desperate race for survival, and Roberto and his companions find themselves caught between hordes of infected and divided loyalties.\",\"genres\":[\"Action\",\"Thriller\",\"Horror\"],\"daysUntil\":null},{\"id\":1813355,\"title\":\"A Story of Derry\",\"poster\":\"https://image.tmdb.org/t/p/w780/4PtzGcegF5Po1NmDAW9IklyvAUh.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/z26LxXDMmAIzKr06FPDudCJyvsM.jpg\",\"rating\":6.6,\"year\":2026,\"type\":\"movie\",\"overview\":\"Hundreds of years before Pennywise, three youngsters venture into the Western Wood...where they encounter a terrifying ancient spirit.\",\"genres\":[\"Drama\",\"Horror\",\"Mystery\"],\"daysUntil\":null},{\"id\":1381071,\"title\":\"Godzilla Minus Zero\",\"poster\":\"https://image.tmdb.org/t/p/w780/hSmIJluOJmTWvJs4d7kHRxjc8s8.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/oqrYIDH4tvfEzPe1yqT4jzmAWHQ.jpg\",\"rating\":7.7,\"year\":2026,\"type\":\"movie\",\"overview\":\"War reduced Japan to zero, and Godzilla plunged it into minus. Two years have passed since then, and the country has faced agonizing struggles to achieve recovery and finally reclaim its daily life. Just as humanity managed to cling to a hard-won peace, a new threat strikes, crushing hope in an instant. There is no third time. Everything ends here.\",\"genres\":[\"Sci-Fi\",\"Horror\",\"Action\"],\"daysUntil\":null},{\"id\":1567605,\"title\":\"Ebenezer\",\"poster\":\"https://image.tmdb.org/t/p/w780/6H2N59jJW1hZEzn2ZdrMvJw5vNI.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/274ahmbkJSzdmcWrWSTu9DFv5rp.jpg\",\"rating\":7.5,\"year\":2026,\"type\":\"movie\",\"overview\":\"An elderly miser embarks on a supernatural journey after visits from the ghost of his former business partner and the Spirits of Christmas Past, Present, and Yet to Come force him to confront his past and fight for a second chance at happiness.\",\"genres\":[\"Fantasy\",\"Drama\",\"Horror\"],\"daysUntil\":null},{\"id\":1514026,\"title\":\"Buddy\",\"poster\":\"https://image.tmdb.org/t/p/w780/1BdZbNvl1SfrrX8J9X5tQzN6Ivu.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/sMmG82PtjK8A9rVc34gwKQtCm3A.jpg\",\"rating\":6.8,\"year\":2026,\"type\":\"movie\",\"overview\":\"Inside the colorful world of \\\"It's Buddy!\\\", a group of children spend their days singing, dancing, and helping Buddy - bright orange unicorn - spread happiness. But when one child refuses to play along, Buddy is not pleased and cracks begin to appear in this seemingly perfect world.\",\"genres\":[\"Horror\",\"Comedy\",\"Fantasy\"],\"daysUntil\":null},{\"id\":1339713,\"title\":\"Obsession\",\"poster\":\"https://image.tmdb.org/t/p/w780/bRwnj8WEKBCvmfeUNOukJPwB43K.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/5lTZyuBTNOfawsfPT8Q0cIg6qAF.jpg\",\"rating\":8.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"After breaking the mysterious \\\"One Wish Willow\\\" to win his crush's heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"genres\":[\"Horror\",\"Thriller\"],\"daysUntil\":null},{\"id\":1291595,\"title\":\"Insidious: Out of the Further\",\"poster\":\"https://image.tmdb.org/t/p/w780/4tTrW9dXCByS5wt2pXVWb58zNjz.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/p40lmrdI4blcAPZQMTPaiy5v5Ym.jpg\",\"rating\":7.7,\"year\":2026,\"type\":\"movie\",\"overview\":\"Gemma, a young mother raising her daughter in the house she grew up in, discovers she can travel into The Further, where she possesses an ability to bring what lives there back to the real world.\",\"genres\":[\"Horror\",\"Thriller\"],\"daysUntil\":null},{\"id\":1400940,\"title\":\"Clayface\",\"poster\":\"https://image.tmdb.org/t/p/w780/9l1NuFjel2j89hiuiJbsxfblqjy.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/f1TVhqJJdxMvUsUDuKHS0ekgYkk.jpg\",\"rating\":7.4,\"year\":2026,\"type\":\"movie\",\"overview\":\"Matt Hagen's meteoric rise from Gotham street kid to Hollywood leading man is tragically cut short when a local crime boss's actions leave him horribly disfigured. Abandoned by his team and with nothing left, Matt seeks out a cutting edge treatment that miraculously returns him to his former self… but also unexpectedly affects his grip on reality, spiraling him down a destructive path of all-consuming revenge.\",\"genres\":[\"Horror\",\"Thriller\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":1375646,\"title\":\"Colony\",\"poster\":\"https://image.tmdb.org/t/p/w780/enz3WLx5QU1FUyhXZld04QWIc6N.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/iGViga8sDCET1S6GfwOlAbuhSGQ.jpg\",\"rating\":8.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"Professor Se-jeong is thrust into a bloody nightmare when a rapidly mutating virus is released during a biotech conference causing authorities to seal the facility. Trapped inside with no escape, Se-jeong along with a small group of survivors must fight to stay alive while the infected undergo horrific transformations.\",\"genres\":[\"Horror\",\"Action\",\"Sci-Fi\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"DInabspW5Ms\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"i11Uw4Qgq_o\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"v4CDWAn7ln4\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}