{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":501179,\"title\":\"Nickelodeon's Ultimate Halloween Haunted House\",\"tagline\":\"\",\"overview\":\"Nickelodeon's Ultimate Halloween Haunted House is bringing all of the scares in this 30 minute hidden camera reality special, featuring your favorite Nick stars making their way through the ultimate haunted house experience.\",\"poster\":\"https://image.tmdb.org/t/p/w780/7oZaiMmhlD20GDrmorjFvEEziwi.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/o99pqyOGSOhQ1AgnuZSRQlvxajy.jpg\",\"rating\":9.7,\"voteCount\":3,\"year\":2016,\"runtime\":22,\"genres\":[\"Family\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":0,\"revenue\":0,\"director\":\"\",\"cast\":[{\"id\":206737,\"name\":\"Rico Rodriguez\",\"character\":\"Himself - Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/qjZhQwwrVFMYDZOget0xYrIMidC.jpg\"},{\"id\":1762563,\"name\":\"JoJo Siwa\",\"character\":\"Special Guest Scar-acter (as Jojo Siwa)\",\"photo\":\"https://image.tmdb.org/t/p/w780/hUDWLbwJAA5W3eFwDrYbEmqs3wf.jpg\"},{\"id\":1470305,\"name\":\"Riele Downs\",\"character\":\"Herself\",\"photo\":\"https://image.tmdb.org/t/p/w780/rQLCU2jdwi1us2j8R4xlOwQ2ZAq.jpg\"},{\"id\":1428067,\"name\":\"Jace Norman\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/c7yb3kj2D3ooW4Py8e5fFW4pHvZ.jpg\"},{\"id\":1680347,\"name\":\"Cree\",\"character\":\"Herself\",\"photo\":\"https://image.tmdb.org/t/p/w780/2qq7GobF9nS1mAARJj1Dyq0GPFL.jpg\"},{\"id\":1335308,\"name\":\"Benjamin Flores Jr.\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/fYdFWuW6gw8fpqUgAGcnVOzdnV2.jpg\"},{\"id\":1546053,\"name\":\"Thomas Kuc\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/5nHZfPNC5W0Ft1vrf3cye8ISKoB.jpg\"},{\"id\":1393180,\"name\":\"Madisyn Shipman\",\"character\":\"Herself\",\"photo\":\"https://image.tmdb.org/t/p/w780/v6OAOsT46MdwuexGXHSW3dhukR