{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":19826,\"title\":\"Barney and the Backyard Gang\",\"tagline\":\"\",\"overview\":\"Barney and the Backyard Gang is a direct-to-video series produced by The Lyons Group and was produced from October 13, 1988 to October 20, 1991. This series launched the stardom of the PBS television show Barney & Friends. Music for the Barney and the Backyard Gang videos was created by Stephen Bates Baltes and Phillip Parker. The series was a regional success, but only a moderate success throughout the rest of the country. Then one day, in 1991, Larry Rifkin, then head of Connecticut Public Television, rented a Barney video for his daughter Leora. He liked the concept and talked to Leach about possibly putting Barney on television through the Public Broadcasting Service. Rock with Barney was the last video in the series before the television show debuted. Also, only four of the kids from the videos (Michael, Luci, Tina and Derek) were carried over to the television show.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/pNBhe94V8yRsNqjt1h6XtNbGiCB.jpg\",\"backdropPath\":null,\"youtubeBackdrop\":\"https://img.youtube.com/vi/KZ_CO2PPbLY/maxresdefault.jpg\",\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":1988,\"genres\":[],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":15,\"createdBy\":[],\"networks\":[\"PBS\",\"Disney Channel\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"1991-10-30\",\"cast\":[],\"trailers\":[{\"key\":\"KZ_CO2PPbLY\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"ejfnyRgZg-A\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"ZLhgNuA8VwU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[],\"seasonNumber\":3,\"seasonName\":\"Season 3\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/pNBhe94V8yRsNqjt1h6XtNbGiCB.jpg\",\"seasonAirDate\":\"1991-07-29\",\"episodes\":[{\"number\":1,\"name\":\"Barney in Concert\",\"overview\":\"Barney and the Backyard Gang take the stage to delight and entertain everyone at Universal Studios in Orlando, Florida with Barney's new best friend, Baby Bop, who is a green dinosaur. They all work together to make a special surprise for the audience using items from \\\"Shimbaree Shimbarah!\\\".\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"1991-07-29\",\"runtime\":30},{\"number\":2,\"name\":\"A Trip to Sally's Birthday Party\",\"overview\":\"Sally gets a surprise when her three stuffed animals, Hum Bear, Melody Mouse and Barney the dinosaur, come to life and they take her and her brother Jonathan, along with Baby Bop and the Backyard Gang, and even their dog, Bingo, to a magical park to meet a marching band and celebrate her birthday party with her friends. They sing and dance and learn how to conquer their fears when a storm hits.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"1991-06-13\",\"runtime\":30},{\"number\":3,\"name\":\"Rock with Barney\",\"overview\":\"Barney, Baby Bop and the Backyard Gang have fun in a movie studio.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"1991-10-30\",\"runtime\":30}],\"firstAirDate\":\"1988-08-29\"}","status":200,"url":""},"revalidate":86400,"tags":[]}