{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":299787,\"title\":\"Iain Stirling's Roast The Internet\",\"tagline\":\"\",\"overview\":\"Iain Stirling's Roast The Internet is a studio comedy entertainment show all about the very worst things on the internet (that we're legally able to talk about on broadcast television). Every episode, Iain roasts social clips, posts and trends, with three famous faces - comedians, online celebrities and TV personalities - joining him each week to tackle their own online bugbears.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/2n7ExlgwiV6fm5IjASS6VxKC5UB.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/rpYv4bJfTtl4ueyIDEwa1CVGmud.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":5,\"voteCount\":2,\"year\":2025,\"genres\":[\"Comedy\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":16,\"createdBy\":[],\"networks\":[\"Comedy Central\"],\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"}],\"lastAirDate\":\"2026-10-26\",\"cast\":[{\"id\":1710437,\"name\":\"Barbara Wiltshire\",\"character\":\"Director\",\"photo\":null},{\"id\":2301035,\"name\":\"Iain Stirling\",\"character\":\"Self\",\"photo\":\"https://image.tmdb.org/t/p/w780/hfQHOMPQ36IdjBAnEttooHO8pGD.jpg\"}],\"trailers\":[{\"key\":\"Au8jNlM5v3U\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"J06XCMyafmM\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"g4p-z7I4mDk\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":69658,\"title\":\"On Air With AIB\",\"poster\":\"https://image.tmdb.org/t/p/w780/q9KEPqcOqDQzVH7GR7z7rrWN9UX.jpg\",\"rating\":7.8,\"year\":2015,\"type\":\"tv\",\"_score\":0.43214285714285716,\"_genreOverlap\":1},{\"id\":70305,\"title\":\"My Brother, My Brother and Me\",\"poster\":\"https://image.tmdb.org/t/p/w780/4LSZGbEDbWhMvruXXVeYhBIMzhV.jpg\",\"rating\":8.5,\"year\":2017,\