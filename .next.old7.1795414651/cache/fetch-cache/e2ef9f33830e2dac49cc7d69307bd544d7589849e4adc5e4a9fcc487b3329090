":\"https://image.tmdb.org/t/p/w780/l4LGTlpRbGqgZURwzGXCZLHRr1k.jpg\",\"rating\":7.4,\"year\":2013,\"type\":\"tv\",\"_score\":0.41090909090909095,\"_genreOverlap\":1},{\"id\":213755,\"title\":\"Dream Maker\",\"poster\":\"https://image.tmdb.org/t/p/w780/n6TwoonxEEHtbawDSvdi0NemyUR.jpg\",\"rating\":8,\"year\":2022,\"type\":\"tv\",\"_score\":0.4083333333333334,\"_genreOverlap\":1}],\"seasonNumber\":2,\"seasonName\":\"Season 2\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/lBWu1bNfk4RbuE2icIVceo1WBW.jpg\",\"seasonAirDate\":\"2023-06-26\",\"episodes\":[{\"number\":1,\"name\":\"Megastars and Meltdowns\",\"overview\":\"Kevin and Franklin Jonas introduce the 12 celebrity relatives; a talent show determines who will face elimination in the Guess Off.\",\"still\":\"https://image.tmdb.org/t/p/w780/zZoXZHaPrQQ49IECXQfa0EwcNY3.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-06-26\",\"runtime\":0},{\"number\":2,\"name\":\"Don't Get Chummy, You Dummy!\",\"overview\":\"The remaining 11 contestants step into the limelight in a Hollywood challenge to prove they have what it takes to make it in Tinseltown; after a series of races, only one lands atop the leaderboard, receiving immunity and a housemate's coveted clue.\",\"still\":\"https://image.tmdb.org/t/p/w780/xNcmOwjsIftGwPMwxfc837ivUsA.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-07-03\",\"runtime\":42},{\"number\":3,\"name\":\"Head Shots And Thick Plots\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/zBCoIOxB2MMtckyLrsr8FNHeXkE.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-07-10\",\"runtime\":42},{\"number\":4,\"name\":\"Flirting With Disaster\",\"overview\":\"New friendships are formed while strategies come to light; in the feeling famous challenge, teams must feel their way through a statue garden full of clues while blindfolded, aiming to name the objects and gain more knowledge about fellow players.\",\"still\":\"https://image.tmdb.org/t/p/w780/hj2pP335lZYW27PHEHb5sPdvO3m.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-07-17\",\"runtime\":42},{\"number\":5,\"name\":\"It's Giving Karma\",\"overview\":\"After a shocking elimination, one competitor has a target on their back; a supersized game of telephone puts the contestants' communication skills to the test as they recite and decode limericks; new, helpful clues are found on the clue wall.\",\"still\":\"https://image.tmdb.org/t/p/w780/j4TfTeR88YxUMmKjYREK6Vs8EwD.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-07-24\",\"runtime\":0},{\"number\":6,\"name\":\"Good Cop Bad Cop\",\"overview\":\"As alliances solidify, others work on new theories about their fellow housemates; in a revealing challenge, competitors must prove themselves masters of deception as they are subjected to an interrogation while hooked up to a heart rate monitor.\",\"still\":\"https://image.tmdb.org/t/p/w780/y1rwDmvvTjP5HUNsvHFxq8LA439.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-07-31\",\"runtime\":42},{\"number\":7,\"name\":\"Absolutely Shredded\",\"overview\":\"Two contestants form an alliance; the challenge has everyone piecing together paper shreds for clues.\",\"still\":\"https://image.tmdb.org/t/p/w780/e2LnqTW83LzIYBc8iomDOCrJncb.jpg\",\"rating\":9,\"voteCount\":2,\"airDate\":\"2023-08-07\",\"runtime\":0},{\"number\":8,\"name\":\"Defections, Connections, and Total Perplexion\",\"overview\":\"With five contestants left, loyalties are tested and two players confront each other; this week's challenge tests the players' celebrity trivia knowledge as more clues are revealed.\",\"still\":\"https://image.tmdb.org/t/p/w780/lsVDYReB3xJw6tGJLKUgC8SYw6F.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-08-14\",\"runtime\":42},{\"number\":9,\"name\":\"Disco Balls and Clue Walls\",\"overview\":\"Tensions are high as the final four contestants compete for a coveted spot in the finale. One player’s long-game strategy and lies are revealed during the challenge while the rest decide what to do with this new information.\",\"still\":null,\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-08-28\",\"runtime\":0},{\"number\":10,\"name\":\"Needle in a Haystack\",\"overview\":\"As the finale arrives, the competition has hit its peak. The top three, with the help of past contestants, race to uncover clues about each player hidden in stacks of hay. Two players are eliminated, while the one left stakes their own claim to fame.\",\"still\":null,\"rating\":8,\"voteCount\":2,\"airDate\":\"2023-08-28\",\"runtime\":0}],\"firstAirDate\":\"2022-07-11\"}","status":200,"url":""},"revalidate":86400,"tags":[]}