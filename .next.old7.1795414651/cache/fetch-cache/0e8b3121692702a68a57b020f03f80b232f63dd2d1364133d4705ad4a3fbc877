{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":9487,\"title\":\"A Bug's Life\",\"tagline\":\"An epic of miniature proportions.\",\"overview\":\"On behalf of \\\"oppressed bugs everywhere,\\\" an inventive ant named Flik hires a troupe of warrior bugs to defend his bustling colony from a horde of freeloading grasshoppers led by the evil-minded Hopper.\",\"poster\":\"https://image.tmdb.org/t/p/w780/Ah3J9OJVc2CNCuH2zMydXy9fmIC.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/hwwFyowfcbLRVmRBOkvnABBNIOs.jpg\",\"rating\":7,\"voteCount\":10045,\"year\":1998,\"runtime\":95,\"genres\":[\"Adventure\",\"Animation\",\"Comedy\",\"Family\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"budget\":80000000,\"revenue\":363258859,\"director\":\"John Lasseter\",\"cast\":[{\"id\":7879,\"name\":\"John Lasseter\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/xlrE4VD2VbZCDpaNdWCpH1ZihPS.jpg\"},{\"id\":21290,\"name\":\"Dave Foley\",\"character\":\"Flik (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/muHRRGDTE7ZWk3guqDAk9L4DqVX.jpg\"},{\"id\":1979,\"name\":\"Kevin Spacey\",\"character\":\"Hopper (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/nPrUZDEbGQe6jwpVbHKJCXsMd7r.jpg\"},{\"id\":15886,\"name\":\"Julia Louis-Dreyfus\",\"character\":\"Atta (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/iEfHQNrVbVFesDPjdySom9nqsFg.jpg\"},{\"id\":17265,\"name\":\"Hayden Panettiere\",\"character\":\"Dot (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/beFQeFN0KcF2MsM5DRFE8YTMDjQ.jpg\"},{\"id\":89784,\"name\":\"Phyllis Diller\",\"character\":\"Queen (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/teELYDRWmPGAVCzH4n4lX17Wa4J.jpg\"},{\"id\":21125,\"name\":\"Richard Kind\",\"character\":\"Molt (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/yWmuVQeQUzb5OSMVDoWkR0IylCK.jpg\"},{\"id\":11076,\"name\":\"David Hyde Pierce\",\"character\":\"Slim (voice)\",\"photo\":\"https