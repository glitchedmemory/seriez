{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":1245,\"title\":\"Harry Enfield's Television Programme\",\"tagline\":\"\",\"overview\":\"Harry Enfield's Television Programme was a British sketch show starring Harry Enfield and Paul Whitehouse. It was first broadcast on BBC Two in 1990 in the Thursday 9 pm slot, which became the traditional time for alternative comedy on television. Enfield was already an established name due to his 'Loadsamoney' character, but the series gave greater presence to his frequent collaborators Paul Whitehouse and Kathy Burke – so much so, that in 1994 the show was retitled Harry Enfield and Chums.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/sZ9ZFS79GTUWLKANDFkxL3TeO7T.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/2jQvEVVW5SbCgpPVBHnIHKjNXjd.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":7.1,\"voteCount\":19,\"year\":1990,\"genres\":[\"Comedy\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":13,\"createdBy\":[\"Harry Enfield\"],\"networks\":[\"BBC One\"],\"countries\":[{\"code\":\"GB\",\"name\":\"GB\"}],\"lastAirDate\":\"1992-12-23\",\"cast\":[{\"id\":169297,\"name\":\"Geoff Posner\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/l0ukWIvl6yZIf4azV6echZmrHWH.jpg\"},{\"id\":66161,\"name\":\"Harry Enfield\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/fzrYlkfm4JhfM9eKuO7xsZzFeaf.jpg\"},{\"id\":34900,\"name\":\"Paul Whitehouse\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/4aacb6fRghFwrT636cYmAYqQ35o.jpg\"},{\"id\":37759,\"name\":\"Kathy Burke\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/q3z7nP1ryyGuwixShrBmghcmm0F.jpg\"},{\"id\":1212142,\"name\":\"Jon Glover\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/xNsuPkSkiJaeewpV3iIUVKg3Ak5.jpg\"}],\"trailers\":[{\"key\":\"rftvNshKnLo\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"