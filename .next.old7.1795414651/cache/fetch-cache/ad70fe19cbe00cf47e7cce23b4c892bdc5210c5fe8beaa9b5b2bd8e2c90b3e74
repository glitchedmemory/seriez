age.tmdb.org/t/p/w780/16aIwqZdx9fBPcVul4icOYuWjxp.jpg\"},{\"id\":1926139,\"name\":\"Leonid Marchenko\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/hFHsRze0jbaFKSUx74RBLT1REFA.jpg\"},{\"id\":2470626,\"name\":\"Mykola Zadniprovskyi\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/2osya2xQcvUNFj5K1sKzchKCbV3.jpg\"},{\"id\":1543304,\"name\":\"Yevhen Malukha\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/vCBx1efbCyzyVEYczJUk4Q0PvPb.jpg\"},{\"id\":1337515,\"name\":\"Yosyp Naiduk\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/l1uA6YGdsogRakdfoTJxc98a1xs.jpg\"},{\"id\":2368589,\"name\":\"Yuriy Potapenko\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/2n9Rim2dPy8eKy4jYXytMXa1ja.jpg\"}],\"similar\":[{\"id\":91010,\"title\":\"Game Change\",\"poster\":\"https://image.tmdb.org/t/p/w780/vGJiVW06PmTiyEYvcWMoEOnQFka.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/wYe0w2odluof3jb9tmn6ct3PS6o.jpg\",\"rating\":6.9,\"year\":2012,\"type\":\"movie\",\"overview\":\"During the Republican run of the 2008 Presidential election, candidate John McCain picks a relative unknown, Alaskan governor Sarah Palin, to be his running mate.  As the campaign kicks into high gear, her lack of experience, in both political and media savvy, becomes a drain upon McCain and his strategists.\",\"genres\":[\"TV Movie\",\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":1638171,\"title\":\"Suffs\",\"poster\":\"https://image.tmdb.org/t/p/w780/1L1uqystrmoeCyK7uHdz0kDT8Kv.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/wrhtZvhroAidTac7TwJ6GKsfDel.jpg\",\"rating\":10,\"year\":2026,\"type\":\"movie\",\"overview\":\"Created by Tony Award winner Shaina Taub, this musical recorded from Broadway tells the story of the American suffragist movement and the remarkable friendships, heartbreak, and action that brought women together—or, in some cases, tore them apart. The ensemble cast features Taub as Alice Paul, Tony winner Nikki M. James as Ida B. Wells, Tony nominee Jenn Colella as Carrie Chapman Catt, and Grace McLean as President Woodrow Wilson.\",\"genres\":[\"Music\",\"History\"],\"daysUntil\":null},{\"id\":9899,\"title\":\"The Producers\",\"poster\":\"https://image.tmdb.org/t/p/w780/nG0Bix2SH2SQcbAIGhb6yqTG5UH.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/8PU4tUGUdrKujKwkUkw3M9ZrAaw.jpg\",\"rating\":6.2,\"year\":2005,\"type\":\"movie\",\"overview\":\"A conniving Broadway producer and his meek accountant plan to profit from charming wealthy old biddies to invest in an overbudget production, and then put on a sure-fire disaster, so nobody will ask for their money back — and what's more disastrous than a tasteless musical celebrating Adolf Hitler.\",\"genres\":[\"Comedy\"],\"daysUntil\":null},{\"id\":10050,\"title\":\"Get Over It\",\"poster\":\"https://image.tmdb.org/t/p/w780/A5cTiukvEqNuTpNFRgVTTf1aZOI.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/saQxwnIr4ftRmFpJeV9DQI1lsWd.jpg\",\"rating\":5.6,\"year\":2001,\"type\":\"movie\",\"overview\":\"When Berke Landers, a popular high school basketball star, gets dumped by his life-long girlfriend, Allison, he soon begins to lose it. But with the help of his best friend Felix's sister Kelly, he follows his ex into the school's spring musical. Thus ensues a love triangle loosely based upon Shakespeare's \\\"A Midsummer Night's Dream\\\", where Berke is only to find himself getting over Allison and beginning to fall for Kelly.\",\"genres\":[\"Comedy\",\"Romance\"],\"daysUntil\":null},{\"id\":275585,\"title\":\"Real Lies\",\"poster\":\"https://image.tmdb.org/t/p/w780/pzaK9JUN1TbyfxbIGX1vBwUfqbL.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/6zC6tZPDvq07104NGUrBhvXJd1S.jpg\",\"rating\":5,\"year\":2014,\"type\":\"movie\",\"overview\":\"Marco Valois wants to direct a serious movie inspired by the life of a soldier living with post-traumatic stress disorder. He soon realizes that the young soldier home from Afghanistan won't open up that easily. Marco, willing to do just about anything to get his story, follows Éric Lebel to his hometown.\",\"genres\":[\"Drama\",\"Comedy\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"oOTlqs_j4IE\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"gx4jKIzvVUo\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"Pnp6axoC6LE\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}