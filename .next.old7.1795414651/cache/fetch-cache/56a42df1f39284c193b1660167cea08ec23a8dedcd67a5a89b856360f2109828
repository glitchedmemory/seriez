em.\",\"genres\":[\"Drama\",\"Thriller\",\"Crime\"],\"daysUntil\":null},{\"id\":11423,\"title\":\"Memories of Murder\",\"poster\":\"https://image.tmdb.org/t/p/w780/jcgUjx1QcupGzjntTVlnQ15lHqy.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/6Kn6qW3an3DkPl3MahWemTzrjCt.jpg\",\"rating\":8.1,\"year\":2003,\"type\":\"movie\",\"overview\":\"A sadistic serial rapist and murderer of young women terrorizes a small province in 1980s South Korea. To prevent further crimes, three increasingly desperate detectives with conflicting methods race against time to unravel the violent mind of the killer in a futile effort to solve the case.\",\"genres\":[\"Crime\",\"Drama\",\"Thriller\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"eP7xQbSkjFQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"RDReD3MQ068\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"pGEeRo3gbHc\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}