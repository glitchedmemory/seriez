{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":43961,\"title\":\"The Sarah Millican Television Programme\",\"tagline\":\"\",\"overview\":\"The Sarah Millican Television Programme is a British comedic television show about television. It is shown on BBC Two and is hosted by comedian Sarah Millican. It began on 8 March 2012 and is scheduled to run for six episodes. A second series was broadcast from Christmas Day 2012 and throughout January, and a third series has been commissioned.\\n\\nAn unbroadcast pilot episode was filmed on 25 May 2011. A series was then commissioned and filmed at the MediaCityUK complex in Salford in late-2011.\\n\\nThe series is a co-production by So Television and Millican's own company, Chopsy Productions.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/7wP4twhiqpKZFmxdxEtUrP60ziW.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/g5IpxvKtRT9LrskmBRpBAhL4fOL.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.9,\"voteCount\":8,\"year\":2012,\"genres\":[\"Comedy\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":18,\"createdBy\":[],\"networks\":[\"BBC Two\"],\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"}],\"lastAirDate\":\"2013-10-29\",\"cast\":[{\"id\":221882,\"name\":\"Sarah Millican\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/g3CbMlFePexOiffZEiuZ2A7xCEa.jpg\"}],\"trailers\":[{\"key\":\"xjS8Ie8RWns\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"WdOV3xr-kzQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"-v0Ih5C5jg4\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[],\"seasonNumber\":3,\"seasonName\":\"Season 3\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/7wP4twhiqpKZFmxdxEtUrP60ziW.jpg\",\"seasonAirDate\":\"2013-09-24\",\"episodes\":[{\"number\":1,\"name\":\"Episode 1\",\"overview\":\"Sarah Mill