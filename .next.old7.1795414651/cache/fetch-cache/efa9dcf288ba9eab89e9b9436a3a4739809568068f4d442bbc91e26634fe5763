{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":68006,\"title\":\"Taken\",\"tagline\":\"\",\"overview\":\"The origin story of younger, hungrier, former Green Beret Bryan Mills as he deals with a personal tragedy that shakes his world. As he fights to overcome the incident and exact revenge, Mills is pulled into a career as a deadly CIA operative, a job that awakens his very particular, and very dangerous, set of skills.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/5TgdridU2w1pVsbQB2pt1xvazBX.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/f3kPFcnHNFFIb0fVZpbiJHX5GYb.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.5,\"voteCount\":280,\"year\":2017,\"genres\":[\"Action & Adventure\",\"Crime\",\"Drama\",\"Comedy\"],\"status\":\"Canceled\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":26,\"createdBy\":[\"Alexander Cary\"],\"networks\":[\"NBC\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2018-06-30\",\"cast\":[{\"id\":63270,\"name\":\"Romeo Tirone\",\"character\":\"Director\",\"photo\":null},{\"id\":222108,\"name\":\"David Wellington\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/uSiyGzGwrlZFZhFRWgBQd29fC0C.jpg\"},{\"id\":55079,\"name\":\"Lukas Ettlin\",\"character\":\"Director\",\"photo\":null},{\"id\":108072,\"name\":\"Ruba Nadda\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/1hdoDSMTVacUqSIOyfqdetZts77.jpg\"},{\"id\":1177777,\"name\":\"Alex Graves\",\"character\":\"Director\",\"photo\":null},{\"id\":26850,\"name\":\"Eduardo Sánchez\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/avKJyjTHky4OenGxepCjj1BYZYB.jpg\"},{\"id\":56435,\"name\":\"Stephen Kay\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/9HsKUi7Ab5jtIQ59OOGyvBtfJRI.jpg\"},{\"id\":20976,\"name\":\"T.J. Scott\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/2sDOBP18EL5qeGTRt1SUHAIfdWa.jpg\"},