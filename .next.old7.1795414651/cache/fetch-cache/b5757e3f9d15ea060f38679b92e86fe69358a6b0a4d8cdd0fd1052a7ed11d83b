,\"year\":2022,\"type\":\"tv\",\"_score\":0.41935483870967744,\"_genreOverlap\":1},{\"id\":61952,\"title\":\"Rankin Presents\",\"poster\":null,\"rating\":0,\"year\":2014,\"type\":\"tv\",\"_score\":0.4181818181818182,\"_genreOverlap\":1},{\"id\":105465,\"title\":\"Homemade\",\"poster\":\"https://image.tmdb.org/t/p/w780/26GU1SxoQ70jTdLxje0spWjRo0V.jpg\",\"rating\":5.5,\"year\":2020,\"type\":\"tv\",\"_score\":0.4181818181818182,\"_genreOverlap\":1},{\"id\":214619,\"title\":\"The King\",\"poster\":\"https://image.tmdb.org/t/p/w780/4bcVytWyujYnwtRtynLE0ouAgh0.jpg\",\"rating\":8.2,\"year\":2022,\"type\":\"tv\",\"_score\":0.41500000000000004,\"_genreOverlap\":1},{\"id\":332105,\"title\":\"Norway from the Air\",\"poster\":\"https://image.tmdb.org/t/p/w780/xoPk48nUoIsbF05rBVfxCy5mjB.jpg\",\"rating\":0,\"year\":2018,\"type\":\"tv\",\"_score\":0.41500000000000004,\"_genreOverlap\":1},{\"id\":74860,\"title\":\"1Minute of Nature\",\"poster\":null,\"rating\":0,\"year\":2015,\"type\":\"tv\",\"_score\":0.4142857142857143,\"_genreOverlap\":1},{\"id\":302437,\"title\":\"Éric Lapointe\",\"poster\":\"https://image.tmdb.org/t/p/w780/tKjCZShp5q2E2sPcnN3lpF86HUk.jpg\",\"rating\":7,\"year\":2025,\"type\":\"tv\",\"_score\":0.4142857142857143,\"_genreOverlap\":1},{\"id\":281913,\"title\":\"Britney: No Filter\",\"poster\":\"https://image.tmdb.org/t/p/w780/onSgJD11TEAUyiB9WQxt3kFaTgF.jpg\",\"rating\":7.2,\"year\":2025,\"type\":\"tv\",\"_score\":0.41034482758620694,\"_genreOverlap\":1},{\"id\":283396,\"title\":\"Juan Gabriel: I Must, I Can, I Will\",\"poster\":\"https://image.tmdb.org/t/p/w780/mHj6BA1TWnNRy8OnEkbBiRSYZH9.jpg\",\"rating\":8.6,\"year\":2025,\"type\":\"tv\",\"_score\":0.408955223880597,\"_genreOverlap\":1},{\"id\":323994,\"title\":\"Why?\",\"poster\":\"https://image.tmdb.org/t/p/w780/dMje59rsumj3SryxV4PIVHYfGYJ.jpg\",\"rating\":0,\"year\":2026,\"type\":\"tv\",\"_score\":0.408955223880597,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":null,\"seasonAirDate\":\"2010-12-01\",\"episodes\":[{\"number\":1,\"name\":\"Meet Charice\",\"overview\":\"Meet Charice! It's double the fun as she celebrates her eighteenth birthday and the upcoming release of her first solo album. Charice gets ready for the press tour ahead and prepares to promote the launch of her self titled record!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-01\",\"runtime\":5},{\"number\":2,\"name\":\"Charice Rocks \\\"Pyramid\\\" Live with Iyaz\",\"overview\":\"On the day her album drops, Charice heads to QVC to perform her hit songs -live! Recording artist, Iyaz, joins in on the fun to perform their hit single, \\\"Pyramid,\\\" and with the guidance of the legendary music producer, David Foster, Charice rocks the sound stage and has a successful day!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-03\",\"runtime\":5},{\"number\":3,\"name\":\"Charice on the Road: NYC\",\"overview\":\"Life on the road is fast paced, but Charice is a pro! She travels to New York City for photo shoots, interviews and press meet-and-greets to tell her story. Even though her day is full of events, Charice always has time to check in with her fans and updates her Twitter so they can follow her adventures!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-08\",\"runtime\":5},{\"number\":4,\"name\":\"Charice on the Road: LA & Wango Tango\",\"overview\":\"It's off to Los Angeles for the Wango Tango concert. Charice spends some quality time with fans and hits the stage with Iyaz to perform their hit in front of a huge crowd! Then, it's off to the recording studio to record her next hit single. This singing sensation is non-stop!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-10\",\"runtime\":5},{\"number\":5,\"name\":\"Charice on the Road: Tokyo\",\"overview\":\"Next stop, Tokyo! Charice flies around the world to visit the record label and performs for the Japanese media. After sharing her story and her voice, it's time for a photo shoot where Charice poses for her Japanese album cover. She's an international superstar in the making!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-15\",\"runtime\":5},{\"number\":6,\"name\":\"Welcome Home Charice!\",\"overview\":\"Charice travels home to the Philippines to promote her new album and gets some down time to celebrate her birthday with family and friends. Then, she's back to work performing for the local Filipino children at the Enchanted Kingdom where she gets a surprise of her own!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-17\",\"runtime\":5},{\"number\":7,\"name\":\"Charice Taps Into Her Spiritual Side\",\"overview\":\"Taking some time out for her spiritual side, Charice celebrates turning eighteen by being baptized with her brother, Carl. Things don't slow down for long because her long awaited album is released in the Philippines and Charice is greeted with the largest audience she has ever performed for.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-22\",\"runtime\":5},{\"number\":8,\"name\":\"Charice Gives Back\",\"overview\":\"Charice wants to make sure that the less fortunate children of the Philippines get to experience some of the best parts of being a kid and having fun. She takes some time out of her tour to connect with the children that remind her of her humble beginnings. Then, after a quick costume change and a little makeup, Charice performs on a popular musical variety show in her homeland!\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-24\",\"runtime\":5},{\"number\":9,\"name\":\"Charice on the Road: Allentown, PA\",\"overview\":\"Back in the United States, Charice reunites with Iyaz to award the winners of the \\\"Don't Text and Drive\\\" campaign in Allentown, Pennsylvania. The small all-girl school is blown away by the duo's performance and Charice and Iyaz earn some unexpected new fans.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-29\",\"runtime\":5},{\"number\":10,\"name\":\"Charice the Fashionista\",\"overview\":\"Charice continues her press tour on the east coast and in between performances Iyaz and Charice take some time out for their favorite activity! They take a break to shop at a local mall and Charice reveals a second love: fashion. Next up on her busy schedule, Charice headlines a show at Mayfair where she's met with an amazing crowd.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2010-12-31\",\"runtime\":5},{\"number\":11,\"name\":\"The Glitch\",\"overview\":\"Charice continues on a non-stop roller coaster ride promoting her album. She makes a quick stop in Pennsylvania to do a radio interview with KISS-FM before she is whisked off to perform at another show. Things don't go smoothly when Charice is faced with some equipment problems during the sound check, but she doesn't let the glitch ruin the show for her fans.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2011-01-05\",\"runtime\":5},{\"number\":12,\"name\":\"Charice: 30 Days Later\",\"overview\":\"As her thirty day press tour winds down, Charice takes time out for some fun at Six Flags where she feeds tigers with her brother, Carl. She's still a kid, after all! Charice reflects back on the past month's adventures and looks ahead to the promising future in store.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2011-01-07\",\"runtime\":5}],\"firstAirDate\":\"2010-12-01\"}","status":200,"url":""},"revalidate":86400,"tags":[]}