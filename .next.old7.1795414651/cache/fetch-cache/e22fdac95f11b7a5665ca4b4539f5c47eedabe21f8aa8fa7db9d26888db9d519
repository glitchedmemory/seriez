{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":4341,\"title\":\"Hey Hey It's Saturday\",\"tagline\":\"\",\"overview\":\"Hey Hey It's Saturday was a long-running variety television program on Australian television. It initially ran for 27 years, debuting on the Nine Network on 9 October 1971 and broadcasting its last episode on 20 November 1999. Its host throughout its entire run was Daryl Somers, who would later become executive producer of the program. The original producer, Gavin Disney, left the program in the 1980s and Somers then jointly formed his own production company, Somers Carroll Productions, with on-screen partner Ernie Carroll, the performer of Somers' puppet sidekick Ossie Ostrich.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/bCbqPGcWm8Brz4s7rPJOXWduz9A.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/rcIKsCfu9FhdCqt9UMFiUfUVJcU.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":1971,\"genres\":[\"Comedy\",\"Family\",\"Talk\"],\"status\":\"In Production\",\"type\":\"tv\",\"totalSeasons\":29,\"totalEpisodes\":681,\"createdBy\":[\"Daryl Somers\",\"Gavin Disney\",\"Ernie Carroll\"],\"networks\":[\"Nine Network\",\"Seven Network\"],\"countries\":[{\"code\":\"AU\",\"name\":\"Australia\"}],\"lastAirDate\":\"2010-11-27\",\"cast\":[{\"id\":1214372,\"name\":\"Livinia Nixon\",\"character\":\"Unknown\",\"photo\":null},{\"id\":1236467,\"name\":\"Red Symons\",\"character\":\"Unknown\",\"photo\":null},{\"id\":138577,\"name\":\"Wilbur Wilde\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/Dh8fmthfimDa5Oygj5oBl0dT59.jpg\"},{\"id\":1236468,\"name\":\"Jacki MacDonald\",\"character\":\"Unknown\",\"photo\":null},{\"id\":1234640,\"name\":\"Daryl Somers\",\"character\":\"Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/xl1hHGtMY24X5FJvAGLeyPLqUxb.jpg\"},{\"id\":1685218,\"name\":\"John Blackman\",\"character\":\"Unknown\",\"photo\":null}],\"trailers\":[{\"key\":\"_KShxkyD5TA\",\"name\"