Until\":null},{\"id\":273248,\"title\":\"The Hateful Eight\",\"poster\":\"https://image.tmdb.org/t/p/w780/jIywvdPjia2t3eKYbjVTcwBQlG8.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7g1zO5t0bd27Iqn5ZUDJmksOGPJ.jpg\",\"rating\":7.8,\"year\":2015,\"type\":\"movie\",\"overview\":\"Bounty hunters seek shelter from a raging blizzard and get caught up in a plot of betrayal and deception.\",\"genres\":[\"Drama\",\"Mystery\",\"Western\"],\"daysUntil\":null},{\"id\":9023,\"title\":\"Spirit: Stallion of the Cimarron\",\"poster\":\"https://image.tmdb.org/t/p/w780/bBEkKDQFianNYwGWR7gJfPVakmG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/b8hPBW0NJmiIVzvQjT3CwIpAdzl.jpg\",\"rating\":7.7,\"year\":2002,\"type\":\"movie\",\"overview\":\"Against impossible odds, Spirit, a young mustang, sets out across the majestic wilderness to regain his freedom and save his homeland. Along the way, he forms a friendship with a young Lakota brave, outwits a squadron of soldiers, and ultimately, finds love.\",\"genres\":[\"Adventure\",\"Animation\",\"Drama\"],\"daysUntil\":null},{\"id\":338766,\"title\":\"Hell or High Water\",\"poster\":\"https://image.tmdb.org/t/p/w780/ljRRxqy2aXIkIBXLmOVifcOR021.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/rmPx82V79OetmdWDkyw1gyED6OE.jpg\",\"rating\":7.3,\"year\":2016,\"type\":\"movie\",\"overview\":\"A divorced dad and his ex-con brother resort to a desperate scheme in order to save their family's farm in West Texas.\",\"genres\":[\"Western\",\"Crime\",\"Drama\"],\"daysUntil\":null},{\"id\":44264,\"title\":\"True Grit\",\"poster\":\"https://image.tmdb.org/t/p/w780/tCrB8pcjadZjsDk7rleGJaIv78k.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/5dwlH8Krm2bsuc2Pubw2cBb03g5.jpg\",\"rating\":7.3,\"year\":2010,\"type\":\"movie\",\"overview\":\"Following the murder of her father by a hired hand, a 14-year-old farm girl sets out to capture the killer. To aid her, she hires the toughest U.S. Marshal she can find—a man with 'true grit'—Reuben J. 'Rooster' Cogburn.\",\"genres\":[\"Drama\",\"Adventure\",\"Western\"],\"daysUntil\":null},{\"id\":698508,\"title\":\"Redeeming Love\",\"poster\":\"https://image.tmdb.org/t/p/w780/2iu0lBF7sfAioLfSnSJtdKxlms6.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/lD8dFIk9wDEvOwZw0RB47e346io.jpg\",\"rating\":7.8,\"year\":2022,\"type\":\"movie\",\"overview\":\"A young couple's relationship clashes with the harsh realities of the California Gold Rush of 1850. Angel, experiencing love for the first time and facing demons unsurmountable, runs from the new life she doesn't believe she deserves. When Michael sets out to find her, Angel discovers that she indeed has the power to choose the life she wants.\",\"genres\":[\"Romance\",\"Drama\",\"Western\"],\"daysUntil\":null},{\"id\":4512,\"title\":\"The Assassination of Jesse James by the Coward Robert Ford\",\"poster\":\"https://image.tmdb.org/t/p/w780/xMKn6EQS7eR5ubhPJbw5pQSBZMw.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/3HvQ5PaxwQJEiRSZD5AyVuqEiNn.jpg\",\"rating\":7.1,\"year\":2007,\"type\":\"movie\",\"overview\":\"Outlaw Jesse James is rumored to be the 'fastest gun in the West'. An eager recruit into James' notorious gang, Robert Ford eventually grows jealous of the famed outlaw and, when Robert and his brother sense an opportunity to kill James, their murderous action elevates their target to near mythical status.\",\"genres\":[\"Drama\",\"Western\"],\"daysUntil\":null},{\"id\":384680,\"title\":\"Hostiles\",\"poster\":\"https://image.tmdb.org/t/p/w780/rqoezyB51GfhiloOB5ZErg5HXas.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/vBSsIyWExRpe3Robi8SAnayrMq1.jpg\",\"rating\":7,\"year\":2017,\"type\":\"movie\",\"overview\":\"A legendary Native American-hating Army captain nearing retirement in 1892 is given one last assignment: to escort a Cheyenne chief and his family through dangerous territory back to his Montana reservation.\",\"genres\":[\"Drama\",\"Western\",\"History\"],\"daysUntil\":nu