{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":15161,\"title\":\"Click\",\"tagline\":\"\",\"overview\":\"Your user-friendly guide to the latest technology news, issues, gadgets and apps.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/osUNbnb0iVTRpyhNnO153ddfXBh.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/1fTT1y42YVCaYb8lcRxCMPTGvrx.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.1,\"voteCount\":10,\"year\":2000,\"genres\":[\"News\",\"Documentary\"],\"status\":\"Canceled\",\"type\":\"tv\",\"totalSeasons\":26,\"totalEpisodes\":1005,\"createdBy\":[\"Stephen Cole\"],\"networks\":[\"BBC World News\",\"BBC News\"],\"countries\":[{\"code\":\"GB\",\"name\":\"GB\"}],\"lastAirDate\":\"2025-03-22\",\"cast\":[{\"id\":2344657,\"name\":\"Spencer Kelly\",\"character\":\"Self - Presenter\",\"photo\":\"https://image.tmdb.org/t/p/w780/sKZiay6vTpRxQqRco68BOF2vDPO.jpg\"}],\"trailers\":[{\"key\":\"Z6EtjtU-oxA\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"PYh8wO9ODVk\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"2QoFtgc6gU8\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":95696,\"title\":\"The Age of A.I.\",\"poster\":\"https://image.tmdb.org/t/p/w780/ccOtYMsGr7xUGgDFS7Tsx32fItv.jpg\",\"rating\":8.1,\"year\":2019,\"type\":\"tv\",\"_score\":0.225,\"_genreOverlap\":1},{\"id\":62040,\"title\":\"Battle Stations\",\"poster\":\"https://image.tmdb.org/t/p/w780/iggY9wJDvEh18Wyjga79BhREEVC.jpg\",\"rating\":2,\"year\":2000,\"type\":\"tv\",\"_score\":0.2236842105263158,\"_genreOverlap\":1},{\"id\":132300,\"title\":\"Murder on the Internet\",\"poster\":\"https://image.tmdb.org/t/p/w780/8tUXz8gN8Hl52N0s1DaGZbB3A2y.jpg\",\"rating\":0,\"year\":2017,\"type\":\"tv\",\"_score\":0.21935483870967742,\"_genreOverlap\":1},{\"id\":95863,\"title\":\"Retro Tech\",\"poster\":\"https://image.tmdb.org/t/p/w780/KqUND422kGEVWCGgYYvW8NrJAm.jpg\",\"rating\":9,\"year\":2019,\"type\":\"tv\",\"_score\":0.21875,\"_genreOverlap\":1},{\"id\":60891,\"title\":\"Nature Tech\",\"poster\":\"https://image.tmdb.org/t/p/w780/eGM2ntlpzK63SAX4DUEqe60tuyE.jpg\",\"rating\":10,\"year\":2006,\"type\":\"tv\",\"_score\":0.2173076923076923,\"_genreOverlap\":1},{\"id\":215920,\"title\":\"Oddity Archive\",\"poster\":\"https://image.tmdb.org/t/p/w780/xR3vmpzfzyhiEwaTO2BwUfeHY4a.jpg\",\"rating\":8,\"year\":2012,\"type\":\"tv\",\"_score\":0.2173076923076923,\"_genreOverlap\":1},{\"id\":64220,\"title\":\"Breakthrough\",\"poster\":\"https://image.tmdb.org/t/p/w780/n8QaodjwN1lbHnU0HnksJS64xiF.jpg\",\"rating\":6,\"year\":2015,\"type\":\"tv\",\"_score\":0.21714285714285714,\"_genreOverlap\":1},{\"id\":212062,\"title\":\"Dirty Rotten Scammers\",\"poster\":\"https://image.tmdb.org/t/p/w780/csk5hLmGsTHuvmyujeRV6TXHRwI.jpg\",\"rating\":0,\"year\":2022,\"type\":\"tv\",\"_score\":0.2153846153846154,\"_genreOverlap\":1},{\"id\":312811,\"title\":\"Carrier Strike Group 8\",\"poster\":\"https://image.tmdb.org/t/p/w780/oxWovviScMBHVcATviJF4Z0B86n.jpg\",\"rating\":0,\"year\":2018,\"type\":\"tv\",\"_score\":0.21250000000000002,\"_genreOverlap\":1},{\"id\":64607,\"title\":\"Dark Net\",\"poster\":\"https://image.tmdb.org/t/p/w780/tWeJD3WEf1NkmBviPlzUOHmtKMd.jpg\",\"rating\":5.8,\"year\":2016,\"type\":\"tv\",\"_score\":0.2109090909090909,\"_genreOverlap\":1},{\"id\":1044,\"title\":\"Planet Earth\",\"poster\":\"https://image.tmdb.org/t/p/w780/bNcNxUtZ520d5de5s78onoiSiwQ.jpg\",\"rating\":8.6,\"year\":2006,\"type\":\"tv\",\"_score\":0.21000000000000002,\"_genreOverlap\":1},{\"id\":313406,\"title\":\"Chernobyl: Inside the Meltdown\",\"poster\":\"https://image.tmdb.org/t/p/w780/h6pIX1Q7TgqoKt4Gg4APDJtc8D1.jpg\",\"rating\":8.6,\"year\":2026,\"type\":\"tv\",\"_score\":0.21000000000000002,\"_genreOverlap\":1}],\"seasonNumber\":19,\"seasonName\":\"2018\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/osUNbnb0iVTRpyhNnO153ddfXBh.jpg\",\"seasonAirDate\":\"2018-01-06\",\"episodes\":[{\"number\":1,\"name\":\"Live and Clicking\",\"overview\":\"Click shows off the highlights from its recent 'live' show including levitating food and advice about how to stay secure online.\",\"still\":\"https://image.tmdb.org/t/p/w780/el0rOvrePe6WEtKZiUnue6Zbw0b.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-01-06\",\"runtime\":30},{\"number\":2,\"name\":\"Viva Las Vegas\",\"overview\":\"A comprehensive guide to all the latest gadgets, websites, games and computer industry news.\\n\\nClick reports from the world's biggest tech show, CES. With the latest in rollable TVs, VR and AR, security gadgets and a drone light show.\",\"still\":\"https://image.tmdb.org/t/p/w780/7sIudgs2hEC3HKz8Nvzc49oCjd8.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-01-13\",\"runtime\":30},{\"number\":3,\"name\":\"High Tech Highway\",\"overview\":\"Following on from their CES show, Click remains in the USA to visit the Las Vegas traffic management centre to see how Las Vegas authorities and roads are using new predictive analytics to plan and react better to emergencies. We explore self-driving bike options, how Honda is working on creating robots with emotions, travel in an autonomous bus, discuss the smart city of the future, and finally relax in a bar staffed by robots.\",\"still\":\"https://image.tmdb.org/t/p/w780/eG1NEE8fQ0aAdwqLNxBTg9yxW7k.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-01-20\",\"runtime\":30},{\"number\":4,\"name\":\"Cheating Death in Silicon Valley\",\"overview\":\"Click investigates technologies promising to help you live longer, from young blood plasma injections to preserving your body for future resurrection.\",\"still\":\"https://image.tmdb.org/t/p/w780/4lDjDZjrFWLIEiJ1Vv5Shqx6xRs.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-01-27\",\"runtime\":30},{\"number\":5,\"name\":\"Law and Order: Dubai\",\"overview\":\"Click is in Dubai meeting the newest members of the police force, police Bots.\\n\\nClick go to a hospital where surgeons are using augmented reality to visualise tumours to improve diagnosis and treatment. The team also go to New York to see a fashion company that is combining style with assistive tech making bespoke pieces of clothing for disabled people. And a visit to a university that is trying to see if we can use tech to monitor and record the level of pollution from our vehicles and could we be taxed according to how much we pollute.\",\"still\":\"https://image.tmdb.org/t/p/w780/wGcl0eHLr9rPPFPHrqJnpSPdOXT.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-02-03\",\"runtime\":30},{\"number\":6,\"name\":\"The Sky's the Limit\",\"overview\":\"Click takes to the skies to report on flying cabs and smarter airports. Plus the NHS is using VR to help calm fear and how Blade Runner 2049 looked so good.\",\"still\":\"https://image.tmdb.org/t/p/w780/sMLQdaw3wqqD3dOznc2MuGShnb2.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-02-10\",\"runtime\":30},{\"number\":7,\"name\":\"Let There Be Light\",\"overview\":\"A remote village in the corner of the Himalayas receives electricity for the first time. What does it mean for the daily lives of the villagers?\",\"still\":\"https://image.tmdb.org/t/p/w780/1sWJ67pe0iu8qAnWxImqKg47eEN.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-02-17\",\"runtime\":30},{\"number\":8,\"name\":\"Your Face or Mine\",\"overview\":\"Click is looking at how Artificial Intelligence is breaking out of uni labs and moving into the public domain, allowing regular people to insert fake faces into videos. They explore how this will impact trust in videos we see online and look how it is already being used to insert famous faces into porn videos.\\n\\nThey are also at a Nintendo event looking at DIY controllers and go behind the scenes and speak to the VFX team behind Planet of the Apes.\",\"still\":\"https://image.tmdb.org/t/p/w780/qG3jcy0cG5GGHcOEKFwkWIqNSTn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-02-24\",\"runtime\":30},{\"number\":9,\"name\":\"All Aboard to Barcelona\",\"overview\":\"Click heads to the Mobile World Congress in Barcelona to find out the latest in the world of smartphones, takes a trip in a holoportal and chats to the Oscar-nominated visual effects supervisor of Star Wars: The Last Jedi.\",\"still\":\"https://image.tmdb.org/t/p/w780/lPnBumakVENVhMiSbSJ2MONdFxr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-03-03\",\"runtime\":30},{\"number\":10,\"name\":\"International Women's Day\",\"overview\":\"Click heads to Stanford University to meet survivors of sexual abuse and the creators of Callisto - an online reporting tool where victims can record their experiences and send them to campus authorities, potentially helping detect serial offenders.\",\"still\":\"https://image.tmdb.org/t/p/w780/lsT39TUHHbCPtXUylX64LG1nDjo.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-03-10\",\"runtime\":30},{\"number\":11,\"name\":\"AI, Robot\",\"overview\":\"In part one of Future of Work, Click asks if artificial intelligence can help save the NHS. Plus a test of robo-reporters and a look inside a highly automated factory in China.\",\"still\":\"https://image.tmdb.org/t/p/w780/8LpUXHXOt7fjFJCAv4QTa4WzTx8.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-03-17\",\"runtime\":30},{\"number\":12,\"name\":\"Rise of the Machines\",\"overview\":\"Will robots replace human workers? The programme meets the people whose livelihoods might be under threat and those who are doing something about it.\",\"still\":\"https://image.tmdb.org/t/p/w780/xttaEiyWsZRCeLNHA26jikmhzDN.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-03-24\",\"runtime\":30},{\"number\":13,\"name\":\"Who Has Your Data?\",\"overview\":\"Click investigates Facebook's data sharing practices. Who has your personal data and what is being done with it?\",\"still\":\"https://image.tmdb.org/t/p/w780/sszCElMq5WXBVMDBD60itkT3IwF.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-03-30\",\"runtime\":30},{\"number\":14,\"name\":\"OM5G\",\"overview\":\"5G is coming. The next generation of wireless technology will give us self-driving cars, smart cities and could even teach you to score a goal like Messi.\",\"still\":\"https://image.tmdb.org/t/p/w780/x3XleYS7xOS2S0pB94iry035vJ7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-04-07\",\"runtime\":30},{\"number\":15,\"name\":\"Old MacDonald had a farm, AI-A-I/O\",\"overview\":\"Click visits a farm where robots drive tractors, manage a field and pick fruits, vegetables and flowers. Plus the latest news on the Facebook data scandal.\",\"still\":\"https://image.tmdb.org/t/p/w780/tQOJyU0DqCjnjfSJ6TYYwCI9OP1.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-04-14\",\"runtime\":30},{\"number\":16,\"name\":\"Can Drones Deliver?\",\"overview\":\"Click looks at all the latest developments in the field of drones - from America's first commercial drone operation to drones saving lives on the beaches of Australia.\",\"still\":\"https://image.tmdb.org/t/p/w780/yAeZTM75fMKLAcCTlDEbom8xZKN.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-04-21\",\"runtime\":30},{\"number\":17,\"name\":\"Mining for Money\",\"overview\":\"Click visits a cryptocurrency mine in Iceland and investigates 'cryptojacking', the new crime becoming a craze amongst hackers.\",\"still\":\"https://image.tmdb.org/t/p/w780/r8BdnM7UMaMfOLUJs5MCbYgFXgq.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-04-28\",\"runtime\":30},{\"number\":18,\"name\":\"Data Detectives\",\"overview\":\"Click investigates the artificially intelligent software being used by police to assist in custody decisions. Plus how CCTV footage could help high street retailers target people more effectively.\",\"still\":\"https://image.tmdb.org/t/p/w780/vQJsBR5ukDJS9zR7ZmEAtr1ne8C.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-05-05\",\"runtime\":30},{\"number\":19,\"name\":\"Faking It\",\"overview\":\"Click looks at the digital tools that are being used to help authenticate limited edition photos of David Bowie and discover art forgeries. Plus the latest from Google.\",\"still\":\"https://image.tmdb.org/t/p/w780/4Jx3UB3daK5n9JVt1hEsFcXdPnL.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-05-12\",\"runtime\":30},{\"number\":20,\"name\":\"GDPR: What is it good for?\",\"overview\":\"Click looks at how the new data privacy laws introduced in May 2018 will change how people use the internet and social media, as well as how we do business.\",\"still\":\"https://image.tmdb.org/t/p/w780/wkdSMifQ5Ap9suNQqoGBNU9WULU.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-05-19\",\"runtime\":30},{\"number\":21,\"name\":\"It's Been Emotional\",\"overview\":\"Click looks at emotion-detecting technology, mind-controlled movies and facial recognition systems used for the Royal Wedding.\",\"still\":\"https://image.tmdb.org/t/p/w780/pOpdK8j1aBInNxRQbrQi5ABfPNq.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-05-26\",\"runtime\":30},{\"number\":22,\"name\":\"Hey from Hay\",\"overview\":\"Click is at Hay Festival with its latest live show, and the team checks out a new service for blind people that helps them navigate the world like never before.\",\"still\":\"https://image.tmdb.org/t/p/w780/eW87MaCSHyghDokUYCO7inLZEle.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-06-02\",\"runtime\":30},{\"number\":23,\"name\":\"World Cup Click Off\",\"overview\":\"Click looks at the technology behind the World Cup: visiting FIFA HQ, examining the World Cup football, and taking penalties against a robot goalkeeper.\",\"still\":\"https://image.tmdb.org/t/p/w780/mS73dqRliSKiEhy4AvVnUKH6wUe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-06-09\",\"runtime\":30},{\"number\":24,\"name\":\"Inside E3 - The World's Largest Gaming Expo\",\"overview\":\"Click is at the world's biggest video game expo, E3 in Los Angeles, to check out all the latest releases and news from the world of gaming.\",\"still\":\"https://image.tmdb.org/t/p/w780/9VOa8ajZDm4pmdmJMlzztq8Q1UJ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-06-16\",\"runtime\":30},{\"number\":25,\"name\":\"Sustainable States\",\"overview\":\"A sustainability special. Click visits America's first sustainable solar-powered town, takes a spin in a solar-powered autonomous shuttle, visits the world's leading hurricane and wind research lab at the University of Miami and goes down under to see how technology is being used to protect the world's largest coral collection at the Great Barrier Reef.\",\"still\":\"https://image.tmdb.org/t/p/w780/uxvd7CmytHtelzlTvDYAYxYmf58.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-06-23\",\"runtime\":30},{\"number\":26,\"name\":\"Can AI Beat a GP?\",\"overview\":\"Jen Copestake is in Rwanda to see if AI could be better at diagnosing illness than a GP. Plus an exclusive look at one of the world's most advanced robots.\",\"still\":\"https://image.tmdb.org/t/p/w780/5OQU7ICSJTCwqKIdXFXnFPqyxj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-06-30\",\"runtime\":30},{\"number\":27,\"name\":\"Inside MIT's AI Workshop\",\"overview\":\"Click heads to MIT's CSAIL to check out its weird and wonderful robotic research, and visits Wimbledon to see how AI is set to transform the tennis tournament.\",\"still\":\"https://image.tmdb.org/t/p/w780/wyrz2eO8bGFGWXHZD8Ebn9KNMeB.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-07-07\",\"runtime\":30},{\"number\":28,\"name\":\"Grand Tech Auto\",\"overview\":\"Strap in as Click is at the races, with exclusive access behind-the-scenes at the Austrian Grand Prix. We get up close with Mercedes' Formula One team, who demonstrate how a pitstop can be done in an incredible 1.85 seconds using secret wheel guns and a ballet-like routine. We get under the hood at Formula One, who have recognised a problem... some people find Formula One quite boring. They're fighting back with 360 cameras, Virtual Reality and they're revving up the audio with an in-exhaust-microphone that can withstand 1000 degrees.\\n\\nWe also look at the peculiar challenges of launching self-driving cars on the streets of India and find out how cars are tested to survive hurricanes.\",\"still\":\"https://image.tmdb.org/t/p/w780/vkjKV9pW4P7ZonJZx30ljCfOgyM.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-07-14\",\"runtime\":30},{\"number\":29,\"name\":\"To Infinity and Beyond\",\"overview\":\"The programme takes to the skies with personal air vehicles, flying cars and tech from the Farnborough Airshow.\",\"still\":\"https://image.tmdb.org/t/p/w780/dT3lUV2aDuAxC7BfgTW5YHOq1Ez.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-07-21\",\"runtime\":30},{\"number\":30,\"name\":\"Shooting Stars\",\"overview\":\"Click visits a green monster of a VFX film set in Hollywood, tests the tech behind Tour de France, and heads Down Under to meet the Great Barrier Reef park rangers who are using drones to save green turtles.\",\"still\":\"https://image.tmdb.org/t/p/w780/5YkOBo7wy2yFoRj7hvoDQf7BoOg.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-07-28\",\"runtime\":30},{\"number\":31,\"name\":\"The Age of AI\",\"overview\":\"Click looks at whether AI could ever create an artistic masterpiece and visits Bangladesh to find out how technology is being used to help farmers there.\",\"still\":\"https://image.tmdb.org/t/p/w780/jjGedoGoj54YV1xAebFyDI0OTjF.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-08-04\",\"runtime\":30},{\"number\":32,\"name\":\"Summer Sizzler\",\"overview\":\"It's time for Click's Summer Sizzler! Click take a look at the latest summer gadgets, go on a VR waterslide adventure and even take a hoverboard for a spin.\",\"still\":\"https://image.tmdb.org/t/p/w780/nxllJrm3nRlyA4thPtX8S7exC04.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-08-11\",\"runtime\":30},{\"number\":33,\"name\":\"Summer of Sport\",\"overview\":\"Clicks goes behind the scenes at a data-driven Tour de France, plays football in VR and attempts a Formula One pit stop.\",\"still\":\"https://image.tmdb.org/t/p/w780/6XYAuttUZtU8mxxnMyuxZorNzO7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-08-18\",\"runtime\":30},{\"number\":34,\"name\":\"Moon Walking\",\"overview\":\"Click finds out what it is like to walk on the moon, tries to balance on 'e-skates' and speaks to Google's 'Security Princess'.\",\"still\":\"https://image.tmdb.org/t/p/w780/gF2XOsiz0WLBxYuh96AckwLaPIr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-09-01\",\"runtime\":30},{\"number\":35,\"name\":\"Play Date\",\"overview\":\"Click investigates the emerging phenomenon of gaming addiction - just what is it, and is it over-hyped or something we should all be concerned about? Click meets addicts, those treating them and people from the gaming industry to view this important issue from all angles.\",\"still\":\"https://image.tmdb.org/t/p/w780/fvwVrl7itIfx5cIwDjYXHcCJcEY.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-09-08\",\"runtime\":30},{\"number\":36,\"name\":\"Beyond Borders\",\"overview\":\"A Brexit special: Click look at the technologies that could be used at borders.\",\"still\":\"https://image.tmdb.org/t/p/w780/gN8MNczWNbz1GclqkpDImOTdPIj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-09-15\",\"runtime\":30},{\"number\":37,\"name\":\"Live in India\",\"overview\":\"Click travels to New Delhi, India to put on a very special live show in front of a packed audience of tech fans. We speak to the CEO of Flipkart - India's first billion dollar company, ask if self-driving cars will ever take to the country's roads and discover if India is ready to embrace artificial intelligence and become a rival to Silicon Valley.\",\"still\":\"https://image.tmdb.org/t/p/w780/40o1hosorxbYYc1Kfkp8KaxWwzE.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-09-22\",\"runtime\":30},{\"number\":38,\"name\":\"Who Controls Your Data?\",\"overview\":\"Click looks at new calls for personal data to be handled differently, including an interview with Sir Tim Berners-Lee, inventor of the World Wide Web.\",\"still\":\"https://image.tmdb.org/t/p/w780/5aPod8B54fKqd4zekCPOxNgjjso.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-09-29\",\"runtime\":30},{\"number\":39,\"name\":\"Billionaire Books Mini Break To The Moon\",\"overview\":\"The latest camera tech comes under the spotlight and we meet the billionaire who has booked a trip around the moon.\",\"still\":\"https://image.tmdb.org/t/p/w780/xfWpXAJlsEUd2JtNv1Y8JxkweJy.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-10-06\",\"runtime\":30},{\"number\":40,\"name\":\"Bringing Colour to World War One\",\"overview\":\"Click chats to director Sir Peter Jackson about his work bringing archive footage from World War One into the 21st century.\",\"still\":\"https://image.tmdb.org/t/p/w780/uhXoKDyqjwjQ1zV5tHBsi0q2ZsQ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-10-13\",\"runtime\":30},{\"number\":41,\"name\":\"Big in Japan\",\"overview\":\"Your user-friendly guide to the latest technology news, issues, gadgets and apps. The programme is in Japan to see the latest gadgets at CEATEC and meet the team who landed a spacecraft on an asteroid. Plus an otherworldly digital art exhibition.\",\"still\":\"https://image.tmdb.org/t/p/w780/iqLQIKSnc3lftvy2bTdlOHsKHmp.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-10-20\",\"runtime\":30},{\"number\":42,\"name\":\"Domo Arigato, Mr Roboto\",\"overview\":\"Click is in Japan discovering the next-gen technologies that are augmenting humans. There are robot legs, robot backpacks and even cars that can read your brainwaves.\",\"still\":\"https://image.tmdb.org/t/p/w780/3LmWRG8XRV3ph87Oym1SpzTxmhA.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-10-27\",\"runtime\":30},{\"number\":43,\"name\":\"The Secrets Behind AI\",\"overview\":\"Click travels to Kenya to meet the low-skilled labourers in Nairobi's slums training AI systems. Plus the team meet Microsoft's CTO of AI for a refreshingly honest chat.\",\"still\":\"https://image.tmdb.org/t/p/w780/csvH3g2Q6Edo1FBb4jZYHA1olz7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-11-03\",\"runtime\":30},{\"number\":44,\"name\":\"Top Quality Fake News\",\"overview\":\"Click talks to people who create fake news and investigates how video and sound can be manipulated. And Chelsea pensioners test a World War I VR app.\",\"still\":\"https://image.tmdb.org/t/p/w780/6uSNZOVbIVr8Q8yhAkdJQr8KQoo.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-11-10\",\"runtime\":30},{\"number\":45,\"name\":\"Putting the Tee in Technology\",\"overview\":\"Click goes swinging with Francesco Molinari, chats death with Hollywood actor Sean Bean and goes under the knife to explore the latest in robotic surgery.\",\"still\":\"https://image.tmdb.org/t/p/w780/epM3FAXL3SWJroxUTKmNlvxEeeG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-11-17\",\"runtime\":30},{\"number\":46,\"name\":\"Trailblazers: The Future of Firefighting\",\"overview\":\"A look at the technology taking firefighting to the next level - from masks that can see through smoke, to trains that battle blazes.\",\"still\":\"https://image.tmdb.org/t/p/w780/hjHMGxKS7MrMkYTW0bao72z5iXo.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-11-24\",\"runtime\":30},{\"number\":47,\"name\":\"Access All Areas\",\"overview\":\"Your user-friendly guide to the latest technology news, issues, gadgets and apps. Click looks at the latest developments in accessibility technology for disabled people.\",\"still\":\"https://image.tmdb.org/t/p/w780/a3IitoVj60MC3yh5QlUXEObT4S5.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-12-01\",\"runtime\":30},{\"number\":48,\"name\":\"Can Tech Save the World?\",\"overview\":\"Your user-friendly guide to the latest technology news. As UN climate change talks get underway, Click asks if policy or technology will save the world.\",\"still\":\"https://image.tmdb.org/t/p/w780/g3cQKqRI8j3j9jnfrm54tCeH7fM.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2018-12-08\",\"runtime\":30},{\"number\":49,\"name\":\"Women in Tech\"