{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":2805,\"title\":\"Soul Food\",\"tagline\":\"\",\"overview\":\"Soul Food: The Series is a television drama that aired Wednesday nights on Showtime from June 28, 2000 to May 26, 2004. Created by filmmaker George Tillman, Jr. and developed for television by Felicia D. Henderson, Soul Food is based upon Tillman's childhood experiences growing up in Wisconsin, and is a continuation of his successful 1997 film of the same name. Having aired for 74 episodes, it is the longest running drama with a predominantly black cast in the history of North American prime-time television.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/pHfIP0C5F0Vh5th9ru3mxhC0Zqc.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/pyCS8oWfBoLdn3eOHlu8q8oYapo.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":7.2,\"voteCount\":14,\"year\":2000,\"genres\":[\"Drama\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":5,\"totalEpisodes\":74,\"createdBy\":[],\"networks\":[\"Showtime\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"},{\"code\":\"CA\",\"name\":\"Canada\"}],\"lastAirDate\":\"2004-05-26\",\"cast\":[{\"id\":166437,\"name\":\"Ken Girotti\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/gzTr9lnkR5FLzM6ezQYlwoSG0Wv.jpg\"},{\"id\":40230,\"name\":\"Kevin Hooks\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/zQIkzw1QsQvnjgLb5TMO4jyoqFY.jpg\"},{\"id\":109095,\"name\":\"Oz Scott\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/sRNIQwZoq9GWmWHAnvDXFG6dv8K.jpg\"},{\"id\":56155,\"name\":\"Stephen Surjik\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/xZAl5XQqf51Yz4maYtLc6HSG62z.jpg\"},{\"id\":23628,\"name\":\"Eriq La Salle\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/3h8c10QW6k7Ck0IWko76SUMiD7F.jpg\"},{\"id\":2390,\"name\":\"LeVar Burton\",\"character\":\"Director\",\"photo\":\"h