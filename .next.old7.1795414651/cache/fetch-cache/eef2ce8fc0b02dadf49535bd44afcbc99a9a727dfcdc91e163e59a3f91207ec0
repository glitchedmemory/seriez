{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":79003,\"title\":\"James Cameron's Story of Science Fiction\",\"tagline\":\"\",\"overview\":\"Explore the evolution of sci-fi from its origins as a small genre with a cult following to the blockbuster pop-cultural phenomenon we know today. In each episode, James Cameron introduces one of the “Big Questions” that humankind has contemplated throughout the ages and reaches back into sci-fi’s past to better understand how our favorite films, TV shows, books, and video games were born.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/qhanotOZnOdgmCZonug5anT0mFo.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/7RizgNN3qH1vjDbhWrJKFoxPfrT.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.8,\"voteCount\":51,\"year\":2018,\"genres\":[\"Documentary\",\"Sci-Fi & Fantasy\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":1,\"totalEpisodes\":6,\"createdBy\":[\"James Cameron\"],\"networks\":[\"AMC\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2018-05-27\",\"cast\":[{\"id\":2710,\"name\":\"James Cameron\",\"character\":\"Self - Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/9NAZnTjBQ9WcXAQEzZpKy4vdQto.jpg\"},{\"id\":6384,\"name\":\"Keanu Reeves\",\"character\":\"Self\",\"photo\":\"https://image.tmdb.org/t/p/w780/8RZLOyYGsoRe9p44q3xin9QkMHv.jpg\"}],\"trailers\":[{\"key\":\"e04_GDLlfrQ\",\"name\":\"James Cameron's Story of Science Fiction: 'Big Questions' Official Teaser\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":214139,\"title\":\"Chart Running Scholar\",\"poster\":\"https://image.tmdb.org/t/p/w780/65P8cJDFB2mo9ElEzYsNrwAH3ZP.jpg\",\"rating\":2,\"year\":2022,\"type\":\"tv\",\"_score\":0.21923076923076923,\"_genreOverlap\":1},{\"id\":246066,\"title\":\"Can You Deliver Time?\",\"poster\":\"https://image.tmdb.org/t/p/w780/j8kWzOnPTILgFxax4RAV9bMEm7t.jpg\",\"rating\":5,\"year\":2020,\"type\":\"tv\",\"_score\":0.2153846153846