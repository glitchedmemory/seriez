id\":283884,\"title\":\"Chuhai Lips: Canned Flavor of Married Women\",\"poster\":\"https://image.tmdb.org/t/p/w780/sVgDf52QbkKRYBXjM4Y2xQOr86X.jpg\",\"rating\":5.6,\"year\":2025,\"type\":\"tv\",\"_score\":0.2111111111111111,\"_genreOverlap\":2},{\"id\":97617,\"title\":\"The Misfit of Demon King Academy\",\"poster\":\"https://image.tmdb.org/t/p/w780/xBNR7V4s5b0qQfRCiyEvIC5PS6v.jpg\",\"rating\":8.4,\"year\":2020,\"type\":\"tv\",\"_score\":0.20991735537190084,\"_genreOverlap\":2},{\"id\":214540,\"title\":\"Dead Mount Death Play\",\"poster\":\"https://image.tmdb.org/t/p/w780/oOlg3bPWOKBgy5kgOTVe8pJz4HI.jpg\",\"rating\":6.9,\"year\":2023,\"type\":\"tv\",\"_score\":0.20849056603773586,\"_genreOverlap\":2}],\"seasonNumber\":5,\"seasonName\":\"Magical Doremi 5\",\"seasonOverview\":\"Unknown secret stories of DO RE MI are exhibited for the first time!\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/dkmpARsHhdEcPTCQJzWunNGNzS5.jpg\",\"seasonAirDate\":\"2004-06-26\",\"episodes\":[{\"number\":1,\"name\":\"Messed Up Cycling ~The Boys' Secret~\",\"overview\":\"Kotake and a group of boys decide to bicycle to Mount Fuji. Doremi, Hazuki, and Aiko have to convince him otherwise.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8721/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-06-26\",\"runtime\":25},{\"number\":2,\"name\":\"New York's MAHO Dou ~Momoko's Secret~\",\"overview\":\"Momoko meets Onpu at New York and tells a story of what happened before she became a witch apprentice.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8722/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-07-10\",\"runtime\":25},{\"number\":3,\"name\":\"The Value of Swimming! ~Aiko's Secret~\",\"overview\":\"The swim meet is nearing and Aiko has been chosen as Anchor for her class. There's only one problem, though...\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8723/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-07-24\",\"runtime\":25},{\"number\":4,\"name\":\"Non-standard ~Onpu's Secret~\",\"overview\":\"Onpu cannot decide on a role for a movie and she reflects on what made her become an idol.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8724/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-08-07\",\"runtime\":25},{\"number\":5,\"name\":\"Someone Who Knows the Sorrow ~Pop and Hana's Secret~\",\"overview\":\"The trouble with Hana is that she isn't potty-trained.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8725/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-08-21\",\"runtime\":25},{\"number\":6,\"name\":\"Sugar Candy Memory ~Baaya's Secret~\",\"overview\":\"When Baaya was younger, she fell in love at first sight with two things. The first was ballet, the other a boy.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8726/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-11-09\",\"runtime\":25},{\"number\":7,\"name\":\"I Love Taiyaki! ~The Parent and Child's Secret~\",\"overview\":\"The son of a Taiyaki maker is fed up with his father criticizing him, and goes to the Maho-do to start his business.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8727/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-11-18\",\"runtime\":25},{\"number\":8,\"name\":\"Recorder Test! ~The Honor Student's Secret~\",\"overview\":\"When a flute is broken by an honor student with a crush, Onpu takes the blame.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8728/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-10-02\",\"runtime\":25},{\"number\":9,\"name\":\"Baseball Club ~The Witches' Secret~\",\"overview\":\"Momoko, inspired by two baseball lovers, makes a team of her own friends and they compete with their first team...\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8729/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-10-16\",\"runtime\":25},{\"number\":10,\"name\":\"Wedding Promise ~Childhood Friends' Secret~\",\"overview\":\"Aiko reunites with Anrima, who made a promise to her when she was younger.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8730/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-10-30\",\"runtime\":25},{\"number\":11,\"name\":\"Valentine's Day ~Hazuki's Secret~\",\"overview\":\"Once upon a time; every Valentine's Day, Hazuki and Masaru swap gifts. There's a reason why they stopped.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8731/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-11-13\",\"runtime\":25},{\"number\":12,\"name\":\"The Seventh Witch Apprentice ~Non-chan's Secret~\",\"overview\":\"Doremi meets a girl named Nozomi in the hospital, who is a fan of witches. She vowed to her, despite her Cancer, that she would become a Witch Apprentice.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8732/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-11-27\",\"runtime\":25},{\"number\":13,\"name\":\"The Doll That Leapt Through Time ~Doremi's Secret~\",\"overview\":\"Doremi meets a mysterious girl named Fami, who shares similar traits with her.\",\"still\":\"https://media.kitsu.app/episodes/thumbnails/8733/original.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2004-12-11\",\"runtime\":25}],\"firstAirDate\":\"1999-02-07\"}","status":200,"url":""},"revalidate":86400,"tags":[]}