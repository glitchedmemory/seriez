\":\"tv\",\"_score\":0.41081081081081083,\"_genreOverlap\":1},{\"id\":98983,\"title\":\"Heartland Docs, DVM\",\"poster\":\"https://image.tmdb.org/t/p/w780/pDFzhXYrCaCbjI5n3Uu7LjbBAUS.jpg\",\"rating\":6.7,\"year\":2020,\"type\":\"tv\",\"_score\":0.4086538461538462,\"_genreOverlap\":1},{\"id\":340370,\"title\":\"Stacey Dooley's Australia: Off the Beaten Track\",\"poster\":\"https://image.tmdb.org/t/p/w780/slMe1fSPFOGt7fkPRBMUnrQZO8F.jpg\",\"rating\":0,\"year\":2026,\"type\":\"tv\",\"_score\":0.4083333333333334,\"_genreOverlap\":1},{\"id\":242681,\"title\":\"The Canadian Angle\",\"poster\":\"https://image.tmdb.org/t/p/w780/lsFPEeWzCOXFvuKe71RjD6NQcIO.jpg\",\"rating\":0,\"year\":2021,\"type\":\"tv\",\"_score\":0.40810810810810816,\"_genreOverlap\":1}],\"seasonNumber\":4,\"seasonName\":\"Season 4\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/hSj88zv9TSHHTQ7Dw44z8hcEX6s.jpg\",\"seasonAirDate\":\"2014-11-05\",\"episodes\":[{\"number\":1,\"name\":\"Shine On\",\"overview\":\"Tim is on the run after his operation was set on fire. Jim Tom prepares for his second coming as a moonshiner. Tickle & Tyler take their partnership to a new level. Josh & Bill sell last year's surplus shine. Jeff & Mark survey an indoor still site.\",\"still\":\"https://image.tmdb.org/t/p/w780/d9EVPPkR6dWAKhJMnewyZcyAGVZ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-11-05\",\"runtime\":42},{\"number\":2,\"name\":\"Moonshine Cascade\",\"overview\":\"Tickle and Tyler need to fix a bad feed line and get back to work at the moonshine cave. Jim Tom and Roy build the still that will carry them to greatness. Josh and Bill are sidelined with a crushed still. Sheriff’s Deputy Chuck gains ground on Lance.\",\"still\":\"https://image.tmdb.org/t/p/w780/auFF1zYUG9yP9Xq1hr4qjnzXVEG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-11-11\",\"runtime\":42},{\"number\":3,\"name\":\"Bullet Proof\",\"overview\":\"Josh & Bill pick up the pieces of their broken still. Lance tries to brew a moonshine game changer as Sheriff's Deputy Chuck closes in. Tickle gets stranded miles from civilization. Tim sets out from Kentucky in search of greener pastures.\",\"still\":\"https://image.tmdb.org/t/p/w780/2ppW3ldGioeKSRyOKeArRmELbJC.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2014-11-18\",\"runtime\":42},{\"number\":4,\"name\":\"Risky Whiskey\",\"overview\":\"Josh and Bill rebuild bigger and better. Lance takes a risk on a new kind of whiskey, while Jeff and Mark prep their indoor still site. Tickle and crew battle the elements in Kentucky. Tim gives the North Carolina distillery a backwoods makeover.\",\"still\":\"https://image.tmdb.org/t/p/w780/tL93bLXbWARhWZVahj16D2D7weh.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-11-25\",\"runtime\":42},{\"number\":5,\"name\":\"Tennessee Rising\",\"overview\":\"Two former still hands of moonshine legend Popcorn Sutton emerge from the shadows. Tim learns that getting out of the illegal liquor business doesn’t get you out of the woods.\",\"still\":\"https://image.tmdb.org/t/p/w780/8FXc5MeKUutKOs9HXr9U6ExoWZ5.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-12-02\",\"runtime\":42},{\"number\":6,\"name\":\"Moonshine Takedown\",\"overview\":\"Tickle nails down a stash spot. Josh and Bill butt heads in the backwoods. Jim Tom and Roy are back in action. Mark and Digger's still goes from old school to state-of-the-art. And Mark and Jeff put the bells and whistles on their new shine spot.\",\"still\":\"https://image.tmdb.org/t/p/w780/fva5C3EcZHEHLJ44j4dOT1eSYZ3.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-12-09\",\"runtime\":42},{\"number\":7,\"name\":\"White Lightning Wars\",\"overview\":\"Mark & Jeff feel the heat as the law closes in. Tim's plan to give a backwoods makeover to Troy's distillery will cost him big. Tickle flirts with disaster as he tries to sell his Kentucky made white lightning.\",\"still\":\"https://image.tmdb.org/t/p/w780/qvBWQd6XTdsudoclNx9jt0ufU3m.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-12-16\",\"runtime\":42},{\"number\":8,\"name\":\"Liquid Assets\",\"overview\":\"Tickle has his hands full keeping track of his liquor and Chico and Tyler are becoming suspicious. Bill and Josh build an underground bunker to hide their shine. Tennessee shiners, Mark and Digger, test an invention that could revolutionize moonshining.\",\"still\":\"https://image.tmdb.org/t/p/w780/6P1fAqNBnedfCiFa8kqs678ry9D.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-12-23\",\"runtime\":42},{\"number\":9,\"name\":\"Shine Jacked\",\"overview\":\"Josh and Bill have a close call with authorities; a new lawman visits two shiners in Tennessee; Tickle learns a lesson the hard way.\",\"still\":\"https://image.tmdb.org/t/p/w780/cxfBk7U6E75qiTcMyrAPpgvaR1m.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2014-12-30\",\"runtime\":42},{\"number\":10,\"name\":\"Moonshine River\",\"overview\":\"Josh and Bill have a triple batch run; Tickle makes a sacrifice to save his partnership; Tim is ready to see if the Asheville distillery can produce his moonshine.\",\"still\":\"https://image.tmdb.org/t/p/w780/iQAJF1rJRq3uosu4AQYgybzC37Z.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2015-01-06\",\"runtime\":42},{\"number\":11,\"name\":\"Shine Overboard\",\"overview\":\"The final weeks of shine season are here. Josh & Bill's liquor gets stuck six feet under. Chico & Tyler brew a sweet & sticky moonshine game-changer. Tickle gets trumped by his old buddy. And Mark & Jeff's first sale on the water ends in disaster.\",\"still\":\"https://image.tmdb.org/t/p/w780/ospKGDSX7lGYaXfbndDEOVLRWeW.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2015-01-13\",\"runtime\":42},{\"number\":12,\"name\":\"Bootleg or Bust\",\"overview\":\"Josh and Bill secretly sell their shine; Tim returns to Virginia to fill an order; Mark tries to make a delivery by boat; Tickle's deal nearly breaks down.\",\"still\":\"https://image.tmdb.org/t/p/w780/kw8wFD8ni4vNrHiCwx5Up5BtrFs.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2015-01-20\",\"runtime\":42},{\"number\":13,\"name\":\"Bros Before Hooch\",\"overview\":\"Tickle takes risks to stay true to his old partner; Josh and Bill make a last run in the woods; Mark and Digger's season is in danger when their deal backfires.\",\"still\":\"https://image.tmdb.org/t/p/w780/z8WgiSpBqCKbB8AfQOlzxC6sME4.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2015-01-27\",\"runtime\":42},{\"number\":14,\"name\":\"The Shining\",\"overview\":\"It’s last call in shine country. Deputy Chuck takes to the water to catch Mark red-handed. Tim & Tickle work together to make a rush delivery of 2,000 cases of liquor in their home state. The cops close in on Josh & Bill with shocking consequences.\",\"still\":\"https://image.tmdb.org/t/p/w780/5hnKK69x0VIHvUhwKH5zDr1gVPX.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2015-02-03\",\"runtime\":42}],\"firstAirDate\":\"2011-12-06\"}","status":200,"url":""},"revalidate":86400,"tags":[]}