{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":475573,\"title\":\"L'après-Midi Près Du Tombeau De Falconetti\",\"tagline\":\"\",\"overview\":\"On a sunny afternoon, an old man sits in the shade of the trees in Montmartre Cemetery in Paris, at the edge of the grave of the great actress Falconetti (1892-1946). She achieved unforgettable recognition as Joan of Arc in Carl Theodor Dreyer's 1928 silent film The Passion of Joan of Arc. She later took her own life in Buenos Aires. Now the old man, Jean-Marie Straub, plays with his cane and keeps her company. Until he is disturbed.\",\"poster\":\"https://image.tmdb.org/t/p/w780/spLfGCwpi9ANX2f9hBga1X8KMaN.jpg\",\"backdrop\":null,\"rating\":0,\"voteCount\":0,\"year\":2012,\"runtime\":0,\"genres\":[],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"BY\",\"name\":\"Belarus\"}],\"budget\":0,\"revenue\":0,\"director\":\"Oleg Tcherny\",\"cast\":[{\"id\":1887438,\"name\":\"Oleg Tcherny\",\"character\":\"Director\",\"photo\":null},{\"id\":935136,\"name\":\"Jean-Marie Straub\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/xj7Z43uVZ6gcXB8yV1xt1Uk4waT.jpg\"}],\"similar\":[],\"videos\":[{\"key\":\"8jg8t4T3gC8\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"A4KClf-vNuw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"MSV_XdVV28Q\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}