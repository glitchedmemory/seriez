y0KRN6G2mhN.jpg\",\"rating\":7.1,\"year\":2023,\"type\":\"tv\",\"_score\":0.20750000000000002,\"_genreOverlap\":2},{\"id\":32037,\"title\":\"Alphablocks\",\"poster\":\"https://image.tmdb.org/t/p/w780/dppvWTIEUSAKJblYoiRP5Pj59yf.jpg\",\"rating\":0,\"year\":2010,\"type\":\"tv\",\"_score\":0.20731707317073172,\"_genreOverlap\":2},{\"id\":283834,\"title\":\"Belfort & Lupin\",\"poster\":\"https://image.tmdb.org/t/p/w780/rkjOvFmOzyl9q2skyTCut1IaTNR.jpg\",\"rating\":9,\"year\":2025,\"type\":\"tv\",\"_score\":0.20600000000000002,\"_genreOverlap\":2},{\"id\":283935,\"title\":\"Touring After the Apocalypse\",\"poster\":\"https://image.tmdb.org/t/p/w780/1WbHcaQcuP0xBkzqvMirvufvxTm.jpg\",\"rating\":7.9,\"year\":2025,\"type\":\"tv\",\"_score\":0.20483870967741938,\"_genreOverlap\":2}],\"seasonNumber\":3,\"seasonName\":\"Season 3\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/mKWn0T2YeC6LtJzf3sc7zliuyGO.jpg\",\"seasonAirDate\":\"2020-10-12\",\"episodes\":[{\"number\":1,\"name\":\"Everything Is Crabs\",\"overview\":\"The hunt is on for Dr. Emilia, and friends start to vanish. It'll take teamwork to make Kipo's dream of a Human Mute Ultimate Friendship Alliance work.\",\"still\":\"https://image.tmdb.org/t/p/w780/A0H8hu64sOsm17z77SkwVgLgq3C.jpg\",\"rating\":9.5,\"voteCount\":4,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":2,\"name\":\"Code Word Milkshake\",\"overview\":\"Emilia's kidnapping her way to a cure. Kipo and her pals must keep their cool as they stake out the doc's unexpected hideout. Does K-pop hold the key?\",\"still\":\"https://image.tmdb.org/t/p/w780/mAuGH9VoG11VoHkUGpWsGWBsm5q.jpg\",\"rating\":9,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":3,\"name\":\"A Wolf in Wolf's Clothing\",\"overview\":\"Old frenemies are on the comeback. Kipo reaches out to alliance stopper Scarlemagne, and Margot asks Wolf for a favor. Are second chances possible?\",\"still\":\"https://image.tmdb.org/t/p/w780/4xww4MfHajiz8oiMmwVSiFpDfqq.jpg\",\"rating\":9,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":4,\"name\":\"Don't You Forget A-Meow Me\",\"overview\":\"With Wolf, Benson and Dave in danger, Kipo must use her brain — not her brawn — to outsmart Dr. Emilia. A Mega gets a helping hand from Scarlemagne.\",\"still\":\"https://image.tmdb.org/t/p/w780/f8kDGcURUY0V55cdp3kOZbh9ZhJ.jpg\",\"rating\":9.7,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":5,\"name\":\"Song ReMix\",\"overview\":\"A \\\"cured\\\" chum returns. Later, a dream family reunion becomes a reality. The race for a vaccine begins after a feverish frolic with the Dubstep Bees.\",\"still\":\"https://image.tmdb.org/t/p/w780/nI5UE5GYxkncwZwyAzq2cdF5cgG.jpg\",\"rating\":9.3,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":6,\"name\":\"It's a Trap\",\"overview\":\"Dr. Emilia and her army work through the death ivy while the alliance creates cunning traps. But can Kipo fight an unstoppable force like destiny?\",\"still\":\"https://image.tmdb.org/t/p/w780/h66MFQFjclI9lBRpdFjp6u0Gfnc.jpg\",\"rating\":9.3,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":7,\"name\":\"Requiem for a Dave\",\"overview\":\"As everyone regroups, Kipo blames herself for the damage done and springs into action. Enter Dave with a tale about fanatics — and one awesome fan.\",\"still\":\"https://image.tmdb.org/t/p/w780/cW8uWdfJnLVtwpUryKeC35xhY8P.jpg\",\"rating\":9,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":8,\"name\":\"Hidden Treasures\",\"overview\":\"Kipo hopes that Prahm will end the war with killer banjo and dance ... but first she must convince the Mutes to forgive. Dr. Emilia smiles and schemes.\",\"still\":\"https://image.tmdb.org/t/p/w780/eetqqS78irvgS5UCs3ZP03fIWHU.jpg\",\"rating\":9,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":9,\"name\":\"Prahmises\",\"overview\":\"Dr. Emilia's determination runs deep — and gets dark. Scarlemagne and Wolf set out to end her, and Song reveals a secret. Let's get the party started!\",\"still\":\"https://image.tmdb.org/t/p/w780/alRiZvFt84Jndcc27GP8WxWqoIr.jpg\",\"rating\":9.3,\"voteCount\":3,\"airDate\":\"2020-10-12\",\"runtime\":23},{\"number\":10,\"name\":\"Age of the Wonderbeasts\",\"overview\":\"Sabotaged! Everyone must work together to stop Dr. Emilia as an epic Mega Mute battle shuts down a successful bash. Now's the time for real heroes.\",\"still\":\"https://image.tmdb.org/t/p/w780/d37u0UEDP9820WPUFYba76mgeEa.jpg\",\"rating\":8,\"voteCount\":5,\"airDate\":\"2020-10-12\",\"runtime\":23}],\"firstAirDate\":\"2020-01-14\"}","status":200,"url":""},"revalidate":86400,"tags":[]}