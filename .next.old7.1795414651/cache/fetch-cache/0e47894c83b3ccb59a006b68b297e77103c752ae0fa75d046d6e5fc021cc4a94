\":6117886,\"name\":\"Cristina Sanabria\",\"character\":\"Olivia (Adolescente)\",\"photo\":\"https://image.tmdb.org/t/p/w780/j3q46NT9CMmgZvAdXTwcuDVE2R3.jpg\"},{\"id\":6117893,\"name\":\"Laura Lancheros\",\"character\":\"Mónica (Adolescente)\",\"photo\":null},{\"id\":5886333,\"name\":\"Isabel Santos\",\"character\":\"Raquel (Adolescente)\",\"photo\":null},{\"id\":4041219,\"name\":\"Valentina Duque\",\"character\":\"Unknown\",\"photo\":\"https://image.tmdb.org/t/p/w780/aLHqgLhRrbb9COp7xOsp4xcyZKT.jpg\"}],\"similar\":[{\"id\":77338,\"title\":\"The Intouchables\",\"poster\":\"https://image.tmdb.org/t/p/w780/1QU7HKgsQbGpzsJbJK4pAVQV9F5.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/q6OGlZ1KMEb14AC8KbPCxyNOal6.jpg\",\"rating\":8.3,\"year\":2011,\"type\":\"movie\",\"overview\":\"A true story of two men who should never have met – a quadriplegic aristocrat who was injured in a paragliding accident and a young man from the projects.\",\"genres\":[\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":490132,\"title\":\"Green Book\",\"poster\":\"https://image.tmdb.org/t/p/w780/7BsvSuDQuoqhWmU2fL7W2GOcZHU.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/5En0fmDagt3Pk8d7P3uTwfeQceg.jpg\",\"rating\":8.2,\"year\":2018,\"type\":\"movie\",\"overview\":\"Tony Lip, a bouncer in 1962, is hired to drive pianist Don Shirley on a tour through the Deep South in the days when African Americans, forced to find alternate accommodations and services due to segregation laws below the Mason-Dixon Line, relied on a guide called The Negro Motorist Green Book.\",\"genres\":[\"Drama\",\"Comedy\",\"History\"],\"daysUntil\":null},{\"id\":508943,\"title\":\"Luca\",\"poster\":\"https://image.tmdb.org/t/p/w780/9x4i9uKGXt8IiiIF5Ey0DIoY738.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/620hnMVLu6RSZW6a5rwO8gqpt0t.jpg\",\"rating\":7.8,\"year\":2021,\"type\":\"movie\",\"overview\":\"Luca and his best friend Alberto experience an unforgettable summer on the Italian Riviera. But all the fun is threatened by a deeply-held secret: they are sea monsters from another world just below the water’s surface.\",\"genres\":[\"Animation\",\"Family\",\"Fantasy\"],\"daysUntil\":null},{\"id\":50646,\"title\":\"Crazy, Stupid, Love.\",\"poster\":\"https://image.tmdb.org/t/p/w780/p4RafgAPk558muOjnBMHhMArjS2.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/vyrCniZsrXZAW08eECKIp1BMLPh.jpg\",\"rating\":7.3,\"year\":2011,\"type\":\"movie\",\"overview\":\"Cal Weaver is living the American dream. He has a good job, a beautiful house, great children and a beautiful wife, named Emily. Cal's seemingly perfect life unravels, however, when he learns that Emily has been unfaithful and wants a divorce. Over 40 and suddenly single, Cal is adrift in the fickle world of dating. Enter, Jacob Palmer, a self-styled player who takes Cal under his wing and teaches him how to be a hit with the ladies.\",\"genres\":[\"Comedy\",\"Drama\",\"Romance\"],\"daysUntil\":null},{\"id\":594,\"title\":\"The Terminal\",\"poster\":\"https://image.tmdb.org/t/p/w780/cPB3ZMM4UdsSAhNdS4c7ps5nypY.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/zywtNiaZ9r7azrcNdl2j0jOgrkw.jpg\",\"rating\":7.4,\"year\":2004,\"type\":\"movie\",\"overview\":\"An Eastern European tourist unexpectedly finds himself stranded in JFK airport, and must take up temporary residence there.\",\"genres\":[\"Comedy\",\"Drama\"],\"daysUntil\":null},{\"id\":937278,\"title\":\"A Man Called Otto\",\"poster\":\"https://image.tmdb.org/t/p/w780/130H1gap9lFfiTF9iDrqNIkFvC9.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/v2LilmCylr3bL9TCZSj6syjowZh.jpg\",\"rating\":7.7,\"year\":2022,\"type\":\"movie\",\"overview\":\"When a lively young family moves in next door, grumpy widower Otto Anderson meets his match in a quick-witted, pregnant woman named Marisol, leading to an unlikely friendship that turns his world upside down.\",\"genres\":[\"Comedy\",\"Drama\"],\"daysUntil\":null},{\"id\":391713,\"title\":\"Lady Bird\",\"poster\":\"https://image.tmdb.org/t/p/w780/gl66K7zRdtNYGrxyS2YDUP5ASZd.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/gDcu0DkF7atjWbJtfpw43yZrNoq.jpg\",\"rating\":7.2,\"year\":2017,\"type\":\"movie\",\"overview\":\"Lady Bird McPherson, a strong willed, deeply opinionated, artistic 17 year old comes of age in Sacramento. Her relationship with her mother and her upbringing are questioned and tested as she plans to head off to college.\",\"genres\":[\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":82693,\"title\":\"Silver Linings Playbook\",\"poster\":\"https://image.tmdb.org/t/p/w780/fhHB1uvfFKKFbj6bTKE8xdtsjKi.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/12GpsUm9nVVKFlcjDTflKLClFVA.jpg\",\"rating\":7.2,\"year\":2012,\"type\":\"movie\",\"overview\":\"After losing his job and wife, and spending time in an institution, a former teacher winds up living with his parents. He wants to rebuild his life and reconcile with his wife, but his father would be happy if he shared his obsession with the Philadelphia Eagles. Things get complicated when he meets Tiffany Maxwell who offers to help him reconnect with his wife if he will do something very important for her in exchange.\",\"genres\":[\"Drama\",\"Comedy\",\"Romance\"],\"daysUntil\":null},{\"id\":674324,\"title\":\"The Banshees of Inisherin\",\"poster\":\"https://image.tmdb.org/t/p/w780/4yFG6cSPaCaPhyJ1vtGOtMD1lgh.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/1vXD5HXqkhvsXFHE7KmCPZGPR1e.jpg\",\"rating\":7.5,\"year\":2022,\"type\":\"movie\",\"overview\":\"Two lifelong friends find themselves at an impasse when one abruptly ends their relationship, with alarming consequences for both of them.\",\"genres\":[\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":10184,\"title\":\"He's Just Not That Into You\",\"poster\":\"https://image.tmdb.org/t/p/w780/jip2ap24Y6JxEgzVRyNqyYssnyR.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/jZkkch6yrP1tVVfEU2uqwej9rBM.jpg\",\"rating\":6.6,\"year\":2009,\"type\":\"movie\",\"overview\":\"Remember that really cute girl/guy who said they'd call – and didn't? Maybe they lost your number. Maybe they're in the hospital. Maybe they're awed by your looks, brains or success. Or maybe... They're just not that into you.\",\"genres\":[\"Comedy\",\"Romance\",\"Drama\"],\"daysUntil\":null},{\"id\":7350,\"title\":\"The Bucket List\",\"poster\":\"https://image.tmdb.org/t/p/w780/idbNSe8zsYKQL97dJApfOrDSdya.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/6OpluXPGIE8hfVrhpeygR7p4XwR.jpg\",\"rating\":7.2,\"year\":2007,\"type\":\"movie\",\"overview\":\"Corporate billionaire Edward Cole and working class mechanic Carter Chambers are worlds apart. At a crossroads in their lives, they share a hospital room and discover they have two things in common: a desire to spend the time they have left doing everything they ever wanted to do and an unrealized need to come to terms with who they are. Together they embark on the road trip of a lifetime, becoming friends along the way and learning to live life to the fullest, with insight and humor.\",\"genres\":[\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":297222,\"title\":\"PK\",\"poster\":\"https://image.tmdb.org/t/p/w780/z2x2Y4tncefsIU7h82gmUM5vnBJ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/gxfvtq5eYiClS2X7hxAAPBNrbWA.jpg\",\"rating\":7.7,\"year\":2014,\"type\":\"movie\",\"overview\":\"A stranger in the city asks questions no one has asked before. Known only by his initials, the man's innocent questions and childlike curiosity take him on a journey of love, laughter and letting go.\",\"genres\":[\"Comedy\",\"Drama\",\"Sci-Fi\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"KLXn2AhAjME\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"rZ6QWqSh3XI\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"iwAo213gjFk\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","s