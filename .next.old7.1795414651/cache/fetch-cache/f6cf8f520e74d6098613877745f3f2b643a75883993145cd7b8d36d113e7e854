{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":43117,\"title\":\"Teen Choice Awards\",\"tagline\":\"\",\"overview\":\"The Teen Choice Awards is a teen awards show presented annually by Fox. The first awards were held in 1999. The program honors the year's biggest achievements in music, movies, sports, television, fashion and more, as voted on by teens aged 13–19. The program features a number of celebrities and also musical performers. The winners are awarded with authentic mini size (182 cm) surfboards designed with a summertime theme. The ceremony has created spin-off teen awards on YouTube.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/3q900BNcKbe3GHga4RVxSnoiqP4.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/pLdOKGTe8LvtW67zyiNqU3512HB.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":9.1,\"voteCount\":10,\"year\":1999,\"genres\":[\"Comedy\",\"Family\",\"Kids\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":21,\"totalEpisodes\":21,\"createdBy\":[],\"networks\":[\"FOX\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2019-08-11\",\"cast\":[],\"trailers\":[{\"key\":\"yJXyg_8-fVs\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"hBueXTLKQJM\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"1mAH28qck8c\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":66379,\"title\":\"Radio Disney Music Awards\",\"poster\":\"https://image.tmdb.org/t/p/w780/nq7jAkkF5j6YO3Zer590ivQlF0e.jpg\",\"rating\":9.6,\"year\":2013,\"type\":\"tv\",\"_score\":0.291324200913242,\"_genreOverlap\":2}],\"seasonNumber\":8,\"seasonName\":\"2006 Teen Choice Awards\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/3q900BNcKbe3GHga4RVxSnoiqP4.jpg\",\"seasonAirDate\":\"2006-08-20\",\"episodes\":[{\"number\":1,\"name\":\"2006 Teen Choice Awards\",\"overview\":\"Th