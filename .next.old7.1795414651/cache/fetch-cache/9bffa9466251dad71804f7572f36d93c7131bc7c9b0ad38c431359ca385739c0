{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":16619,\"title\":\"Super Singer Junior\",\"tagline\":\"Ithu Thamizhagathin Chellakuralukkana Thedal\",\"overview\":\"Super Singer Junior is a reality TV show since February 2007 hosted by Vijay TV. It is a singing talent hunt for the children of age group 6–15. This is the junior version of the Super Singer show.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/qTU82fjeHqD7DnF82BdjNOo2VIn.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/mJEs144YThc7qXSlZy1uNdOJqAW.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":2007,\"genres\":[\"Reality\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":11,\"totalEpisodes\":569,\"createdBy\":[\"Pradeep Milroy Peter\"],\"networks\":[\"STAR Vijay\"],\"countries\":[{\"code\":\"IN\",\"name\":\"IN\"}],\"lastAirDate\":\"2026-10-25\",\"cast\":[{\"id\":6079462,\"name\":\"Vijaya Kumar Vivekanandan\",\"character\":\"Director\",\"photo\":null},{\"id\":1738680,\"name\":\"K. S. Chithra\",\"character\":\"Self - Judge\",\"photo\":\"https://image.tmdb.org/t/p/w780/rKvXtCL4J3ubZzvfNyLJdn57hkB.jpg\"},{\"id\":968459,\"name\":\"Ma Ka Pa Anand\",\"character\":\"Self - Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/7swfB5OrtPhXtR59GpbHY6sNcBl.jpg\"},{\"id\":237662,\"name\":\"D. Imman\",\"character\":\"Self - Judge\",\"photo\":\"https://image.tmdb.org/t/p/w780/dZF2DEx8LKRTUZVt0GCOBQ0JjZ8.jpg\"},{\"id\":1422792,\"name\":\"Anuradha Sriram\",\"character\":\"Self - Judge\",\"photo\":\"https://image.tmdb.org/t/p/w780/eTzC68JPJuT2pXcVSq7ciSHtBpI.jpg\"}],\"trailers\":[{\"key\":\"E_cwBM9P2A4\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"zOPizcSzbmw\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"gSXxtohwdIg\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":41814,\"title\":\"The Voice of Germany\",\"poster\":\"https://image.tmdb.org/t/p/w780/7fp1Yx1uy4HjlgaNSSy0psEtVyn.jpg\",\"rating\":6.1,\"year\":2011,\"type\":\"tv\",\"_score\":0.4348837209302326,\"_genreOverlap\":1},{\"id\":70329,\"title\":\"The Voice : La Plus Belle Voix\",\"poster\":\"https://image.tmdb.org/t/p/w780/4ZDcYogtYL3DisEAx86UAhb5Isf.jpg\",\"rating\":6.8,\"year\":2012,\"type\":\"tv\",\"_score\":0.4342857142857143,\"_genreOverlap\":1},{\"id\":40072,\"title\":\"Arab Idol\",\"poster\":\"https://image.tmdb.org/t/p/w780/JYED9yuRt2a4WOCecsazHkF4ba.jpg\",\"rating\":7,\"year\":2011,\"type\":\"tv\",\"_score\":0.4310344827586207,\"_genreOverlap\":1},{\"id\":2791,\"title\":\"It Takes Two\",\"poster\":null,\"rating\":6,\"year\":2006,\"type\":\"tv\",\"_score\":0.4272727272727273,\"_genreOverlap\":1},{\"id\":65613,\"title\":\"Rising Star\",\"poster\":null,\"rating\":2,\"year\":2016,\"type\":\"tv\",\"_score\":0.4257142857142857,\"_genreOverlap\":1},{\"id\":284226,\"title\":\"The Voice\",\"poster\":\"https://image.tmdb.org/t/p/w780/yb4zib3ua021MiEwA1MPUx2QMC4.jpg\",\"rating\":7,\"year\":2025,\"type\":\"tv\",\"_score\":0.4245901639344262,\"_genreOverlap\":1},{\"id\":13085,\"title\":\"Star Académie\",\"poster\":\"https://image.tmdb.org/t/p/w780/vI8WCgwmIDYgsBXR8kjBBH2s2Ov.jpg\",\"rating\":0,\"year\":2003,\"type\":\"tv\",\"_score\":0.42380952380952386,\"_genreOverlap\":1},{\"id\":39845,\"title\":\"The Voice\",\"poster\":\"https://image.tmdb.org/t/p/w780/t79aBTcPC4vEeeDMv8cWE9tnVwe.jpg\",\"rating\":5.6,\"year\":2012,\"type\":\"tv\",\"_score\":0.42142857142857143,\"_genreOverlap\":1},{\"id\":6124,\"title\":\"Deutschland sucht den Superstar\",\"poster\":\"https://image.tmdb.org/t/p/w780/oRdvhqNtCn6tkCP90crUD7jDgVs.jpg\",\"rating\":5.3,\"year\":2002,\"type\":\"tv\",\"_score\":0.42093023255813955,\"_genreOverlap\":1},{\"id\":39614,\"title\":\"The Voice UK\",\"poster\":\"https://image.tmdb.org/t/p/w780/dLfTwqgw948vgD1NbBVeyonhKN4.jpg\",\"rating\":6.1,\"year\":2012,\"type\":\"tv\",\"_score\":0.41800000000000004,\"_genreOverlap\":1},{\"id\":96907,\"title\":\"The Masked Singer\",\"poster\":\"https://image.tmdb.org/t/p/w780/vMLKuw9l499nhCjozTQatmx139V.jpg\",\"rating\":7,\"year\":2020,\"type\":\"tv\",\"_score\":0.4153846153846154,\"_genreOverlap\":1},{\"id\":95395,\"title\":\"Mask Singer\",\"poster\":\"https://image.tmdb.org/t/p/w780/47VTi9FAQu3TKYEWr3mBGAXx5ip.jpg\",\"rating\":5.8,\"year\":2019,\"type\":\"tv\",\"_score\":0.41333333333333333,\"_genreOverlap\":1}],\"seasonNumber\":11,\"seasonName\":\"Season 11\",\"seasonOverview\":\"Twenty rising stars take centre stage on Super Singer. With daring rounds and legendary mentors, every note tells a story. Who will claim the coveted crown?\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/hUPToua8NUaGbkBHLE2VByLuYJf.jpg\",\"seasonAirDate\":\"2026-05-09\",\"episodes\":[{\"number\":1,\"name\":\"Global Junior Talents\",\"overview\":\"Ma Ka Pa kicks off a musical night From Sejal's melody to Denin's standing ovation Later , Saurabi's shocking Tamil debut, witness the rising stars of Senior Singers.\",\"still\":\"https://image.tmdb.org/t/p/w780/2R3uyZBsgmNFWeyVGuZyCL9gMz6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-09\",\"runtime\":71},{\"number\":2,\"name\":\"A Grand Musical Beginning\",\"overview\":\"A musical celebration of talented little masters begins with an exciting introductory round. Stay tuned to watch the junior singers win hearts with their magical voices!\",\"still\":\"https://image.tmdb.org/t/p/w780/uZxPffYcPJbjeYiXZAsOieVDfG7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-10\",\"runtime\":65},{\"number\":3,\"name\":\"The Selection Showdown\",\"overview\":\"Stay tuned as young contestants deliver breathtaking performances in the Top Twenty selection. As emotions soar, some secure their spots while others are moved to the waiting list.\",\"still\":\"https://image.tmdb.org/t/p/w780/8t9sGVKUAGP4xrdKDWQUPOzOcgp.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-16\",\"runtime\":71},{\"number\":4,\"name\":\"Top 20 Musical Stars\",\"overview\":\"Laya, Sree Vardhini, Aryan and Vishnu enter the Top 20. Visually impaired Sarveshwaran scores 100 percent and touches hearts. Later, Ma Ka Pa welcomes 17 selected contestants.\",\"still\":\"https://image.tmdb.org/t/p/w780/zgllolhN9RYTXJesk8CpTZNLIqU.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-17\",\"runtime\":71},{\"number\":5,\"name\":\"Super Singer Juniors Battle\",\"overview\":\"Ma Ka Pa and Priyanka host as juniors shine. Vaishnavan and Aryan join Imman's team, judges fight over Lenin Berno until he chooses Anuradha, and Sejal delivers a hit solo.\",\"still\":\"https://image.tmdb.org/t/p/w780/b3QfBVjNJK6CkVqCub6AB9gQbBr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-23\",\"runtime\":73},{\"number\":6,\"name\":\"Singing Battle Heats Up\",\"overview\":\"The little masters' singing battle grows intense as judges fiercely compete with stars to win them. Watch the junior singers secure their places on the judges' teams!\",\"still\":\"https://image.tmdb.org/t/p/w780/rQPNdslUnHwh1tQrMbZzv32SK99.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-24\",\"runtime\":64},{\"number\":7,\"name\":\"Team-building in Full Swing!\",\"overview\":\"Judges enjoy energetic acts by Vinu and Mithran. Imman wins Jeanna for his team, while Anuradha bags Surabhi after a standing ovation.\",\"still\":\"https://image.tmdb.org/t/p/w780/ySgvqyOdq0vA2hHzV6HeTeUgNy.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-30\",\"runtime\":63},{\"number\":8,\"name\":\"The Teams are Ready!\",\"overview\":\"Contestants impress with heartfelt performances in the selection round. Anuradha and Imman form strong teams with talented singers for the upcoming weeks.\",\"still\":\"https://image.tmdb.org/t/p/w780/8TF56yjmviHgrlotM4JA7MUSMt6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-05-31\",\"runtime\":61},{\"number\":9,\"name\":\"Grand Musical Night\",\"overview\":\"Ma Ka Pa and Priyanka welcome special judge T. Rajendran to the show. Later, Sarveshwaran overcomes the odds with a stellar performance, making mentor Imman proud.\",\"still\":\"https://image.tmdb.org/t/p/w780/2pbtMvc7fvYywjXgjdBBqxf7FDl.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-06\",\"runtime\":74},{\"number\":10,\"name\":\"A Colourful Show by Little Stars\",\"overview\":\"The stage comes alive as little singers showcase vibrant getups in a fancy dress competitive round. Watch as judges are left amazed by their delightful performances.\",\"still\":\"https://image.tmdb.org/t/p/w780/a61DylLXDdSx7SA6Msc4vgit9Mr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-07\",\"runtime\":65},{\"number\":11,\"name\":\"Exciting Fancy Dress Round!\",\"overview\":\"The fancy dress round turns more exciting as Madonna Sebastian joins the show, delivering stunning performances alongside the little stars. Stay tuned for the fun!\",\"still\":\"https://image.tmdb.org/t/p/w780/k72MBDPCmWTpiGOdSoeb0mIq5iV.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-13\",\"runtime\":64},{\"number\":12,\"name\":\"Soulful Singing to Big Hugs\",\"overview\":\"Judges and hosts join the kids for an unforgettable night of Kathakali dance, triple buzzers, and elite singing. Ma Ka Pa and Priyanka close the show on a comedic note.\",\"still\":\"https://image.tmdb.org/t/p/w780/gTxbGwzAw2EtnP3szi4KAIUxwtk.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-14\",\"runtime\":56},{\"number\":13,\"name\":\"Soulful Duets Ignite the Stage\",\"overview\":\"Musical magic ignites as Vijay Yesudas and Manchari join the judges. Experience the heartfelt duets, standing ovations, and mesmerising judge-contestant collaborations.\",\"still\":\"https://image.tmdb.org/t/p/w780/pBjF7xpBxBqDygc4zsbNzk4ZCHQ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-20\",\"runtime\":63},{\"number\":14,\"name\":\"Sensational Duets Rock the Stage!\",\"overview\":\"An energetic night of folk, nostalgia, and comedy! Ma Ka Pa pairs up for a fun duet and stirs up the stage, while top duets earn judges buzzers and gift vouchers.\",\"still\":\"https://image.tmdb.org/t/p/w780/4KywWnW8fjXXOafB8jDVVNZRJ29.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-21\",\"runtime\":64},{\"number\":15,\"name\":\"Pattikada vs Pattanama\",\"overview\":\"The energetic Pattikada vs Pattanama round leaves the judges completely thrilled. Unmissable musical acts and fun moments make this a spectacular night.\",\"still\":\"https://image.tmdb.org/t/p/w780/bv0tfksUgq1wLFoZA0QFBmFBW8c.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-27\",\"runtime\":65},{\"number\":16,\"name\":\"The Battle for the Trophy\",\"overview\":\"Sensational performances earn standing ovations and high praise from the judges. Ma Ka Pa brings the laughs before a tense Pattikada and Pattanama's trophy reveal.\",\"still\":\"https://image.tmdb.org/t/p/w780/9kwe4AvpwZdOrP3BjfuymwOOeDD.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-06-28\",\"runtime\":64},{\"number\":17,\"name\":\"The Meaningful Melodies Round\",\"overview\":\"The judges and lyricist Pa. Vijay welcome a round of meaningful lyrics, featuring spectacular buzzer-winning acts, valuable guidance, and deeply emotional moments.\",\"still\":\"https://image.tmdb.org/t/p/w780/jEwrZEW90VL1TyehpSc0TvzTpAJ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-04\",\"runtime\":66},{\"number\":18,\"name\":\"A Night of Melodic Surprises\",\"overview\":\"A night of high energy music earns standing ovations. Pa. Vijay recalls lyricist Vaali, while emotional hugs, special gifts, and family surprises fill the stage.\",\"still\":\"https://image.tmdb.org/t/p/w780/iAiEOutxLPkc4kPTbjR9PRCcOpG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-05\",\"runtime\":64},{\"number\":19,\"name\":\"A Soulful Tribute to Bharathiraja\",\"overview\":\"A heartfelt tribute to Bharathiraja celebrates his legendary contribution to Tamil cinema with soulful performances. The episode honours his timeless legacy with special guests.\",\"still\":\"https://image.tmdb.org/t/p/w780/9E9v3LlbzGijrzB2aBETpnracjA.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-11\",\"runtime\":64},{\"number\":20,\"name\":\"A Musical Salute to a Legend!\",\"overview\":\"Host duo Ma Ka Pa and Priyanka open with a Bharathiraja tribute.Contestants overcome errors, delivering emotional, buzzer-winning acts that earn standing ovations.\",\"still\":\"https://image.tmdb.org/t/p/w780/a3tdkeXFIJwfbzJvr2V2Z3XJu9k.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-12\",\"runtime\":71},{\"number\":21,\"name\":\"K. Bhagyaraj's Cinematic Legacy\",\"overview\":\"A grand tribute to K. Bhagyaraj unfolds with special guest Livingston. Soulful performances celebrating S. Janaki's timeless melodies leave the audience spellbound.\",\"still\":\"https://image.tmdb.org/t/p/w780/hFtQO5x3mJ8Il9k6zHY8qX35xUD.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-18\",\"runtime\":74},{\"number\":22,\"name\":\"Golden Tunes of K. Bhagyaraj\",\"overview\":\"Ma Ka Pa invites R. Sundarajan to honour K. Bhagyaraj. The juniors enact a movie scene, and the judges award buzzers as the singers deliver spectacular, mesmerising performances.\",\"still\":\"https://image.tmdb.org/t/p/w780/1A3QnDaqOMBCE0uApKqQGHfDsSQ.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-19\",\"runtime\":67},{\"number\":23,\"name\":\"Celebrating S. Janaki's Legacy\",\"overview\":\"Celebrating S. Janaki's legacy, the stage comes alive with emotional performances and a breathtaking medley. Heartfelt memories and tributes make the celebration even more special.\",\"still\":\"https://image.tmdb.org/t/p/w780/2960852UCiPdSFWWYOab2XfkjTG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-25\",\"runtime\":85},{\"number\":24,\"name\":\"A Magical Evening Of Melodies\",\"overview\":\"Seniors honour the legendary singer with flawless acts, magical duets and buzzers. Standing ovations follow, while judges and guests team up for memorable musical mashups.\",\"still\":\"https://image.tmdb.org/t/p/w780/kTZlA0cf6DJLHbe75zAjzaJBlOn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-07-26\",\"runtime\":71},{\"number\":25,\"name\":\"Junior's One-on-One Face Off\",\"overview\":\"Junior Singers enter an intense one-on-one battle round. Engaging games ignite every face off, and winners claim amazing gifts from the Gift Room in this thrilling competition.\",\"still\":\"https://image.tmdb.org/t/p/w780/3e1wLYWoRTqLmjB7uE5W5HJ3EqM.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-01\",\"runtime\":68},{\"number\":26,\"name\":\"Fun Fuels Fierce Competition\",\"overview\":\"Fun-filled games, and the arrival of Teddy and King Kong fill the competitive round with excitement. The kids delight singer Chitra with a special birthday celebration.\",\"still\":\"https://image.tmdb.org/t/p/w780/6YE3hgnEYMTY1TJR2w4TSzSb99.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-02\",\"runtime\":67},{\"number\":27,\"name\":\"Aadi Thiruvizha Special\",\"overview\":\"Actress Radha joins Aadi Thiruvizha for a grand Divine Round. Meanwhile, the contestants captivate the crowd with divine acts and expert judge feedback.\",\"still\":\"https://image.tmdb.org/t/p/w780/bKPuqdq84lPlcSa2cACWdTtI4rG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-08\",\"runtime\":80},{\"number\":28,\"name\":\"The Little Stars' Divine Melodies\",\"overview\":\"The little stars enchant the stage with soulful devotional songs, vividly bringing the Gods' presence alive. Tune in to witness the divine glory of the Aadi Thiruvizha round.\",\"still\":\"https://image.tmdb.org/t/p/w780/nvMDhU8sjuPGJssfbwb4uJ8slZb.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-09\",\"runtime\":78},{\"number\":29,\"name\":\"Heartwarming Tributes to Loved Ones\",\"overview\":\"The dedication round celebrates inspiring bonds through heartfelt songs and meaningful gifts. Contestants honour their loved ones with emotional performances and gratitude.\",\"still\":\"https://image.tmdb.org/t/p/w780/9SKUycZ6JvIiyvMneOUToHIo7ME.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-15\",\"runtime\":89},{\"number\":30,\"name\":\"Heartfelt Tributes Fill the Stage\",\"overview\":\"Love and gratitude take centre stage in the dedication round. Contestants pour their emotions into heartfelt performances while competing for Golden Voice of the Week.\",\"still\":\"https://image.tmdb.org/t/p/w780/48oJS6LPa4vnYHsIlh7wjnpwWt8.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-16\",\"runtime\":83},{\"number\":31,\"name\":\"Fun Max Cinematic Round\",\"overview\":\"Movie magic meets unstoppable fun in the Cinema Round with hilarious recreations and spectacular singing acts by junior singers. Tune in for a fun-filled cinematic celebration!\",\"still\":\"https://image.tmdb.org/t/p/w780/gtBDyiNXPTaiu3cYDrAS4RPACkL.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-22\",\"runtime\":74},{\"number\":32,\"name\":\"Musical Magic and Comedy Mayhem\",\"overview\":\"A power-packed night of soulful music, side-splitting comedy, and emotional acts. Judges share warm praise and expert guidance for every stunning performance.\",\"still\":\"https://image.tmdb.org/t/p/w780/75YpmdJpwTZz4tgsu11JBSeSG5P.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-23\",\"runtime\":66},{\"number\":33,\"name\":\"Rock and Roll Extravaganza\",\"overview\":\"Special guest Shruti Haasan lights up the stage, getting emotional over a special clip. Thrilling performances win buzzers, while judge Chithra mesmerises all.\",\"still\":\"https://image.tmdb.org/t/p/w780/sstUcNRrGwnLlwuncizi0JmqmfU.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-29\",\"runtime\":58},{\"number\":34,\"name\":\"Retro Magic Takes Over the Stage\",\"overview\":\"Retro classics come alive in the Rock 'n' Roll round through energetic performances. A special celebration honours Shruti Haasan's journey with a montage of her memorable moments.\",\"still\":\"https://image.tmdb.org/t/p/w780/9PVJ0t75zrxWNCsUUagNCQcFcFR.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-08-30\",\"runtime\":62},{\"number\":35,\"name\":\"Rocking Medleys Blend with Emotion\",\"overview\":\"An emotional family reunion for Saurabi and Shruthi's rocking performance elevates the Rock 'n' Roll round. Retro medleys from Super Singer stars steal the spotlight.\",\"still\":\"https://image.tmdb.org/t/p/w780/hioaWpihKWOT65cIZN65iO4Fizp.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-05\",\"runtime\":62},{\"number\":36,\"name\":\"Celebrating Deva's Musical Legacy\",\"overview\":\"Ma Ka Pa and Priyanka welcome Deva for a special round filled with top performances and custom lyrics. Mani and Band receive a lesson, while Chithra and Deva share glowing praise.\",\"still\":\"https://image.tmdb.org/t/p/w780/98pMymX7mZXWHHstvmMdjjewlt4.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-12\",\"runtime\":73},{\"number\":37,\"name\":\"A Soulful Tribute to Deva's Music\",\"overview\":\"Judges are spellbound as Little Stars deliver energetic renditions of Deva's hits. Tears of joy follow as Deva's musical troupe surprises him with a pleasant entry on stage.\",\"still\":\"https://image.tmdb.org/t/p/w780/h4gRzABxRaFPXurnRNc1N4sJ3J6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-13\",\"runtime\":69},{\"number\":38,\"name\":\"A Magical Top 10 Moon Night\",\"overview\":\"Priyanka and Ma Ka Pa host the Top 10 Moon event. As guest stars join the fun, powerful singing acts impress the judges and lead to touching family moments.\",\"still\":\"https://image.tmdb.org/t/p/w780/i8ZgHfLqqZIAFsmyF0sPeF0ZqyG.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-19\",\"runtime\":77},{\"number\":39,\"name\":\"A Night of Unforgettable Music\",\"overview\":\"Special guest Venkat Prabhu visits for a magical night of music! Featuring Golden Moon honours, heartwarming parent tributes, and stellar duets with legendary singers.\",\"still\":\"https://image.tmdb.org/t/p/w780/5O2hGdtKBVB346PdzHtebs6oDtU.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-20\",\"runtime\":71},{\"number\":40,\"name\":\"Race to Finale Showdown!\",\"overview\":\"The Race to Finale begins with the top 10 contestants competing for the Golden Buzzer and belt. As the competition heats up, tune in to see who secures the ticket to the finale!\",\"still\":\"https://image.tmdb.org/t/p/w780/vCZpwA8K2hmyZBq7dWjP3d3KCCw.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-26\",\"runtime\":63},{\"number\":41,\"name\":\"The Battle for Finale Tickets\",\"overview\":\"As the competition intensifies, contestants race towards the finale while judges identify mistakes and mark corrections. With stakes rising, contestants strive to prove themselves.\",\"still\":\"https://image.tmdb.org/t/p/w780/ezUWrRXKvCo6XjMksd2lHrlQeBr.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-09-27\",\"runtime\":69},{\"number\":42,\"name\":\"Race to Finale Phase 2 Begins\",\"overview\":\"The contestants turn up the energy in Race to Finale Phase 2, battling it out for the finale ticket. Fuelled by confidence, they push ahead with renewed determination.\",\"still\":\"https://image.tmdb.org/t/p/w780/q7Xi1DHCXP64jT23MA7dKISa7F8.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-10-03\",\"runtime\":65},{\"number\":43,\"name\":\"Stars Unleash Magic\",\"overview\":\"Hosts Ma Ka Pa and Priyanka welcome team Anbil Avan to The Race 2 Finale Phase 2. Amid stunning acts, fun music lessons, and dancing, stars honor the first finalist!\",\"still\":\"https://image.tmdb.org/t/p/w780/qCxcvDLZf7ZwlWwsbwNeoVJpWnv.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2026-10-04\",\"runtime\":73},{\"number\":44,\"name\":\"Race to Finale Phase 3!\",\"overview\":\"The Race to Finale Phase 3 continues with the contestants delivering power-packed performances. Tune in as one singer earns the Golden Buzzer and becomes the second finalist!\",\"still\":\"https://image.tmdb.org/t/p/w780/2x5jlueZWRHV704NkX9BtTxNgE5.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"202