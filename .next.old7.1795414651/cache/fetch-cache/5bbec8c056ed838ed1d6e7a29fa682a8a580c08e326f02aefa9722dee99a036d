{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":803266,\"title\":\"Nice View\",\"tagline\":\"\",\"overview\":\"Desperate to pay for his little sister's surgery, a young man takes part in a risky business venture - only to encounter some serious setbacks.\",\"poster\":\"https://image.tmdb.org/t/p/w780/nAc8jgeqW0OQMfmPSuBcvxjOz70.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/jQHk7plj9crd9Un8eXWwL35N5Tp.jpg\",\"rating\":6.4,\"voteCount\":50,\"year\":2022,\"runtime\":106,\"genres\":[\"Drama\",\"Family\",\"Comedy\"],\"status\":\"Released\",\"type\":\"movie\",\"countries\":[{\"code\":\"CN\",\"name\":\"China\"}],\"budget\":0,\"revenue\":211018982,\"director\":\"Wen Muye\",\"cast\":[{\"id\":1958907,\"name\":\"Wen Muye\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/8iot35qIoFNZYwmCiQ0FZV178Zi.jpg\"},{\"id\":2223265,\"name\":\"Jackson Yee\",\"character\":\"Jing Hao\",\"photo\":\"https://image.tmdb.org/t/p/w780/jbsqJKOzY8M5RisSX5A6tRm1H4O.jpg\"},{\"id\":1397566,\"name\":\"Tian Yu\",\"character\":\"Liang Yongcheng\",\"photo\":\"https://image.tmdb.org/t/p/w780/hltc7NNhaBpD45nVqhC1dPkoVuB.jpg\"},{\"id\":3850954,\"name\":\"Helen Chen\",\"character\":\"Jing Tong\",\"photo\":\"https://image.tmdb.org/t/p/w780/yDBr4S0KKf67prVkphqgKLIMQtc.jpg\"},{\"id\":1161018,\"name\":\"Qi Xi\",\"character\":\"Wang Chunmei\",\"photo\":\"https://image.tmdb.org/t/p/w780/aHsRvLngZL6uiagJ8DlctiHEcdo.jpg\"},{\"id\":3781946,\"name\":\"Gong Lei\",\"character\":\"Zhang Longhao\",\"photo\":\"https://image.tmdb.org/t/p/w780/gSZANQg4sOsJDuYMizwkHNCwiYs.jpg\"},{\"id\":1996700,\"name\":\"Xu Juncong\",\"character\":\"Zhang Chao\",\"photo\":\"https://image.tmdb.org/t/p/w780/nZYcU98OsKJeOyEdHFZwrrPqlaE.jpg\"},{\"id\":2318514,\"name\":\"Wang Ning\",\"character\":\"Liu Hengzhi\",\"photo\":\"https://image.tmdb.org/t/p/w780/laGyx0OO6pAqq981ZZIa1TZPEm9.jpg\"},{\"id\":2149028,\"name\":\"Huang Yao\",\"character\":\"Wu Xiaoli\",\"photo\":\"https://image.tmdb.org/t/p/w780/9gDCwUWkrWy