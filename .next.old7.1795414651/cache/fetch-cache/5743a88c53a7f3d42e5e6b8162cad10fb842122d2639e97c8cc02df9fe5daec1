\":31936,\"title\":\"Melissa & Joey\",\"poster\":\"https://image.tmdb.org/t/p/w780/fTl1DSKH2VP5o70b44wsYJLn1xP.jpg\",\"rating\":6.8,\"year\":2010,\"type\":\"tv\",\"_score\":0.4083333333333334,\"_genreOverlap\":2},{\"id\":62936,\"title\":\"Sex&Drugs&Rock&Roll\",\"poster\":\"https://image.tmdb.org/t/p/w780/qj7PJgee5NNfWr46cKn5xuMiG09.jpg\",\"rating\":5.9,\"year\":2015,\"type\":\"tv\",\"_score\":0.225,\"_genreOverlap\":1},{\"id\":62856,\"title\":\"The Real O'Neals\",\"poster\":\"https://image.tmdb.org/t/p/w780/1I7Ta2NzLKjVzYsIBct0UF2U3ul.jpg\",\"rating\":7.2,\"year\":2016,\"type\":\"tv\",\"_score\":0.2126760563380282,\"_genreOverlap\":1},{\"id\":2234,\"title\":\"Noah's Arc\",\"poster\":\"https://image.tmdb.org/t/p/w780/nox8E0pLnmGZAVTnN5U4yWtlVQu.jpg\",\"rating\":6.4,\"year\":2005,\"type\":\"tv\",\"_score\":0.21011235955056182,\"_genreOverlap\":1},{\"id\":62819,\"title\":\"Another Period\",\"poster\":\"https://image.tmdb.org/t/p/w780/sEzplvZRKoFxiF7x6bG5dffiTwy.jpg\",\"rating\":6.8,\"year\":2015,\"type\":\"tv\",\"_score\":0.20722891566265061,\"_genreOverlap\":1},{\"id\":246394,\"title\":\"Things You Should Have Done\",\"poster\":\"https://image.tmdb.org/t/p/w780/tcp6ykLjtB4jW84XAsvCvZJZno5.jpg\",\"rating\":6.6,\"year\":2024,\"type\":\"tv\",\"_score\":0.20483870967741938,\"_genreOverlap\":1},{\"id\":97308,\"title\":\"Noha 22\",\"poster\":null,\"rating\":0,\"year\":2011,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1},{\"id\":97309,\"title\":\"Cyranův ostrov\",\"poster\":\"https://image.tmdb.org/t/p/w780/ekEtjgoao1Z3PEIXWXa4ucgnCww.jpg\",\"rating\":0,\"year\":2009,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1},{\"id\":63103,\"title\":\"La sagrada família\",\"poster\":\"https://image.tmdb.org/t/p/w780/26ktIB5Ox3ih6FjfTDjDX6YE6Cv.jpg\",\"rating\":10,\"year\":2010,\"type\":\"tv\",\"_score\":0.2,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/xdQwcxyvoAt0V8Wu17MQ3qVEkjV.jpg\",\"seasonAirDate\":\"1966-09-12\",\"episodes\":[{\"number\":1,\"name\":\"Royal Flush\",\"overview\":\"The Monkees rescue Princess Bettina, Duchess of Harmonica (Katherine Walsh) from her evil uncle Archduke Otto (Theodore Marcuse).\",\"still\":\"https://image.tmdb.org/t/p/w780/dJatdY7A2pkoryeJBwZHqezankb.jpg\",\"rating\":6.3,\"voteCount\":4,\"airDate\":\"1966-09-12\",\"runtime\":25},{\"number\":2,\"name\":\"Monkee See, Monkee Die\",\"overview\":\"The Monkees spend the night in a haunted house to collect an inheritance.\",\"still\":\"https://image.tmdb.org/t/p/w780/uiM8NBYk9WwxNlbQLIA3aG7pQpN.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"1966-09-19\",\"runtime\":25},{\"number\":3,\"name\":\"Monkee vs. Machine\",\"overview\":\"In a computerized toy factory, the Monkees foil an efficiency expert (Stan Freberg) who wants to replace an old toymaker (Walter Janovitz) with automation.\",\"still\":\"https://image.tmdb.org/t/p/w780/jMsMsX7xHqtR440mb2MLzk48zYJ.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-09-26\",\"runtime\":25},{\"number\":4,\"name\":\"Your Friendly Neighborhood Kidnappers\",\"overview\":\"A shady PR man (Andre Philippe) kidnaps the Monkees to prevent them from winning a talent contest in order for his clients (rival band the Four Swines) to win.\",\"still\":\"https://image.tmdb.org/t/p/w780/eDZM6PiaJRH4JSVJdI0qjGLV0RQ.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-10-03\",\"runtime\":25},{\"number\":5,\"name\":\"The Spy Who Came in from the Cool\",\"overview\":\"The Monkees get mixed up in a spy ring (Jacques Aubuchon, Arlene Martel) after Davy accidentally purchases a set of red maracas containing secret microfilm. Can the Monkees outwit two professional spies ?\",\"still\":\"https://image.tmdb.org/t/p/w780/AaTe4qCXN57eNc7Purfhg0k8OmZ.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-10-10\",\"runtime\":25},{\"number\":6,\"name\":\"Success Story\",\"overview\":\"Davy's grandfather (Ben Wright) visits, and the Monkees try to convince him that his grandson is wealthy and successful.\",\"still\":\"https://image.tmdb.org/t/p/w780/b4K0eTzZaD56jfmOPYerbSJRvoX.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1966-10-17\",\"runtime\":25},{\"number\":7,\"name\":\"Monkees in a Ghost Town\",\"overview\":\"Stranded in a ghost town after their car runs out of gas, the Monkees are held prisoner by bank robbers (Len Lesser, Lon Chaney Jr.) and their boss, \\\"The Big Man\\\" (Rose Marie).\",\"still\":\"https://image.tmdb.org/t/p/w780/4CBNr3AXJRi3VU3gF6XRopoAbxq.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-10-24\",\"runtime\":25},{\"number\":8,\"name\":\"Don't Look a Gift Horse in the Mouth\",\"overview\":\"Davy is given a horse, which the Monkees have to hide from their landlord, Mr. Babbitt (Henry Corden). It is returned to a heart-broken child (Kerry MacLane) and father (Jim Boles) after Davy rides it to victory over the horse of the father's neighbor. Famed character actor, and frequent Bob Hope sideman, Jerry Colonna plays veterinarian Doctor Mann.\",\"still\":\"https://image.tmdb.org/t/p/w780/fRLqYPu75rjN7RPUADAbkQZXjHg.jpg\",\"rating\":5,\"voteCount\":1,\"airDate\":\"1966-10-31\",\"runtime\":24},{\"number\":9,\"name\":\"The Chaperone\",\"overview\":\"Davy's feelings for retired General Harley Vandenberg's (Arch Johnson) daughter Leslie (Sherry Alberoni) leads Micky to pose as a female chaperone at a party after the real chaperone (Diana Chesney) gets drunk.\",\"still\":\"https://image.tmdb.org/t/p/w780/nxzUAeSattKMFZ9ORECQIOtYLFd.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-11-07\",\"runtime\":25},{\"number\":10,\"name\":\"Here Come the Monkees - The Pilot\",\"overview\":\"The Monkees play a sweet sixteen party and help the birthday girl (Robyn Millan) with her studies after she falls for Davy.\",\"still\":\"https://image.tmdb.org/t/p/w780/4oXM4j3UffZjrLeynp13JxwYQ00.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1966-11-14\",\"runtime\":25},{\"number\":11,\"name\":\"Monkees à la Carte\",\"overview\":\"The Monkees pose as the Purple Flower Gang to save their favourite Italian restaurant from a gangster (Harvey Lembeck).\",\"still\":\"https://image.tmdb.org/t/p/w780/iAJWQdah85jkCYCk5U9IopJQKTg.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1966-11-21\",\"runtime\":25},{\"number\":12,\"name\":\"I've Got a Little Song Here\",\"overview\":\"Mike is fleeced by a fraudulent music publisher (Phil Leeds), but Micky dons the guise of a flashy Hollywood producer to get Mike's money back.\",\"still\":\"https://image.tmdb.org/t/p/w780/orQrFVOGk2qE7JIg4ysixi4DDWk.jpg\",\"rating\":6.5,\"voteCount\":2,\"airDate\":\"1966-11-28\",\"runtime\":25},{\"number\":13,\"name\":\"One Man Shy (Peter and the Debutante)\",\"overview\":\"Bashful Peter tries to win the heart of lovely debutante Valerie Cartwright (Lisa James) while dealing with her haughty boyfriend Ronnie Farnsworth (George Furth).\",\"still\":\"https://image.tmdb.org/t/p/w780/uNzT8vN7VmYsJ7fJb3VjM2RqBMl.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-12-05\",\"runtime\":25},{\"number\":14,\"name\":\"Dance, Monkee, Dance\",\"overview\":\"The Monkees sign up for lessons at Renaldo's Dance Au Go Go (Hal March), and then find out that their contracts are for life.\",\"still\":\"https://image.tmdb.org/t/p/w780/2iUbPUK4NixDJXAD5VoPfDYUvK7.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-12-12\",\"runtime\":25},{\"number\":15,\"name\":\"Too Many Girls (Davy and Fern)\",\"overview\":\"A domineering stage mother tries to use Davy to further her daughter Fern's career.\",\"still\":\"https://image.tmdb.org/t/p/w780/af0bCb2vx5WLNCKz7c9ZpLiUtkl.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1966-12-19\",\"runtime\":25},{\"number\":16,\"name\":\"Son of a Gypsy\",\"overview\":\"A band of gypsies, headed by the powerful Maria (Jeanne Arnold), force the Monkees to steal a priceless statuette called the \\\"Maltese Vulture.\\\"\",\"still\":\"https://image.tmdb.org/t/p/w780/28mggELvqBVoU3Eeyzwt1ZBWuMF.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1966-12-26\",\"runtime\":25},{\"number\":17,\"name\":\"The Case of the Missing Monkee\",\"overview\":\"Peter becomes involved with the disappearance of the respected Professor Milo Schnitzler (Norbert Schiller) and then disappears himself.\",\"still\":\"https://image.tmdb.org/t/p/w780/5eenPQwq0HHW3BDAZHNTnkMGTpv.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-01-09\",\"runtime\":25},{\"number\":18,\"name\":\"I Was a Teenage Monster\",\"overview\":\"A mad scientist (John Hoyt) hires the Monkees to teach his monster (Richard Kiel) music—and then transplants their musical talent into the monster. Can the Monkees get their talent back? Byron Foulger appears as Groot, Dr. Mendoza's assistant.\",\"still\":\"https://image.tmdb.org/t/p/w780/o1FNQWzsOriwQWnWqaZ2uP2VJDB.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-01-16\",\"runtime\":25},{\"number\":19,\"name\":\"The Audition (Find the Monkees)\",\"overview\":\"When television producer Hubbell Bensen (Carl Ballantine) hears a tape of the Monkees, he frantically stages auditions in the hope of finding them for his new television show, unaware they are desperately trying to audition for him.\",\"still\":\"https://image.tmdb.org/t/p/w780/qs3OP2wAQv7XsjzmbEhG8aXpSQh.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-01-23\",\"runtime\":25},{\"number\":20,\"name\":\"Monkees in the Ring\",\"overview\":\"A crooked fight promoter (Ned Glass) prepares to cash in on a big bet by making Davy a stooge in a bout with the champ.\",\"still\":\"https://image.tmdb.org/t/p/w780/tsTf4AoYna0merNH38090NKRJR5.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-01-30\",\"runtime\":25},{\"number\":21,\"name\":\"The Prince and the Paupers\",\"overview\":\"Davy doubles for a lookalike Peruvian prince in order to win the heart of Wendy Forsythe (Heather North) or forfeit his throne to evil Count Myron (Oscar Beregi Jr.).\",\"still\":\"https://image.tmdb.org/t/p/w780/31EEH9slpGq3vO3a64iQ3nEWRHX.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-02-06\",\"runtime\":25},{\"number\":22,\"name\":\"Monkees at the Circus\",\"overview\":\"To save a bankrupt circus, the Monkees pose as a troupe of dazzling, supreme high-wire artists from France known as the Mozzarelli Brothers, but get in trouble when their guise requires them to actually perform.\",\"still\":\"https://image.tmdb.org/t/p/w780/ayJlAOMu42V5oOyr8YqlboHvdCU.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-02-13\",\"runtime\":25},{\"number\":23,\"name\":\"Captain Crocodile\",\"overview\":\"The Monkees' appearance on popular children's show The Captain Crocodile Show is sabotaged by its host (Joey Forman), who fears that his guest's popularity is diminishing his own.\",\"still\":\"https://image.tmdb.org/t/p/w780/lxbCAP1buImvoVgvja6XAyPEzBR.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-02-20\",\"runtime\":25},{\"number\":24,\"name\":\"Monkees à la Mode\",\"overview\":\"The Monkees are chosen as \\\"Typical Young Americans of the Year,\\\" by Chic magazine, a haughty publication that runs a bogus article on the group moulding them into a false image of clean cut young men.\",\"still\":\"https://image.tmdb.org/t/p/w780/vZBosV5IVJsnaKUzVF2QuYUYxfr.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-02-27\",\"runtime\":25},{\"number\":25,\"name\":\"Alias Micky Dolenz\",\"overview\":\"The police cash in on Micky's striking resemblance to imprisoned crime kingpin Baby Face Morales in an attempt to locate robbery loot.\",\"still\":\"https://image.tmdb.org/t/p/w780/yCyL9xUlxfi3dabzzgB0KiS9A6i.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-03-06\",\"runtime\":25},{\"number\":26,\"name\":\"Monkee Chow Mein\",\"overview\":\"Peter finds a secret message in a fortune cookie at a Chinese restaurant, forcing Monkeemen Davy and Mike to come to his rescue from the evil Dragonman (Joey Forman).\",\"still\":\"https://image.tmdb.org/t/p/w780/rs1Dm9WN4F6adDzPNwbG3NOp2OW.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-03-13\",\"runtime\":25},{\"number\":27,\"name\":\"Monkee Mother\",\"overview\":\"Middle-aged widow Millie (Rose Marie) moves in with the Monkees as a new tenant, resulting in the boys' trying to find her a husband.\",\"still\":\"https://image.tmdb.org/t/p/w780/iixeKHzz9ViOaB00kSMHitL1jnv.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-03-20\",\"runtime\":25},{\"number\":28,\"name\":\"Monkees on the Line\",\"overview\":\"Hired by a telephone answering service, the Monkees are soon plunged into mix-ups, hang-ups and crossed wires leading to pursuit by a crooked bettor (Milton Frome).\",\"still\":\"https://image.tmdb.org/t/p/w780/yMGJGkoarrgXcG2g3qFoL8seAeA.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-03-27\",\"runtime\":25},{\"number\":29,\"name\":\"Monkees Get Out More Dirt\",\"overview\":\"The Monkees' friendship is threatened when they all fall for the same girl, luscious local laundromat proprietress April Conquest (Julie Newmar).\",\"still\":\"https://image.tmdb.org/t/p/w780/jcyO9sPniAqlWaPYUZBpSbYuofB.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"1967-04-03\",\"runtime\":25},{\"number\":30,\"name\":\"Monkees in Manhattan\",\"overview\":\"In New York City, the Monkees fend off an irate hotel manager (Philip Ober) as they help a producer (Richard Anders) get backing for a Broadway musical.\",\"still\":\"https://image.tmdb.org/t/p/w780/q6NiCGVXLSAAtpqsjg5O7kaYHQE.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-04-10\",\"runtime\":25},{\"number\":31,\"name\":\"Monkees at the Movies\",\"overview\":\"The Monkees have a run-in with a snobbish movie idol (Bobby Sherman) on the set as extras in a beach movie.\",\"still\":\"https://image.tmdb.org/t/p/w780/AdF4Hm0xL1DJZ7ZDHLHwctIvELX.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-04-17\",\"runtime\":25},{\"number\":32,\"name\":\"Monkees on Tour\",\"overview\":\"A mini-documentary chronicling a live Monkees concert gig on location in Phoenix, Arizona during their first public appearance tour.\",\"still\":\"https://image.tmdb.org/t/p/w780/wsMVYLpCRTpCOO4bgbQpZgDrob4.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"1967-04-24\",\"runtime\":26}],\"firstAirDate\":\"1966-09-12\"}","status":200,"url":""},"revalidate":86400,"tags":[]}