{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":44733,\"title\":\"Pramface\",\"tagline\":\"\",\"overview\":\"Pramface is a BBC Three television comedy series starring Scarlett Alice Johnson, Sean Michael Verey, Ben Crompton, Bronagh Gallagher, Anna Chancellor and Angus Deayton. Written by Chris Reddy and produced by BBC/Little Comet, the six-part first series commenced transmission on 23 February 2012. The second series began on 8 January 2013, with the first episode 60 minutes long, as a special, and the remainder of the series consisted of the usual 30 minute episodes. The second series concluded on 19 February 2013. A third series was confirmed on 29 April 2013.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/sqauxqOdQxvnhqOel9KlJF0yXJ1.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/3hNX1mBhkw3ifuyw1gnIxJjics9.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6.9,\"voteCount\":23,\"year\":2012,\"genres\":[\"Comedy\",\"Family\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":19,\"createdBy\":[],\"networks\":[\"BBC Three\"],\"countries\":[{\"code\":\"GB\",\"name\":\"GB\"}],\"lastAirDate\":\"2014-03-25\",\"cast\":[{\"id\":47705,\"name\":\"Dan Zeff\",\"character\":\"Director\",\"photo\":null},{\"id\":1191002,\"name\":\"Misha Manson-Smith\",\"character\":\"Director\",\"photo\":null},{\"id\":113971,\"name\":\"Scarlett Alice Johnson\",\"character\":\"Laura Derbyshire\",\"photo\":\"https://image.tmdb.org/t/p/w780/4ovPLETIFDAXauXYoBGbEbOt09j.jpg\"},{\"id\":1495779,\"name\":\"Sean Verey\",\"character\":\"Jamie Prince\",\"photo\":\"https://image.tmdb.org/t/p/w780/sNyrfHAXbU21wYjAL6ywB0fwjGC.jpg\"},{\"id\":141536,\"name\":\"Emer Kenny\",\"character\":\"Danielle Reeves\",\"photo\":\"https://image.tmdb.org/t/p/w780/nJs1lenchFwZTB6VTIF3SPmYfgW.jpg\"},{\"id\":72315,\"name\":\"Ben Crompton\",\"character\":\"Keith Prince\",\"photo\":\"https://image.tmdb.org/t/p/w780/tsHOfCvdONdzVun4xaWGE4a8t8S.jpg\"},{\"id\":33399,\"n