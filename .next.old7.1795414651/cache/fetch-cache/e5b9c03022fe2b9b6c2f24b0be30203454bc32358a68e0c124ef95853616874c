{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":330957,\"title\":\"Just Us\",\"tagline\":\"\",\"overview\":\"Just Us is a British children's family drama television series was written and created by Kay Mellor, it was originally aired on ITV as part of the children's programming block CITV and ran for three series and twenty-four episodes between 18 February 1992 and 11 March 1994.  The series follows the lives and dynamics of the Holdsworth family. Moving away from traditional, straight forward sitcoms, the series combined family drama with Mellor's signature writing style, occasionally delving into more serious, emotional and unexpected territory.\",\"posterPath\":null,\"backdropPath\":null,\"youtubeBackdrop\":\"https://img.youtube.com/vi/w9YUKiHhCuQ/maxresdefault.jpg\",\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":1992,\"genres\":[\"Family\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":24,\"createdBy\":[\"Kay Mellor\"],\"networks\":[],\"countries\":[{\"code\":\"GB\",\"name\":\"United Kingdom\"}],\"lastAirDate\":\"1994-03-11\",\"cast\":[{\"id\":135418,\"name\":\"Kay Mellor\",\"character\":\"Jenny Holdsworth\",\"photo\":\"https://image.tmdb.org/t/p/w780/xpBGg5sCcHGIyGZUui9QdlC65Ab.jpg\"},{\"id\":2190637,\"name\":\"Dan Riley\",\"character\":\"Marcus Clarkson\",\"photo\":null},{\"id\":1186695,\"name\":\"William Chubb\",\"character\":\"Steve Holdsworth\",\"photo\":\"https://image.tmdb.org/t/p/w780/jlRY49VmupR3eU2j5s8yNxwX9Po.jpg\"},{\"id\":5309305,\"name\":\"Sarah Yates\",\"character\":\"Laura Holdsworth\",\"photo\":null},{\"id\":1220166,\"name\":\"Angela Griffin\",\"character\":\"Zoe Ashton\",\"photo\":\"https://image.tmdb.org/t/p/w780/jJbrvE2UAn34WTupPsOoj87cHlI.jpg\"}],\"trailers\":[{\"key\":\"w9YUKiHhCuQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"3BIvTkNMb8w\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"GWffJQRYQBs\",\"name\":\"Offic