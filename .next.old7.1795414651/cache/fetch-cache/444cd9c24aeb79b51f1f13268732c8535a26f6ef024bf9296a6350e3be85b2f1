ating\":0,\"year\":2023,\"type\":\"tv\",\"_score\":0.20967741935483872,\"_genreOverlap\":1},{\"id\":2,\"title\":\"Clerks\",\"poster\":\"https://image.tmdb.org/t/p/w780/xunXvzFlkf1GGgMkCySA9CCFumB.jpg\",\"rating\":7.2,\"year\":2000,\"type\":\"tv\",\"_score\":0.2090909090909091,\"_genreOverlap\":1},{\"id\":3817,\"title\":\"The Land Before Time\",\"poster\":\"https://image.tmdb.org/t/p/w780/p4eUTWcyh5U62Y26HkALQQjdwMF.jpg\",\"rating\":6.6,\"year\":2007,\"type\":\"tv\",\"_score\":0.2090909090909091,\"_genreOverlap\":1},{\"id\":441,\"title\":\"Father of the Pride\",\"poster\":\"https://image.tmdb.org/t/p/w780/eJ8kqnWfgeYb1XyKmRXCBs599pa.jpg\",\"rating\":5.1,\"year\":2004,\"type\":\"tv\",\"_score\":0.20833333333333334,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/sXxef6eluFczqa6WkU1pgrlJ59v.jpg\",\"seasonAirDate\":\"2016-01-15\",\"episodes\":[{\"number\":1,\"name\":\"Never Judge a Hyena By Its Spots\",\"overview\":\"When Kion gets separated from the rest of the Lion Guard, he finds himself lost in the Outlands where he meets Jasiri, a friendly female hyena, who rescues him and helps face off against Janja and the other hyenas.\",\"still\":\"https://image.tmdb.org/t/p/w780/9QGXnXGBAD8G9uyBvfWzxL4POsw.jpg\",\"rating\":8.3,\"voteCount\":3,\"airDate\":\"2016-01-15\",\"runtime\":23},{\"number\":2,\"name\":\"The Rise of Makuu\",\"overview\":\"When a crocodile named Makuu takes over as leader of the crocodiles and his aggressive antics send the Pride Lands into chaos, Kion questions whether to intervene or respect animal traditions.\",\"still\":\"https://image.tmdb.org/t/p/w780/fGh9CIC2ahC7oAUfdSH8U5zRUrJ.jpg\",\"rating\":7,\"voteCount\":3,\"airDate\":\"2016-01-15\",\"runtime\":23},{\"number\":3,\"name\":\"Bunga the Wise\",\"overview\":\"After floodwaters threaten the Pride Lands and Bunga comes up with a quick fix, Kion and the other members of the Lion Guard learn that the quick and easy solution to a problem is not always the best.\",\"still\":\"https://image.tmdb.org/t/p/w780/zYN52QSMyS1wgjjkWhMx4pq7IIx.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2016-01-22\",\"runtime\":23},{\"number\":4,\"name\":\"Can't Wait to Be Queen\",\"overview\":\"When Simba leaves Kiara in charge of Pride Rock for the first time, Kion reluctantly agrees to obey her which proves difficult when Janja tries to take advantage of Kiara’s inexperience and hatches a plot to take over the Pride Lands.\",\"still\":\"https://image.tmdb.org/t/p/w780/3N7YqPVSlkmr57TVKcoaA5UbVRU.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2016-01-29\",\"runtime\":23},{\"number\":5,\"name\":\"Eye of the Beholder\",\"overview\":\"Ono temporarily loses vision in one eye and questions his value to the Lion Guard as the \\\"keenest of sight.\\\"\",\"still\":\"https://image.tmdb.org/t/p/w780/aibMtJxFFvSTySEKyWt0lMRszQv.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2016-02-05\",\"runtime\":23},{\"number\":6,\"name\":\"The Kupatana Celebration\",\"overview\":\"Kion inadvertently leads a pack of jackals into the Pride Lands, where they wreak havoc during a highly regarded Pride Lands ceremony. Ana Gasteyer (ABC’s “The Goldbergs”) guest stars as Rairai, the clever and scheming matriarch to a family of jackals.\",\"still\":\"https://image.tmdb.org/t/p/w780/sb5vLrfEadHQgc7NLhrCAsv7skA.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2016-02-12\",\"runtime\":23},{\"number\":7,\"name\":\"Fuli's New Family\",\"overview\":\"The Guard thinks that Fuli is lonely since she spends so much time on her own; they try to include her in their family time.\",\"still\":\"https://image.tmdb.org/t/p/w780/aZm8uepoAFC8Djk8zo3FcnpjKZ0.jpg\",\"rating\":9.5,\"voteCount\":2,\"airDate\":\"2016-02-19\",\"runtime\":23},{\"number\":8,\"name\":\"The Search for Utamu\",\"overview\":\"Fuli learns a lesson in teamwork when she takes on a mission alone and overexerts herself, leaving her defenseless against attacking vultures.\",\"still\":\"https://image.tmdb.org/t/p/w780/lgPZxTZYvaez1hAqB1orf78RkU5.jpg\",\"rating\":9,\"voteCount\":2,\"airDate\":\"2016-02-26\",\"runtime\":23},{\"number\":9,\"name\":\"Follow That Hippo!\",\"overview\":\"Beshte rescues a young elephant that idolizes him after he wanders into danger.\",\"still\":\"https://image.tmdb.org/t/p/w780/ekZa7YY0TOrSQUukQwItt8vqRhN.jpg\",\"rating\":7,\"voteCount\":2,\"airDate\":\"2016-03-18\",\"runtime\":23},{\"number\":10,\"name\":\"The Call of the Drongo\",\"overview\":\"The Lion Guard steps in when they encounter a deceptive drongo bird named Tamaa who mimics predators to scare off smaller animals.\",\"still\":\"https://image.tmdb.org/t/p/w780/6ltBFr9P6xxKr7Dn3TYCJ09wvF6.jpg\",\"rating\":10,\"voteCount\":2,\"airDate\":\"2016-03-25\",\"runtime\":23},{\"number\":11,\"name\":\"Paintings and Predictions\",\"overview\":\"Believing that Rafiki's paintings predict the future, Bunga enlists the rest of the Lion Guard to save Kion from danger.\",\"still\":\"https://image.tmdb.org/t/p/w780/Av5H61W6ij05EseEc4qS0lPoMch.jpg\",\"rating\":6.5,\"voteCount\":2,\"airDate\":\"2016-04-01\",\"runtime\":23},{\"number\":12,\"name\":\"The Mbali Fields Migration\",\"overview\":\"Kion and the Guard must lead a large herd through the Outlands to find a less crowded grazing ground.\",\"still\":\"https://image.tmdb.org/t/p/w780/qO1c3e23SxtGMfqCx29Sjm52UeP.jpg\",\"rating\":9.5,\"voteCount\":2,\"airDate\":\"2016-04-22\",\"runtime\":23},{\"number\":13,\"name\":\"Bunga and the King\",\"overview\":\"When Bunga and Simba are trapped underground, they discover a shared family background – they were both raised by Timon and Pumbaa.\",\"still\":\"https://image.tmdb.org/t/p/w780/nrTdj7bVCs70Ui2rfTvz90eoGyn.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2016-04-29\",\"runtime\":23},{\"number\":14,\"name\":\"The Imaginary Okapi\",\"overview\":\"When Beshte befriends a shy okapi, the Lion Guard thinks Beshte has an imaginary friend\",\"still\":\"https://image.tmdb.org/t/p/w780/dC8wUvwUHs7UXPUg3WTtT1GHl7U.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2016-07-08\",\"runtime\":23},{\"number\":15,\"name\":\"Too Many Termites\",\"overview\":\"The Lion Guard mistakenly chase off aardwolves instead of hyenas and the Pride Lands become overrun with termites.\",\"still\":\"https://image.tmdb.org/t/p/w780/ywWBu6Rkir3ny4IGQrzkgOhOnTL.jpg\",\"rating\":9.5,\"voteCount\":2,\"airDate\":\"2016-07-15\",\"runtime\":23},{\"number\":16,\"name\":\"The Trouble with Galagos\",\"overview\":\"The Lion Guard helps a leopard named Badili stand up to a bully who is challenging his territory.\",\"still\":\"https://image.tmdb.org/t/p/w780/tcmjFUXPGFkNhYjQksAAy1MQk9G.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2016-08-05\",\"runtime\":23},{\"number\":17,\"name\":\"Janja's New Crew\",\"overview\":\"Janja replaces Chungu and Cheezi with two new hyenas in an attempt to sideline the Lion Guard.\",\"still\":\"https://image.tmdb.org/t/p/w780/uTPJ9qTIvq4JLO0DJuxhx2rcrPO.jpg\",\"rating\":9.5,\"voteCount\":2,\"airDate\":\"2016-08-26\",\"runtime\":23},{\"number\":18,\"name\":\"Baboons!\",\"overview\":\"The Lion Guard rescues a baby baboon and Fuli returns the baboon to its mother.\",\"still\":\"https://image.tmdb.org/t/p/w780/z1dVLiix9Qw55gcAtpkYwfkwwQd.jpg\",\"rating\":8.5,\"voteCount\":2,\"airDate\":\"2016-09-23\",\"runtime\":23},{\"number\":19,\"name\":\"Beware the Zimwi\",\"overview\":\"When tales of a mysterious creature plague the Pride Lands, the Guard must conquer their fears and track down the elusive beast.\",\"still\":\"https://image.tmdb.org/t/p/w780/zgxxsHmvnykcqLPwxbHBwgICmIF.jpg\",\"rating\":7.5,\"voteCount\":2,\"airDate\":\"2016-10-14\",\"runtime\":23},{\"number\":20,\"name\":\"Lions of the Outlands\",\"overview\":\"The Lion Guard must choose whether to side with the hyenas or the lions when Jasiri, the good hyena, asks for help.\",\"still\":\"https://image.tmdb.org/t/p/w780/4n62JtMg7VNgalmIWSvLWbaPH2r.jpg\",\"rating\":10,\"voteCount\":2,\"airDate\":\"2016-11-11\",\"runtime\":23},{\"number\":21,\"name\":\"Never Roar Again\",\"overview\":\"Fearing he has lost control of his roar, Kion vows to never use it again.\",\"still\":\"https://image.tmdb.org/t/p/w780/2HNywOOGsUNLz2t5j2GwsVFs9d0.jpg\",\"rating\":8,\"voteCount\":2,\"airDate\":\"2016-11-18\",\"runtime\":23},{\"number\":22,\"name\":\"The Lost Gorillas\",\"overview\":\"The Guard helps two buffoonish Gorilla princes return to their home in the snowy Rwenzori Mountains.\",\"still\":\"https://image.tmdb.org/t/p/w780/7Ckvq9RiwDJgzQ9PdiTkCUlJVVX.jpg\",\"rating\":5.5,\"voteCount\":2,\"airDate\":\"2016-12-02\",\"runtime\":23},{\"number\":23,\"name\":\"The Trail to Udugu\",\"overview\":\"While Nala takes Kion and Kiara on a trip to teach them the importance of working together, Simba is left in charge of the Lion Guard.\",\"still\":\"https://image.tmdb.org/t/p/w780/mjNoiIvLoIF9ePhDr8lzeOYEwf2.jpg\",\"rating\":9,\"voteCount\":2,\"airDate\":\"2017-01-06\",\"runtime\":23},{\"number\":24,\"name\":\"Ono's Idol\",\"overview\":\"Ono meets his idol, legendary eagle Hadithi, and learns that his hero isn't what he expected.\",\"still\":\"https://image.tmdb.org/t/p/w780/eNtNkXJHNCkxrbIvxe20saJ5PZG.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"2017-02-24\",\"runtime\":23},{\"number\":25,\"name\":\"Beshte and the Hippo Lanes\",\"overview\":\"Beshte's dad is injured while creating \\\"Hippo Lanes,\\\" so Beshte must step in and take over the job.\",\"still\":\"https://image.tmdb.org/t/p/w780/cVmd7QFYeySqaUAf4jh5zB5N100.jpg\",\"rating\":9,\"voteCount\":2,\"airDate\":\"2017-03-17\",\"runtime\":23},{\"number\":26,\"name\":\"Ono the Tickbird\",\"overview\":\"While Ono fills in as a Rhino's seeing-eye bird, the rest of the Lion Guard helps by getting the rhino and tick-bird to resolve their differences.\",\"still\":\"https://image.tmdb.org/t/p/w780/vXLNBScJmep1E4nnsYpRfM7UgZm.jpg\",\"rating\":7.5,\"voteCount\":2,\"airDate\":\"2017-04-21\",\"runtime\":23}],\"firstAirDate\":\"2016-01-15\"}","status":200,"url":""},"revalidate":86400,"tags":[]}