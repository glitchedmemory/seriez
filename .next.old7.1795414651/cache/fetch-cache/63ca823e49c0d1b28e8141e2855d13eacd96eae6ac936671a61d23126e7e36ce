\":1236153,\"title\":\"Mercy\",\"poster\":\"https://image.tmdb.org/t/p/w780/pyok1kZJCfyuFapYXzHcy7BLlQa.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/gIClklFGYBe0uiOoiP2vtocJbss.jpg\",\"rating\":7.1,\"year\":2026,\"type\":\"movie\",\"overview\":\"In the near future, a detective stands on trial accused of murdering his wife. He has ninety minutes to prove his innocence to the advanced AI Judge he once championed, before it determines his fate.\",\"genres\":[\"Sci-Fi\",\"Thriller\",\"Crime\"],\"daysUntil\":null},{\"id\":438148,\"title\":\"Minions: The Rise of Gru\",\"poster\":\"https://image.tmdb.org/t/p/w780/4dBDk1LPdvdhcZdjQBmdXwiVKUA.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/wZS4xSfPtk1NPQnx9zsT5R2WhCu.jpg\",\"rating\":7.3,\"year\":2022,\"type\":\"movie\",\"overview\":\"A fanboy of a supervillain supergroup known as the Vicious 6, Gru hatches a plan to become evil enough to join them, with the backup of his followers, the Minions.\",\"genres\":[\"Animation\",\"Comedy\",\"Crime\"],\"daysUntil\":null},{\"id\":198184,\"title\":\"Chappie\",\"poster\":\"https://image.tmdb.org/t/p/w780/uuDUpzlMFomdSfNWlpEPS9nVZWV.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/qX5T5GVAcq2UKaaiAx5SZp1AtlY.jpg\",\"rating\":6.8,\"year\":2015,\"type\":\"movie\",\"overview\":\"Every child comes into the world full of promise, and none more so than Chappie: he is gifted, special, a prodigy. Like any child, Chappie will come under the influence of his surroundings—some good, some bad—and he will rely on his heart and soul to find his way in the world and become his own man. But there's one thing that makes Chappie different from any one else: he is a robot.\",\"genres\":[\"Crime\",\"Action\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":10559,\"title\":\"Frequency\",\"poster\":\"https://image.tmdb.org/t/p/w780/bnuWuzgJSl2V7bEDM6dPQv9PQQx.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/1VIb9d4OMsyBy6KVgYg5p0SNii8.jpg\",\"rating\":7.3,\"year\":2000,\"type\":\"movie\",\"overview\":\"When a rare phenomenon gives police officer John Sullivan the chance to speak to his father, 30 years in the past, he takes the opportunity to prevent his dad's tragic death.  After his actions inadvertently give rise to a series of brutal murders he and his father must find a way to fix the consequences of altering time.\",\"genres\":[\"Sci-Fi\",\"Crime\",\"Thriller\"],\"daysUntil\":null},{\"id\":1227877,\"title\":\"I Love Boosters\",\"poster\":\"https://image.tmdb.org/t/p/w780/4pNKIUFy7tkZiBx0rnSmG9ysRy.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/fBZ9cWUI1yB9Fcs2eoYZ4mmMUmI.jpg\",\"rating\":6.3,\"year\":2026,\"type\":\"movie\",\"overview\":\"A group of shoplifters take aim at a cutthroat fashion maven by stealing from her stores and reselling them at a lower price — what they call 'fashion-forward philanthropy'.\",\"genres\":[\"Comedy\",\"Sci-Fi\",\"Crime\"],\"daysUntil\":null},{\"id\":440471,\"title\":\"Escape Plan 2: Hades\",\"poster\":\"https://image.tmdb.org/t/p/w780/A6tb8JNrie2qT8JC2tGqshayuck.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/xIAaN3AQqaJiN5RJ0WsmBady8Hq.jpg\",\"rating\":5.1,\"year\":2018,\"type\":\"movie\",\"overview\":\"Ray Breslin manages an elite team of security specialists trained in the art of breaking people out of the world's most impenetrable prisons. When his most trusted operative, Shu Ren, is kidnapped and disappears inside the most elaborate prison ever built, Ray must track him down with the help of some of his former friends.\",\"genres\":[\"Action\",\"Thriller\",\"Crime\"],\"daysUntil\":null},{\"id\":302156,\"title\":\"Criminal\",\"poster\":\"https://image.tmdb.org/t/p/w780/hn6HmGTopbbxv4Myy2IwGWxViFP.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/nZscubw1LcZ2ZRjPt92A0C2JcQy.jpg\",\"rating\":6.2,\"year\":2016,\"type\":\"movie\",\"overview\":\"CIA Agent Bill Pope is on a mission to track down a shadowy hacker named 'The Dutchman'. When he gets mysteriously killed, an experimental procedure transfers his memories into a dangerous ex-convict. When he wakes up Pope's memories, his mission is to eliminate The Dutchman before the hacker launches ICBMs and starts World War III.\",\"genres\":[\"Action\",\"Crime\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":605116,\"title\":\"Project Power\",\"poster\":\"https://image.tmdb.org/t/p/w780/TnOeov4w0sTtV2gqICqIxVi74V.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/qVygtf2vU15L2yKS4Ke44U4oMdD.jpg\",\"rating\":6.4,\"year\":2020,\"type\":\"movie\",\"overview\":\"An ex-soldier, a teen and a cop collide in New Orleans as they hunt for the source behind a dangerous new pill that grants users temporary superpowers.\",\"genres\":[\"Action\",\"Crime\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":932420,\"title\":\"Code 8 Part II\",\"poster\":\"https://image.tmdb.org/t/p/w780/h89INyaoH16CdlT7q7BtKikIFRy.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/ekRp1sEA8pnuzVHQkUESTgNSKdW.jpg\",\"rating\":6.4,\"year\":2024,\"type\":\"movie\",\"overview\":\"In a world where superpowered people are heavily policed by robots, an ex-con teams up with a drug lord he despises to protect a teen from a corrupt cop.\",\"genres\":[\"Sci-Fi\",\"Action\",\"Crime\"],\"daysUntil\":null},{\"id\":461130,\"title\":\"Code 8\",\"poster\":\"https://image.tmdb.org/t/p/w780/izGX7npHEopDQvngYcxMJEfcFbj.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/gqbgCJUZyy4NEdk5m0qxaNOvAqq.jpg\",\"rating\":6.3,\"year\":2019,\"type\":\"movie\",\"overview\":\"In Lincoln City, some inhabitants have extraordinary abilities. Most live below the poverty line, under the close surveillance of a heavily militarized police force. Connor, a construction worker with powers, involves with a criminal gang to help his ailing mother. (Based on the short film “Code 8,” 2016.)\",\"genres\":[\"Sci-Fi\",\"Action\",\"Crime\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"wOBS8UjWQcQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\