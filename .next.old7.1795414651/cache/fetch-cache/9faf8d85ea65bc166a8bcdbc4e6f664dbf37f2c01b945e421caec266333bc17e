{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":42445,\"title\":\"Borgen\",\"tagline\":\"\",\"overview\":\"40-year old political leader Birgitte Nyborg secures her party a landslide victory through her idealism and huge effort, then faces the biggest challenge of her life: how most effectively to use the newly won seats, and how far she is willing to go in order to gain as much influence as possible.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/gKf64xroqFPBukjCfQ44FUVUOrc.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/vR9tii8XddnYsedsw4FZ0bqdjMs.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8.1,\"voteCount\":287,\"year\":2010,\"genres\":[\"Drama\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":30,\"createdBy\":[\"Adam Price\",\"Camilla Hammerich\"],\"networks\":[\"DR1\"],\"countries\":[{\"code\":\"DK\",\"name\":\"Denmark\"}],\"lastAirDate\":\"2013-03-10\",\"cast\":[{\"id\":99747,\"name\":\"Jesper W. Nielsen\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/saKeKGUFwyMXxbtugjIpFHi67Ll.jpg\"},{\"id\":1020017,\"name\":\"Louise Friedberg\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/37eFZ1AW7FD3lVGKJK5SgHiZaHt.jpg\"},{\"id\":543592,\"name\":\"Annette K. Olesen\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/wz0RWPQCXMQuUHuunsjdb6nQJzB.jpg\"},{\"id\":206476,\"name\":\"Mikkel Nørgaard\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/hS9bAmMnJRQ7aqYuiJIDzIStkK0.jpg\"},{\"id\":82351,\"name\":\"Henrik Ruben Genz\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/1S5HkLFDnxfxwYAP2E2DDWquk2v.jpg\"},{\"id\":118171,\"name\":\"Rumle Hammerich\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/zNNI3xGRVRisHkVfdA1xfFYUMKF.jpg\"},{\"id\":1558,\"name\":\"Søren Kragh-Jacobsen\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/6xnfFo4wbM4slCP2qMcFjG3Jtv