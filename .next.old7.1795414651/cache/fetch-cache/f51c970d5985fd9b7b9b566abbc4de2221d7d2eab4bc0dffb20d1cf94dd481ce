{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":34971,\"title\":\"Storage Wars\",\"tagline\":\"Go bid or go home\",\"overview\":\"When rent is not paid on a storage locker for three months in California, the contents can be sold by an auctioneer as a single lot of items in the form of a cash-only auction. The show follows professional buyers who purchase the contents based only on a five-minute inspection of what they can see from the door when it is open. The goal is to turn a profit on the merchandise.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/aI4HWTpEnps1lDyxy5vScazpxDy.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/wVuVvxpp1ljzlhBrFW22xktyaFL.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":5.8,\"voteCount\":141,\"year\":2010,\"genres\":[\"Reality\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":18,\"totalEpisodes\":368,\"createdBy\":[\"Thom Beers\"],\"networks\":[\"A&E\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2026-07-18\",\"cast\":[{\"id\":1645016,\"name\":\"Dan Dotson\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/w0d6FauPsORBkiVCosefgBUs7zE.jpg\"},{\"id\":1645019,\"name\":\"Brandi Passante\",\"character\":\"Herself\",\"photo\":\"https://image.tmdb.org/t/p/w780/ahfw5HtPv04oqo7tCjm7O5d3zQ.jpg\"},{\"id\":1645017,\"name\":\"Laura Dotson\",\"character\":\"Herself\",\"photo\":\"https://image.tmdb.org/t/p/w780/hk0g72DFEFzbrn3uGaSYAHm5QAU.jpg\"},{\"id\":1645020,\"name\":\"Darrell Sheets\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/l8qhD7zBi36zcf78J5iFF7ddNkV.jpg\"},{\"id\":1645023,\"name\":\"Barry Weiss\",\"character\":\"Himself\",\"photo\":\"https://image.tmdb.org/t/p/w780/8u5OzGKzGalZdvRywfpII6Yem5l.jpg\"}],\"trailers\":[{\"key\":\"FbvYl7qDZYo\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"l6Zf4bpfEeQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":