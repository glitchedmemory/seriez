s://image.tmdb.org/t/p/w780/bXbBKbvqiLqMaGnIoKg6p1AcU5i.jpg\",\"rating\":7.5,\"year\":2015,\"type\":\"tv\",\"_score\":0.21935483870967742,\"_genreOverlap\":1},{\"id\":98136,\"title\":\"Beneath The Wave\",\"poster\":\"https://image.tmdb.org/t/p/w780/cdFDfGkagGSAg2nZGSLNsBAt9Wj.jpg\",\"rating\":5,\"year\":2020,\"type\":\"tv\",\"_score\":0.21935483870967742,\"_genreOverlap\":1},{\"id\":63419,\"title\":\"Villiany Ganbo\",\"poster\":\"https://image.tmdb.org/t/p/w780/xpNwJhkJqUXx0f7cczD8FGHWKvP.jpg\",\"rating\":7.3,\"year\":2014,\"type\":\"tv\",\"_score\":0.21567164179104478,\"_genreOverlap\":1},{\"id\":214483,\"title\":\"Candy Color Paradox\",\"poster\":\"https://image.tmdb.org/t/p/w780/8lV4ByiJrsZanqBiIxZN9Hm0Duv.jpg\",\"rating\":6.8,\"year\":2022,\"type\":\"tv\",\"_score\":0.2152542372881356,\"_genreOverlap\":1},{\"id\":315509,\"title\":\"The Secret Kitchen\",\"poster\":\"https://image.tmdb.org/t/p/w780/rgfGSWukbKKorAAjaXdo3W6JZ3i.jpg\",\"rating\":8,\"year\":2026,\"type\":\"tv\",\"_score\":0.20491803278688525,\"_genreOverlap\":1},{\"id\":315113,\"title\":\"Umanai Onna wa Dame desu ka? DINKs no Totsukitoka\",\"poster\":\"https://image.tmdb.org/t/p/w780/zM1de71DmK7VxMkiukhc3hCzx64.jpg\",\"rating\":0,\"year\":2026,\"type\":\"tv\",\"_score\":0.20441176470588238,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Miniseries\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/lJdLumw2vLg0yKSfZM5lwmmmZGE.jpg\",\"seasonAirDate\":\"2014-10-20\",\"episodes\":[{\"number\":1,\"name\":\"500 Million Game I\",\"overview\":\"Da-jung is alarmed to find bundles of cash inside a bag that an old lady left in her possession. Just as she's about to hand it in, she gets a call.\",\"still\":\"https://image.tmdb.org/t/p/w780/jjlvpBJDDhBBYk3ZjN8o5gy4jSc.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-10-20\",\"runtime\":60},{\"number\":2,\"name\":\"500 Million Game II\",\"overview\":\"Dal-gu introduces debt-ridden Da-jung to Woo-jin, an old prison acquaintance. He decides to assist her when he learns of her circumstances.\",\"still\":\"https://image.tmdb.org/t/p/w780/2o2rSFxNqzYQf1wrpc8LnCfOYmE.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-10-21\",\"runtime\":60},{\"number\":3,\"name\":\"Minority Game I\",\"overview\":\"Appealing to her missing father on TV draws attention to Da-jung. Woo-jin also appears on the show to look into the scam behind his mother’s death.\",\"still\":\"https://image.tmdb.org/t/p/w780/vRGDJRvavI2T5N9yXSHDQ1MUUPJ.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2014-10-27\",\"runtime\":60},{\"number\":4,\"name\":\"Minority Game II\",\"overview\":\"Woo-jin suspects one player of joining three teams in order to win the Minority Game. He tries getting close to the contestant named Traitor X.\",\"still\":\"https://image.tmdb.org/t/p/w780/ui0JTz46pHbsF4G40LTqcF9cM8E.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2014-10-28\",\"runtime\":60},{\"number\":5,\"name\":\"Layoff Game I\",\"overview\":\"Woo-jin catches Dal-gu red-handed trying to steal Da-jung's winnings. Later, Do-young invites Da-jung to participate in a magazine photo shoot.\",\"still\":\"https://image.tmdb.org/t/p/w780/ui0JTz46pHbsF4G40LTqcF9cM8E.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2014-11-03\",\"runtime\":60},{\"number\":6,\"name\":\"Layoff Game II\",\"overview\":\"Having escaped earlier danger, and with Dal-gu's help, Woo-jin sneaks into the game hall and imparts words of advice to an isolated Da-jung.\",\"still\":\"https://image.tmdb.org/t/p/w780/noqYk0e7hdVUOYj1sCpyaoYBA2T.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-11-04\",\"runtime\":60},{\"number\":7,\"name\":\"President Game I\",\"overview\":\"It's the President's Game; only those elected can make it through. Dal-gu, who has given up debt collecting, is chosen as a candidate.\",\"still\":\"https://image.tmdb.org/t/p/w780/l9fpfiF0e0OK5qwqx7fHP7l3jAN.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-11-10\",\"runtime\":60},{\"number\":8,\"name\":\"President Game II\",\"overview\":\"Dal-gu fulfills his promise to distribute the funds among his supporters -- only to discover the safe is empty. Do-young points the finger at Woo-jin.\",\"still\":\"https://image.tmdb.org/t/p/w780/2DAZLQmg9DZIQFM84CJ7WxSqxx6.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2014-11-11\",\"runtime\":60},{\"number\":9,\"name\":\"Smuggling Game I\",\"overview\":\"The show's producer meets Da-jung's father in secret, while Woo-jin suspects Do-young of being connected to past psychological experiments in the U.S.\",\"still\":\"https://image.tmdb.org/t/p/w780/5QYIIWtY51NcNfEr8F9iKzGUbEs.jpg\",\"rating\":10,\"voteCount\":1,\"airDate\":\"2014-11-17\",\"runtime\":60},{\"number\":10,\"name\":\"Smuggling Game II\",\"overview\":\"Woo-jin tries closing in on Do-young by persuading three of his team members to join him. But Do-young has plenty more tricks up his sleeve.\",\"still\":\"https://image.tmdb.org/t/p/w780/yvxGRWalTcNuMGJOiK66lTbOsXk.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-11-18\",\"runtime\":60},{\"number\":11,\"name\":\"Last Man Standing I\",\"overview\":\"Da-jung is shocked to discover that Woo-jin is the real cause of her father’s debt. The finals begin amid a mix of speculation and emotions.\",\"still\":\"https://image.tmdb.org/t/p/w780/RBbv6HoIRLdhFXHiIQQmkofIf9.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-11-24\",\"runtime\":68},{\"number\":12,\"name\":\"Last Man Standing II\",\"overview\":\"Da-jung, Woo-jin and Do-young reach the final. Each harbors a distrust of the others as they point their guns, possibly loaded with live ammunition.\",\"still\":\"https://image.tmdb.org/t/p/w780/lBDcfU27LApCfI0gLBouZFczFCc.jpg\",\"rating\":9,\"voteCount\":1,\"airDate\":\"2014-11-25\",\"runtime\":61}],\"firstAirDate\":\"2014-10-20\"}","status":200,"url":""},"revalidate":86400,"tags":[]}