{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":59671,\"title\":\"Bering Sea Gold: Under the Ice\",\"tagline\":\"\",\"overview\":\"Bering Sea Gold: Under the Ice is a reality television series, from the creators of the Deadliest Catch, set in Nome, Alaska that airs on Discovery Channel. In the series we follow the crews on 'The Lazy Gator', 'The Clark' and 'Shamrock' during the ice season. Viewers of the Bering Sea Gold television series will recognise several crew members.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/x3pdfX9Q6Zx4zUhMwcSA81rUc1o.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/8NSgTjHpFTRb82CnShUlRieXxLq.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":7.4,\"voteCount\":7,\"year\":2012,\"genres\":[\"Reality\",\"Documentary\",\"Drama\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":3,\"totalEpisodes\":18,\"createdBy\":[],\"networks\":[\"Discovery\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2014-10-10\",\"cast\":[{\"id\":1215558,\"name\":\"Mike Rowe\",\"character\":\"Self - Narrator (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/rkNnugOmkMD1sXPCSQK1UZFAoWE.jpg\"},{\"id\":3286247,\"name\":\"Zeke Tenhoff\",\"character\":\"Self - Owner of The Clark\",\"photo\":\"https://image.tmdb.org/t/p/w780/8OmiDRJfo5JNdjsJEHpgcgYR5CA.jpg\"},{\"id\":3286243,\"name\":\"Emily Riedel\",\"character\":\"Self - Owner of The Eroica\",\"photo\":\"https://image.tmdb.org/t/p/w780/b50Oykc18RIVXzVxl1wzoEFwNvH.jpg\"},{\"id\":3286241,\"name\":\"Shawn Pomrenke\",\"character\":\"Self - Owner of Shamrock\",\"photo\":\"https://image.tmdb.org/t/p/w780/3DpeQUMLvBywWDnfTHo2bK4vU0y.jpg\"},{\"id\":3286248,\"name\":\"Steve Riedel\",\"character\":\"Self - Captain of Steve's World on Ice\",\"photo\":\"https://image.tmdb.org/t/p/w780/pvvevuZBm6Mikj0N9zjyCBCFNQe.jpg\"}],\"trailers\":[{\"key\":\"Uo3eyPZYCIU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"