{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":59670,\"title\":\"Southie Rules\",\"tagline\":\"\",\"overview\":\"Southie Rules is an American reality television series on A&E. The series premiered on January 29, 2013, and chronicles the day-to-day life of the Niedzwiecki family, a multi-generational family located in South Boston that lives all under one roof in a three-level home. A&E moved the series to Saturday after episode four ratings fell to a series low of 606,000 viewers, which is half of its debut audience. Two episodes aired on February 23, 2013 while the remaining episodes were burned off on March 2, 2013 in a mid-afternoon marathon.\",\"posterPath\":null,\"backdropPath\":null,\"youtubeBackdrop\":\"https://img.youtube.com/vi/m45ZmaKp_5Q/maxresdefault.jpg\",\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":2013,\"genres\":[\"Reality\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":1,\"totalEpisodes\":11,\"createdBy\":[],\"networks\":[\"A&E\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2013-03-16\",\"cast\":[{\"id\":1325074,\"name\":\"Jessica Hanna\",\"character\":\"Herself\",\"photo\":null},{\"id\":1325075,\"name\":\"Devin Mahoney\",\"character\":\"Himself\",\"photo\":null},{\"id\":1325076,\"name\":\"Jennifer Mazzeo\",\"character\":\"Herself\",\"photo\":null},{\"id\":1325077,\"name\":\"Matt Niedzwiechi\",\"character\":\"Himself\",\"photo\":null},{\"id\":1325078,\"name\":\"Camille Niedzwiecki\",\"character\":\"Herself\",\"photo\":null},{\"id\":1325079,\"name\":\"Jonathan Niedzwiecki\",\"character\":\"Himself\",\"photo\":null},{\"id\":1325080,\"name\":\"Walter Niedzwiecki\",\"character\":\"Himself\",\"photo\":null},{\"id\":1325081,\"name\":\"Jarod Winters\",\"character\":\"Himself\",\"photo\":null},{\"id\":1325082,\"name\":\"Leah Lentini Winters\",\"character\":\"Herself\",\"photo\":null}],\"trailers\":[{\"key\":\"m45ZmaKp_5Q\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\"