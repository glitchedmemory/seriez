780/pAc9cxhsBhXfDh2qTHwYXr5vv6m.jpg\",\"rating\":0,\"year\":2009,\"type\":\"tv\",\"_score\":0.21445783132530122,\"_genreOverlap\":1},{\"id\":214605,\"title\":\"Fairy From the Painting\",\"poster\":\"https://image.tmdb.org/t/p/w780/7N4kRCwfcbjExPKaSW2uhEFWcPi.jpg\",\"rating\":6,\"year\":2022,\"type\":\"tv\",\"_score\":0.2122448979591837,\"_genreOverlap\":1},{\"id\":32039,\"title\":\"Love Is Only In The Movies\",\"poster\":null,\"rating\":0,\"year\":2010,\"type\":\"tv\",\"_score\":0.21071428571428572,\"_genreOverlap\":1},{\"id\":32043,\"title\":\"The Proud Twins\",\"poster\":\"https://image.tmdb.org/t/p/w780/2Be4SwVGJL5f5E4OVf9o67x2UkF.jpg\",\"rating\":7.3,\"year\":2005,\"type\":\"tv\",\"_score\":0.20923076923076925,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/hdLb5Ernh2TtbqYJr8SLDEq8c6L.jpg\",\"seasonAirDate\":\"2023-07-27\",\"episodes\":[{\"number\":1,\"name\":\"Boys Should Be Carful Outside\",\"overview\":\"Childhood neighbors Ling Chao and Xiao Tu have spent their lives teasing and supporting each other. As they begin a new school year, their close friendship hides feelings neither is ready to acknowledge.\",\"still\":\"https://image.tmdb.org/t/p/w780/9E0UrECQiQ0FEEpPgI3wHykJGEk.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":27},{\"number\":2,\"name\":\"A New Official is Supposed to Apply Strict Measures\",\"overview\":\"Daily quarrels and playful competitions continue, but Ling Chao quietly watches over Xiao Tu whenever she needs help. Their families encourage their inseparable bond.\",\"still\":\"https://image.tmdb.org/t/p/w780/tPnpysdrMx1uqtkbXDB4VJ6G1IW.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":33},{\"number\":3,\"name\":\"A Secret I Can't Tell\",\"overview\":\"The arrival of new classmates changes the group dynamic. Xiao Tu begins making new friends, while Ling Chao unexpectedly finds himself bothered by the attention she receives.\",\"still\":\"https://image.tmdb.org/t/p/w780/upxWh9cdRl7fdVYG3gWdHIkCQyY.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":26},{\"number\":4,\"name\":\"Doomsday\",\"overview\":\"A misunderstanding sparks jealousy between the childhood friends. Though neither admits it, both begin realizing that their relationship means more than simple friendship.\",\"still\":\"https://image.tmdb.org/t/p/w780/5jBCfGUhFKNefmWXgkra5gepEY9.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":37},{\"number\":5,\"name\":\"You Caught My Attention\",\"overview\":\"Preparing for school activities brings Ling Chao and Xiao Tu closer. Their teamwork highlights how naturally they rely on each other through every challenge.\",\"still\":\"https://image.tmdb.org/t/p/w780/jndKIG8AETTLqH9WTK7WF9T1OZL.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":39},{\"number\":6,\"name\":\"A Wonderful Destiny\",\"overview\":\"As classmates tease them about their closeness, Ling Chao starts recognizing his growing affection. Xiao Tu remains unaware of the depth of his emotions.\",\"still\":\"https://image.tmdb.org/t/p/w780/ij6FmJXg1uwyd93Hb2R909g3mh6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":38},{\"number\":7,\"name\":\"Dad, You're Back\",\"overview\":\"After supporting each other through personal struggles, the pair promises to stay together no matter what the future brings. Their bond grows stronger than ever.\",\"still\":\"https://image.tmdb.org/t/p/w780/bsaxt4k91mgqHcG8czw4N0hKPIU.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":36},{\"number\":8,\"name\":\"Rabbits Don't Eat Grass by Their Nests\",\"overview\":\"A heartfelt moment leaves both questioning the true nature of their relationship. While friendship remains their foundation, romance quietly begins to bloom.\",\"still\":\"https://image.tmdb.org/t/p/w780/iQcWSuNnbDmF1CHc6PfQwUVqLav.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":34},{\"number\":9,\"name\":\"I Was Blown by the Cold Wind for You\",\"overview\":\"Ling Chao realizes he can no longer hide his feelings for Xiao Tu. While trying to act as her dependable best friend, he quietly searches for the right moment to confess.\",\"still\":\"https://image.tmdb.org/t/p/w780/9KkXOfAkxZZdAuMDp4F2tNpAcnj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":36},{\"number\":10,\"name\":\"You, the One from My Memory\",\"overview\":\"A series of misunderstandings keeps the two from expressing their true emotions. Despite the awkwardness, they continue supporting each other through school and everyday life.\",\"still\":\"https://image.tmdb.org/t/p/w780/gG5ftcDw2B6m0payFTS3oZVzhf.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":33},{\"number\":11,\"name\":\"The Original Dream\",\"overview\":\"When Xiao Tu faces setbacks, Ling Chao remains her biggest source of comfort. His unwavering support makes her realize just how important he is in her life.\",\"still\":\"https://image.tmdb.org/t/p/w780/yfHJ4uibXYKfHXbIFn2rs1kgRIy.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":39},{\"number\":12,\"name\":\"I Want To See You\",\"overview\":\"Unable to ignore his feelings any longer, Ling Chao finally opens his heart. Xiao Tu is surprised but begins seeing their lifelong friendship in a new light.\",\"still\":\"https://image.tmdb.org/t/p/w780/eNPavRDcZ9fUFz3nLsgdTjat9so.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":34},{\"number\":13,\"name\":\"Heartbeat 404\",\"overview\":\"As the two navigate the transition from friends to something more, they discover that trust built over the years becomes the strongest foundation for love.\",\"still\":\"https://image.tmdb.org/t/p/w780/oiAYIIu2ls1XERcc20fSEiIRnvo.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":30},{\"number\":14,\"name\":\"If This Is Not Love\",\"overview\":\"Now growing closer as a couple, Ling Chao and Xiao Tu learn to balance romance with school, friendships, and family expectations without losing what makes them special.\",\"still\":\"https://image.tmdb.org/t/p/w780/rXBhqXU9Zei1GwvC6JJ9JSuUGjV.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":36},{\"number\":15,\"name\":\"A Little Crush\",\"overview\":\"Facing challenges together, the couple encourages each other to pursue their dreams. Their relationship deepens as they overcome misunderstandings with honesty and patience.\",\"still\":\"https://image.tmdb.org/t/p/w780/jTLOdAPfVQde1J27TOSpOFPshje.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":31},{\"number\":16,\"name\":\"This Damn Sweetness\",\"overview\":\"Ling Chao and Xiao Tu embrace the happiness they've long overlooked. With their friends cheering them on, they look forward to a future filled with shared dreams and lasting love.\",\"still\":\"https://image.tmdb.org/t/p/w780/KswGmcTppmdfNWeQfpQxatJNre.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":37},{\"number\":17,\"name\":\"The Experience of First Love\",\"overview\":\"Ling Chao and Xiao Tu support each other's academic goals while adjusting to life as a couple. Their years of friendship help them face every new challenge with confidence.\",\"still\":\"https://image.tmdb.org/t/p/w780/rhmVyOKC0oXqBmRW5ZnMzcFNu0C.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":37},{\"number\":18,\"name\":\"You Can't Escape\",\"overview\":\"Family expectations and school pressures test their relationship. Instead of growing apart, they learn that honest communication keeps their bond stronger than ever.\",\"still\":\"https://image.tmdb.org/t/p/w780/7jK5fEpG6mqNXvwuWmpLj4nipEo.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":31},{\"number\":19,\"name\":\"Green Mood\",\"overview\":\"As graduation approaches, the couple reflects on their childhood memories and the journey that brought them together. Their shared experiences strengthen their promise to stay by each other's side.\",\"still\":\"https://image.tmdb.org/t/p/w780/3U0VSndY60bMptyE2kHOOSRWlev.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":33},{\"number\":20,\"name\":\"Happy Breakup\",\"overview\":\"Important opportunities force Ling Chao and Xiao Tu to think about life beyond school. They encourage one another to pursue their dreams without fear of change.\",\"still\":\"https://image.tmdb.org/t/p/w780/unuZUBsAtfyRxPIcdpgLhb27H0j.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":38},{\"number\":21,\"name\":\"How Valuable Is The Sense Of Security?\",\"overview\":\"Surrounded by family and friends, the couple celebrates new milestones. They reaffirm their commitment to supporting each other through every stage of life.\",\"still\":\"https://image.tmdb.org/t/p/w780/wc7ShXRpEndmMh5atwMxNEVNbi4.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":32},{\"number\":22,\"name\":\"Life Is Full Of Ups And Downs\",\"overview\":\"Ling Chao and Xiao Tu embrace adulthood while holding onto the warmth of their childhood friendship. Their relationship matures through trust, patience, and unwavering affection.\",\"still\":\"https://image.tmdb.org/t/p/w780/46B7XJN6HYlGRPOewb1WqSnrwSe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":35},{\"number\":23,\"name\":\"I Got You Back\",\"overview\":\"Standing at the threshold of a new beginning, the couple faces the future with confidence. They realize that every memory has prepared them for the life they dream of together.\",\"still\":\"https://image.tmdb.org/t/p/w780/jzpkMFdwPMjOAfZcUxknXp1XY6e.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":32},{\"number\":24,\"name\":\"The Person Who Loves Me The Most In This World\",\"overview\":\"Ling Chao and Xiao Tu turn a lifetime of friendship into a lasting love story. Hand in hand, they step toward a bright future, proving that the most beautiful romances begin with unwavering trust, cherished memories, and choosing each other every single day.\",\"still\":\"https://image.tmdb.org/t/p/w780/1tc34TfTWbxgNSmnVMYJ0RLopS0.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2023-07-27\",\"runtime\":38}],\"firstAirDate\":\"2023-07-27\"}","status":200,"url":""},"revalidate":86400,"tags":[]}