\":1},{\"id\":217568,\"title\":\"Bros On Foot\",\"poster\":\"https://image.tmdb.org/t/p/w780/98ktxSmEUWjQKEdIV5hdDEjrkqf.jpg\",\"rating\":10,\"year\":2023,\"type\":\"tv\",\"_score\":0.2111111111111111,\"_genreOverlap\":1},{\"id\":315551,\"title\":\"Roadtrip Australia – Three Top Chefs on Four Wheels\",\"poster\":\"https://image.tmdb.org/t/p/w780/rPoNNDKhvcoWVEyk3stx6TzV09x.jpg\",\"rating\":8,\"year\":2026,\"type\":\"tv\",\"_score\":0.20967741935483872,\"_genreOverlap\":1},{\"id\":70662,\"title\":\"Road 66\",\"poster\":null,\"rating\":0,\"year\":2017,\"type\":\"tv\",\"_score\":0.20849056603773586,\"_genreOverlap\":1},{\"id\":65032,\"title\":\"Jon Richardson Grows Up\",\"poster\":\"https://image.tmdb.org/t/p/w780/8lKim1fY2IRQM0ILpMyyE8GSMLK.jpg\",\"rating\":7.5,\"year\":2014,\"type\":\"tv\",\"_score\":0.20689655172413796,\"_genreOverlap\":1}],\"seasonNumber\":2,\"seasonName\":\"Season 2\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/AcZTjWs5ajlLaHjsahSKP6R3JdP.jpg\",\"seasonAirDate\":\"2012-08-07\",\"episodes\":[{\"number\":1,\"name\":\"Two Halves of the Same Willie\",\"overview\":\"Handyman\\\" Roy gets in a heap of trouble after he saws a giant Willie Mays sculpture in half while \\\"Cowgirl\\\" Jennifer deals with a sobbing customer who is sad to see his prized possession go.\",\"still\":\"https://image.tmdb.org/t/p/w780/jbySqA0LD2PqLiBOyThD3xGz2X6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-07\",\"runtime\":24},{\"number\":2,\"name\":\"The King and His Axe\",\"overview\":\"Chris and Robbie transport two pieces of music history owned by \\\"The King\\\" himself. With a load that is slowing him down, Jarrett races against the clock to get to a restaurant opening in time.\",\"still\":\"https://image.tmdb.org/t/p/w780/3F661rIxt9U8tEohX56G0APVeqd.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-07\",\"runtime\":24},{\"number\":3,\"name\":\"Love at First Flight\",\"overview\":\"Marc runs into some bad weather that takes a toll on an exposed, custom-built hot rod. Jarrett just barely squeezes three chicken coops into his trailer.\",\"still\":\"https://image.tmdb.org/t/p/w780/2J35DLzHPRPpxGXmOGpF97iPxky.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-14\",\"runtime\":24},{\"number\":4,\"name\":\"One Crystal Short of a Geode\",\"overview\":\"\\\"Big Rig\\\" driver, Marc Springer, gets more than he bargained for when he comes toe to toe with an irate customer. \\\"Rookie\\\" Jarrett manages to barely pass a customer inspection after delivering two unique sculptures to a museum.\",\"still\":\"https://image.tmdb.org/t/p/w780/A3Wtbp4nQ2k6tFGUUI6RE7ALdXt.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-14\",\"runtime\":24},{\"number\":5,\"name\":\"From Sphere to Infinity & Beyond\",\"overview\":\"Roy shows his softer side by offering to deliver a coin-operated ride to a boy who just lost his father. Chris and Robbie run into some legal troubles when they are pulled over in Arizona.\",\"still\":\"https://image.tmdb.org/t/p/w780/3fgrpvXkVsIL4IkK9RJJ7QnL6aw.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-21\",\"runtime\":24},{\"number\":6,\"name\":\"Chicken Ship\",\"overview\":\"Jennifer tries to get a sensitive parrot to his owner before depression sets in and Roy run gets delayed after his truck breaks down.\",\"still\":\"https://image.tmdb.org/t/p/w780/yAXQpJUIrcuqdZ9fKaHZ3KneuW3.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-21\",\"runtime\":24},{\"number\":7,\"name\":\"Mud Bug Boogie\",\"overview\":\"\\\"Big Rig\\\" Marc hits a violent hailstorm while transporting an enormous trolley bus that might just be over the height limit. Jennifer fights the scorching summer sun while she races to get 400 lbs. of live crawfish on ice to a restaurant opening.\",\"still\":\"https://image.tmdb.org/t/p/w780/e0WSXlQKIhI9qwymPxJKrWVj2Yn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-28\",\"runtime\":24},{\"number\":8,\"name\":\"Not With a Whimper but a Bang\",\"overview\":\"The Hotshot Couple\\\" catch a bad flu en route to the pickup of a state-of-the-art nuclear bomb shelter and Chris butts heads with the seller on the loading of the oversized bunker.\",\"still\":\"https://image.tmdb.org/t/p/w780/hJEZw1WaqDr9QmOs3uGRyUipm.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-08-28\",\"runtime\":24},{\"number\":9,\"name\":\"Planes, Pains, and a Spire of Flames\",\"overview\":\"Jennifer troubleshoots the biggest load of her career--a Mini Max Airplane--that tests her patience. Marc doesn't have a minute to spare or he'll suffer huge consequences with this high dollar load.\",\"still\":\"https://image.tmdb.org/t/p/w780/lhFQ5i7eUbQe0NEJGm4RD5JZppT.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-09-11\",\"runtime\":24},{\"number\":10,\"name\":\"Flux Capacity\",\"overview\":\"Roy's truck comes to a screeching halt when it breaks down for the last time while Jarrett delivers a $150,000 restored Delorean to a nit-picking customer.\",\"still\":\"https://image.tmdb.org/t/p/w780/hLImSK0HCQD9A7R6oJuWloHhE1N.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-09-11\",\"runtime\":24},{\"number\":11,\"name\":\"Wheels of Misfortune\",\"overview\":\"Jarrett endures the worst load of his career with a carriage too large for his trailer while Jennifer must hire out help to assist with the loading of a carnival ride.\",\"still\":\"https://image.tmdb.org/t/p/w780/pxpFG5lBMmOYNCe02jXTS9aYb4H.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-09-18\",\"runtime\":24},{\"number\":12,\"name\":\"Wings, a Prayer and a Know-It-All\",\"overview\":\"Chris and Robbie do their first \\\"motherload\\\" -- a vintage DC-7 Airplane -- while Roy helps a community to rebuild their homes after the devastating Bastrop, Texas fires.\",\"still\":\"https://image.tmdb.org/t/p/w780/ogALeIne2i2RbP0of4s9YCc1W5a.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-09-18\",\"runtime\":24},{\"number\":13,\"name\":\"Big Idea, Bad Idea\",\"overview\":\"Chris and Robbie haul an enormous spider to an amusement park with a strict delivery schedule. The precariously positioned arachnid requires reinforcements to ensure its safety, putting the young couple to work.\",\"still\":\"https://image.tmdb.org/t/p/w780/iu8RsqBmFu8FVdrK1TwokzbXlGT.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-10-02\",\"runtime\":24},{\"number\":14,\"name\":\"Cruisin' for a Bruisin'\",\"overview\":\"Jennifer has two days to get a six-layer wedding cake to a reception completely in tact. After picking up a Bozo the Clown arcade game, she books it to get to the wedding in time, but when she arrives, the pastry chefs do not like what they see.\",\"still\":\"https://image.tmdb.org/t/p/w780/rE7SIgGOqH0eV0HWjRmO5vGCEIC.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2012-10-02\",\"runtime\":24}],\"firstAirDate\":\"2012-01-10\"}","status":200,"url":""},"revalidate":86400,"tags":[]}