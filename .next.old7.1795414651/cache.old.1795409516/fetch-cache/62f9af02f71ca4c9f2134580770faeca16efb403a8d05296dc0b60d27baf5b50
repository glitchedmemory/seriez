{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":3864,\"title\":\"NOVA scienceNOW\",\"tagline\":\"\",\"overview\":\"NOVA scienceNOW is a News magazine version of the long-running and venerable PBS science program Nova. Premiering on January 25, 2005, the series was originally hosted by Robert Krulwich, who described it as an experiment in coverage of \\\"breaking science, science that's right out of the lab, science that sometimes bumps up against politics, art, culture\\\". At the beginning of season two, Neil deGrasse Tyson replaced Krulwich as the show's host. Tyson announced he would leave the show and was replaced by David Pogue beginning season 6.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/bYpFFLz9UxPLRLxRSRN8zj3165T.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/1OdOOv4fGjZ4lQAc8juGZGUrloE.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8,\"voteCount\":10,\"year\":2005,\"genres\":[\"Documentary\",\"News\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":6,\"totalEpisodes\":40,\"createdBy\":[],\"networks\":[\"PBS\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2012-11-14\",\"cast\":[{\"id\":93047,\"name\":\"Joshua Seftel\",\"character\":\"Director\",\"photo\":\"https://image.tmdb.org/t/p/w780/8KNtzGaiJTFzsV7oaSeCHZ35miX.jpg\"},{\"id\":1248182,\"name\":\"Julia Cort\",\"character\":\"Director\",\"photo\":null},{\"id\":1258365,\"name\":\"Terri Randall\",\"character\":\"Director\",\"photo\":null},{\"id\":1223307,\"name\":\"Sarah Holt\",\"character\":\"Director\",\"photo\":null},{\"id\":1245962,\"name\":\"David Pogue\",\"character\":\"Host\",\"photo\":\"https://image.tmdb.org/t/p/w780/h8VsU0aoMZv4DQioaCeBSDLIKsb.jpg\"},{\"id\":2070707,\"name\":\"Ziya Tong\",\"character\":\"Self (Correspondent)\",\"photo\":null},{\"id\":2070708,\"name\":\"Peter Standring\",\"character\":\"Self (Correspondent)\",\"photo\":null},{\"id\":559311,\"name\":\"Chad Cohen\",\"character\":\"Self (Cor