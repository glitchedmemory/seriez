ore\":0.2272727272727273,\"_genreOverlap\":1},{\"id\":62041,\"title\":\"Alaska: Earth's Frozen Kingdom\",\"poster\":\"https://image.tmdb.org/t/p/w780/w2WXnM9xRMHt57ls5gH1PeglUyV.jpg\",\"rating\":6.5,\"year\":2015,\"type\":\"tv\",\"_score\":0.225,\"_genreOverlap\":1},{\"id\":128493,\"title\":\"Gold Rush: Winter's Fortune\",\"poster\":\"https://image.tmdb.org/t/p/w780/kK7W4fzovQQ5UPtDc7gbZfujDcf.jpg\",\"rating\":8.1,\"year\":2021,\"type\":\"tv\",\"_score\":0.22181818181818183,\"_genreOverlap\":1},{\"id\":64982,\"title\":\"Alaska Monsters\",\"poster\":\"https://image.tmdb.org/t/p/w780/sM41ap1J43tARURhVIqJYYmbkIn.jpg\",\"rating\":4,\"year\":2014,\"type\":\"tv\",\"_score\":0.21690140845070424,\"_genreOverlap\":1}],\"seasonNumber\":18,\"seasonName\":\"Season 18\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/n7IIySs19AluPpviWMZC4wJkw4M.jpg\",\"seasonAirDate\":\"2024-08-16\",\"episodes\":[{\"number\":1,\"name\":\"Into Hell Niño\",\"overview\":\"Chaotic El Niño conditions impact the ice, creating dangerous pressure ridges and flipping the gold miners' game plans upside down as some are forced off their claims.\",\"still\":\"https://image.tmdb.org/t/p/w780/zPqn1KvxfD9u6ELOuPfzzmvaf6u.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-08-16\",\"runtime\":41},{\"number\":2,\"name\":\"Opportunity Knocks\",\"overview\":\"As Shawn takes advantage of an unexpected deal, Zeke must pivot his strategy when the Tomcod claim proves dangerously inaccessible. A mistake by his crew forces Chris McCully to rethink his operation as Kris Kelly contends with troublesome ground.\",\"still\":\"https://image.tmdb.org/t/p/w780/eHZSA34c2WMRyptQ53xBA8uKYDB.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-08-23\",\"runtime\":41},{\"number\":3,\"name\":\"The Art of Cold War\",\"overview\":\"Vernon's crew attempts their first dive on the frozen battlefield, but tempers explode. Zeke breaks in his season by revisiting a mining spot from his past. Shawn sends in his ace diver, and the Kellys make a much-needed breakthrough.\",\"still\":\"https://image.tmdb.org/t/p/w780/oI0x3zl7iZe59MmWG3BVYGe5FIb.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-08-30\",\"runtime\":41},{\"number\":4,\"name\":\"Nome Alone\",\"overview\":\"Left out in the cold by his crew, Chris McCully risks an unprecedented winter solo dive without a tender. The Kellys look to continue their new hot streak, but hypothermia becomes a serious threat for one diver when equipment begins to fall apart.\",\"still\":\"https://image.tmdb.org/t/p/w780/5VM9vkkZzlPtTpNvIbvsSz8oozH.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-06\",\"runtime\":41},{\"number\":5,\"name\":\"A Tale of Three Miners\",\"overview\":\"A perilous plunge into deeper depths wreaks havoc on Chris McCully's air compressor. Shawn scours foreign ground for gold to keep his operation funded. A faulty sluice box could spell disaster for the Kellys.\",\"still\":\"https://image.tmdb.org/t/p/w780/kJTmt1J7uJIz2GenTzV6BPD1FbM.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-13\",\"runtime\":41},{\"number\":6,\"name\":\"Place Your Bets\",\"overview\":\"Shawn moves in on Vernon's spot on Claim 56 as the two miners chase the same paystreak but only one will prevail.\",\"still\":\"https://image.tmdb.org/t/p/w780/ovB2pCViktR2ncfza2lBSl1BL6G.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-13\",\"runtime\":41},{\"number\":7,\"name\":\"Perfect Disharmony\",\"overview\":\"Chris McCully pushes his fancy new equipment to the brink. Vernon and his rookie diver clash. A frozen regulator threatens Andy's life. Shawn casts a wide net to get his season going finally.\",\"still\":\"https://image.tmdb.org/t/p/w780/m6gZBGpDPrrGq9XHV87sLSzSR9y.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-20\",\"runtime\":41},{\"number\":8,\"name\":\"Tangled Up in Gold\",\"overview\":\"Desperate to salvage his season, Shawn takes a pivotal leap of faith. Zeke reaches a critical crossroads after his family visits him at the mining site. Vernon's diver gets into a risky tangle under the ice. The Kellys initiate their fledgling diver.\",\"still\":\"https://image.tmdb.org/t/p/w780/hFBzSYMZdD4IO2ypoLb3ucTQvCc.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-20\",\"runtime\":41},{\"number\":9,\"name\":\"Choose Your Own Misadventure\",\"overview\":\"Birthday boy Shawn Pomrenke boldly moves back to Tomcod. Fed up with a faulty sluice box, the Kellys resurrect an old piece of equipment called The Coffin. Zeke finds a reef that could yield some great gold, and Chris McCully plans a marathon dive.\",\"still\":\"https://image.tmdb.org/t/p/w780/tJsDWz7xzPo5UuC9cKwCDNPB7qg.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-09-27\",\"runtime\":41},{\"number\":10,\"name\":\"The Pit and the Pugilists\",\"overview\":\"Shawn must clear the ice on his gold-filled inland claim, to avoid bogging down in summertime mud; a crew fight sidelines Vern's lucrative run; Chris makes a risky wager that will force him to double his gold goal.\",\"still\":\"https://image.tmdb.org/t/p/w780/1slYSGeTlti3Xrxx2eCv6HywClL.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-04\",\"runtime\":41},{\"number\":11,\"name\":\"Trapped Under Ice\",\"overview\":\"With 72 hours left in the Bering Sea mining season, shifting ice cuts off access to Vern's diver under the ice; the Kellys hit a paystreak but are praying their repairs will hold up; Shawn hits bedrock and learns if his gamble paid off.\",\"still\":\"https://image.tmdb.org/t/p/w780/39f2okEOsLewfCZ3L8bskM0z5cD.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-11\",\"runtime\":41},{\"number\":12,\"name\":\"Downside Up\",\"overview\":\"It's the final day of Bering Sea Gold's most difficult ice season, and Shawn makes one more epic dive to try and hit his goal. Young gun Chris races all-out for his biggest cleanup yet, and Vern relies on diver Gary to secure their ambitious summer plans.\",\"still\":null,\"rating\":0,\"voteCount\":0,\"airDate\":\"2024-10-18\",\"runtime\":41}],\"firstAirDate\":\"2012-01-27\"}","status":200,"url":""},"revalidate":86400,"tags":[]}