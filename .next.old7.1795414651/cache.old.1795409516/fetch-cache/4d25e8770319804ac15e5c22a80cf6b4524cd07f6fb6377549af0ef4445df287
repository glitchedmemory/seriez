,\"similar\":[],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/rfAxAa8K7OuIy0rliu7cahNXbo3.jpg\",\"seasonAirDate\":\"2002-02-25\",\"episodes\":[{\"number\":1,\"name\":\"Tusenbröder - Del 1\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/2cg5BwNjbLbW8r9ViZUfjjbkhIn.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2002-02-25\",\"runtime\":60},{\"number\":2,\"name\":\"Tusenbröder - Del 2\",\"overview\":\"Amanda förlorar barnet vid födseln och hon och Niklas går i samtalsterapi. Hoffas bank hotar med att säga upp villalånet och Annelie börjar förstå att han har problem med ekonomin. Men Hoffa är alldeles för stolt för att ta de händer som räcks ut för att hjälpa honom. När hans bror ber att få hjälpa honom säger han nej. De tre har hittat en liten bank i ett samhälle i Södermanland som de rånar en kylig vinterdag. Efter rånet stoppas de i en poliskontroll men de har tur och kan åka vidare.\",\"still\":\"https://image.tmdb.org/t/p/w780/nEclgmtKOHLyPDFbAMS2AXKxptf.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2002-03-04\",\"runtime\":60},{\"number\":3,\"name\":\"Tusenbröder - Del 3\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/3aZmbikgdDV65ZfPlp0akZPFKt7.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2002-03-11\",\"runtime\":60},{\"number\":4,\"name\":\"Tusenbröder - Del 4\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/kyF5EHW9jM6OmagQYgsit3iHL0O.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2002-03-18\",\"runtime\":60},{\"number\":5,\"name\":\"Tusenbröder - Del 5\",\"overview\":\"\",\"still\":\"https://image.tmdb.org/t/p/w780/lMaE6NXwghL6eX4yQn64iOo3I7R.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2002-03-25\",\"runtime\":60}],\"firstAirDate\":\"2002-02-25\"}","status":200,"url":""},"revalidate":86400,"tags":[]}