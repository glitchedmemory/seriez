{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":115465,\"title\":\"Gold Rush: Mine Rescue with Freddy & Juan\",\"tagline\":\"\",\"overview\":\"With nearly 40 years of mining under his belt, Freddy Dodge goes on the road to help struggling mine owners to hit the mother lode; he teams up with Juan Ibarra to overhaul washplants, introduce gold recovery techniques and transform operations.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/4YShR1hfjNl1Hltjm9PE5UClZSd.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/iROmECE3YzFDrCFoACTOXWyEcDr.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":8.3,\"voteCount\":20,\"year\":2021,\"genres\":[\"Reality\"],\"status\":\"Returning Series\",\"type\":\"tv\",\"totalSeasons\":6,\"totalEpisodes\":56,\"createdBy\":[],\"networks\":[\"Discovery\",\"discovery+\"],\"countries\":[{\"code\":\"US\",\"name\":\"United States of America\"}],\"lastAirDate\":\"2026-05-01\",\"cast\":[{\"id\":1646699,\"name\":\"Freddy Dodge\",\"character\":\"Self\",\"photo\":\"https://image.tmdb.org/t/p/w780/2twSUBLZo8R4ifBWGr8kTPS62Sr.jpg\"},{\"id\":2914319,\"name\":\"Juan Ibarra\",\"character\":\"Self\",\"photo\":\"https://image.tmdb.org/t/p/w780/26faj6BPLfKADq9qLftCImFevrh.jpg\"},{\"id\":54221,\"name\":\"Paul Christie\",\"character\":\"Narrator (voice)\",\"photo\":null}],\"trailers\":[{\"key\":\"VXwbudUlBPA\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"zm3ZhWvOIC8\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"ToXOMOZr9tg\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":128493,\"title\":\"Gold Rush: Winter's Fortune\",\"poster\":\"https://image.tmdb.org/t/p/w780/kK7W4fzovQQ5UPtDc7gbZfujDcf.jpg\",\"rating\":8.1,\"year\":2021,\"type\":\"tv\",\"_score\":0.42608695652173917,\"_genreOverlap\":1},{\"id\":247950,\"title\":\"America's Backyard Gold\",\"poster\":\"https://image.tmdb.org/t/p/w780/uRnEhTIIpn29DeFf8P