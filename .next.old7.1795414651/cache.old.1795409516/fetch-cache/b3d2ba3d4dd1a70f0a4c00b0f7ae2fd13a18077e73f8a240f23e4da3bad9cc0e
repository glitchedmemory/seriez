{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":210899,\"title\":\"UniteUp!\",\"tagline\":\"\",\"overview\":\"Akira Kiyose, a high schooler who loves to sing, gets recruited by a talent agency called sMiLea Production. Akira learns that the legendary idols “Anela”, who shocked the world with their sudden retirement, are behind the agency developing talent. Together with Banri Naoe and Chihiro Isuzugawa, also recruited by the agency, they form an idol group as they chase their dream towards super stardom alongside other idol groups “LEGIT” and “JAXX/JAXX”.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/7jWi4SppOmtQMfxmviNlEUAY3Tz.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/axAMkNIcbyHVJj3B04LElzNmsFd.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":6,\"voteCount\":9,\"year\":2023,\"genres\":[\"Animation\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":24,\"createdBy\":[],\"networks\":[\"Gunma TV\",\"TOKYO MX\",\"BS11\",\"Tochigi TV\"],\"countries\":[{\"code\":\"JP\",\"name\":\"Japan\"}],\"lastAirDate\":\"2025-04-06\",\"cast\":[{\"id\":2234425,\"name\":\"Jun Takahashi\",\"character\":\"Director\",\"photo\":null},{\"id\":3699781,\"name\":\"Shoichi Kita\",\"character\":\"Director\",\"photo\":null},{\"id\":1938744,\"name\":\"Shinichiro Ushijima\",\"character\":\"Director\",\"photo\":null},{\"id\":1298322,\"name\":\"Yojiro Arai\",\"character\":\"Director\",\"photo\":null},{\"id\":1481750,\"name\":\"Yoshitaka Nagaoka\",\"character\":\"Director\",\"photo\":null},{\"id\":3515823,\"name\":\"Kazuya Monma\",\"character\":\"Director\",\"photo\":null},{\"id\":1567477,\"name\":\"Ayako Kurata\",\"character\":\"Director\",\"photo\":null},{\"id\":2935153,\"name\":\"Tazumi Mukaiyama\",\"character\":\"Director\",\"photo\":null},{\"id\":3707556,\"name\":\"Tomoki Fujiwara\",\"character\":\"Director\",\"photo\":null},{\"id\":2282935,\"name\":\"Tomomi Umetsu\",\"character\":\"Director\",\"photo\":null},{\"id\":2376301,\"