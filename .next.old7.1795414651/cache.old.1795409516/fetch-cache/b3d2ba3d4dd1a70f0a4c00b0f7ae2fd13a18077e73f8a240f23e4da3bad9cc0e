/w780/jB0zajERUFTkCPSw6e69AAxFnhu.jpg\"},{\"id\":3083119,\"name\":\"Shinnosuke Morikage\",\"character\":\"Eishirou Nijou (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/qMAP8gHThbCLTYYK3Htru2BPlzb.jpg\"},{\"id\":2155373,\"name\":\"Ryuichiro Sakata\",\"character\":\"Fuuga Tougou (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/ubmVQU1nrzgbLv11lfLRq8x7wKO.jpg\"},{\"id\":1388751,\"name\":\"Soma Saito\",\"character\":\"Lin Ootsuki (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/8W8Y02Jmjivw0kk5PDih9dqiyd9.jpg\"},{\"id\":2161808,\"name\":\"Yoshiki Nakajima\",\"character\":\"Maoto Tsujidou (voice)\",\"photo\":\"https://image.tmdb.org/t/p/w780/izvxmcL0bL5BqpqSdHRuHEPidZ2.jpg\"}],\"trailers\":[{\"key\":\"m-YNN51Q8oM\",\"name\":\"Official Trailer 1 [Subtitled]\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"YW6YRHlBjTg\",\"name\":\"Teaser Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"MEnSbQViKzE\",\"name\":\"Promotional Video 1 [Subtitled]\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":31736,\"title\":\"Eyeshield 21\",\"poster\":\"https://image.tmdb.org/t/p/w780/1y4hiISidFouTSHkF5tOzy8fvyU.jpg\",\"rating\":8.4,\"year\":2005,\"type\":\"tv\",\"_score\":0.419811320754717,\"_genreOverlap\":1},{\"id\":31715,\"title\":\"Strain: Strategic Armored Infantry\",\"poster\":\"https://image.tmdb.org/t/p/w780/2WrCZULqB481U27oqAOtTLn5dqj.jpg\",\"rating\":6.2,\"year\":2006,\"type\":\"tv\",\"_score\":0.41875,\"_genreOverlap\":1},{\"id\":97243,\"title\":\"Kamisama Minarai: Himitsu no Cocotama\",\"poster\":\"https://image.tmdb.org/t/p/w780/alZBH9XDflTctNO5GIRkGmx5Zqw.jpg\",\"rating\":8,\"year\":2015,\"type\":\"tv\",\"_score\":0.41855670103092785,\"_genreOverlap\":1},{\"id\":31741,\"title\":\"Black Blood Brothers\",\"poster\":\"https://image.tmdb.org/t/p/w780/tAA1BKAqpRtnemHL8zF4cG7NtYn.jpg\",\"rating\":6.3,\"year\":2006,\"type\":\"tv\",\"_score\":0.41704545454545455,\"_genreOverlap\":1},{\"id\":130728,\"title\":\"DD Fist of the North Star\",\"poster\":\"https://image.tmdb.org/t/p/w780/8Lv6YKpP12AUalXkBzJb7Mg2sRd.jpg\",\"rating\":6,\"year\":2013,\"type\":\"tv\",\"_score\":0.4166666666666667,\"_genreOverlap\":1},{\"id\":314554,\"title\":\"From Overshadowed to Overpowered: Second Reincarnation of a Talentless Sage\",\"poster\":\"https://image.tmdb.org/t/p/w780/p4TE3kK2iyuADfDYIRDTxjahdNa.jpg\",\"rating\":7,\"year\":2026,\"type\":\"tv\",\"_score\":0.4164835164835165,\"_genreOverlap\":1},{\"id\":31731,\"title\":\"Gunslinger Girl\",\"poster\":\"https://image.tmdb.org/t/p/w780/hZrhtwcSydWh3rxQSB6we1KSql7.jpg\",\"rating\":7,\"year\":2003,\"type\":\"tv\",\"_score\":0.4164835164835165,\"_genreOverlap\":1},{\"id\":31739,\"title\":\"Kiba\",\"poster\":\"https://image.tmdb.org/t/p/w780/roNaULLgqVA8SnLoOntOaPFvY8L.jpg\",\"rating\":7.6,\"year\":2006,\"type\":\"tv\",\"_score\":0.4163265306122449,\"_genreOverlap\":1},{\"id\":130765,\"title\":\"Love All Play\",\"poster\":\"https://image.tmdb.org/t/p/w780/m19Cko9WIICOCdV7qiRyj5ZxyhE.jpg\",\"rating\":7,\"year\":2022,\"type\":\"tv\",\"_score\":0.41475409836065574,\"_genreOverlap\":1},{\"id\":314561,\"title\":\"Perfect Addiction\",\"poster\":\"https://image.tmdb.org/t/p/w780/yvqBzg1YHek499OQP2k6MWWI23X.jpg\",\"rating\":4.3,\"year\":2026,\"type\":\"tv\",\"_score\":0.4145631067961165,\"_genreOverlap\":1},{\"id\":31911,\"title\":\"Fullmetal Alchemist: Brotherhood\",\"poster\":\"https://image.tmdb.org/t/p/w780/5ZFUEOULaVml7pQuXxhpR2SmVUw.jpg\",\"rating\":8.7,\"year\":2009,\"type\":\"tv\",\"_score\":0.40967741935483876,\"_genreOverlap\":1},{\"id\":31718,\"title\":\"Darker than Black\",\"poster\":\"https://image.tmdb.org/t/p/w780/mPvVMKMsQGCV6dlLAtCKT9CsSWN.jpg\",\"rating\":7.6,\"year\":2007,\"type\":\"tv\",\"_score\":0.4076923076923077,\"_genreOverlap\":1}],\"seasonNumber\":1,\"seasonName\":\"Season 1\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/7jWi4SppOmtQMfxmviNlEUAY3Tz.jpg\",\"seasonAirDate\":\"2023-01-07\",\"episodes\":[{\"number\":1,\"name\":\"Let's Be Idols & Unite\",\"overview\":\"High schooler Akira was raised as the heir of Kikunoyu, a sento bathhouse run by his grandfather and mother. He always had dreams of becoming a hero. But he quit baseball, which he'd been playing since he was young, and spent his days going to karaoke after school with his childhood friend Kacchan. One day, Kacchan receives an email from the idol talent agency sMiLea Production on a recommendation from the legendary idol Anela. Although Akira has no relation to it, it seems that he might be involved...\",\"still\":\"https://image.tmdb.org/t/p/w780/8yjAs7TCGX7sWHpGSXR5Ryjh5rW.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-01-07\",\"runtime\":24},{\"number\":2,\"name\":\"Let's Try Singing & Unite\",\"overview\":\"Akira is unable to hide his surprise that he was singer KIKUNOYU, but decides to try his hand at being an idol. When visiting the agency office, he is told he'll be in an idol group with singers EVAN (Banri) and Suzu (Chihiro). On their way home, Banri, wearing a mask and sunglasses and dressed suspiciously from head to toe, suddenly gets frightened and hides when Chihiro reaches out for his mask. There seems to be a reason for his suspicious getup──?!\",\"still\":\"https://image.tmdb.org/t/p/w780/zq138tI0KDTZT5ri27JCf8ua5Zg.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-01-14\",\"runtime\":24},{\"number\":3,\"name\":\"Let's Clash & Unite\",\"overview\":\"Banri had a complex about his face and hid it. But after singing with Akira and Chihiro at the bathhouse Kikonoyu, the singers became closer, and he was able to show his true face. With vocal and dance lessons ahead of their debut, the three decide to see and learn from LEGIT's live performance. However, at the time, it didn't seem like LEGIT was preparing for the concert while Daiki and Eishiro argued as Fuga stared on...\",\"still\":\"https://image.tmdb.org/t/p/w780/5kOZvATORJwgwJWjt1sbRQfhnJr.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"2023-01-21\",\"runtime\":24},{\"number\":4,\"name\":\"Let's Prevail & Unite\",\"overview\":\"At the live performance, Akira is moved by the presence of Daiki, who looks like the main character of Akira's favorite hero anime, \\\"Crossfire.\\\" Revved up, Akira and his group get inspired for their lessons, but the dance lessons particularly seem hopeless. Later, it's decided that the three of them will get to participate in a commercial shoot as LEGIT's backup dancers. Although there's not much time before filming begins, LEGIT gives them one-on-one dance lessons. Akira, who fretfully practices yet makes little progress, begins feeling impatient and makes a proposal to Banri and Chihiro.\",\"still\":\"https://image.tmdb.org/t/p/w780/kNQGm589SL0qg97ipDWBD5tOtKp.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-02-11\",\"runtime\":24},{\"number\":5,\"name\":\"Let's Stand Up & Unite\",\"overview\":\"Akira's group is relieved to make it through the commercial shoot without any problems when Lin immediately informs them that their debut has been set. At the same time the three are busy with shoots and interviews, Anela features in an up-close and personal program focusing from now up until their retirement. Various thoughts and memories come back to the surface, including the day Lin and Maoto decided to retire and the establishment of sMiLea Production.\",\"still\":\"https://image.tmdb.org/t/p/w780/xY1rIPsP9hvAYAQcCeI0Cuqe6bu.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-02-18\",\"runtime\":24},{\"number\":6,\"name\":\"Let's Communicate & Unite\",\"overview\":\"On the day of Akira, Banri, and Chihiro's group unveiling, a typhoon forces them to cancel their live outdoor performance. Instead, the three who want to express their gratitude directly to the fans who stood by them as online singers propose a crowdless online live stream. But Lin was adamantly against it. He wanted a properly prepared event for the three-man group, but with the help of LEGIT and JAXX/JAXX, he changed his mind. The live stream somehow begins to take shape thanks to everyone's cooperation, but the power goes just before starting...?!\",\"still\":\"https://image.tmdb.org/t/p/w780/67BgZokTQ5FJaUk41mwvwAdrWyR.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-02-25\",\"runtime\":24},{\"number\":7,\"name\":\"Let's Confront & Unite\",\"overview\":\"As PROTOSTAR, Akira, Banri, and Chihiro successfully completed their live debut. But for some reason, Chihiro seems conflicted. In actuality, Chihiro is the eldest son of a famous Japanese dance master. Chihiro, unable to get into the swing of practice, is severly troubled that he cannot tell his father he is an idol nor can he tell his friends the situation. Worried about Chihiro who keeps skipping lessons, Akira and Banri visit Chihiro's house──?!\",\"still\":\"https://image.tmdb.org/t/p/w780/vLUcCinJ4nsr5elEDOsNwISkCIw.jpg\",\"rating\":8,\"voteCount\":1,\"airDate\":\"2023-03-04\",\"runtime\":24},{\"number\":8,\"name\":\"Let's Go Beyond & Unite\",\"overview\":\"With Chihiro's problem solved and their bond deepened, PROTOSTAR arrives in Hawaii together with LEGIT, JAXX/JAXX, and their leaders, Lin and Maoto. Actually, it was for a magazine photo shoot featuring the idols affiliated with sMiLea Production. Still, Akira, who was overseas for the first time, led the way putting everyone in high spirits. Each of them had a good time eating and sightseeing during the shoot. But on the flight home, they suddenly realized Banri was missing...!\",\"still\":\"https://image.tmdb.org/t/p/w780/ivdPuoZPv3XG9cnj7KKBSGIcOsq.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-03-11\",\"runtime\":24},{\"number\":9,\"name\":\"Let's Soar & Unite\",\"overview\":\"A few years back, Homare, Izumi, Jun, and Kanata lived together in a share house while working as an idol group, but they were unexpectedly fired. While in a slump, they found and helped Gakuto who had apparently collapsed from hunger and was lying on the side of the road. The four were moved by Gakuto, who came to Tokyo to make music, and his singing. Later on, Izumi is invited by Homare and the others to join a band. But try as he may, he worries about the future, unable to take the first step forward...\",\"still\":\"https://image.tmdb.org/t/p/w780/xwrCQtdGbZtfWTNF7xHmGiaIvbJ.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-03-25\",\"runtime\":24},{\"number\":10,\"name\":\"Let's Choose & Unite\",\"overview\":\"JAXX/JAXX's nationwide tour finishes, and during the after-party, Rin and Maoto announce that they have decided to hold sMiLea Production's first-ever joint live performance. While PROTOSTAR is excited for their first concert with a live audience, and LEGIT and JAXX/JAXX get fully motivated, it's decided that they will all perform a song written and composed by Maoto at the joint live show. While the important role of the group's lead has yet to be chosen, a suspicious reporter reaches out to Daiki──!\",\"still\":\"https://image.tmdb.org/t/p/w780/h3ySV18kJbs0r6ihp8rTfK13kQF.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-04-01\",\"runtime\":24},{\"number\":11,\"name\":\"Let's Believe & Unite\",\"overview\":\"Confusion hits everyone at sMiLea Production when an article in a weekly magazine states that the person who forced Lin to retire from being an idol was Daiki. The group's lead still has yet to be decided, and there are rumors that the joint live performance will be canceled. But while everyone gets increasingly anxious, only Akira continues to believe in Daiki. Akira does his best to support LEGIT's work and make the joint live performance a reality with persistence and a positive attitude. One day, Akira runs into Daiki at the same school he attends for supplementary lessons...!\",\"still\":\"https://image.tmdb.org/t/p/w780/5Wz8edOjAHM938IfMpop4XhdVMa.jpg\",\"rating\":7,\"voteCount\":1,\"airDate\":\"2023-04-08\",\"runtime\":24},{\"number\":12,\"name\":\"Let's Connect & Unite Up!\",\"overview\":\"Akira's determination to never give up and his unfailing faith in Daiki is conveyed through a game of baseball, and with Daiki's recommendation, Akira becomes the group's lead. With each of their thoughts and feelings connected and united as one, sMiLea Production's joint idol live performance finally lifts its curtains for showtime──!\",\"still\":\"https://image.tmdb.org/t/p/w780/os2Dc5FCfq7iwBjAmApgIJBCfzj.jpg\",\"rating\":6,\"voteCount\":1,\"airDate\":\"2023-04-15\",\"runtime\":24}],\"firstAirDate\":\"2023-01-07\"}","status":200,"url":""},"revalidate":86400,"tags":[]}