:[\"Action\",\"Drama\"],\"daysUntil\":null},{\"id\":1648534,\"title\":\"Sendai Girls Meiko Satomura THE FINAL\",\"poster\":\"https://image.tmdb.org/t/p/w780/rWXo3QOzOFC9smuZiOLHCVu4ajG.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/uSsA4mAbLozUy38LBRBohv45tSe.jpg\",\"rating\":9,\"year\":2025,\"type\":\"movie\",\"overview\":\"Meiko Satomura THE FINAL was a professional wrestling event promoted by Sendai Girls' Pro-Wrestling. It took place on April 29, 2025, at Korakuen Hall in Tokyo, Japan, and served as the retirement show for Sendai Girls' founder and joshi puroresu legend, \\\"The Final Boss\\\" Meiko Satomura. For her final announced match, she teamed with current protégé Manami against her long-time rival Aja Kong and perhaps her greatest trainee, Chihiro Hashimoto.\",\"genres\":[\"Action\",\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":290453,\"title\":\"TNA Turning Point 2004\",\"poster\":\"https://image.tmdb.org/t/p/w780/6SErrQJRHzHInBQPiOzZpncSaPQ.jpg\",\"backdrop\":null,\"rating\":7.5,\"year\":2004,\"type\":\"movie\",\"overview\":\"Triple X and America's Most Wanted settle their two year blood feud inside the dangerous and sadistic Six Sides of Steel where the losing team must disband. Features AJ Styles, Jeff Hardy, and Randy Savage vs. The Kings of Wrestling, plus Diamond Dallas Page vs. Raven from Orlando, FL.\",\"genres\":[\"Action\"],\"daysUntil\":null},{\"id\":40782,\"title\":\"WWE: The History Of The Intercontinental Championship\",\"poster\":\"https://image.tmdb.org/t/p/w780/mEiJNVDHP7OkefAGlzvVtYz0wUj.jpg\",\"backdrop\":null,\"rating\":7.3,\"year\":2008,\"type\":\"movie\",\"overview\":\"It's a WWE Championship with a rich and storied history and the biggest names in sports entertainment have worn its gold on the road to immortality. The Intercontinental Championship traced its history back to the 1970's, and has been held by current and future Hall of Fame superstars, including The Rock, Stone Cold Steve Austin, Triple H, Shawn Michaels, The Ultimate Warrior, Bret \\\"Hit Man\\\" Hart, Mr. Perfect, Eddie Guerrero, Edge, \\\"Macho Man\\\" Randy Savage, Ricky \\\"The Dragon\\\" Steamboat, and so many more. Throughout the summer, fans will vote for their favorite Intercontinental Championship matches from each decade, with the top vote-getters being collected in this 3-DVD set.\",\"genres\":[\"Documentary\",\"Action\",\"History\"],\"daysUntil\":null},{\"id\":1650627,\"title\":\"Sendai Girls' Pro-Wrestling in Sendai PIT\",\"poster\":\"https://image.tmdb.org/t/p/w780/4GdsKozvDVfkfWrdN7IejzSIhvM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/oSvrRp74lSuny2U0GvqUl62Nty5.jpg\",\"rating\":7,\"year\":2026,\"type\":\"movie\",\"overview\":\"Sendai Girls' Pro-Wrestling in Sendai PIT was a professional wrestling event promoted by Sendai Girls' Pro-Wrestling, held on March 27, 2026, at Sendai PIT in Sendai, Miyagi, Japan.\",\"genres\":[\"Action\",\"Drama\"],\"daysUntil\":null},{\"id\":1649548,\"title\":\"TJPW Texas Stampede in Austin ~ Day 2\",\"poster\":\"https://image.tmdb.org/t/p/w780/nTSdviV1SqxNcHsHHyOs9EybEUM.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/q8idzW0XJBhgq0Jybg4H2Z16mCa.jpg\",\"rating\":7,\"year\":2026,\"type\":\"movie\",\"overview\":\"Texas Stampede in Austin ~ Day 2 was a professional wrestling event promoted by Tokyo Joshi Pro-Wrestling (TJPW), held on March 18, 2026 at Palmer Events Center in Austin, Texas, USA.\",\"genres\":[\"Action\",\"Drama\",\"Comedy\"],\"daysUntil\":null},{\"id\":480133,\"title\":\"WWE Hell in a Cell 2017\",\"poster\":\"https://image.tmdb.org/t/p/w780/39glsCRPuihUpBzGKJdVv8iktGi.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/agfeVK9fZDgiSOKO4DBngWaR7al.jpg\",\"rating\":7,\"year\":2017,\"type\":\"movie\",\"overview\":\"Hell in a Cell (2017) is an upcoming professional wrestling pay-per-view (PPV) event and WWE Network event, produced by WWE for the SmackDown brand. It will take place on October 8, 2017 at Little Caesars Arena in Detroit, Michigan. It will be the ninth event under the Hell in a Cell chronology.\",\"genres\":[\"Action\",\"Drama\"],\"daysUntil\":null},{\"id\":1062276,\"title\":\"Dark Match\",\"poster\":\"https://image.tmdb.org/t/p/w780/6E6fBED3ix7FmrWUWZdeYG4vqK8.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/7q5RVohE85yuQ9uZWXEXlHmfUOE.jpg\",\"rating\":6,\"year\":2024,\"type\":\"movie\",\"overview\":\"A small-time wrestling company accepts a well-paying gig in a backwoods town only to learn, too late, that the community is run by a mysterious cult leader with devious plans for their match.\",\"genres\":[\"Action\",\"Horror\"],\"daysUntil\":null},{\"id\":291363,\"title\":\"Perfect Sport\",\"poster\":\"https://image.tmdb.org/t/p/w780/heuTUk1b5UCJGvRcc7bnwxumT3h.jpg\",\"backdrop\":null,\"rating\":6,\"year\":2008,\"type\":\"movie\",\"overview\":\"Lee Bishop is forced to grow up quickly when his mother leaves for Iraq and his younger sister joins him on the varsity wrestling squad.\",\"genres\":[\"Drama\"],\"daysUntil\":null},{\"id\":1650741,\"title\":\"Marigold Spring Victory Series 2026 ~ Day 6\",\"poster\":\"https://image.tmdb.org/t/p/w780/wYuWX1ESIfGs237VzYgCVowiMnf.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/z7gmj72FCpC0H106Tf7WZUfwzG8.jpg\",\"rating\":5,\"year\":2026,\"type\":\"movie\",\"overview\":\"Marigold Spring Victory Series 2026 ~ Day 6 was a professional wrestling event promoted by Dream Star★Fighting Marigold. It took place on March 28, 2026 at Shinjuku FACE in Tokyo, Japan. In the main event, Mayu Iwatani defended the GHC Women's and Marigold Super Fly Championships against Natsumi Showzuki in a double-title match.\",\"genres\":[\"Action\",\"Drama\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"zSRfZNplaPU\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"2wbSdqOqTd0\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"38JEZ50QlzA\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",