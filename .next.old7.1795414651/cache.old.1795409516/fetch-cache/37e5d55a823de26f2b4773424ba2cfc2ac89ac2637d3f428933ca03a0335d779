nres\":[\"Action\",\"Drama\"],\"daysUntil\":null},{\"id\":1560520,\"title\":\"Batman: Knightfall Part 1: Knightfall\",\"poster\":\"https://image.tmdb.org/t/p/w780/360qdtu2hLnqMu8SVHMywn420w1.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/caBIySpwuFi2i7ynvHIlnxJLOdN.jpg\",\"rating\":9.1,\"year\":2026,\"type\":\"movie\",\"overview\":\"Arkham Asylum has been destroyed, and all its inmates have been unleashed upon Gotham City. As Batman races to round up some of his greatest enemies, he is pushed to his physical and mental limits and into a final confrontation with a new threat: the man called Bane!\",\"genres\":[\"Animation\",\"Action\",\"Adventure\"],\"daysUntil\":null},{\"id\":98,\"title\":\"Gladiator\",\"poster\":\"https://image.tmdb.org/t/p/w780/aDb548BOkFfI4nFm0kx8A3Ezh7H.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/Ar7QuJ7sJEiC0oP3I8fKBKIQD9u.jpg\",\"rating\":8.2,\"year\":2000,\"type\":\"movie\",\"overview\":\"After the death of Emperor Marcus Aurelius, his devious son takes power and demotes Maximus, one of Rome's most capable generals who Marcus preferred. Eventually, Maximus is forced to become a gladiator and battle to the death against other men for the amusement of paying audiences.\",\"genres\":[\"Action\",\"Drama\",\"Adventure\"],\"daysUntil\":null},{\"id\":1284465,\"title\":\"The Death of Robin Hood\",\"poster\":\"https://image.tmdb.org/t/p/w780/13MmRwmG5NmaMfU8qNrtgGXisiD.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/lh3BDkmWJh998n4fQcHYcVi7dpm.jpg\",\"rating\":6.7,\"year\":2026,\"type\":\"movie\",\"overview\":\"Grappling with his past after a life of crime and murder, Robin Hood finds himself gravely injured after a battle he thought would be his last. In the hands of a mysterious woman, he is offered a chance at salvation.\",\"genres\":[\"Adventure\",\"Drama\",\"Action\"],\"daysUntil\":null},{\"id\":1439930,\"title\":\"The Punisher: One Last Kill\",\"poster\":\"https://image.tmdb.org/t/p/w780/qQclTgLMDvGBuUBFGHRipxkEwWR.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/qO55CD8tgVL1T4WKn6zYFFiD6lL.jpg\",\"rating\":8.2,\"year\":2026,\"type\":\"movie\",\"overview\":\"As Frank Castle searches for meaning beyond revenge, an unexpected force pulls him back into the fight.\",\"genres\":[\"Action\",\"Drama\",\"Crime\"],\"daysUntil\":null},{\"id\":124905,\"title\":\"Godzilla\",\"poster\":\"https://image.tmdb.org/t/p/w780/tphkjmQq8WebuVwNXelmjLUXuPJ.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/6CLNOzMXO9bvapDD8gsdwkJU4wN.jpg\",\"rating\":6.4,\"year\":2014,\"type\":\"movie\",\"overview\":\"Ford Brody, a Navy bomb expert, has just reunited with his family in San Francisco when he is forced to go to Japan to help his estranged father, Joe. Soon, both men are swept up in an escalating crisis when an ancient alpha predator arises from the sea to combat malevolent adversaries that threaten the survival of humanity. The creatures leave colossal destruction in their wake, as they make their way toward their final battleground: San Francisco.\",\"genres\":[\"Action\",\"Drama\",\"Sci-Fi\"],\"daysUntil\":null},{\"id\":977942,\"title\":\"The Uprising\",\"poster\":\"https://image.tmdb.org/t/p/w780/7TUl15TOsIvndKlgMWTtLgtEzZP.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/kAlAFblqBI6aGXItR4DRpT5Tozg.jpg\",\"rating\":7.7,\"year\":2026,\"type\":\"movie\",\"overview\":\"As war and plague devastate 14th-century England, a humble peasant ignites a rebellion, uniting an army of commoners to defy the King’s might in a desperate fight for justice and survival.\",\"genres\":[\"Action\",\"Drama\",\"History\"],\"daysUntil\":null},{\"id\":272,\"title\":\"Batman Begins\",\"poster\":\"https://image.tmdb.org/t/p/w780/sPX89Td70IDDjVr85jdSBb4rWGr.jpg\",\"backdrop\":\"https://image.tmdb.org/t/p/original/9IIBboV7MCT0bTxzXHmWK1Hq558.jpg\",\"rating\":7.7,\"year\":2005,\"type\":\"movie\",\"overview\":\"Driven by tragedy, billionaire Bruce Wayne dedicates his life to uncovering and defeating the corruption that plagues his home, Gotham City.  Unable to work within the system, he instead creates a new identity, a symbol of fear for the criminal underworld - The Batman.\",\"genres\":[\"Drama\",\"Crime\",\"Action\"],\"daysUntil\":null}],\"videos\":[{\"key\":\"vQ-nGvf6QVQ\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"vVe9SS9MmOI\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"},{\"key\":\"BlavHotN_ZY\",\"name\":\"Official Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"daysUntil\":null}","status":200,"url":""},"revalidate":86400,"tags":[]}