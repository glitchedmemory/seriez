ore\":0.2272727272727273,\"_genreOverlap\":1},{\"id\":62041,\"title\":\"Alaska: Earth's Frozen Kingdom\",\"poster\":\"https://image.tmdb.org/t/p/w780/w2WXnM9xRMHt57ls5gH1PeglUyV.jpg\",\"rating\":6.5,\"year\":2015,\"type\":\"tv\",\"_score\":0.225,\"_genreOverlap\":1},{\"id\":128493,\"title\":\"Gold Rush: Winter's Fortune\",\"poster\":\"https://image.tmdb.org/t/p/w780/kK7W4fzovQQ5UPtDc7gbZfujDcf.jpg\",\"rating\":8.1,\"year\":2021,\"type\":\"tv\",\"_score\":0.22181818181818183,\"_genreOverlap\":1},{\"id\":64982,\"title\":\"Alaska Monsters\",\"poster\":\"https://image.tmdb.org/t/p/w780/sM41ap1J43tARURhVIqJYYmbkIn.jpg\",\"rating\":4,\"year\":2014,\"type\":\"tv\",\"_score\":0.21690140845070424,\"_genreOverlap\":1}],\"seasonNumber\":14,\"seasonName\":\"Season 14\",\"seasonOverview\":\"\",\"seasonPoster\":\"https://image.tmdb.org/t/p/w780/erzb8ruUywh4Zt5TCEB9Qaigsk6.jpg\",\"seasonAirDate\":\"2021-10-26\",\"episodes\":[{\"number\":1,\"name\":\"Winter, Lose or Draw\",\"overview\":\"In the high-stakes game of ice mining, Shawn chases a jackpot along an ancient riverbed, Kris goes all-in on brand new equipment and Zeke bets on his season with a fresh crew.\",\"still\":\"https://image.tmdb.org/t/p/w780/iytOih8RB4GSArWpnY2X9rL6sCm.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-10-26\",\"runtime\":41},{\"number\":2,\"name\":\"Snow Man's Land\",\"overview\":\"As the fleet must dig out of a snowstorm and beware of another on the horizon, Vernon sets up on the promising Claim 56, the Kellys race to get their new equipment on the ice, and Shawn battles an air compressor.\",\"still\":\"https://image.tmdb.org/t/p/w780/qMW8Q75oxsnJIrDRH4OHCUxM2J8.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-11-02\",\"runtime\":41},{\"number\":3,\"name\":\"No Country for Cold Men\",\"overview\":\"Shawn and Vernon hope to double down with back-to-back divers; Zeke faces an undetected flooding nightmare; the Kellys run into a hose shortage that forces them to pivot.\",\"still\":\"https://image.tmdb.org/t/p/w780/4QngROpeOAaTa09bzUyj78oFeYI.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-11-09\",\"runtime\":41},{\"number\":4,\"name\":\"Dive Till You Drop\",\"overview\":\"While all the mining teams compete in marathon dives, Shawn brings new gear to stay mining longer, Vernon sends down two ace divers, Kris expects to get on the gold and Zeke hopes for zero malfunctions.\",\"still\":\"https://image.tmdb.org/t/p/w780/tMejKzIvXYcjniFq0jM6JIxXQtK.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-11-16\",\"runtime\":41},{\"number\":5,\"name\":\"Bust a Move\",\"overview\":\"While the Captains rethink their mining locations, Vernon's diver tries to mine without a light, Shawn follows a yellow brick road in search of the motherlode, the Kellys must find gold to pay off their debts and Zeke stretches out the hose.\",\"still\":\"https://image.tmdb.org/t/p/w780/i1fFUkAoPphe1lYsajFa1YlIDLe.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-11-23\",\"runtime\":41},{\"number\":6,\"name\":\"Hustle and Overflow\",\"overview\":\"Shawn is driven to desperate measures to solve his water overflow problems. Zeke gives the West Beach Claim one last shot. Kris tries out Captain James as a diver. Vernon pushes forward despite dangerous ice conditions.\",\"still\":\"https://image.tmdb.org/t/p/w780/9semD4uNSfa8D9YkaCcwUKo8SOj.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-11-30\",\"runtime\":41},{\"number\":7,\"name\":\"Texas Cold 'Em\",\"overview\":\"Vernon races against weakening ice on Claim 56. Kris preps his operation for his upcoming absence. Shawn turns to an unusual method to track down a tricky paystreak. Zeke makes an eleventh hour move to Tomcod.\",\"still\":\"https://image.tmdb.org/t/p/w780/k1YbCWhZ3YfjnEsDequGGp6rGO6.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-12-07\",\"runtime\":41},{\"number\":8,\"name\":\"Yo Brother, Where Art Thou?\",\"overview\":\"With Kris away on father duty, Andy must bring in the gold as captain of the Reaper. Vernon tries to maximize his returns by minimizing his moves. Shawn finds himself just short of a paystreak. Zeke tries Shawn's coordinates to put some gold in the box.\",\"still\":\"https://image.tmdb.org/t/p/w780/amMiAQ55DaXVSSCtafvef3k2jsX.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-12-14\",\"runtime\":41},{\"number\":9,\"name\":\"Mining on a Prayer\",\"overview\":\"Kris must move fast in the face of a life-threatening incident. Vernon pushes a diver for a personal record. Shawn deals with a crack in the ice to keep on the trail of the Tomcod jackpot. Zeke sees signs of life just as his season is coming to an end.\",\"still\":\"https://image.tmdb.org/t/p/w780/x2jC08cLiEtr0yCOqzwqSaYESnz.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-12-21\",\"runtime\":41},{\"number\":10,\"name\":\"Legend vs. Underdog\",\"overview\":\"Top contenders Shawn and Vernon battle it out for their final haul in the face of a storm ready to knock them off the ice. Zeke risks one last move. Kris hopes to pull enough to set up his summer.\",\"still\":\"https://image.tmdb.org/t/p/w780/wMiIVKoeQXCpQI8a9maxVL5x7Cp.jpg\",\"rating\":0,\"voteCount\":0,\"airDate\":\"2021-12-28\",\"runtime\":41}],\"firstAirDate\":\"2012-01-27\"}","status":200,"url":""},"revalidate":86400,"tags":[]}