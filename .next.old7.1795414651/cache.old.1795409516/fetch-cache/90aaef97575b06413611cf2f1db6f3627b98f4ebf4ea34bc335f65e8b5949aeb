{"kind":"FETCH","data":{"headers":{},"body":"{\"id\":230248,\"title\":\"Scúp\",\"tagline\":\"\",\"overview\":\"Set in a struggling Irish language newspaper in Belfast, the series is built around the character of Rob Cullan. a journalist who has left a high flying job in an English newspaper under a cloud. He is persuaded to return to the community he grew up in by the wily newspaper proprietor Diarmuid Black to help rescue his ailing publication.\",\"posterPath\":\"https://image.tmdb.org/t/p/w780/6oTUaNLqXHajuev0hn7wfuczKMB.jpg\",\"backdropPath\":\"https://image.tmdb.org/t/p/original/mhAAKXSYnQe7Hj6lMJeJsTNMUQj.jpg\",\"youtubeBackdrop\":null,\"anilistBanner\":null,\"rating\":0,\"voteCount\":0,\"year\":2013,\"genres\":[\"Drama\"],\"status\":\"Ended\",\"type\":\"tv\",\"totalSeasons\":2,\"totalEpisodes\":14,\"createdBy\":[\"Colin Bateman\"],\"networks\":[\"TG4\"],\"countries\":[{\"code\":\"IE\",\"name\":\"Ireland\"}],\"lastAirDate\":\"2014-05-06\",\"cast\":[{\"id\":150575,\"name\":\"Declan Recks\",\"character\":\"Director\",\"photo\":null},{\"id\":111837,\"name\":\"Don Wycherley\",\"character\":\"Rob Cullan\",\"photo\":\"https://image.tmdb.org/t/p/w780/tW4s04DGwi7MEXQ6bIxdIYmI0ah.jpg\"},{\"id\":1541149,\"name\":\"Kelly Gough\",\"character\":\"Alix\",\"photo\":\"https://image.tmdb.org/t/p/w780/4rlQ8J5AvE1d7WjbFHu6QnP3I65.jpg\"},{\"id\":63360,\"name\":\"Denis Conway\",\"character\":\"Diarmuid\",\"photo\":\"https://image.tmdb.org/t/p/w780/egljQUHOL5l01bxgV28wctLaYtw.jpg\"},{\"id\":2919605,\"name\":\"Caitríona Ní Mhurchú\",\"character\":\"Janine\",\"photo\":\"https://image.tmdb.org/t/p/w780/rfaqizNUH2yQc1r8rKBsObLQMGq.jpg\"},{\"id\":140006,\"name\":\"Donncha Crowley\",\"character\":\"Cormac\",\"photo\":\"https://image.tmdb.org/t/p/w780/9y7N5XAYXSYfb1IoRLxiZWPKtAh.jpg\"}],\"trailers\":[{\"key\":\"CgcTjL-76Zg\",\"name\":\"Blaisín Scup / Scup Trailer\",\"site\":\"YouTube\",\"type\":\"Trailer\"}],\"similar\":[{\"id\":1438,\"title\":\"The Wire\",\"poster\":\"https://image.tmdb.